// ============================================
// DJ-2026-014 三段式玻璃输送线控制系统
// 全局变量表 (GVL)
// PLC: 汇川AM系列 (Autoshop编程环境)
// 版本: V1.0.0 [2026-04-12]
// ============================================

VAR_GLOBAL

    (* ========== 1. 数字量输入 (DI/X) ========== *)

    (* 操作按钮 *)
    X_SystemReset         AT %IX0.0 : BOOL;   // 系统复位按钮 (上升沿)
    X_EmergencyStop        AT %IX0.1 : BOOL;   // 急停按钮 (常闭,断开=急停)

    (* 上游操作按钮 *)
    X_Start_Upstream      AT %IX0.2 : BOOL;   // 上游启动 (保持型)
    X_Stop_Upstream       AT %IX0.3 : BOOL;   // 上游停止 (上升沿)

    (* 本站操作按钮 *)
    X_Start_Station       AT %IX0.4 : BOOL;   // 本站启动 (保持型)
    X_Stop_Station        AT %IX0.5 : BOOL;   // 本站停止 (上升沿)

    (* 下游操作按钮 *)
    X_Start_Downstream    AT %IX0.6 : BOOL;   // 下游启动 (保持型)
    X_Stop_Downstream     AT %IX0.7 : BOOL;   // 下游停止 (上升沿)


    (* 传感器输入 - 上游 *)
    X_SensorUpstream_Inlet     AT %IX1.0 : BOOL;  // 上游入口检测
    X_SensorUpstream_Position1 AT %IX1.1 : BOOL;  // 上游到位检测(本站入口)

    (* 传感器输入 - 本站 *)
    X_SensorStation_Position1   AT %IX1.2 : BOOL;  // 本站到位检测

    (* 传感器输入 - 下游 *)
    X_SensorDownstream_Position1 AT %IX1.3 : BOOL;  // 下游到位检测
    X_SensorDownstream_Outlet   AT %IX1.4 : BOOL;  // 下游出口检测


    (* 驱动器状态输入 *)
    X_DriveAlarm_Upstream    AT %IX2.0 : BOOL;  // 上游驱动报警
    X_DriveAlarm_Station     AT %IX2.1 : BOOL;  // 本站驱动报警
    X_DriveAlarm_Downstream  AT %IX2.2 : BOOL;  // 下游驱动报警

    X_DriveReady_Upstream    AT %IX2.3 : BOOL;  // 上游驱动就绪
    X_DriveReady_Station     AT %IX2.4 : BOOL;  // 本站驱动就绪
    X_DriveReady_Downstream  AT %IX2.5 : BOOL;  // 下游驱动就绪


    (* ========== 2. 数字量输出 (DO/Y) ========== *)

    (* 电机运行输出 *)
    Y_MotorRun_Upstream     AT %QX0.0 : BOOL;  // 上游电机运行
    Y_MotorRun_Station      AT %QX0.1 : BOOL;  // 本站电机运行
    Y_MotorRun_Downstream   AT %QX0.2 : BOOL;  // 下游电机运行

    (* 运行指示灯 *)
    Y_RunInd_Upstream       AT %QX1.0 : BOOL;  // 上游运行指示(绿)
    Y_RunInd_Station        AT %QX1.1 : BOOL;  // 本站运行指示(绿)
    Y_RunInd_Downstream     AT %QX1.2 : BOOL;  // 下游运行指示(绿)

    (* 故障指示灯 *)
    Y_FaultInd_Upstream     AT %QX1.3 : BOOL;  // 上游故障指示(红)
    Y_FaultInd_Station      AT %QX1.4 : BOOL;  // 本站故障指示(红)
    Y_FaultInd_Downstream   AT %QX1.5 : BOOL;  // 下游故障指示(红)

    (* 产品到位指示 *)
    Y_ProductDone_Upstream  AT %QX1.6 : BOOL;  // 上游到位完成(黄)
    Y_ProductDone_Station   AT %QX1.7 : BOOL;  // 本站到位完成(黄)
    Y_ProductDone_Downstream AT %QX2.0 : BOOL;  // 下游到位完成(黄)

    (* 报警输出 *)
    Y_Alarm_Buzzer          AT %QX2.1 : BOOL;  // 蜂鸣器
    Y_Alarm_TowerLight       AT %QX2.2 : BOOL;  // 塔灯


    (* ========== 3. 数据寄存器 (D) ========== *)

    (* 模式与方向设定 *)
    D_MainControlMode       AT %DW0   : INT := 0;   // 主控模式: 0停止/1手动/2自动

    D_MotorDirection_Upstream  AT %DW2 : INT := 0;  // 上游方向: 0正转/1反转
    D_MotorDirection_Station   AT %DW4 : INT := 0;  // 本站方向: 0正转/1反转
    D_MotorDirection_Downstream AT %DW6 : INT := 0;  // 下游方向: 0正转/1反转

    D_SlowDelayTime         AT %DW8   : INT := 1000; // 慢速延时时间(ms),默认1秒

    (* 状态字输出 *)
    D_StatusWord_Upstream   AT %DW10  : INT := 0;   // 上游状态字
    D_StatusWord_Station    AT %DW12  : INT := 0;   // 本站状态字
    D_StatusWord_Downstream AT %DW14  : INT := 0;   // 下游状态字

    (* 系统状态 *)
    D_SystemStatus          AT %DW16  : INT := 0;   // 系统状态: 0停/1运行/2故障/3急停
    D_ProductCount          AT %DW18  : DINT := 0;  // 生产计数
    D_CycleCount_Total      AT %DW20  : DINT := 0;  // 总循环次数


    (* ========== 4. 模拟量 (预留) ========== *)

    (* 速度设定输入 (AI) - 可从HMI电位器或上位机给定 *)
    I_SpeedSet_Upstream     AT %IW0   : REAL := 50.0;  // 上游速度设定(Hz),默认50Hz
    I_SpeedSet_Station      AT %IW2   : REAL := 50.0;  // 本站速度设定(Hz),默认50Hz
    I_SpeedSet_Downstream   AT %IW4   : REAL := 50.0;  // 下游速度设定(Hz),默认50Hz

    (* 速度输出 (AO) - 输出到变频器模拟量口 *)
    Q_SpeedFreq_Upstream    AT %QW0   : REAL := 0.0;   // 上游速度输出(V/Hz)
    Q_SpeedFreq_Station     AT %QW2   : REAL := 0.0;   // 本站速度输出(V/Hz)
    Q_SpeedFreq_Downstream  AT %QW4   : REAL := 0.0;   // 下游速度输出(V/Hz)


END_VAR
