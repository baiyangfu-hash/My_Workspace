// 工作站控制FB块 - 严格按照实例语法规范
// 版本：v1.0.0 [2026-02-01_10:00]
// 功能：控制工作站的启动、停止、报警处理和状态管理
// 输入变量：
//   i_WSManualStart - 工作站手动启动信号，上升沿触发
//   i_WSManualStop - 工作站手动停止信号，上升沿触发
//   i_WSAutoStart - 工作站自动启动信号，上升沿触发
//   i_WSAutoStop - 工作站自动停止信号，上升沿触发
//   i_WSAlarm - 工作站报警信号，高电平有效
//   i_WSReset - 工作站复位信号，上升沿触发
//   i_WSMasterCommand - 主控命令：0=无命令,1=启动,2=急停,3=暂停,4=初始化
//   i_WSMasterCommandEnable - 主控命令使能信号，上升沿触发
//   i_WSControlParams - 控制参数：运行模式(0=自动,1=手动,2=半自动)
//   i_WSParamUpdate - 参数更新标志，上升沿触发
// 输出变量：
//   q_WSOutput - 工作站控制输出信号，高电平有效
//   q_WSAlarmStatus - 工作站报警状态输出，高电平有效
//   q_WSStatusWord - 工作站状态字，位0-7表示不同状态
//   q_WSCommandStatus - 命令执行状态：0=空闲,1=执行中,2=执行完成,3=不予执行
//   q_WSWorkstationStatus - 工作站状态：0=待料中,1=堵料中,2=工作中,3=报警中
// 内部变量：
//   tmp_bWSOutput - 工作站输出状态内部变量
//   tmp_bWSAlarmStatus - 工作站报警状态内部变量
//   tmp_nWSStatusWord - 工作站状态字内部变量
//   tmp_bWSManualMode - 工作站手动模式标志
//   tmp_bWSAutoMode - 工作站自动模式标志
//   tmp_bWSInitialized - 工作站初始化标志
//   tmp_bWSRunning - 工作站运行状态标志
//   tmp_bWSReady - 工作站就绪状态标志
//   tmp_nWSCommandStatus - 命令执行状态内部变量
//   tmp_nWSWorkstationStatus - 工作站状态内部变量
//   tmp_nWSControlParams - 控制参数内部变量
//   tmp_bWSCommandExecuting - 命令执行中标志
//   prev_WSManualStart - 上升沿检测变量
//   prev_WSManualStop - 上升沿检测变量
//   prev_WSAutoStart - 上升沿检测变量
//   prev_WSAutoStop - 上升沿检测变量
//   prev_WSReset - 上升沿检测变量
//   prev_WSMasterCommandEnable - 上升沿检测变量
//   prev_WSParamUpdate - 上升沿检测变量
// 变更记录：
// [2026-02-01] 变更原因：创建工作站控制功能块
// 变更内容：根据实例语法规范创建工作站控制FB块，实现主控命令执行、控制参数处理、状态报告、报警处理和状态监控功能

FUNCTION_BLOCK FB_WorkstationControl
VAR_INPUT
    i_WSManualStart         : BOOL;          // 工作站手动启动信号，上升沿触发
    i_WSManualStop          : BOOL;          // 工作站手动停止信号，上升沿触发
    i_WSAutoStart           : BOOL;          // 工作站自动启动信号，上升沿触发
    i_WSAutoStop            : BOOL;          // 工作站自动停止信号，上升沿触发
    i_WSAlarm               : BOOL;          // 工作站报警信号，高电平有效
    i_WSReset               : BOOL;          // 工作站复位信号，上升沿触发
    i_WSMasterCommand       : INT;           // 主控命令：0=无命令,1=启动,2=急停,3=暂停,4=初始化
    i_WSMasterCommandEnable : BOOL;          // 主控命令使能信号，上升沿触发
    i_WSControlParams       : INT;           // 控制参数：运行模式(0=自动,1=手动,2=半自动)
    i_WSParamUpdate         : BOOL;          // 参数更新标志，上升沿触发
END_VAR

VAR_OUTPUT
    q_WSOutput              : BOOL;          // 工作站控制输出信号，高电平有效
    q_WSAlarmStatus         : BOOL;          // 工作站报警状态输出，高电平有效
    q_WSStatusWord          : DWORD;         // 工作站状态字，位0-7表示不同状态
    q_WSCommandStatus       : INT;           // 命令执行状态：0=空闲,1=执行中,2=执行完成,3=不予执行
    q_WSWorkstationStatus   : INT;           // 工作站状态：0=待料中,1=堵料中,2=工作中,3=报警中
END_VAR

VAR
    // 内部变量
    tmp_bWSOutput           : BOOL := FALSE; // 工作站输出状态内部变量
    tmp_bWSAlarmStatus      : BOOL := FALSE; // 工作站报警状态内部变量
    tmp_nWSStatusWord       : DWORD := 0;    // 工作站状态字内部变量
    tmp_bWSManualMode       : BOOL := FALSE; // 工作站手动模式标志
    tmp_bWSAutoMode         : BOOL := FALSE; // 工作站自动模式标志
    tmp_bWSInitialized      : BOOL := FALSE; // 工作站初始化标志
    tmp_bWSRunning          : BOOL := FALSE; // 工作站运行状态标志
    tmp_bWSReady            : BOOL := FALSE; // 工作站就绪状态标志
    tmp_nWSCommandStatus    : INT := 0;       // 命令执行状态内部变量
    tmp_nWSWorkstationStatus : INT := 0;      // 工作站状态内部变量
    tmp_nWSControlParams    : INT := 0;       // 控制参数内部变量
    tmp_bWSCommandExecuting : BOOL := FALSE; // 命令执行中标志
    
    // 上升沿检测变量
    tmp_prev_WSManualStart      : BOOL := FALSE;
    tmp_prev_WSManualStop       : BOOL := FALSE;
    tmp_prev_WSAutoStart        : BOOL := FALSE;
    tmp_prev_WSAutoStop         : BOOL := FALSE;
    tmp_prev_WSReset            : BOOL := FALSE;
    tmp_prev_WSMasterCommandEnable : BOOL := FALSE;
    tmp_prev_WSParamUpdate      : BOOL := FALSE;
END_VAR

BEGIN
    // 1. 初始化模块
    IF NOT tmp_bWSInitialized THEN
        // 初始化所有内部变量
        tmp_bWSOutput := FALSE;
        tmp_bWSAlarmStatus := FALSE;
        tmp_nWSStatusWord := 0;
        tmp_bWSManualMode := FALSE;
        tmp_bWSAutoMode := FALSE;
        tmp_bWSRunning := FALSE;
        tmp_bWSReady := TRUE;
        tmp_nWSCommandStatus := 0;
        tmp_nWSWorkstationStatus := 0;
        tmp_nWSControlParams := 0;
        tmp_bWSCommandExecuting := FALSE;
        
        // 初始化完成
        tmp_bWSInitialized := TRUE;
        tmp_nWSWorkstationStatus := 0; // 待料中
    END_IF
    
    // 2. 报警处理模块
    IF i_WSAlarm THEN
        // 触发报警
        tmp_bWSAlarmStatus := TRUE;
        tmp_bWSOutput := FALSE;
        tmp_bWSRunning := FALSE;
        tmp_nWSWorkstationStatus := 3; // 报警中
        tmp_nWSCommandStatus := 3; // 不予执行
    ELSIF i_WSReset AND NOT tmp_prev_WSReset THEN
        // 复位报警
        tmp_bWSAlarmStatus := FALSE;
        tmp_nWSWorkstationStatus := 0; // 待料中
        tmp_nWSCommandStatus := 0; // 空闲
    END_IF
    
    // 3. 参数处理模块
    IF i_WSParamUpdate AND NOT prev_WSParamUpdate THEN
        // 更新控制参数
        tmp_nWSControlParams := i_WSControlParams;
        
        // 更新运行模式
        CASE tmp_nWSControlParams OF
            0: // 自动模式
                tmp_bWSAutoMode := TRUE;
                tmp_bWSManualMode := FALSE;
            1: // 手动模式
                tmp_bWSManualMode := TRUE;
                tmp_bWSAutoMode := FALSE;
            2: // 半自动模式
                tmp_bWSManualMode := TRUE;
                tmp_bWSAutoMode := TRUE;
            ELSE
                // 无效参数，保持当前模式
        END_CASE
    END_IF
    
    // 4. 主控命令处理模块
    IF i_WSMasterCommandEnable AND NOT prev_WSMasterCommandEnable THEN
        // 执行主控命令
        tmp_bWSCommandExecuting := TRUE;
        tmp_nWSCommandStatus := 1; // 执行中
        
        CASE i_WSMasterCommand OF
            1: // 启动命令
                IF NOT tmp_bWSAlarmStatus THEN
                    tmp_bWSOutput := TRUE;
                    tmp_bWSRunning := TRUE;
                    tmp_nWSWorkstationStatus := 2; // 工作中
                    tmp_nWSCommandStatus := 2; // 执行完成
                ELSE
                    tmp_nWSCommandStatus := 3; // 不予执行
                END_IF;
            
            2: // 急停命令
                tmp_bWSOutput := FALSE;
                tmp_bWSRunning := FALSE;
                tmp_nWSWorkstationStatus := 0; // 待料中
                tmp_nWSCommandStatus := 2; // 执行完成
            
            3: // 暂停命令
                tmp_bWSOutput := FALSE;
                tmp_bWSRunning := FALSE;
                tmp_nWSWorkstationStatus := 0; // 待料中
                tmp_nWSCommandStatus := 2; // 执行完成
            
            4: // 初始化命令
                // 重新初始化
                tmp_bWSInitialized := FALSE;
                tmp_nWSCommandStatus := 2; // 执行完成
            
            ELSE: // 无命令或无效命令
                tmp_nWSCommandStatus := 3; // 不予执行
        END_CASE;
        
        tmp_bWSCommandExecuting := FALSE;
    END_IF
    
    // 5. 手动控制模块
    IF tmp_bWSManualMode AND NOT tmp_bWSAlarmStatus THEN
        // 手动启动
        IF i_WSManualStart AND NOT prev_WSManualStart THEN
            tmp_bWSOutput := TRUE;
            tmp_bWSRunning := TRUE;
            tmp_nWSWorkstationStatus := 2; // 工作中
        END_IF;
        
        // 手动停止
        IF i_WSManualStop AND NOT prev_WSManualStop THEN
            tmp_bWSOutput := FALSE;
            tmp_bWSRunning := FALSE;
            tmp_nWSWorkstationStatus := 0; // 待料中
        END_IF;
    END_IF
    
    // 6. 自动控制模块
    IF tmp_bWSAutoMode AND NOT tmp_bWSAlarmStatus THEN
        // 自动启动
        IF i_WSAutoStart AND NOT prev_WSAutoStart THEN
            tmp_bWSOutput := TRUE;
            tmp_bWSRunning := TRUE;
            tmp_nWSWorkstationStatus := 2; // 工作中
        END_IF;
        
        // 自动停止
        IF i_WSAutoStop AND NOT prev_WSAutoStop THEN
            tmp_bWSOutput := FALSE;
            tmp_bWSRunning := FALSE;
            tmp_nWSWorkstationStatus := 0; // 待料中
        END_IF;
    END_IF
    
    // 7. 状态监控模块
    // 更新状态字
    tmp_nWSStatusWord := 0;
    
    // 位0: 手动模式
    IF tmp_bWSManualMode THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000001;
    END_IF;
    
    // 位1: 自动模式
    IF tmp_bWSAutoMode THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000002;
    END_IF;
    
    // 位2: 输出状态
    IF tmp_bWSOutput THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000004;
    END_IF;
    
    // 位3: 报警状态
    IF tmp_bWSAlarmStatus THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000008;
    END_IF;
    
    // 位4: 初始化完成
    IF tmp_bWSInitialized THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000010;
    END_IF;
    
    // 位5: 运行状态
    IF tmp_bWSRunning THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000020;
    END_IF;
    
    // 位6: 就绪状态
    IF tmp_bWSReady THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000040;
    END_IF;
    
    // 位7: 错误状态
    IF tmp_bWSAlarmStatus THEN
        tmp_nWSStatusWord := tmp_nWSStatusWord OR 16#00000080;
    END_IF;
    
    // 8. 状态报告模块
    // 更新输出变量
    q_WSOutput := tmp_bWSOutput;
    q_WSAlarmStatus := tmp_bWSAlarmStatus;
    q_WSStatusWord := tmp_nWSStatusWord;
    q_WSCommandStatus := tmp_nWSCommandStatus;
    q_WSWorkstationStatus := tmp_nWSWorkstationStatus;
    
    // 更新上升沿检测变量
    prev_WSManualStart := i_WSManualStart;
    prev_WSManualStop := i_WSManualStop;
    prev_WSAutoStart := i_WSAutoStart;
    prev_WSAutoStop := i_WSAutoStop;
    prev_WSReset := i_WSReset;
    prev_WSMasterCommandEnable := i_WSMasterCommandEnable;
    prev_WSParamUpdate := i_WSParamUpdate;
END_FUNCTION_BLOCK