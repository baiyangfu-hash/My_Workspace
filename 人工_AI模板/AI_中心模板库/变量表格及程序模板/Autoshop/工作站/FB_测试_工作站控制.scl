// 工作站控制测试FB块 - 严格按照实例语法规范
// 版本：v1.0.0 [2026-02-01_10:00]
// 功能：测试工作站控制功能块的各项功能
// 输入变量：
//   test_i_WSManualStart - 测试手动启动信号
//   test_i_WSManualStop - 测试手动停止信号
//   test_i_WSAutoStart - 测试自动启动信号
//   test_i_WSAutoStop - 测试自动停止信号
//   test_i_WSAlarm - 测试报警信号
//   test_i_WSReset - 测试复位信号
//   test_i_WSMasterCommand - 测试主控命令
//   test_i_WSMasterCommandEnable - 测试主控命令使能信号
//   test_i_WSControlParams - 测试控制参数
//   test_i_WSParamUpdate - 测试参数更新标志
//   test_bTestMode - 测试模式标志
// 输出变量：
//   test_q_WSOutput - 测试工作站输出信号
//   test_q_WSAlarmStatus - 测试工作站报警状态输出
//   test_q_WSStatusWord - 测试工作站状态字
//   test_q_WSCommandStatus - 测试命令执行状态
//   test_q_WSWorkstationStatus - 测试工作站状态
//   test_bTestComplete - 测试完成标志
// 变更记录：
// [2026-02-01] 变更原因：创建工作站控制测试功能块
// 变更内容：根据实例语法规范创建测试FB块，用于验证工作站控制功能块的各项功能

FUNCTION_BLOCK FB_TestWorkstationControl
VAR
    // 工作站控制功能块实例
    fb_WorkstationControl : FB_WorkstationControl;
    
    // 测试输入变量
    test_i_WSManualStart         : BOOL := FALSE;
    test_i_WSManualStop          : BOOL := FALSE;
    test_i_WSAutoStart           : BOOL := FALSE;
    test_i_WSAutoStop            : BOOL := FALSE;
    test_i_WSAlarm               : BOOL := FALSE;
    test_i_WSReset               : BOOL := FALSE;
    test_i_WSMasterCommand       : INT := 0;
    test_i_WSMasterCommandEnable : BOOL := FALSE;
    test_i_WSControlParams       : INT := 0;
    test_i_WSParamUpdate         : BOOL := FALSE;
    test_bTestMode               : BOOL := FALSE; // 测试模式标志
    
    // 测试输出变量
    test_q_WSOutput              : BOOL;
    test_q_WSAlarmStatus         : BOOL;
    test_q_WSStatusWord          : DWORD;
    test_q_WSCommandStatus       : INT;
    test_q_WSWorkstationStatus   : INT;
    test_bTestComplete           : BOOL := FALSE; // 测试完成标志
    
    // 测试内部变量
    test_nTestStep               : INT := 0;     // 测试步骤
    test_tTestTimer              : TIME := T#0s; // 测试定时器
END_VAR

BEGIN
    // 连接功能块输入输出
    fb_WorkstationControl.i_WSManualStart         := test_i_WSManualStart;
    fb_WorkstationControl.i_WSManualStop          := test_i_WSManualStop;
    fb_WorkstationControl.i_WSAutoStart           := test_i_WSAutoStart;
    fb_WorkstationControl.i_WSAutoStop            := test_i_WSAutoStop;
    fb_WorkstationControl.i_WSAlarm               := test_i_WSAlarm;
    fb_WorkstationControl.i_WSReset               := test_i_WSReset;
    fb_WorkstationControl.i_WSMasterCommand       := test_i_WSMasterCommand;
    fb_WorkstationControl.i_WSMasterCommandEnable := test_i_WSMasterCommandEnable;
    fb_WorkstationControl.i_WSControlParams       := test_i_WSControlParams;
    fb_WorkstationControl.i_WSParamUpdate         := test_i_WSParamUpdate;
    
    // 调用功能块
    fb_WorkstationControl();
    
    // 读取功能块输出
    test_q_WSOutput              := fb_WorkstationControl.q_WSOutput;
    test_q_WSAlarmStatus         := fb_WorkstationControl.q_WSAlarmStatus;
    test_q_WSStatusWord          := fb_WorkstationControl.q_WSStatusWord;
    test_q_WSCommandStatus       := fb_WorkstationControl.q_WSCommandStatus;
    test_q_WSWorkstationStatus   := fb_WorkstationControl.q_WSWorkstationStatus;
    
    // 测试逻辑
    IF test_bTestMode THEN
        CASE test_nTestStep OF
            0: // 初始化测试
                test_i_WSControlParams := 0; // 自动模式
                test_i_WSParamUpdate := TRUE;
                test_nTestStep := 1;
                test_tTestTimer := T#1s;
            
            1: // 等待参数更新
                IF test_tTestTimer <= T#0s THEN
                    test_i_WSParamUpdate := FALSE;
                    test_nTestStep := 2;
                    test_tTestTimer := T#1s;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            2: // 测试自动启动
                test_i_WSAutoStart := TRUE;
                test_nTestStep := 3;
                test_tTestTimer := T#1s;
            
            3: // 等待启动完成
                IF test_tTestTimer <= T#0s THEN
                    test_i_WSAutoStart := FALSE;
                    test_nTestStep := 4;
                    test_tTestTimer := T#2s;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            4: // 测试自动停止
                test_i_WSAutoStop := TRUE;
                test_nTestStep := 5;
                test_tTestTimer := T#1s;
            
            5: // 等待停止完成
                IF test_tTestTimer <= T#0s THEN
                    test_i_WSAutoStop := FALSE;
                    test_nTestStep := 6;
                    test_tTestTimer := T#1s;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            6: // 测试报警
                test_i_WSAlarm := TRUE;
                test_nTestStep := 7;
                test_tTestTimer := T#1s;
            
            7: // 等待报警处理
                IF test_tTestTimer <= T#0s THEN
                    test_nTestStep := 8;
                    test_tTestTimer := T#1s;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            8: // 测试复位
                test_i_WSReset := TRUE;
                test_nTestStep := 9;
                test_tTestTimer := T#1s;
            
            9: // 等待复位完成
                IF test_tTestTimer <= T#0s THEN
                    test_i_WSReset := FALSE;
                    test_i_WSAlarm := FALSE;
                    test_nTestStep := 10;
                    test_tTestTimer := T#1s;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            10: // 测试主控命令
                test_i_WSMasterCommand := 1; // 启动命令
                test_i_WSMasterCommandEnable := TRUE;
                test_nTestStep := 11;
                test_tTestTimer := T#1s;
            
            11: // 等待命令执行
                IF test_tTestTimer <= T#0s THEN
                    test_i_WSMasterCommandEnable := FALSE;
                    test_nTestStep := 12;
                    test_tTestTimer := T#2s;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            12: // 测试急停命令
                test_i_WSMasterCommand := 2; // 急停命令
                test_i_WSMasterCommandEnable := TRUE;
                test_nTestStep := 13;
                test_tTestTimer := T#1s;
            
            13: // 等待急停执行
                IF test_tTestTimer <= T#0s THEN
                    test_i_WSMasterCommandEnable := FALSE;
                    test_nTestStep := 14;
                    test_bTestComplete := TRUE;
                ELSE
                    test_tTestTimer := test_tTestTimer - T#100ms;
                END_IF;
            
            ELSE:
                test_bTestComplete := TRUE;
        END_CASE;
    END_IF;
END_FUNCTION_BLOCK