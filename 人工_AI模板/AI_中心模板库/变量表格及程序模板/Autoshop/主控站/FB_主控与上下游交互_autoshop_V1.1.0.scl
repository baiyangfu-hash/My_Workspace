    q_WorkstationParamUpdate0 : BOOL;   // 工作站0参数更新信号
    q_WorkstationParamUpdate1 : BOOL;   // 工作站1参数更新信号
    q_WorkstationParamUpdate2 : BOOL;   // 工作站2参数更新信号
    q_WorkstationParamUpdate3 : BOOL;   // 工作站3参数更新信号
    q_WorkstationParamUpdate4 : BOOL;   // 工作站4参数更新信号
    q_WorkstationParamUpdate5 : BOOL;   // 工作站5参数更新信号
    q_WorkstationParamUpdate6 : BOOL;   // 工作站6参数更新信号
    q_WorkstationParamUpdate7 : BOOL;   // 工作站7参数更新信号
    
    // 外部通讯输出变量
    q_MESDataUpload : BOOL;                           // MES数据上传信号
    q_MESProductionData : STRING;                     // MES生产数据
    q_ERPDataSync : BOOL;                             // ERP数据同步信号
    q_ERPInventoryData : STRING;                      // ERP库存数据
    q_HMISystemStatus : DWORD;                        // HMI系统状态字
    
    q_HMIWorkstationStatus0 : INT;      // HMI工作站0状态
    q_HMIWorkstationStatus1 : INT;      // HMI工作站1状态
    q_HMIWorkstationStatus2 : INT;      // HMI工作站2状态
    q_HMIWorkstationStatus3 : INT;      // HMI工作站3状态
    q_HMIWorkstationStatus4 : INT;      // HMI工作站4状态
    q_HMIWorkstationStatus5 : INT;      // HMI工作站5状态
    q_HMIWorkstationStatus6 : INT;      // HMI工作站6状态
    q_HMIWorkstationStatus7 : INT;      // HMI工作站7状态
    
    // 报警输出变量
    q_AlarmActive : BOOL;                             // 报警激活信号
    q_StatusWord : DWORD;                             // 系统状态字
    q_AlarmMessage : STRING;                          // 报警消息
END_VAR
*)
 (*
VAR
   
    // 初始化变量
    b_FirstScan : BOOL := TRUE;                       // 首次扫描标志
    b_SystemReady : BOOL := TRUE;                     // 系统准备好状态
    
    // 错误处理变量
    b_Error : BOOL := FALSE;                          // 错误状态
    
    // 工作站状态变量
    b_AllWorkstationsReady : BOOL := FALSE;           // 所有工作站准备就绪
    b_AllWorkstationsCompleted : BOOL := FALSE;       // 所有工作站完成
    
    b_WorkstationReady0 : BOOL := FALSE;              // 工作站0准备好内部状态
    b_WorkstationReady1 : BOOL := FALSE;              // 工作站1准备好内部状态
    b_WorkstationReady2 : BOOL := FALSE;              // 工作站2准备好内部状态
    b_WorkstationReady3 : BOOL := FALSE;              // 工作站3准备好内部状态
    b_WorkstationReady4 : BOOL := FALSE;              // 工作站4准备好内部状态
    b_WorkstationReady5 : BOOL := FALSE;              // 工作站5准备好内部状态
    b_WorkstationReady6 : BOOL := FALSE;              // 工作站6准备好内部状态
    b_WorkstationReady7 : BOOL := FALSE;              // 工作站7准备好内部状态
    
    b_WorkstationRunning0 : BOOL := FALSE;            // 工作站0运行内部状态
    b_WorkstationRunning1 : BOOL := FALSE;            // 工作站1运行内部状态
    b_WorkstationRunning2 : BOOL := FALSE;            // 工作站2运行内部状态
    b_WorkstationRunning3 : BOOL := FALSE;            // 工作站3运行内部状态
    b_WorkstationRunning4 : BOOL := FALSE;            // 工作站4运行内部状态
    b_WorkstationRunning5 : BOOL := FALSE;            // 工作站5运行内部状态
    b_WorkstationRunning6 : BOOL := FALSE;            // 工作站6运行内部状态
    b_WorkstationRunning7 : BOOL := FALSE;            // 工作站7运行内部状态
    
    b_WorkstationError0 : BOOL := FALSE;              // 工作站0错误内部状态
    b_WorkstationError1 : BOOL := FALSE;              // 工作站1错误内部状态
    b_WorkstationError2 : BOOL := FALSE;              // 工作站2错误内部状态
    b_WorkstationError3 : BOOL := FALSE;              // 工作站3错误内部状态
    b_WorkstationError4 : BOOL := FALSE;              // 工作站4错误内部状态
    b_WorkstationError5 : BOOL := FALSE;              // 工作站5错误内部状态
    b_WorkstationError6 : BOOL := FALSE;              // 工作站6错误内部状态
    b_WorkstationError7 : BOOL := FALSE;              // 工作站7错误内部状态
    
    n_WorkstationStatus0 : INT := 0;                  // 工作站0状态码
    n_WorkstationStatus1 : INT := 0;                  // 工作站1状态码
    n_WorkstationStatus2 : INT := 0;                  // 工作站2状态码
    n_WorkstationStatus3 : INT := 0;                  // 工作站3状态码
    n_WorkstationStatus4 : INT := 0;                  // 工作站4状态码
    n_WorkstationStatus5 : INT := 0;                  // 工作站5状态码
    n_WorkstationStatus6 : INT := 0;                  // 工作站6状态码
    n_WorkstationStatus7 : INT := 0;                  // 工作站7状态码
    
    n_WorkstationCycleCount0 : INT := 0;              // 工作站0循环计数
    n_WorkstationCycleCount1 : INT := 0;              // 工作站1循环计数
    n_WorkstationCycleCount2 : INT := 0;              // 工作站2循环计数
    n_WorkstationCycleCount3 : INT := 0;              // 工作站3循环计数
    n_WorkstationCycleCount4 : INT := 0;              // 工作站4循环计数
    n_WorkstationCycleCount5 : INT := 0;              // 工作站5循环计数
    n_WorkstationCycleCount6 : INT := 0;              // 工作站6循环计数
    n_WorkstationCycleCount7 : INT := 0;              // 工作站7循环计数
    
    // 外部通讯状态变量
    b_MESConnected : BOOL := FALSE;                   // MES系统连接状态
    b_ERPConnected : BOOL := FALSE;                   // ERP系统连接状态
    b_HMIConnected : BOOL := FALSE;                   // HMI系统连接状态
    
    // 生产控制变量
    n_CurrentState : INT := 0;                        // 当前状态机状态
    n_ProductionPhase : INT := 0;                     // 生产阶段
    
    // 数据变量
    tmp_sAlarmMessage : STRING := '';                 // 报警消息
    tmp_sProductionData : STRING := '';               // 生产数据
    tmp_sInventoryData : STRING := '';                // 库存数据
    
    // 通用变量
    n_LoopCounter : INT := 0;                         // 循环计数器
    
    // 计时器变量
    In_tTimer1 : ARRAY[0..5] OF BOOL := FALSE;        // 计时器输入数组
    ET_tTimer1 : ARRAY[0..5] OF TIME := T#0s;         // 计时器输出数组
    
    // 测试功能变量
    b_TestStarted : BOOL := FALSE;                    // 测试开始标志
    b_TestCompleted : BOOL := FALSE;                  // 测试完成标志
    n_TestStep : INT := 0;                            // 测试步骤
    
    // 常量定义
    n_MaxWorkstations : INT := 8;                     // 最大工作站数量
END_VAR

BEGIN
 *)
    // 主控制逻辑
    
    // 1. 初始化模块
    IF b_FirstScan THEN
        // 初始化内部变量
        b_SystemReady := TRUE;
        b_Error := FALSE;
        n_CurrentState := 0;
        
        // 初始化工作站状态
        b_WorkstationReady0 := FALSE;
        b_WorkstationReady1 := FALSE;
        b_WorkstationReady2 := FALSE;
        b_WorkstationReady3 := FALSE;
        b_WorkstationReady4 := FALSE;
        b_WorkstationReady5 := FALSE;
        b_WorkstationReady6 := FALSE;
        b_WorkstationReady7 := FALSE;
        
        b_WorkstationRunning0 := FALSE;
        b_WorkstationRunning1 := FALSE;
        b_WorkstationRunning2 := FALSE;
        b_WorkstationRunning3 := FALSE;
        b_WorkstationRunning4 := FALSE;
        b_WorkstationRunning5 := FALSE;
        b_WorkstationRunning6 := FALSE;
        b_WorkstationRunning7 := FALSE;
        
        b_WorkstationError0 := FALSE;
        b_WorkstationError1 := FALSE;
        b_WorkstationError2 := FALSE;
        b_WorkstationError3 := FALSE;
        b_WorkstationError4 := FALSE;
        b_WorkstationError5 := FALSE;
        b_WorkstationError6 := FALSE;
        b_WorkstationError7 := FALSE;
        
        n_WorkstationStatus0 := 0;
        n_WorkstationStatus1 := 0;
        n_WorkstationStatus2 := 0;
        n_WorkstationStatus3 := 0;
        n_WorkstationStatus4 := 0;
        n_WorkstationStatus5 := 0;
        n_WorkstationStatus6 := 0;
        n_WorkstationStatus7 := 0;
        
        // 初始化外部通讯状态
        b_MESConnected := FALSE;
        b_ERPConnected := FALSE;
        b_HMIConnected := FALSE;
        
        // 初始化输出变量
        q_SystemReady := TRUE;
        q_StatusWord := 0;
        
        // 初始化计时器
        FOR n_LoopCounter := 0 TO 5 DO
            ET_tTimer1[n_LoopCounter] := T#0s;
        END_FOR;
        
        b_FirstScan := FALSE;
    END_IF;
    
    // 2. 工作站监控模块
    // 采集工作站状态
    b_WorkstationReady0 := i_WorkstationReady0;
    b_WorkstationReady1 := i_WorkstationReady1;
    b_WorkstationReady2 := i_WorkstationReady2;
    b_WorkstationReady3 := i_WorkstationReady3;
    b_WorkstationReady4 := i_WorkstationReady4;
    b_WorkstationReady5 := i_WorkstationReady5;
    b_WorkstationReady6 := i_WorkstationReady6;
    b_WorkstationReady7 := i_WorkstationReady7;
    
    b_WorkstationRunning0 := i_WorkstationRunning0;
    b_WorkstationRunning1 := i_WorkstationRunning1;
    b_WorkstationRunning2 := i_WorkstationRunning2;
    b_WorkstationRunning3 := i_WorkstationRunning3;
    b_WorkstationRunning4 := i_WorkstationRunning4;
    b_WorkstationRunning5 := i_WorkstationRunning5;
    b_WorkstationRunning6 := i_WorkstationRunning6;
    b_WorkstationRunning7 := i_WorkstationRunning7;
    
    b_WorkstationError0 := i_WorkstationError0;
    b_WorkstationError1 := i_WorkstationError1;
    b_WorkstationError2 := i_WorkstationError2;
    b_WorkstationError3 := i_WorkstationError3;
    b_WorkstationError4 := i_WorkstationError4;
    b_WorkstationError5 := i_WorkstationError5;
    b_WorkstationError6 := i_WorkstationError6;
    b_WorkstationError7 := i_WorkstationError7;
    
    // 处理工作站报警信息
    IF b_WorkstationError0 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.16 := TRUE; // 工作站0错误状态位
    END_IF;
    
    IF b_WorkstationError1 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.17 := TRUE; // 工作站1错误状态位
    END_IF;
    
    IF b_WorkstationError2 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.18 := TRUE; // 工作站2错误状态位
    END_IF;
    
    IF b_WorkstationError3 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.19 := TRUE; // 工作站3错误状态位
    END_IF;
    
    IF b_WorkstationError4 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.20 := TRUE; // 工作站4错误状态位
    END_IF;
    
    IF b_WorkstationError5 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.21 := TRUE; // 工作站5错误状态位
    END_IF;
    
    IF b_WorkstationError6 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.22 := TRUE; // 工作站6错误状态位
    END_IF;
    
    IF b_WorkstationError7 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.23 := TRUE; // 工作站7错误状态位
    END_IF;
    
    // 统计工作站生产数据
    IF R_TRIG(CLK := i_WorkstationCycleComplete0).Q THEN
        n_WorkstationCycleCount0 := n_WorkstationCycleCount0 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete1).Q THEN
        n_WorkstationCycleCount1 := n_WorkstationCycleCount1 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete2).Q THEN
        n_WorkstationCycleCount2 := n_WorkstationCycleCount2 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete3).Q THEN
        n_WorkstationCycleCount3 := n_WorkstationCycleCount3 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete4).Q THEN
        n_WorkstationCycleCount4 := n_WorkstationCycleCount4 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete5).Q THEN
        n_WorkstationCycleCount5 := n_WorkstationCycleCount5 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete6).Q THEN
        n_WorkstationCycleCount6 := n_WorkstationCycleCount6 + 1;
    END_IF;
    
    IF R_TRIG(CLK := i_WorkstationCycleComplete7).Q THEN
        n_WorkstationCycleCount7 := n_WorkstationCycleCount7 + 1;
    END_IF;
    
    // 更新HMI工作站状态
    n_WorkstationStatus0 := 0;
    IF b_WorkstationReady0 THEN
        n_WorkstationStatus0 := 1;
    END_IF;
    IF b_WorkstationRunning0 THEN
        n_WorkstationStatus0 := 2;
    END_IF;
    IF b_WorkstationError0 THEN
        n_WorkstationStatus0 := 3;
    END_IF;
    q_HMIWorkstationStatus0 := n_WorkstationStatus0;
    
    n_WorkstationStatus1 := 0;
    IF b_WorkstationReady1 THEN
        n_WorkstationStatus1 := 1;
    END_IF;
    IF b_WorkstationRunning1 THEN
        n_WorkstationStatus1 := 2;
    END_IF;
    IF b_WorkstationError1 THEN
        n_WorkstationStatus1 := 3;
    END_IF;
    q_HMIWorkstationStatus1 := n_WorkstationStatus1;
    
    n_WorkstationStatus2 := 0;
    IF b_WorkstationReady2 THEN
        n_WorkstationStatus2 := 1;
    END_IF;
    IF b_WorkstationRunning2 THEN
        n_WorkstationStatus2 := 2;
    END_IF;
    IF b_WorkstationError2 THEN
        n_WorkstationStatus2 := 3;
    END_IF;
    q_HMIWorkstationStatus2 := n_WorkstationStatus2;
    
    n_WorkstationStatus3 := 0;
    IF b_WorkstationReady3 THEN
        n_WorkstationStatus3 := 1;
    END_IF;
    IF b_WorkstationRunning3 THEN
        n_WorkstationStatus3 := 2;
    END_IF;
    IF b_WorkstationError3 THEN
        n_WorkstationStatus3 := 3;
    END_IF;
    q_HMIWorkstationStatus3 := n_WorkstationStatus3;
    
    n_WorkstationStatus4 := 0;
    IF b_WorkstationReady4 THEN
        n_WorkstationStatus4 := 1;
    END_IF;
    IF b_WorkstationRunning4 THEN
        n_WorkstationStatus4 := 2;
    END_IF;
    IF b_WorkstationError4 THEN
        n_WorkstationStatus4 := 3;
    END_IF;
    q_HMIWorkstationStatus4 := n_WorkstationStatus4;
    
    n_WorkstationStatus5 := 0;
    IF b_WorkstationReady5 THEN
        n_WorkstationStatus5 := 1;
    END_IF;
    IF b_WorkstationRunning5 THEN
        n_WorkstationStatus5 := 2;
    END_IF;
    IF b_WorkstationError5 THEN
        n_WorkstationStatus5 := 3;
    END_IF;
    q_HMIWorkstationStatus5 := n_WorkstationStatus5;
    
    n_WorkstationStatus6 := 0;
    IF b_WorkstationReady6 THEN
        n_WorkstationStatus6 := 1;
    END_IF;
    IF b_WorkstationRunning6 THEN
        n_WorkstationStatus6 := 2;
    END_IF;
    IF b_WorkstationError6 THEN
        n_WorkstationStatus6 := 3;
    END_IF;
    q_HMIWorkstationStatus6 := n_WorkstationStatus6;
    
    n_WorkstationStatus7 := 0;
    IF b_WorkstationReady7 THEN
        n_WorkstationStatus7 := 1;
    END_IF;
    IF b_WorkstationRunning7 THEN
        n_WorkstationStatus7 := 2;
    END_IF;
    IF b_WorkstationError7 THEN
        n_WorkstationStatus7 := 3;
    END_IF;
    q_HMIWorkstationStatus7 := n_WorkstationStatus7;
    
    // 3. 工作站控制模块
    IF NOT b_Error THEN
        // 启动/停止工作站控制
        IF i_WorkstationStart0 THEN
            q_WorkstationStart0 := TRUE;
        ELSIF i_WorkstationStop0 THEN
            q_WorkstationStart0 := FALSE;
        END_IF;
        
        IF i_WorkstationStart1 THEN
            q_WorkstationStart1 := TRUE;
        ELSIF i_WorkstationStop1 THEN
            q_WorkstationStart1 := FALSE;
        END_IF;
        
        IF i_WorkstationStart2 THEN
            q_WorkstationStart2 := TRUE;
        ELSIF i_WorkstationStop2 THEN
            q_WorkstationStart2 := FALSE;
        END_IF;
        
        IF i_WorkstationStart3 THEN
            q_WorkstationStart3 := TRUE;
        ELSIF i_WorkstationStop3 THEN
            q_WorkstationStart3 := FALSE;
        END_IF;
        
        IF i_WorkstationStart4 THEN
            q_WorkstationStart4 := TRUE;
        ELSIF i_WorkstationStop4 THEN
            q_WorkstationStart4 := FALSE;
        END_IF;
        
        IF i_WorkstationStart5 THEN
            q_WorkstationStart5 := TRUE;
        ELSIF i_WorkstationStop5 THEN
            q_WorkstationStart5 := FALSE;
        END_IF;
        
        IF i_WorkstationStart6 THEN
            q_WorkstationStart6 := TRUE;
        ELSIF i_WorkstationStop6 THEN
            q_WorkstationStart6 := FALSE;
        END_IF;
        
        IF i_WorkstationStart7 THEN
            q_WorkstationStart7 := TRUE;
        ELSIF i_WorkstationStop7 THEN
            q_WorkstationStart7 := FALSE;
        END_IF;
        
        // 调整工作站运行参数
        IF i_WorkstationParamChanged0 THEN
            q_WorkstationParam0 := i_WorkstationParam0;
            q_WorkstationParamUpdate0 := TRUE;
        ELSE
            q_WorkstationParamUpdate0 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged1 THEN
            q_WorkstationParam1 := i_WorkstationParam1;
            q_WorkstationParamUpdate1 := TRUE;
        ELSE
            q_WorkstationParamUpdate1 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged2 THEN
            q_WorkstationParam2 := i_WorkstationParam2;
            q_WorkstationParamUpdate2 := TRUE;
        ELSE
            q_WorkstationParamUpdate2 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged3 THEN
            q_WorkstationParam3 := i_WorkstationParam3;
            q_WorkstationParamUpdate3 := TRUE;
        ELSE
            q_WorkstationParamUpdate3 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged4 THEN
            q_WorkstationParam4 := i_WorkstationParam4;
            q_WorkstationParamUpdate4 := TRUE;
        ELSE
            q_WorkstationParamUpdate4 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged5 THEN
            q_WorkstationParam5 := i_WorkstationParam5;
            q_WorkstationParamUpdate5 := TRUE;
        ELSE
            q_WorkstationParamUpdate5 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged6 THEN
            q_WorkstationParam6 := i_WorkstationParam6;
            q_WorkstationParamUpdate6 := TRUE;
        ELSE
            q_WorkstationParamUpdate6 := FALSE;
        END_IF;
        
        IF i_WorkstationParamChanged7 THEN
            q_WorkstationParam7 := i_WorkstationParam7;
            q_WorkstationParamUpdate7 := TRUE;
        ELSE
            q_WorkstationParamUpdate7 := FALSE;
        END_IF;
        
        // 协调多工作站工作流程
        CASE n_ProductionPhase OF
            0: // 准备阶段
                // 检查所有工作站是否准备就绪
                b_AllWorkstationsReady := b_WorkstationReady0 AND b_WorkstationReady1 AND b_WorkstationReady2 AND b_WorkstationReady3 AND 
                                        b_WorkstationReady4 AND b_WorkstationReady5 AND b_WorkstationReady6 AND b_WorkstationReady7;
                
                IF b_AllWorkstationsReady THEN
                    n_ProductionPhase := 1; // 进入生产阶段
                END_IF;
            
            1: // 生产阶段
                // 按顺序启动工作站
                IF b_WorkstationReady0 AND NOT b_WorkstationRunning0 THEN
                    q_WorkstationStart0 := TRUE;
                END_IF;
                
                IF b_WorkstationReady1 AND NOT b_WorkstationRunning1 THEN
                    q_WorkstationStart1 := TRUE;
                END_IF;
                
                IF b_WorkstationReady2 AND NOT b_WorkstationRunning2 THEN
                    q_WorkstationStart2 := TRUE;
                END_IF;
                
                IF b_WorkstationReady3 AND NOT b_WorkstationRunning3 THEN
                    q_WorkstationStart3 := TRUE;
                END_IF;
                
                IF b_WorkstationReady4 AND NOT b_WorkstationRunning4 THEN
                    q_WorkstationStart4 := TRUE;
                END_IF;
                
                IF b_WorkstationReady5 AND NOT b_WorkstationRunning5 THEN
                    q_WorkstationStart5 := TRUE;
                END_IF;
                
                IF b_WorkstationReady6 AND NOT b_WorkstationRunning6 THEN
                    q_WorkstationStart6 := TRUE;
                END_IF;
                
                IF b_WorkstationReady7 AND NOT b_WorkstationRunning7 THEN
                    q_WorkstationStart7 := TRUE;
                END_IF;
            
            2: // 完成阶段
                // 检查所有工作站是否完成
                b_AllWorkstationsCompleted := NOT b_WorkstationRunning0 AND NOT b_WorkstationRunning1 AND NOT b_WorkstationRunning2 AND NOT b_WorkstationRunning3 AND 
                                            NOT b_WorkstationRunning4 AND NOT b_WorkstationRunning5 AND NOT b_WorkstationRunning6 AND NOT b_WorkstationRunning7;
                
                IF b_AllWorkstationsCompleted THEN
                    n_ProductionPhase := 0; // 回到准备阶段
                END_IF;
        END_CASE;
    END_IF;
    
    // 4. 外部通讯模块
    // MES系统通讯
    IF i_MESConnect THEN
        // 建立MES连接
        b_MESConnected := TRUE;
        q_StatusWord.12 := TRUE;
        
        // 数据上传到MES
        IF b_MESConnected THEN
            q_MESDataUpload := TRUE;
            // 模拟生产数据
            tmp_sProductionData := 'ProductionData:{WS1:';
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount0));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS2:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount1));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS3:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount2));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS4:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount3));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS5:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount4));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS6:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount5));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS7:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount6));
            tmp_sProductionData := CONCAT(tmp_sProductionData, ',WS8:');
            tmp_sProductionData := CONCAT(tmp_sProductionData, INT_TO_STRING(n_WorkstationCycleCount7));
            tmp_sProductionData := CONCAT(tmp_sProductionData, '}');
            q_MESProductionData := tmp_sProductionData;
        END_IF;
    ELSE
        b_MESConnected := FALSE;
        q_StatusWord.12 := FALSE;
        q_MESDataUpload := FALSE;
    END_IF;

    // ERP系统通讯
    IF i_ERPConnect THEN
        // 建立ERP连接
        b_ERPConnected := TRUE;
        q_StatusWord.13 := TRUE;
        
        // 同步信息到ERP
        IF b_ERPConnected THEN
            q_ERPDataSync := TRUE;
            // 模拟库存数据
            tmp_sInventoryData := 'InventoryData:{RawMaterials:1000,FinishedGoods:500}';
            q_ERPInventoryData := tmp_sInventoryData;
        END_IF;
    ELSE
        b_ERPConnected := FALSE;
        q_StatusWord.13 := FALSE;
        q_ERPDataSync := FALSE;
    END_IF;

    // HMI系统通讯
    IF i_HMIConnect THEN
        // 建立HMI连接
        b_HMIConnected := TRUE;
        q_StatusWord.14 := TRUE;
        
        // 实时更新HMI数据
        IF b_HMIConnected THEN
            q_HMISystemStatus := q_StatusWord;
        END_IF;
    ELSE
        b_HMIConnected := FALSE;
        q_StatusWord.14 := FALSE;
    END_IF;
    
    // 5. 报警处理模块
    // 工作站报警处理
    IF b_WorkstationError0 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.16 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 1 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError1 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.17 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 2 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError2 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.18 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 3 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError3 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.19 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 4 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError4 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.20 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 5 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError5 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.21 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 6 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError6 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.22 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 7 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;
    
    IF b_WorkstationError7 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.23 := TRUE;
        
        // 记录报警信息
        tmp_sAlarmMessage := '工作站 8 发生故障';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;

    // 通讯报警处理
    IF NOT b_MESConnected THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        q_StatusWord.15 := TRUE;
        tmp_sAlarmMessage := 'MES系统连接失败';
        q_AlarmMessage := tmp_sAlarmMessage;
        q_AlarmActive := TRUE;
    END_IF;

    // 复位处理
    IF i_Reset THEN
        b_Error := FALSE;
        q_StatusWord.8 := FALSE;
        q_AlarmActive := FALSE;
        tmp_sAlarmMessage := '';
        q_AlarmMessage := tmp_sAlarmMessage;
        
        // 重置工作站错误状态
        q_StatusWord.16 := FALSE;
        q_StatusWord.17 := FALSE;
        q_StatusWord.18 := FALSE;
        q_StatusWord.19 := FALSE;
        q_StatusWord.20 := FALSE;
        q_StatusWord.21 := FALSE;
        q_StatusWord.22 := FALSE;
        q_StatusWord.23 := FALSE;
        
        // 重置通讯错误状态
        q_StatusWord.15 := FALSE;
    END_IF;
    
    // 6. 状态机模块
    // 更新状态字
    q_StatusWord.0 := b_SystemReady;
    q_StatusWord.1 := b_AllWorkstationsReady;
    q_StatusWord.2 := (n_ProductionPhase = 1); // 生产中状态
    q_StatusWord.3 := (n_ProductionPhase = 2); // 完成状态
    q_StatusWord.4 := b_MESConnected;
    q_StatusWord.5 := b_ERPConnected;
    q_StatusWord.6 := b_HMIConnected;
    q_StatusWord.7 := b_Error;

    // 状态转换逻辑
    CASE n_CurrentState OF
        0: // 初始状态
            IF b_SystemReady THEN
                n_CurrentState := 1;
            END_IF;
        
        1: // 系统就绪
            IF b_AllWorkstationsReady THEN
                n_CurrentState := 2;
            END_IF;
        
        2: // 生产准备
            IF i_StartProduction THEN
                n_CurrentState := 3;
                n_ProductionPhase := 1;
            END_IF;
        
        3: // 生产运行
            IF b_AllWorkstationsCompleted THEN
                n_CurrentState := 4;
                n_ProductionPhase := 2;
            ELSIF b_Error THEN
                n_CurrentState := 5;
            END_IF;
        
        4: // 生产完成
            IF i_ResetProduction THEN
                n_CurrentState := 1;
                n_ProductionPhase := 0;
            END_IF;
        
        5: // 错误状态
            IF i_Reset AND NOT b_Error THEN
                n_CurrentState := 1;
            END_IF;
    END_CASE;
    
    // 7. 计时器处理
    // 系统初始化超时
    TON_1(IN := In_tTimer1[0], PT := T#30s, Q => , ET => ET_tTimer1[0]);
    IF ET_tTimer1[0] >= T#30s THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        In_tTimer1[0] := FALSE;
    END_IF;

    // 工作站连接超时
    TON_WS(IN := In_tTimer1[1], PT := T#10s, Q => , ET => ET_tTimer1[1]);
    IF ET_tTimer1[1] >= T#10s AND NOT b_WorkstationReady0 THEN
        b_WorkstationError0 := TRUE;
        In_tTimer1[1] := FALSE;
    END_IF;

    // MES系统连接超时
    TON_MES(IN := In_tTimer1[2], PT := T#15s, Q => , ET => ET_tTimer1[2]);
    IF ET_tTimer1[2] >= T#15s AND NOT b_MESConnected THEN
        b_Error := TRUE;
        q_StatusWord.15 := TRUE;
        In_tTimer1[2] := FALSE;
    END_IF;

    // ERP系统连接超时
    TON_ERP(IN := In_tTimer1[3], PT := T#15s, Q => , ET => ET_tTimer1[3]);
    IF ET_tTimer1[3] >= T#15s AND NOT b_ERPConnected THEN
        b_Error := TRUE;
        q_StatusWord.15 := TRUE;
        In_tTimer1[3] := FALSE;
    END_IF;

    // HMI系统连接超时
    TON_HMI(IN := In_tTimer1[4], PT := T#5s, Q => , ET => ET_tTimer1[4]);
    IF ET_tTimer1[4] >= T#5s AND NOT b_HMIConnected THEN
        b_Error := TRUE;
        q_StatusWord.15 := TRUE;
        In_tTimer1[4] := FALSE;
    END_IF;

    // 生产周期超时
    TON_Production(IN := In_tTimer1[5], PT := T#60s, Q => , ET => ET_tTimer1[5]);
    IF ET_tTimer1[5] >= T#60s AND n_ProductionPhase = 1 THEN
        b_Error := TRUE;
        q_StatusWord.8 := TRUE;
        In_tTimer1[5] := FALSE;
    END_IF;
    
    // 8. 测试功能模块
    CASE i_TestMode OF
        0: // 完整流程测试
            // 测试主控站完整工作流程
            IF NOT b_TestStarted THEN
                b_TestStarted := TRUE;
                n_TestStep := 1;
            END_IF;
            
            CASE n_TestStep OF
                1: // 测试初始化
                    IF q_SystemReady THEN
                        n_TestStep := 2;
                    END_IF;
                
                2: // 测试工作站准备
                    // 模拟所有工作站准备就绪
                    i_WorkstationReady0 := TRUE;
                    i_WorkstationReady1 := TRUE;
                    i_WorkstationReady2 := TRUE;
                    i_WorkstationReady3 := TRUE;
                    i_WorkstationReady4 := TRUE;
                    i_WorkstationReady5 := TRUE;
                    i_WorkstationReady6 := TRUE;
                    i_WorkstationReady7 := TRUE;
                    
                    IF b_AllWorkstationsReady THEN
                        n_TestStep := 3;
                    END_IF;
                
                3: // 测试生产启动
                    i_StartProduction := TRUE;
                    IF n_ProductionPhase = 1 THEN
                        n_TestStep := 4;
                    END_IF;
                
                4: // 测试生产运行
                    // 模拟工作站运行
                    i_WorkstationRunning0 := TRUE;
                    i_WorkstationRunning1 := TRUE;
                    i_WorkstationRunning2 := TRUE;
                    i_WorkstationRunning3 := TRUE;
                    i_WorkstationRunning4 := TRUE;
                    i_WorkstationRunning5 := TRUE;
                    i_WorkstationRunning6 := TRUE;
                    i_WorkstationRunning7 := TRUE;
                    n_TestStep := 5;
                
                5: // 测试生产完成
                    // 模拟工作站完成
                    i_WorkstationRunning0 := FALSE;
                    i_WorkstationRunning1 := FALSE;
                    i_WorkstationRunning2 := FALSE;
                    i_WorkstationRunning3 := FALSE;
                    i_WorkstationRunning4 := FALSE;
                    i_WorkstationRunning5 := FALSE;
                    i_WorkstationRunning6 := FALSE;
                    i_WorkstationRunning7 := FALSE;
                    
                    i_WorkstationCycleComplete0 := TRUE;
                    i_WorkstationCycleComplete1 := TRUE;
                    i_WorkstationCycleComplete2 := TRUE;
                    i_WorkstationCycleComplete3 := TRUE;
                    i_WorkstationCycleComplete4 := TRUE;
                    i_WorkstationCycleComplete5 := TRUE;
                    i_WorkstationCycleComplete6 := TRUE;
                    i_WorkstationCycleComplete7 := TRUE;
                    
                    IF n_ProductionPhase = 2 THEN
                        n_TestStep := 6;
                    END_IF;
                
                6: // 测试完成
                    b_TestCompleted := TRUE;
                    b_TestStarted := FALSE;
            END_CASE;
        
        1: // 工作站监控测试
            // 测试工作站状态采集和显示
            // 交替设置工作站状态
            i_WorkstationReady0 := TRUE;
            i_WorkstationRunning0 := FALSE;
            
            i_WorkstationReady1 := TRUE;
            i_WorkstationRunning1 := TRUE;
            
            i_WorkstationReady2 := TRUE;
            i_WorkstationRunning2 := FALSE;
            
            i_WorkstationReady3 := TRUE;
            i_WorkstationRunning3 := TRUE;
            
            i_WorkstationReady4 := TRUE;
            i_WorkstationRunning4 := FALSE;
            
            i_WorkstationReady5 := TRUE;
            i_WorkstationRunning5 := TRUE;
            
            i_WorkstationReady6 := TRUE;
            i_WorkstationRunning6 := FALSE;
            
            i_WorkstationReady7 := TRUE;
            i_WorkstationRunning7 := TRUE;
        
        2: // 工作站控制测试
            // 测试工作站启动/停止和参数调整
            q_WorkstationStart0 := TRUE;
            q_WorkstationParam0 := 100.0;
            q_WorkstationParamUpdate0 := TRUE;
            
            q_WorkstationStart1 := FALSE;
            q_WorkstationParamUpdate1 := FALSE;
            
            q_WorkstationStart2 := TRUE;
            q_WorkstationParam2 := 100.0;
            q_WorkstationParamUpdate2 := TRUE;
            
            q_WorkstationStart3 := FALSE;
            q_WorkstationParamUpdate3 := FALSE;
            
            q_WorkstationStart4 := TRUE;
            q_WorkstationParam4 := 100.0;
            q_WorkstationParamUpdate4 := TRUE;
            
            q_WorkstationStart5 := FALSE;
            q_WorkstationParamUpdate5 := FALSE;
            
            q_WorkstationStart6 := TRUE;
            q_WorkstationParam6 := 100.0;
            q_WorkstationParamUpdate6 := TRUE;
            
            q_WorkstationStart7 := FALSE;
            q_WorkstationParamUpdate7 := FALSE;
        
        3: // MES系统通讯测试
            // 测试与MES系统的通讯
            i_MESConnect := TRUE;
        
        4: // ERP系统通讯测试
            // 测试与ERP系统的通讯
            i_ERPConnect := TRUE;
        
        5: // 报警处理测试
            // 测试报警信息处理和故障应对
            i_WorkstationError0 := TRUE;
    END_CASE;
END_BODY
END_FUNCTION_BLOCK
