// FB_主控与上下游交互功能块
// 版本：v1.0.0
// 日期：2026-01-28
// 描述：实现主控系统与上下游设备之间的通信交互，包括上游请求处理、下游请求处理、本站允许控制、产品转移管理等功能
(*
FUNCTION_BLOCK FB_UpstreamDownstreamInteraction
VAR_INPUT
    
    输入变量定义
  
    i_UpstreamRequest : BOOL;         // 上游请求信号，为ON时表示上游系统请求操作
    i_DownstreamRequest : BOOL;       // 下游请求信号，为ON时表示下游系统请求操作
    i_LocalAllow : BOOL;              // 本站允许信号，为ON时表示本站允许操作
    i_UpstreamTransferring : BOOL;    // 上游产品转移中信号，为ON时表示上游正在转移产品
    i_DownstreamTransferring : BOOL;  // 下游产品转移中信号，为ON时表示下游正在转移产品
    i_Reset : BOOL;                   // 复位按钮信号，为ON时清除所有错误状态
    i_Alarm : BOOL;                   // 报警信号，为ON时表示系统发生报警
END_VAR
  *)
(*
VAR_OUTPUT
    
    输出变量定义
    
    q_UpstreamRequestAck : BOOL;      // 上游请求确认，为ON时表示确认收到上游请求
    q_DownstreamRequestAck : BOOL;    // 下游请求确认，为ON时表示确认收到下游请求
    q_LocalAllowStatus : BOOL;        // 本站允许状态，为ON时表示本站允许操作
    q_LocalReceiveComplete : BOOL;    // 本站接收完成，为ON时表示本站已完成产品接收
    q_LocalSendComplete : BOOL;       // 本站发送完成，为ON时表示本站已完成产品发送
    q_StatusWord : INT;               // 状态字，位0:上游请求, 位1:下游请求, 位2:本站允许, 位3:上游转移中, 位4:下游转移中, 位5:接收完成, 位6:发送完成, 位7:错误状态
END_VAR
*)
 (*
VAR
   
    内部变量定义
   
    tmp_bUpstreamRequest : BOOL;      // 上游请求内部状态
    tmp_bDownstreamRequest : BOOL;    // 下游请求内部状态
    tmp_bLocalAllow : BOOL;            // 本站允许内部状态
    tmp_bUpstreamTransferring : BOOL;  // 上游转移中内部状态
    tmp_bDownstreamTransferring : BOOL; // 下游转移中内部状态
    tmp_bReceiveComplete : BOOL;       // 接收完成内部状态
    tmp_bSendComplete : BOOL;          // 发送完成内部状态
    tmp_bError : BOOL;                 // 错误状态内部变量
    tmp_nStatusWord : INT;             // 状态字内部变量
    
    // 计时器变量
    In_tTimer1 : BOOL[10];             // 计时器1输入数组
    Q_tTimer1 : BOOL[10];              // 计时器1输出数组
    R_tTimer1 : BOOL[10];              // 计时器1复位数组
    PT_tTimer1 : DINT[10];             // 计时器1预设值数组
    ET_tTimer1 : DINT[10];             // 计时器1当前值数组
END_VAR

BEGIN
 *)
    // 主控制逻辑
    
    // 1. 上游请求处理
    IF i_UpstreamRequest AND NOT tmp_bUpstreamRequest THEN
        // 上升沿触发，处理上游请求
        q_UpstreamRequestAck := TRUE;
        tmp_bUpstreamRequest := TRUE;
        
        // 启动请求超时计时器
        In_tTimer1[0] := TRUE;
        PT_tTimer1[0] := 5000; // 5秒超时
    END_IF;
    
    // 上游请求超时处理
    IF Q_tTimer1[0] THEN
        // 请求超时
        q_UpstreamRequestAck := FALSE;
        In_tTimer1[0] := FALSE;
        R_tTimer1[0] := TRUE;
    END_IF;
    
    // 复位上游请求状态
    IF NOT i_UpstreamRequest THEN
        tmp_bUpstreamRequest := FALSE;
        R_tTimer1[0] := TRUE;
    END_IF;
    
    // 2. 下游请求处理
    IF i_DownstreamRequest AND NOT tmp_bDownstreamRequest THEN
        // 上升沿触发，处理下游请求
        q_DownstreamRequestAck := TRUE;
        tmp_bDownstreamRequest := TRUE;
        
        // 启动请求超时计时器
        In_tTimer1[1] := TRUE;
        PT_tTimer1[1] := 5000; // 5秒超时
    END_IF;
    
    // 下游请求超时处理
    IF Q_tTimer1[1] THEN
        // 请求超时
        q_DownstreamRequestAck := FALSE;
        In_tTimer1[1] := FALSE;
        R_tTimer1[1] := TRUE;
    END_IF;
    
    // 复位下游请求状态
    IF NOT i_DownstreamRequest THEN
        tmp_bDownstreamRequest := FALSE;
        R_tTimer1[1] := TRUE;
    END_IF;
    
    // 3. 本站允许控制
    tmp_bLocalAllow := i_LocalAllow;
    q_LocalAllowStatus := tmp_bLocalAllow;
    
    // 4. 上游产品转移管理
    IF i_UpstreamTransferring AND NOT tmp_bUpstreamTransferring THEN
        // 上升沿触发，开始上游转移
        tmp_bUpstreamTransferring := TRUE;
        q_LocalReceiveComplete := FALSE;
        
        // 启动上游转移超时计时器
        In_tTimer1[2] := TRUE;
        PT_tTimer1[2] := 30000; // 30秒超时
    ELSIF NOT i_UpstreamTransferring AND tmp_bUpstreamTransferring THEN
        // 下降沿触发，上游转移完成
        tmp_bUpstreamTransferring := FALSE;
        q_LocalReceiveComplete := TRUE;
        
        // 停止上游转移超时计时器
        In_tTimer1[2] := FALSE;
        R_tTimer1[2] := TRUE;
    END_IF;
    
    // 上游转移超时处理
    IF Q_tTimer1[2] THEN
        // 转移超时
        tmp_bError := TRUE;
        In_tTimer1[2] := FALSE;
        R_tTimer1[2] := TRUE;
    END_IF;
    
    // 5. 下游产品转移管理
    IF i_DownstreamTransferring AND NOT tmp_bDownstreamTransferring THEN
        // 上升沿触发，开始下游转移
        tmp_bDownstreamTransferring := TRUE;
        q_LocalSendComplete := FALSE;
        
        // 启动下游转移超时计时器
        In_tTimer1[3] := TRUE;
        PT_tTimer1[3] := 30000; // 30秒超时
    ELSIF NOT i_DownstreamTransferring AND tmp_bDownstreamTransferring THEN
        // 下降沿触发，下游转移完成
        tmp_bDownstreamTransferring := FALSE;
        q_LocalSendComplete := TRUE;
        
        // 停止下游转移超时计时器
        In_tTimer1[3] := FALSE;
        R_tTimer1[3] := TRUE;
    END_IF;
    
    // 下游转移超时处理
    IF Q_tTimer1[3] THEN
        // 转移超时
        tmp_bError := TRUE;
        In_tTimer1[3] := FALSE;
        R_tTimer1[3] := TRUE;
    END_IF;
    
    // 6. 报警处理
    IF i_Alarm THEN
        tmp_bError := TRUE;
    END_IF;
    
    // 7. 复位处理
    IF i_Reset THEN
        tmp_bError := FALSE;
        q_UpstreamRequestAck := FALSE;
        q_DownstreamRequestAck := FALSE;
        q_LocalReceiveComplete := FALSE;
        q_LocalSendComplete := FALSE;
        
        // 复位所有计时器
        FOR i := 0 TO 9 DO
            In_tTimer1[i] := FALSE;
            R_tTimer1[i] := TRUE;
        END_FOR;
    END_IF;
    
    // 8. 状态字计算
    tmp_nStatusWord := 0;
    
    // 位0: 上游请求
    IF tmp_bUpstreamRequest THEN
        tmp_nStatusWord := tmp_nStatusWord OR 1;
    END_IF;
    
    // 位1: 下游请求
    IF tmp_bDownstreamRequest THEN
        tmp_nStatusWord := tmp_nStatusWord OR 2;
    END_IF;
    
    // 位2: 本站允许
    IF tmp_bLocalAllow THEN
        tmp_nStatusWord := tmp_nStatusWord OR 4;
    END_IF;
    
    // 位3: 上游转移中
    IF tmp_bUpstreamTransferring THEN
        tmp_nStatusWord := tmp_nStatusWord OR 8;
    END_IF;
    
    // 位4: 下游转移中
    IF tmp_bDownstreamTransferring THEN
        tmp_nStatusWord := tmp_nStatusWord OR 16;
    END_IF;
    
    // 位5: 接收完成
    IF q_LocalReceiveComplete THEN
        tmp_nStatusWord := tmp_nStatusWord OR 32;
    END_IF;
    
    // 位6: 发送完成
    IF q_LocalSendComplete THEN
        tmp_nStatusWord := tmp_nStatusWord OR 64;
    END_IF;
    
    // 位7: 错误状态
    IF tmp_bError THEN
        tmp_nStatusWord := tmp_nStatusWord OR 128;
    END_IF;
    
    // 更新状态字输出
    q_StatusWord := tmp_nStatusWord;
    
    // 9. 计时器处理
    // 这里使用TONR定时器的逻辑实现
    FOR i := 0 TO 9 DO
        IF In_tTimer1[i] AND NOT R_tTimer1[i] THEN
            // 计时器运行
            IF ET_tTimer1[i] < PT_tTimer1[i] THEN
                ET_tTimer1[i] := ET_tTimer1[i] + 1;
            ELSE
                Q_tTimer1[i] := TRUE;
                In_tTimer1[i] := FALSE;
            END_IF;
        ELSIF R_tTimer1[i] THEN
            // 计时器复位
            ET_tTimer1[i] := 0;
            Q_tTimer1[i] := FALSE;
            R_tTimer1[i] := FALSE;
        END_IF;
    END_FOR;
//END_BODY
//END_FUNCTION_BLOCK