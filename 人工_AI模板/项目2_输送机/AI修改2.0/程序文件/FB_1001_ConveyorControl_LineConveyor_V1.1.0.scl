(*    - 801_PLC变量命名与功能块命名规范_DEV-V1.0.3                  *)
(*    - 810_PLC编程规范_DEV-V1.0.1                                  *)
(*                                                                  *)
(*  变更记录：                                                        *)
(* ---------------------------------------------------------------- *)
