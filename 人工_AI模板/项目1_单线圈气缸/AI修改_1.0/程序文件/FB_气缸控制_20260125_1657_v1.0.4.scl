// 气缸控制FB块 - 基于IEC 61131-3标准
// 功能：单线圈气缸伸缩控制、动点报警
// 版本：v1.0.4 [2026-01-25]
// 作者：Trae AI
// 说明：根据人工修改规范修订，实现单线圈气缸控制逻辑
// 模板文件：用于创建新的气缸控制FB实例

// 输入变量 - 严格按照变量表命名
(*VAR_INPUT
    i_动点传感器 : BOOL;          // 动点传感器
    i_原点传感器 : BOOL;          // 原点传感器
    i_气缸_S1 : BOOL;              // 气缸开始到动点
    i_气缸_S0 : BOOL;              // 气缸开始到原点
    i_屏蔽动点 : BOOL;            // 屏蔽动点
    i_屏蔽原点 : BOOL;            // 屏蔽原点
    i_复位 : BOOL;                // 复位
    i_动点原点工作取反 : BOOL;    // 动点原点工作取反
END_VAR

// 输出变量 - 严格按照变量表命名
VAR_OUTPUT
    q_气缸动点动作 : BOOL;        // 气缸动点动作（控制气缸阀信号）
    q_气缸动点到位 : BOOL;        // 气缸动点到位
    q_气缸原点到位 : BOOL;        // 气缸原点到位
    q_动点异常 : BOOL;            // 动点异常
    q_原点异常 : BOOL;            // 原点异常
END_VAR

// 内部变量 - 严格按照变量表命名
VAR
    // 定时器相关变量
    原点到位延时 : DINT[2];       // 原点到位延时
    动点到位延时 : DINT[2];       // 动点到位延时
    报警延时 : DINT := 3000;       // 报警延时时间
    
    // 中间变量
    M_0 : BOOL[10];                // 中间变量M0[0-9]
    T_0 : BOOL[10];                // 定时器T0[0-9]
    
    // MW变量
    MW_0 : DINT[10];               // 内部DINT变量0（统一用于所有定时器ET输出）
    
    // 状态管理变量
    n_State : INT := 0;            // 状态机状态：0-初始化，1-原点状态，2-动点状态，3-报警状态
END_VAR*)
// 程序主体
//BEGIN
    // 网络1：气缸动点动作控制
    // 当i_气缸_S1闭合时，SET q_气缸动点动作
    IF i_气缸_S1 THEN
        q_气缸动点动作 := TRUE;
    END_IF;
    
    // 当i_气缸_S0闭合时，RST q_气缸动点动作
    IF i_气缸_S0 THEN
        q_气缸动点动作 := FALSE;
    END_IF;
    
    // 网络2：气缸原点状态监控
    // 原点到位延时初始化
    IF 原点到位延时[0] = 0 THEN
        原点到位延时[0] := 10;  // K10
    END_IF;
    IF 原点到位延时[1] = 0 THEN
        原点到位延时[1] := 100; // K100
    END_IF;
    
    // 正常原点到位延时定时器
    T_0[0] := q_气缸动点动作 AND NOT i_屏蔽原点 AND i_原点传感器;
    T_0[8] := i_复位 OR NOT q_气缸动点动作;
    TONR(IN := T_0[0], 
         PT := 原点到位延时[0], 
         R := T_0[8], 
         Q => M_0[0], 
         ET => MW_0[0]);
    
    // 屏蔽原点到位延时定时器
    T_0[1] := q_气缸动点动作 AND i_屏蔽原点;
    T_0[9] := i_复位 OR NOT q_气缸动点动作;
    TONR(IN := T_0[1], 
         PT := 原点到位延时[1], 
         R := T_0[9], 
         Q => M_0[1], 
         ET => MW_0[1]);
    
    // 网络3：气缸动点状态监控
    // 动点到位延时初始化
    IF 动点到位延时[0] = 0 THEN
        动点到位延时[0] := 10;  // K10
    END_IF;
    IF 动点到位延时[1] = 0 THEN
        动点到位延时[1] := 100; // K100
    END_IF;
    
    // 正常动点到位延时定时器
    T_0[3] := q_气缸动点动作 AND NOT i_屏蔽动点 AND i_动点传感器;
    M_0[5] := i_复位 OR NOT q_气缸动点动作;
    TONR(IN := T_0[3], 
         PT := 动点到位延时[0], 
         R := M_0[5], 
         Q => M_0[3], 
         ET => MW_0[3]);
    
    // 屏蔽动点到位延时定时器
    T_0[4] := q_气缸动点动作 AND i_屏蔽动点;
    M_0[6] := i_复位 OR NOT q_气缸动点动作;
    TONR(IN := T_0[4], 
         PT := 动点到位延时[1], 
         R := M_0[6], 
         Q => M_0[4], 
         ET => MW_0[4]);
    
    // 到位状态互斥逻辑
    // 原点到位状态
    IF (M_0[0] OR M_0[1]) THEN
        q_气缸原点到位 := TRUE;
        q_气缸动点到位 := FALSE;
    // 动点到位状态
    ELSIF (M_0[3] OR M_0[4]) THEN
        q_气缸原点到位 := FALSE;
        q_气缸动点到位 := TRUE;
    // 未知状态
    ELSE
        q_气缸原点到位 := FALSE;
        q_气缸动点到位 := FALSE;
    END_IF;
    
    // 网络4：原点报警
    // 原点报警定时器
    T_0[5] := q_气缸动点动作 AND NOT i_屏蔽原点 AND NOT i_原点传感器;
    T_0[2] := i_复位 OR NOT T_0[5];
    TONR(IN := T_0[5], 
         PT := 报警延时, 
         R := T_0[2], 
         Q => M_0[8], 
         ET => MW_0[8]);
    
    // 原点报警触发与自动恢复
    IF M_0[8] THEN
        q_原点异常 := TRUE;
        n_State := 3; // 切换到报警状态
    ELSIF NOT (q_气缸动点动作 AND NOT i_屏蔽原点 AND NOT i_原点传感器) THEN
        // 当报警条件消失时，自动恢复
        q_原点异常 := FALSE;
    END_IF;
    
    // 网络5：动点报警
    // 报警延时初始化
    IF 报警延时 = 0 THEN
        报警延时 := 3000;  // K3000
    END_IF;
    
    // 动点报警定时器
    T_0[6] := q_气缸动点动作 AND NOT i_屏蔽动点 AND NOT i_动点传感器;
    T_0[7] := i_复位 OR NOT T_0[6];
    TONR(IN := T_0[6], 
         PT := 报警延时, 
         R := T_0[7], 
         Q => M_0[9], 
         ET => MW_0[9]);
    
    // 动点报警触发与自动恢复
    IF M_0[9] THEN
        q_动点异常 := TRUE;
        n_State := 3; // 切换到报警状态
    ELSIF NOT (q_气缸动点动作 AND NOT i_屏蔽动点 AND NOT i_动点传感器) THEN
        // 当报警条件消失时，自动恢复
        q_动点异常 := FALSE;
    END_IF;
    
    // 网络6：报警复位
    // 当i_复位闭合时，复位异常状态
    IF i_复位 THEN
        q_原点异常 := FALSE;
        q_动点异常 := FALSE;
        // 复位中间变量
        M_0[8] := FALSE;
        M_0[9] := FALSE;
    END_IF;
    
    // 网络7：状态机管理
    // 状态初始化
    IF i_复位 THEN
        n_State := 0; // 复位到初始化状态
    END_IF;
    
    // 状态机逻辑
    CASE n_State OF
        // 初始化状态
        0:
            // 检查初始状态
            IF q_气缸原点到位 THEN
                n_State := 1; // 切换到原点状态
            ELSIF q_气缸动点到位 THEN
                n_State := 2; // 切换到动点状态
            ELSE
                // 保持初始化状态
            END_IF;
        
        // 原点状态
        1:
            // 当气缸动点动作时，切换到动点状态
            IF q_气缸动点动作 THEN
                n_State := 2;
            END_IF;
        
        // 动点状态
        2:
            // 当气缸回到原点时，切换到原点状态
            IF NOT q_气缸动点动作 AND q_气缸原点到位 THEN
                n_State := 1;
            END_IF;
        
        // 报警状态
        3:
            // 当报警清除且回到正常状态时，切换到相应状态
            IF NOT q_动点异常 AND NOT q_原点异常 THEN
                IF q_气缸原点到位 THEN
                    n_State := 1;
                ELSIF q_气缸动点到位 THEN
                    n_State := 2;
                ELSE
                    n_State := 0;
                END_IF;
            END_IF;
    END_CASE;
    
    // 网络8：安全保护逻辑
    // 传感器故障检测
    // 当两个传感器同时触发时，可能存在传感器故障
    IF i_原点传感器 AND i_动点传感器 THEN
        // 传感器故障处理
        q_原点异常 := TRUE;
        q_动点异常 := TRUE;
        n_State := 3; // 切换到报警状态
    END_IF;
    
    // 气缸动作互斥保护
    // 确保气缸动作信号不会与其他信号冲突
    IF i_气缸_S1 AND i_气缸_S0 THEN
        // 控制信号冲突，停止气缸动作
        q_气缸动点动作 := FALSE;
        q_原点异常 := TRUE;
        n_State := 3; // 切换到报警状态
    END_IF;
    
    // 超时保护
    //