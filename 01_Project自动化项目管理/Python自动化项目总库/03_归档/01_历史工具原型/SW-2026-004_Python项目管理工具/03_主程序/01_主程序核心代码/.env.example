# Python项目管理工具 - 环境变量配置模板
# 使用方法：复制此文件为 .env，然后填入实际值
# cp .env.example .env

# ==================== 应用配置 ====================
APP_NAME=Python项目管理工具
APP_VERSION=1.1.0
DEBUG_MODE=false

# ==================== 安全配置 ====================
# API密钥 - 必须修改为随机生成的密钥！
# 生成随机密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe

# JWT Token过期时间（小时）
API_TOKEN_EXPIRE_HOURS=24

# bcrypt密码加密轮数
BCRYPT_ROUNDS=12

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///data/project_manager.db
DATABASE_ECHO=false

# ==================== API配置 ====================
API_HOST=127.0.0.1
API_PORT=5000
API_CORS_ENABLED=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
