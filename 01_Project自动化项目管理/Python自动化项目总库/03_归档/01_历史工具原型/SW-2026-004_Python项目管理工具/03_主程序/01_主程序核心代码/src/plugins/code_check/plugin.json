{
    "plugin_id": "code_check",
    "plugin_name": "代码规范检查",
    "plugin_version": "1.0.0",
    "plugin_author": "Trae AI",
    "plugin_description": "检查Python代码是否符合PEP8规范，支持自定义规则配置",
    "permissions": ["file_read", "project_access"],
    "default_config": {
        "max_line_length": 120,
        "ignore_files": ["__init__.py"],
        "ignore_rules": []
    },
    "config_schema": {
        "type": "object",
        "properties": {
            "max_line_length": {
                "type": "integer",
                "title": "最大行长度",
                "default": 120,
                "minimum": 80,
                "maximum": 200
            },
            "ignore_files": {
                "type": "array",
                "title": "忽略文件",
                "items": {
                    "type": "string"
                }
            },
            "ignore_rules": {
                "type": "array",
                "title": "忽略规则",
                "items": {
                    "type": "string"
                }
            }
        }
    },
    "dependencies": [],
    "python_packages": [],
    "is_builtin": true,
    "download_url": "",
    "repository": "",
    "homepage": "",
    "tags": ["开发工具", "代码质量", "PEP8"],
    "icon": "",
    "min_app_version": "1.0.0",
    "max_app_version": "",
    "changelog": "## v1.0.0\n- 初始版本\n- 支持PEP8基础规则检查\n- 支持自定义最大行长度\n- 支持忽略特定文件和规则",
    "license": "MIT"
}
