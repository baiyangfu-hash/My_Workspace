{
    "plugin_id": "plc_variable_parser",
    "plugin_name": "PLC变量表解析器",
    "plugin_version": "1.0.0",
    "plugin_author": "Trae AI",
    "plugin_description": "解析和管理PLC变量表，支持Autoshop/Work3/Codesys格式，提供变量编辑、批量修改、格式转换功能",
    "permissions": ["file_read", "file_write", "project_access"],
    "default_config": {
        "default_encoding": "auto",
        "default_format": "autoshop",
        "export_encoding": "utf-8",
        "auto_detect_format": true,
        "preserve_original_format": true
    },
    "config_schema": {
        "type": "object",
        "properties": {
            "default_encoding": {
                "type": "string",
                "title": "默认编码",
                "enum": ["auto", "utf-8", "gbk", "gb2312", "utf-16"],
                "default": "auto",
                "description": "打开文件时的默认编码，auto为自动检测"
            },
            "default_format": {
                "type": "string",
                "title": "默认PLC格式",
                "enum": ["autoshop", "work3", "codesys"],
                "default": "autoshop",
                "description": "默认的PLC变量表格式"
            },
            "export_encoding": {
                "type": "string",
                "title": "导出编码",
                "enum": ["utf-8", "gbk", "gb2312", "utf-16"],
                "default": "utf-8",
                "description": "导出文件时使用的编码"
            },
            "auto_detect_format": {
                "type": "boolean",
                "title": "自动检测格式",
                "default": true,
                "description": "是否自动检测PLC格式"
            },
            "preserve_original_format": {
                "type": "boolean",
                "title": "保持原始格式",
                "default": true,
                "description": "导出时是否保持与源文件相同的格式和编码"
            }
        }
    },
    "dependencies": [],
    "python_packages": ["chardet"],
    "is_builtin": true,
    "download_url": "",
    "repository": "",
    "homepage": "",
    "tags": ["PLC", "工控", "变量", "Autoshop", "Work3", "Codesys"],
    "icon": "",
    "min_app_version": "1.0.0",
    "max_app_version": "",
    "changelog": "## v1.0.0\n- 初始版本\n- 支持Autoshop格式解析\n- 支持Work3格式解析\n- 支持Codesys格式解析\n- 支持变量编辑和批量修改\n- 支持CSV/JSON导出\n- 支持编码自动检测",
    "license": "MIT"
}
