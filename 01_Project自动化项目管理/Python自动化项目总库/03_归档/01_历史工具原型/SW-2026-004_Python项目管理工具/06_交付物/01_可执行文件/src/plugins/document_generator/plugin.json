{
    "plugin_id": "document_generator",
    "plugin_name": "文档生成器",
    "plugin_version": "1.0.0",
    "plugin_author": "Trae AI",
    "plugin_description": "自动生成项目文档：README、接口文档、CHANGELOG等，支持多种模板",
    "permissions": ["file_write", "project_access"],
    "default_config": {
        "template_dir": "templates",
        "include_contributors": true,
        "include_license": true
    },
    "config_schema": {
        "type": "object",
        "properties": {
            "template_dir": {
                "type": "string",
                "title": "模板目录",
                "default": "templates"
            },
            "include_contributors": {
                "type": "boolean",
                "title": "包含贡献者信息",
                "default": true
            },
            "include_license": {
                "type": "boolean",
                "title": "包含许可证信息",
                "default": true
            }
        }
    },
    "dependencies": [],
    "python_packages": [],
    "is_builtin": true,
    "download_url": "",
    "repository": "",
    "homepage": "",
    "tags": ["文档", "自动化", "README"],
    "icon": "",
    "min_app_version": "1.0.0",
    "max_app_version": "",
    "changelog": "## v1.0.0\n- 初始版本\n- 支持README文档生成\n- 支持接口文档生成\n- 支持CHANGELOG生成\n- 支持自定义模板",
    "license": "MIT"
}
