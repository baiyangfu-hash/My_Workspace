(* ================================================================= *)
(*  功能块名称：FB_1003_PickPlace_BufferFraming                       *)
(*  功能描述：取放料机构控制 - 6步S20~S25状态机(Z升降+X1横移+4夹爪) *)
(*  版本号：V8.0.0 (结构体整块传递架构)                               *)
(* ================================================================= *)
FUNCTION_BLOCK FB_1003_PickPlace_BufferFraming

(* ==================== VAR_IN_OUT (V8.0.0 结构体整块传递) ==================== *)
VAR_IN_OUT
    io_stPickPlace              : ST_PickPlace;  // 取放料工站全量数据结构体
    io_stZAxis                  : ST_ServoAxis;  // Z轴(升降)
    io_stX1Axis                 : ST_ServoAxis;  // X1轴(取放料横移)
END_VAR

(* ==================== VAR ==================== *)
VAR
    // 局部解包/封包变量
    i_bAutoMode                 : BOOL;
    i_bManualMode               : BOOL;
    i_bStart                    : BOOL;
    i_bStop                     : BOOL;
    i_bReset                    : BOOL;
    i_bLx_ZAxis_JogUp           : BOOL;
    i_bLx_ZAxis_JogDown         : BOOL;
    i_bLx_X1Axis_JogFwd         : BOOL;
    i_bLx_X1Axis_JogRev         : BOOL;
    i_bLx_FrontClamp            : BOOL;
    i_bLx_RearClamp             : BOOL;
    i_bLx_FrontClamp2           : BOOL;
    i_bLx_RearClamp2            : BOOL;
    i_bLx_LiftUp                : BOOL;
    i_bLx_LiftDown              : BOOL;
    i_rZSpeed                   : REAL;
    i_rX1Speed                  : REAL;
    i_iClampConfirmTime         : INT;
    i_iLiftActionTime           : INT;
    i_iPickLayer                : INT;
    i_bFrameDetect1             : BOOL;
    i_bFrameDetect2             : BOOL;
    i_bFrontClampClosed         : BOOL;
    i_bFrontClamp2Closed        : BOOL;
    i_bRearClampClosed          : BOOL;
    i_bRearClamp2Closed         : BOOL;
    i_bLiftWorkPoint            : BOOL;
    i_bLongEdge1Detect          : BOOL;
    i_bLongEdge2Detect          : BOOL;
    i_bShortEdge1Detect         : BOOL;
    i_bShortEdge2Detect         : BOOL;
    i_bFullMaterialDetect1      : BOOL;
    i_bFullMaterialDetect2      : BOOL;

    q_bFrontClamp               : BOOL;
    q_bRearClamp                : BOOL;
    q_bFrontClamp2              : BOOL;
    q_bRearClamp2               : BOOL;
    q_bLiftUp                   : BOOL;
    q_bLiftDown                 : BOOL;
    q_bPlaceDoneToFeeder        : BOOL;
    q_bRunning                  : BOOL;
    q_bSensorFault              : BOOL;
    q_bProductMissing           : BOOL;
    q_bFrameOnPickupPlatform    : BOOL;
    q_bX1Fault                  : BOOL;
    q_bZFault                   : BOOL;
    q_iCurrentState             : INT;
    q_iAlarmCode                : INT;
    q_iCurrentPickLayer         : INT;

    bStepEntry                  : BOOL;
    bRunning                    : BOOL;
    iCurrentState               : INT;
    iAlarmCode                  : INT;
    bStartTriggered             : BOOL;
    iPickLayer                  : INT;

    tIn                         : ARRAY[0..2] OF BOOL;
    tQ                          : ARRAY[0..2] OF BOOL;
    tR                          : ARRAY[0..2] OF BOOL;
    tPt                         : ARRAY[0..2] OF DINT;
    tEt                         : ARRAY[0..2] OF DINT;

    tLiftTimer                  : FB_TONR;
    tClampTimer                 : FB_TONR;
    tPlaceDoneTimer             : FB_TONR;

    bSensorFault                : BOOL;
    bProductMissing             : BOOL;
    bFrameOnPlatform            : BOOL;
    bPlaceDonePulse             : BOOL;

    rPickHeight                 : REAL := 514.0;
    rPlaceHeightL1              : REAL := 520.0;
    rPlaceHeightL2              : REAL := 540.0;
    rPlaceDownHeight            : REAL := 524.0;
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    S20_IDLE                    : INT := 0;     // 待机等待
    S21_UP_TO_PICK              : INT := 1;     // 上升到取料高度
    S22_CLAMP_AND_DETECT        : INT := 2;     // 夹紧与检测
    S23_MOVE_TO_PLACE           : INT := 3;     // 移动到放料位置
    S24_DOWN_TO_PLACE           : INT := 4;     // 下降到放料高度
    S25_UNCLAMP_AND_NOTIFY      : INT := 5;     // 松开与通知

    T_LIFT_DEFAULT              : DINT := 3000;   // 升降默认3s
    T_CLAMP_DEFAULT             : DINT := 800;    // 夹紧默认800ms
    T_PLACE_DONE_PULSE          : DINT := 500;    // 放料完成脉冲500ms
END_VAR

(* ==================== 结构体解包 (输入映射) ==================== *)
i_bAutoMode                     := io_stPickPlace.i_bAutoMode;
i_bManualMode                   := io_stPickPlace.i_bManualMode;
i_bStart                        := io_stPickPlace.i_bStart;
i_bStop                         := io_stPickPlace.i_bStop;
i_bReset                        := io_stPickPlace.i_bReset;
i_bLx_FrontClamp                := io_stPickPlace.i_bLx_FrontClamp;
i_bLx_RearClamp                 := io_stPickPlace.i_bLx_RearClamp;
i_bLx_FrontClamp2               := io_stPickPlace.i_bLx_FrontClamp2;
i_bLx_RearClamp2                := io_stPickPlace.i_bLx_RearClamp2;
i_bLx_LiftUp                    := io_stPickPlace.i_bLx_LiftUp OR io_stPickPlace.i_bLx_Lift_Up;
i_bLx_LiftDown                  := io_stPickPlace.i_bLx_LiftDown OR io_stPickPlace.i_bLx_Lift_Down;
i_rZSpeed                       := io_stPickPlace.i_rZSpeed;
i_rX1Speed                      := io_stPickPlace.i_rX1Speed;
i_iClampConfirmTime             := io_stPickPlace.i_iClampConfirmTime;
i_iLiftActionTime               := io_stPickPlace.i_iLiftActionTime;
i_iPickLayer                    := io_stPickPlace.i_iPickLayer_Input;
i_bFrameDetect1                 := io_stPickPlace.i_bFrameDetect1;
i_bFrameDetect2                 := io_stPickPlace.i_bFrameDetect2;
i_bFrontClampClosed             := io_stPickPlace.i_bFrontClamp_Closed;
i_bFrontClamp2Closed            := io_stPickPlace.i_bFrontClamp2_Closed;
i_bRearClampClosed              := io_stPickPlace.i_bRearClamp_Closed;
i_bRearClamp2Closed             := io_stPickPlace.i_bRearClamp2_Closed;
i_bLiftWorkPoint                := io_stPickPlace.i_bLift_WorkPoint;
i_bLongEdge1Detect              := io_stPickPlace.i_bLongEdge1Detect;
i_bLongEdge2Detect              := io_stPickPlace.i_bLongEdge2Detect;
i_bShortEdge1Detect             := io_stPickPlace.i_bShortEdge1Detect;
i_bShortEdge2Detect             := io_stPickPlace.i_bShortEdge2Detect;
i_bFullMaterialDetect1          := io_stPickPlace.i_bFullMaterialDetect1;
i_bFullMaterialDetect2          := io_stPickPlace.i_bFullMaterialDetect2;

(* ==================== 定时器调用 ==================== *)
tLiftTimer(IN := tIn[0], R := tR[0], PT := tPt[0], Q => tQ[0], ET => tEt[0]);
tClampTimer(IN := tIn[1], R := tR[1], PT := tPt[1], Q => tQ[1], ET => tEt[1]);
tPlaceDoneTimer(IN := tIn[2], R := tR[2], PT := tPt[2], Q => tQ[2], ET => tEt[2]);

(* ==================== 使能关闭 (V7.0: 含轴命令清除) ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    (* --- 气缸/电机输出清零 --- *)
    q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
    q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
    q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    
    (* --- V7.0: 轴命令全部清除 (直接操作ST_ServoAxis) --- *)
    io_stZAxis.stAbs.Execute  := FALSE;
    io_stX1Axis.stAbs.Execute := FALSE;
    io_stZAxis.stStop.Execute := FALSE;
    io_stX1Axis.stStop.Execute := FALSE;
    
    (* --- 状态/诊断清零 --- *)
    q_iAlarmCode := 0; q_bSensorFault := FALSE;
    q_bProductMissing := FALSE; q_bFrameOnPickupPlatform := FALSE;
    q_bPlaceDoneToFeeder := FALSE; q_bRunning := FALSE;
    q_bX1Fault := FALSE; q_bZFault := FALSE;
    iCurrentState := S20_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
    RETURN;
END_IF;

(* ==================== 停止处理 (V7.0: SV_Stop急停) ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := S20_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    
    (* --- 气缸/电机停止 --- *)
    q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
    q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
    q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    
    (* --- V7.0: 急停两轴 (SV_Stop) --- *)
    io_stZAxis.stStop.Execute  := TRUE;
    io_stX1Axis.stStop.Execute := TRUE;
    io_stZAxis.stAbs.Execute  := FALSE;
    io_stX1Axis.stAbs.Execute := FALSE;
    
    q_bPlaceDoneToFeeder := FALSE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* --- 启动触发 --- *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
    END_IF;

    CASE iCurrentState OF

        S20_IDLE: (* 0 - 待机等待 *)
            IF bStepEntry THEN
                (* V7.0: 清除轴定位命令 *)
                io_stZAxis.stAbs.Execute  := FALSE;
                io_stX1Axis.stAbs.Execute := FALSE;
                q_bPlaceDoneToFeeder := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* V7.0: 使能检查 (SV_Power) — 自动模式下确保轴已使能 *)
            IF NOT io_stZAxis.stPower.Status THEN
                io_stZAxis.stPower.Enable := TRUE;
            END_IF;
            IF NOT io_stX1Axis.stPower.Status THEN
                io_stX1Axis.stPower.Enable := TRUE;
            END_IF;

            (* V7.0: 伺服报警检查 (ST_Sensor.ServoAlarm) *)
            IF io_stZAxis.stSensor.ServoAlarm OR io_stX1Axis.stSensor.ServoAlarm THEN
                iAlarmCode := 73;
                IF io_stZAxis.stSensor.ServoAlarm THEN q_bZFault := TRUE; END_IF;
                IF io_stX1Axis.stSensor.ServoAlarm THEN q_bX1Fault := TRUE; END_IF;
            END_IF;

            (* 检查取料平台是否有残留边框 *)
            IF i_bFrameDetect1 OR i_bFrameDetect2 THEN
                q_bFrameOnPickupPlatform := TRUE;
                bFrameOnPlatform := TRUE;
                iAlarmCode := 80;
            END_IF;

            IF bStartTriggered AND i_iPickLayer > 0 AND i_iPickLayer <= 4 THEN
                iPickLayer := i_iPickLayer;
                bRunning := TRUE;
                bStepEntry := TRUE;
                iCurrentState := S21_UP_TO_PICK;
            END_IF;

        S21_UP_TO_PICK: (* 1 - Z上升到取料高度D514 [SV_ABS] *)
            IF bStepEntry THEN
                (* V7.0: 安全互锁 — 限位检查 (ST_Sensor) *)
                IF io_stZAxis.stSensor.FwdLimit OR io_stZAxis.stSensor.RevLimit THEN
                    iAlarmCode := 74;
                    iCurrentState := S20_IDLE;
                    bRunning := FALSE; bStartTriggered := FALSE;
                    bStepEntry := FALSE;
                ELSE
                    (* V7.0: 绝对定位 (SV_Abs) — 直接写入轴结构体 *)
                    io_stZAxis.stAbs.Position  := rPickHeight;
                    io_stZAxis.stAbs.Velocity  := i_rZSpeed;
                    io_stZAxis.stAbs.Execute   := TRUE;
                    
                    IF i_iLiftActionTime > 0 THEN
                        tPt[0] := INT_TO_DINT(i_iLiftActionTime);
                    ELSE
                        tPt[0] := T_LIFT_DEFAULT;
                    END_IF;
                    tIn[0] := TRUE; tR[0] := FALSE;
                    bStepEntry := FALSE;
                END_IF;
            END_IF;

            (* V7.0.1: 到位判断 — 仅依赖PLCopen Done *)
            IF io_stZAxis.stAbs.Done THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stZAxis.stAbs.Execute := FALSE;
                bStepEntry := TRUE;
                iCurrentState := S22_CLAMP_AND_DETECT;
            
            (* V7.0: 错误判断 — 超时 OR 轴错误 *)
            ELSIF tQ[0] OR io_stZAxis.stAbs.Error THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stZAxis.stAbs.Execute := FALSE;
                
                (* V7.0: 轴出错时触发SV_Stop + SV_Reset *)
                io_stZAxis.stStop.Execute := TRUE;
                
                IF io_stZAxis.stAbs.Error THEN
                    iAlarmCode := 75;
                    q_bZFault := TRUE;
                ELSE
                    iAlarmCode := 71;
                END_IF;
                iCurrentState := S20_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            END_IF;

        S22_CLAMP_AND_DETECT: (* 2 - 四夹紧 + 四光电检测 *)
            IF bStepEntry THEN
                q_bFrontClamp := TRUE; q_bRearClamp := TRUE;
                q_bFrontClamp2 := TRUE; q_bRearClamp2 := TRUE;
                IF i_iClampConfirmTime > 0 THEN
                    tPt[1] := INT_TO_DINT(i_iClampConfirmTime);
                ELSE
                    tPt[1] := T_CLAMP_DEFAULT;
                END_IF;
                tIn[1] := TRUE; tR[1] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[1] THEN
                tIn[1] := FALSE; tR[1] := TRUE;
                (* 检测四组夹紧到位 *)
                IF i_bFrontClampClosed AND i_bRearClampClosed AND
                   i_bFrontClamp2Closed AND i_bRearClamp2Closed THEN
                    (* 夹紧到位,检测产品 *)
                    IF i_bLongEdge1Detect AND i_bLongEdge2Detect AND
                       i_bShortEdge1Detect AND i_bShortEdge2Detect THEN
                        bStepEntry := TRUE;
                        iCurrentState := S23_MOVE_TO_PLACE;
                    ELSE
                        q_bProductMissing := TRUE;
                        bProductMissing := TRUE;
                        iAlarmCode := 72;
                        iCurrentState := S25_UNCLAMP_AND_NOTIFY;
                    END_IF;
                ELSE
                    q_bSensorFault := TRUE;
                    bSensorFault := TRUE;
                    iAlarmCode := 71;
                    iCurrentState := S25_UNCLAMP_AND_NOTIFY;
                END_IF;
            END_IF;

        S23_MOVE_TO_PLACE: (* 3 - X1移动到放料位置,按层选 [SV_ABS] *)
            IF bStepEntry THEN
                (* V7.0: X1轴限位互锁 (ST_Sensor) *)
                IF io_stX1Axis.stSensor.FwdLimit OR io_stX1Axis.stSensor.RevLimit THEN
                    iAlarmCode := 74;
                    iCurrentState := S20_IDLE;
                    bRunning := FALSE; bStartTriggered := FALSE;
                    bStepEntry := FALSE;
                ELSE
                    (* V7.0: 绝对定位 (SV_Abs) — 按层选放料位置 *)
                    IF (iPickLayer = 1) OR (iPickLayer = 3) THEN
                        io_stX1Axis.stAbs.Position := rPlaceHeightL1;
                    ELSE
                        io_stX1Axis.stAbs.Position := rPlaceHeightL2;
                    END_IF;
                    io_stX1Axis.stAbs.Velocity := i_rX1Speed;
                    io_stX1Axis.stAbs.Execute  := TRUE;
                    bStepEntry := FALSE;
                END_IF;
            END_IF;

            (* X1到位后进入下降步 — 传感器信号 OR Done *)
            IF i_bFullMaterialDetect1 OR i_bFullMaterialDetect2 OR io_stX1Axis.stAbs.Done THEN
                io_stX1Axis.stAbs.Execute := FALSE;
                bStepEntry := TRUE;
                iCurrentState := S24_DOWN_TO_PLACE;
            END_IF;

        S24_DOWN_TO_PLACE: (* 4 - Z下降到放料高度D524 [SV_ABS] *)
            IF bStepEntry THEN
                (* V7.0: Z轴限位互锁 *)
                IF io_stZAxis.stSensor.FwdLimit OR io_stZAxis.stSensor.RevLimit THEN
                    iAlarmCode := 74;
                    iCurrentState := S20_IDLE;
                    bRunning := FALSE; bStartTriggered := FALSE;
                    bStepEntry := FALSE;
                ELSE
                    (* V7.0: 绝对定位 (SV_Abs) *)
                    io_stZAxis.stAbs.Position  := rPlaceDownHeight;
                    io_stZAxis.stAbs.Velocity  := i_rZSpeed;
                    io_stZAxis.stAbs.Execute   := TRUE;
                    q_bLiftDown := TRUE;
                    q_bLiftUp := FALSE;
                    
                    IF i_iLiftActionTime > 0 THEN
                        tPt[0] := INT_TO_DINT(i_iLiftActionTime);
                    ELSE
                        tPt[0] := T_LIFT_DEFAULT;
                    END_IF;
                    tIn[0] := TRUE; tR[0] := FALSE;
                    bStepEntry := FALSE;
                END_IF;
            END_IF;

            (* 到位 — 传感器信号 OR Done *)
            IF i_bLiftWorkPoint OR io_stZAxis.stAbs.Done THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stZAxis.stAbs.Execute := FALSE;
                q_bLiftDown := FALSE;
                bStepEntry := TRUE;
                iCurrentState := S25_UNCLAMP_AND_NOTIFY;
            
            (* 超时或轴错误 *)
            ELSIF tQ[0] OR io_stZAxis.stAbs.Error THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stZAxis.stAbs.Execute := FALSE;
                q_bLiftDown := FALSE;
                
                (* V7.0: 出错急停 *)
                io_stZAxis.stStop.Execute := TRUE;
                
                IF io_stZAxis.stAbs.Error THEN
                    iAlarmCode := 75;
                ELSE
                    iAlarmCode := 71;
                END_IF;
                iCurrentState := S20_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            END_IF;

        S25_UNCLAMP_AND_NOTIFY: (* 5 - 四松开 + 通知FB_1004 *)
            IF bStepEntry THEN
                q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
                q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
                tPt[2] := T_PLACE_DONE_PULSE;
                tIn[2] := TRUE; tR[2] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[2] THEN
                tIn[2] := FALSE; tR[2] := TRUE;
                q_bPlaceDoneToFeeder := TRUE;
                bPlaceDonePulse := TRUE;
                bStepEntry := TRUE;
                iCurrentState := S20_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            END_IF;

        ELSE
            iCurrentState := S20_IDLE;
            bRunning := FALSE; bStartTriggered := FALSE;
    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE; iCurrentState := S20_IDLE;
    bStepEntry := TRUE; bStartTriggered := FALSE;
    q_bPlaceDoneToFeeder := FALSE;

    (* 前夹紧 *)
    IF i_bLx_FrontClamp THEN q_bFrontClamp := TRUE; ELSE q_bFrontClamp := FALSE; END_IF;
    (* 后夹紧 *)
    IF i_bLx_RearClamp THEN q_bRearClamp := TRUE; ELSE q_bRearClamp := FALSE; END_IF;
    (* 前夹紧2 *)
    IF i_bLx_FrontClamp2 THEN q_bFrontClamp2 := TRUE; ELSE q_bFrontClamp2 := FALSE; END_IF;
    (* 后夹紧2 *)
    IF i_bLx_RearClamp2 THEN q_bRearClamp2 := TRUE; ELSE q_bRearClamp2 := FALSE; END_IF;

    (* 升降 *)
    IF i_bLx_LiftUp AND NOT i_bLx_LiftDown THEN
        q_bLiftUp := TRUE; q_bLiftDown := FALSE;
    ELSIF i_bLx_LiftDown AND NOT i_bLx_LiftUp THEN
        q_bLiftDown := TRUE; q_bLiftUp := FALSE;
    ELSE
        q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    END_IF;

    (* V7.0: 手动模式下也清除轴命令 *)
    io_stZAxis.stAbs.Execute  := FALSE;
    io_stX1Axis.stAbs.Execute := FALSE;

    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;

ELSE
    q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
    q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
    q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    
    (* V7.0: 轴命令清除 *)
    io_stZAxis.stAbs.Execute  := FALSE;
    io_stX1Axis.stAbs.Execute := FALSE;
    q_bPlaceDoneToFeeder := FALSE;
END_IF;

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;
q_iCurrentPickLayer := iPickLayer;
q_iAlarmCode := iAlarmCode;

(* 放料完成脉冲自清除 *)
IF bPlaceDonePulse AND tQ[2] = FALSE THEN
    q_bPlaceDoneToFeeder := FALSE;
    bPlaceDonePulse := FALSE;
END_IF;

(* ==================== 结构体封包 (输出映射) ==================== *)
io_stPickPlace.o_bFrontClamp_Action        := q_bFrontClamp;
io_stPickPlace.o_bRearClamp_Action         := q_bRearClamp;
io_stPickPlace.o_bFrontClamp2_Action       := q_bFrontClamp2;
io_stPickPlace.o_bRearClamp2_Action        := q_bRearClamp2;
io_stPickPlace.o_bLift_Up                  := q_bLiftUp;
io_stPickPlace.o_bLift_Down                := q_bLiftDown;
io_stPickPlace.o_bLiftUp                   := q_bLiftUp;
io_stPickPlace.o_bLiftDown                 := q_bLiftDown;
io_stPickPlace.o_bFrontClamp_Release       := NOT q_bFrontClamp;
io_stPickPlace.o_bRearClamp_Release        := NOT q_bRearClamp;
io_stPickPlace.o_bFrontClamp2_Release      := NOT q_bFrontClamp2;
io_stPickPlace.o_bRearClamp2_Release       := NOT q_bRearClamp2;
io_stPickPlace.o_bPlaceComplete_ToFeeder   := q_bPlaceDoneToFeeder;
io_stPickPlace.o_bRunning                  := q_bRunning;
io_stPickPlace.o_bFault                    := (q_iAlarmCode > 0);
io_stPickPlace.o_bX1Fault                  := q_bX1Fault;
io_stPickPlace.o_bZFault                   := q_bZFault;
io_stPickPlace.o_iCurrentState             := q_iCurrentState;
io_stPickPlace.o_iCurrentPickLayer         := q_iCurrentPickLayer;
io_stPickPlace.o_iStationAlarmCode         := q_iAlarmCode;

END_FUNCTION_BLOCK
