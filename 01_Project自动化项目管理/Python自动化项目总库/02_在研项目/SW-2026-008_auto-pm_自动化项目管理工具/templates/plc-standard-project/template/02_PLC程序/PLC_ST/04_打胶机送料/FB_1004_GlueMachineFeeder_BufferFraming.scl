(* ================================================================= *)
(*  功能块名称：FB_1004_GlueMachineFeeder_BufferFraming               *)
(*  功能描述：打胶机送料机构 - 4步D760状态机(X2横移+打胶机交互)    *)
(*  创建日期：2026-05-04                                              *)
(*  版本号：V7.0.0                                                    *)
(*  编制人：Trae                                                      *)
(*  审核人：人工                                                      *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - LSP-905_SCL编程规范                    *)
(*    - ST_ServoAxis V3.0 (PLCopen MC Part 1 嵌套结构体)              *)
(*                                                                     *)
(*  变更记录：                                                          *)
(* ---------------------------------------------------------------- *)
(*  V7.0.0 (2026-07-26) CHG-PLC-2026-004 架构统一                    *)
(*  - 重构: 删除间接轴请求输出(q_bX2AxisHomeRequest/q_bX2AxisMoveAbsReq/q_rX2AxisTargetPos) *)
(*  - 新增: VAR_IN_OUT io_stX2Axis:ST_ServoAxis (对齐FB_1003架构)   *)
(*  - 新增: 直接操作stPower(使能)/stAbs(绝对定位)/stStop(急停)       *)
(*  - 新增: stSensor安全互锁(ServoAlarm)                             *)
(*  - 新增: PLCopen标准状态读取(Done/Error)                          *)
(*  - 新增: 诊断输出 q_bX2Fault                                      *)
(* ---------------------------------------------------------------- *)
(*  V6.0.0 (2026-05-18) Trae                                         *)
(*  - 重写: 6步→4步D760状态机（对齐源程序D760~D763）               *)
(*  - 重写: o_前缀→q_前缀（801规范）                               *)
(*  - 新增: 轴抽象请求接口(q_bXxxReq+q_rTargetPos)                  *)
(*  - 新增: 安全区信号(Y47)与打胶机允许取料(Y44)                   *)
(*  - 新增: 送料平台边框检测(F81)                                  *)
(*  - 新增: TONR定时器（tIn/tQ/tR/tPt/tEt简化命名）               *)
(* ---------------------------------------------------------------- *)
(*  V1.0.0 (2026-05-04)                                              *)
(*  - 6步版本,含直接伺服控制（已废弃）                            *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1004_GlueMachineFeeder_BufferFraming

(* ==================== VAR_IN_OUT (V8.0.0 结构体整块传递) ==================== *)
VAR_IN_OUT
    io_stFeeder                 : ST_GlueFeeder;  // 打胶送料工站全量数据结构体
    (* --- 伺服轴引用 (ST_ServoAxis V3.0 嵌套结构体) --- *)
    io_stX2Axis                 : ST_ServoAxis;   // X2轴(送料横移) - 直读直写
END_VAR

(* ==================== VAR ==================== *)
VAR
    // 局部解包/封包变量 (白盒兼容内部逻辑)
    i_bAutoMode                 : BOOL;
    i_bManualMode               : BOOL;
    i_bStart                    : BOOL;
    i_bStop                     : BOOL;
    i_bLx_X2JogPos              : BOOL;
    i_bLx_X2JogNeg              : BOOL;
    i_bPlaceDone                : BOOL;
    i_rX2Speed                  : REAL;
    i_bGlueMachineAllowFeed     : BOOL;
    i_bGlueMachinePickupComplete: BOOL;
    i_bX2ZoneSensor1            : BOOL;
    i_bX2ZoneSensor2            : BOOL;
    i_bX2ZoneSensor3            : BOOL;
    i_bX2ZoneSensor4            : BOOL;

    q_bAllowPickup              : BOOL;
    q_bSafetyZoneSignal         : BOOL;
    q_iCurrentState             : INT;
    q_iAlarmCode                : INT;
    q_bFrameOnFeedPlatform      : BOOL;
    q_bRunning                  : BOOL;
    q_bX2Fault                  : BOOL;

    bStepEntry                  : BOOL;
    bRunning                    : BOOL;
    iCurrentState               : INT;
    iAlarmCode                  : INT;
    bStartTriggered             : BOOL;

    tIn                         : ARRAY[0..1] OF BOOL;
    tQ                          : ARRAY[0..1] OF BOOL;
    tR                          : ARRAY[0..1] OF BOOL;
    tPt                         : ARRAY[0..1] OF DINT;
    tEt                         : ARRAY[0..1] OF DINT;

    tMoveTimer                  : FB_TONR;
    tCommTimer                  : FB_TONR;

    bPlaceDoneMem               : BOOL;
    bFrameOnPlatform            : BOOL;

    rPickupPos                  : REAL := 620.0;
    rGluePlacePos               : REAL := 630.0;
    rStandbyPos                 : REAL := 610.0;
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    D760_IDLE               : INT := 0;     (* 空闲待机 *)
    D760_MOVE_TO_PICKUP     : INT := 1;     (* X2→取料位D620 *)
    D760_MOVE_TO_GLUE       : INT := 2;     (* X2→打胶机送料D630 *)
    D760_RETURN_STANDBY     : INT := 3;     (* X2→待机位D610 *)

    T_MOVE_DEFAULT          : DINT := 20000;   (* 移动超时默认20s *)
    T_COMM_DEFAULT          : DINT := 10000;  (* 通信超时默认10s *)
END_VAR

(* ==================== 结构体解包 (输入映射) ==================== *)
i_bAutoMode                 := io_stFeeder.i_bAutoMode;
i_bManualMode               := io_stFeeder.i_bManualMode;
i_bStart                    := io_stFeeder.i_bStart;
i_bStop                     := io_stFeeder.i_bStop;
i_bLx_X2JogPos              := io_stFeeder.i_bLx_X2Axis_JogFwd;
i_bLx_X2JogNeg              := io_stFeeder.i_bLx_X2Axis_JogRev;
i_bPlaceDone                := io_stFeeder.i_bPickPlace_FeedComplete;
i_rX2Speed                  := io_stFeeder.i_rFeedSpeed;
i_bGlueMachineAllowFeed     := io_stFeeder.i_bGlueMachine_AllowFeed;
i_bGlueMachinePickupComplete:= io_stFeeder.i_bGlueMachine_PickupComplete;
i_bX2ZoneSensor1            := FALSE;
i_bX2ZoneSensor2            := FALSE;
i_bX2ZoneSensor3            := FALSE;
i_bX2ZoneSensor4            := FALSE;

(* ==================== 定时器调用 ==================== *)
tMoveTimer(IN := tIn[0], R := tR[0], PT := tPt[0], Q => tQ[0], ET => tEt[0]);
tCommTimer(IN := tIn[1], R := tR[1], PT := tPt[1], Q => tQ[1], ET => tEt[1]);

(* ==================== 使能关闭 (V7.0: 含轴命令清除) ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    (* V7.0: 轴命令清除 (直接操作ST_ServoAxis) *)
    io_stX2Axis.stAbs.Execute  := FALSE;
    io_stX2Axis.stStop.Execute := FALSE;

    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
    q_iAlarmCode := 0; q_bFrameOnFeedPlatform := FALSE;
    q_bX2Fault := FALSE;
    q_bRunning := FALSE;
    iCurrentState := D760_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    bPlaceDoneMem := FALSE;
    RETURN;
END_IF;

(* ==================== 停止处理 (V7.0: SV_Stop急停) ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := D760_IDLE; bRunning := FALSE; bStepEntry := TRUE;

    (* V7.0: 急停X2轴 (SV_Stop) *)
    io_stX2Axis.stStop.Execute := TRUE;
    io_stX2Axis.stAbs.Execute  := FALSE;

    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    bPlaceDoneMem := FALSE;
END_IF;

(* ==================== 放料完成脉冲记忆 ==================== *)
IF i_bPlaceDone THEN
    bPlaceDoneMem := TRUE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* --- 启动触发 --- *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
        bRunning := TRUE;
    END_IF;

    CASE iCurrentState OF

        D760_IDLE: (* 0 - 空闲待机 *)
            IF bStepEntry THEN
                (* V7.0: 清除轴定位命令 *)
                io_stX2Axis.stAbs.Execute := FALSE;
                q_bAllowPickup := FALSE;
                q_bSafetyZoneSignal := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* V7.0: 使能检查 (SV_Power) — 自动模式下确保轴已使能 *)
            IF NOT io_stX2Axis.stPower.Status THEN
                io_stX2Axis.stPower.Enable := TRUE;
            END_IF;

            (* V7.0: 伺服报警检查 (ST_Sensor.ServoAlarm) *)
            IF io_stX2Axis.stSensor.ServoAlarm THEN
                q_bX2Fault := TRUE;
                iAlarmCode := 73;
            END_IF;

            (* 检查送料平台是否有残留边框 *)
            IF i_bX2ZoneSensor1 OR i_bX2ZoneSensor2 THEN
                q_bFrameOnFeedPlatform := TRUE;
                bFrameOnPlatform := TRUE;
                iAlarmCode := 81;
            END_IF;

            IF bPlaceDoneMem AND bStartTriggered THEN
                bPlaceDoneMem := FALSE;
                bStepEntry := TRUE;
                iCurrentState := D760_MOVE_TO_PICKUP;
            END_IF;

        D760_MOVE_TO_PICKUP: (* 1 - X2→取料点D620 [SV_ABS] *)
            IF bStepEntry THEN
                (* V7.0: 绝对定位 (SV_Abs) — 直接写入轴结构体 *)
                io_stX2Axis.stAbs.Position  := rPickupPos;
                io_stX2Axis.stAbs.Velocity  := i_rX2Speed;
                io_stX2Axis.stAbs.Execute   := TRUE;

                tPt[0] := T_MOVE_DEFAULT;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* V7.0: 到位判断 — PLCopen Done + 传感器冗余确认 *)
            IF io_stX2Axis.stAbs.Done THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stX2Axis.stAbs.Execute := FALSE;
                bStepEntry := TRUE;
                iCurrentState := D760_MOVE_TO_GLUE;

            (* V7.0: 错误判断 — 超时 OR 轴错误 *)
            ELSIF tQ[0] OR io_stX2Axis.stAbs.Error THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stX2Axis.stAbs.Execute := FALSE;

                (* V7.0: 轴出错时触发SV_Stop *)
                io_stX2Axis.stStop.Execute := TRUE;

                IF io_stX2Axis.stAbs.Error THEN
                    iAlarmCode := 75;  (* 轴定位错误 *)
                    q_bX2Fault := TRUE;
                ELSE
                    iAlarmCode := 203; (* 移动超时 *)
                END_IF;
                iCurrentState := D760_IDLE;
                bRunning := FALSE;
            END_IF;

        D760_MOVE_TO_GLUE: (* 2 - X2→放料点D630,与打胶机交互 [SV_ABS] *)
            IF bStepEntry THEN
                (* V7.0: 绝对定位 (SV_Abs) *)
                io_stX2Axis.stAbs.Position  := rGluePlacePos;
                io_stX2Axis.stAbs.Velocity  := i_rX2Speed;
                io_stX2Axis.stAbs.Execute   := TRUE;

                tPt[0] := T_MOVE_DEFAULT;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* V7.0: 到位判断 — PLCopen Done + 传感器冗余确认 *)
            IF io_stX2Axis.stAbs.Done THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stX2Axis.stAbs.Execute := FALSE;
                q_bSafetyZoneSignal := TRUE;

            ELSIF tQ[0] OR io_stX2Axis.stAbs.Error THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stX2Axis.stAbs.Execute := FALSE;
                io_stX2Axis.stStop.Execute := TRUE;

                IF io_stX2Axis.stAbs.Error THEN
                    iAlarmCode := 75;
                    q_bX2Fault := TRUE;
                ELSE
                    iAlarmCode := 203;
                END_IF;
                iCurrentState := D760_IDLE;
                bRunning := FALSE;
            END_IF;

            (* 打胶机交互: 安全区已激活 → 等待打胶机响应 *)
            IF q_bSafetyZoneSignal THEN
                IF i_bGlueMachineAllowFeed THEN
                    q_bAllowPickup := TRUE;
                END_IF;
                IF i_bGlueMachinePickupComplete THEN
                    q_bAllowPickup := FALSE;
                    bStepEntry := TRUE;
                    iCurrentState := D760_RETURN_STANDBY;
                END_IF;
            END_IF;

        D760_RETURN_STANDBY: (* 3 - X2→待机位D610 [SV_ABS] *)
            IF bStepEntry THEN
                (* V7.0: 绝对定位 (SV_Abs) *)
                io_stX2Axis.stAbs.Position  := rStandbyPos;
                io_stX2Axis.stAbs.Velocity  := i_rX2Speed;
                io_stX2Axis.stAbs.Execute   := TRUE;

                tPt[0] := T_MOVE_DEFAULT;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* V7.0: 到位判断 — PLCopen Done *)
            IF io_stX2Axis.stAbs.Done THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stX2Axis.stAbs.Execute := FALSE;
                q_bSafetyZoneSignal := FALSE;
                bStepEntry := TRUE;
                iCurrentState := D760_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;

            ELSIF tQ[0] OR io_stX2Axis.stAbs.Error THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                io_stX2Axis.stAbs.Execute := FALSE;
                io_stX2Axis.stStop.Execute := TRUE;
                q_bSafetyZoneSignal := FALSE;

                IF io_stX2Axis.stAbs.Error THEN
                    iAlarmCode := 75;
                    q_bX2Fault := TRUE;
                ELSE
                    iAlarmCode := 203;
                END_IF;
                iCurrentState := D760_IDLE;
                bRunning := FALSE;
            END_IF;

        ELSE
            iCurrentState := D760_IDLE;
            bRunning := FALSE; bStartTriggered := FALSE;
    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE; iCurrentState := D760_IDLE;
    bStepEntry := TRUE; bStartTriggered := FALSE;
    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
    bPlaceDoneMem := FALSE;

    (* 手动点动: 直接操作轴 *)
    IF i_bLx_X2JogPos AND NOT i_bLx_X2JogNeg THEN
        io_stX2Axis.stAbs.Position := rGluePlacePos;
        io_stX2Axis.stAbs.Execute  := TRUE;
    ELSIF i_bLx_X2JogNeg AND NOT i_bLx_X2JogPos THEN
        io_stX2Axis.stAbs.Position := rStandbyPos;
        io_stX2Axis.stAbs.Execute  := TRUE;
    ELSE
        io_stX2Axis.stAbs.Execute := FALSE;
    END_IF;

    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;

ELSE
    (* V7.0: 无模式时清除轴命令 *)
    io_stX2Axis.stAbs.Execute := FALSE;
    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
END_IF;

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;
q_iAlarmCode := iAlarmCode;

(* ==================== 结构体封包 (输出映射) ==================== *)
io_stFeeder.o_bAllowPickup              := q_bAllowPickup;
io_stFeeder.o_bSafetyZoneSignal         := q_bSafetyZoneSignal;
io_stFeeder.o_bRunning                  := q_bRunning;
io_stFeeder.o_bFault                    := (q_iAlarmCode > 0);
io_stFeeder.o_bX2Fault                  := q_bX2Fault;
io_stFeeder.o_iCurrentState             := q_iCurrentState;
io_stFeeder.o_iStationAlarmCode         := q_iAlarmCode;

END_FUNCTION_BLOCK