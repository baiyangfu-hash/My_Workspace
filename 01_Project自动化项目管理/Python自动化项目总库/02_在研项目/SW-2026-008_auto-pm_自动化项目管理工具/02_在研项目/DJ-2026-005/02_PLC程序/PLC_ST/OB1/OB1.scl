// ============================================================================
// OB1.scl - 边框缓存机主组织块 (V7.1.1)
// ============================================================================
// 描述:
//   DJ-2026-005 边框缓存机 PLC 控制系统主循环程序.
//   负责实例化并按工艺顺序调用各工站功能块.
//
// 架构:
//   "主控 + 功能块"模式,OB1 作为调度中心:
//   - 不包含业务逻辑
//   - 仅负责 FB 实例化与调用顺序管理
//   - 所有 I/O 映射通过 GlobalVars 数据块完成
//
// FB 调用顺序（按工艺流程）:
//   1. FB_ExternalDeviceInteraction   - 外部设备交互/安全门/急停
//   2. 4×FB_1002_SingleLayerConveyor  - 四层输送机展开调用 (L1~L4)
//   3. FB_1003_PickPlace              - 取放料机构
//   4. FB_1004_GlueMachineFeeder      - 打胶机送料机构
//   5. FB_2001_CommonAlarm            - 公共报警管理
//
// 变更记录:
//   V7.1.1 (2026-05-20): 修复FB_1003 i_iPickLayer输入源 (TC11 Bug修复)
//          - i_iPickLayer 接线从 o_iCurrentPickLayer(输出) → i_iPickLayer_Input(独立输入)
//          - 断开输出→输入反馈回路, 解决 FB_1003 内部 iPickLayer(=0) 覆盖问题
//   V7.1.0 (2026-05-20): FB_1003 V7.0.0集成ST_ServoAxis V3.0
//          - FB_1003调用新增VAR_IN_OUT: io_stZAxis/io_stX1Axis => astServoAxis[1..2]
//          - GlobalVars.db新增astServoAxis[1..3]: ST_ServoAxis数组
//   V7.0.0 (2026-05-18): Conveyor子系统V7.0.0重构对齐
//          - 取消FB_1001容器, 展开调用4×FB_1002 (L1~L4)
//          - 新增汇总逻辑: q_bRunning(4层OR)/q_bFault(4层OR)/q_iAlarmCode(MIN优先级)
//          - 下游引用更新: PickPlace取q_aLayerFeedDone, FB_2001取q_iAlarmCode
//   V6.0.1 (2026-05-18): 修复 - 所有GlobalVars成员引用对齐GlobalVars.db实际定义
//          - stExternal: 匹配FB_ExternalDeviceInteraction实际27输入/16输出引脚
//          - stConveyor: 匹配FB_1001实际34输入/30输出(含ARRAY[1..4])引脚
//          - stPickPlace: 匹配FB_1003 V6.0.0实际51输入/20输出引脚
//          - stFeeder: 匹配FB_1004 V6.0.0实际14输入/9输出引脚
//          - stGlobal: 匹配FB_2001实际3-INT输入/10输出引脚
//   V6.0.0 (2026-05-18): Phase 3全部重写 - 同步所有FB V6.0.0新接口
// ============================================================================

// [中途省略至 427 行]

// ============================================================================
// 第5部分：公共报警管理 (FB_2001 V2.1.0)
// ============================================================================
GlobalVars.fbCommonAlarm(
    i_iConveyorAlarm             := GlobalVars.stConveyor.q_iAlarmCode,
    i_iPickPlaceAlarm            := GlobalVars.stPickPlace.o_iStationAlarmCode,
    i_iFeederAlarm               := GlobalVars.stFeeder.o_iStationAlarmCode,
    i_bReset                     := GlobalVars.stGlobal.i_bReset,

    q_wGlobalAlarmWord           => GlobalVars.stGlobal.o_wGlobalAlarmWord,
    q_iCurrentAlarmCode          => GlobalVars.stGlobal.o_iCurrentAlarmCode,
    q_bAnyAlarmActive            => GlobalVars.stGlobal.o_bAnyAlarmActive,
    q_iMESAlarmCount             => GlobalVars.stGlobal.o_iMESAlarmCount,
    q_iMESAlarmQueue             => GlobalVars.stGlobal.o_iMESAlarmQueue
);

ORGANIZATION_BLOCK OB1

BEGIN
// ============================================================================
// 第1部分：外部设备交互 (组框机/打胶机/机器人)
// ============================================================================
REGION// fbExternalDevice 
    // =========================================================================
GlobalVars.fbExternalDevice(
    i_bEnable                    := GlobalVars.stExternal.i_bEnable,
    i_bAutoMode                  := GlobalVars.stExternal.i_bAutoMode,
    i_bManualMode                := GlobalVars.stExternal.i_bManualMode,
    i_bStart                     := GlobalVars.stExternal.i_bStart,
    i_bStop                      := GlobalVars.stExternal.i_bStop,
    i_bReset                     := GlobalVars.stExternal.i_bReset,

    i_bFrameMachine_AutoRunning   := GlobalVars.stExternal.i_bFrameMachine_AutoRunning,
    i_bFrameMachine_AllowFeed     := GlobalVars.stExternal.i_bFrameMachine_AllowFeed,
    i_bFrameMaterialRequest      := GlobalVars.stExternal.i_bFrameMaterialRequest,
    i_bDoorOpenRequest           := GlobalVars.stExternal.i_bDoorOpenRequest,
    i_bFrameMachine_EStop        := GlobalVars.stExternal.i_bFrameMachine_EStop,
    i_bFrameMachine_SafetyErr    := GlobalVars.stExternal.i_bFrameMachine_SafetyErr,
    i_bFrameMachine_CommErr      := GlobalVars.stExternal.i_bFrameMachine_CommErr,

    i_bGlueMachine_AutoRunning    := GlobalVars.stExternal.i_bGlueMachine_AutoRunning,
    i_bGlueMachine_AllowFeed      := GlobalVars.stExternal.i_bGlueMachine_AllowFeed,
    i_bGlueMachine_PickComplete   := GlobalVars.stExternal.i_bGlueMachine_PickComplete,
    i_bGlueMachine_Fault          := GlobalVars.stExternal.i_bGlueMachine_Fault,
    i_bGlueMachine_EStop          := GlobalVars.stExternal.i_bGlueMachine_EStop,
    i_bGlueMachine_CommErr        := GlobalVars.stExternal.i_bGlueMachine_CommErr,

    i_bRobot_AutoRunning          := GlobalVars.stExternal.i_bRobot_AutoRunning,
    i_bRobot_StackComplete        := GlobalVars.stExternal.i_bRobot_StackComplete,
    i_bRobot_Fault                := GlobalVars.stExternal.i_bRobot_Fault,
    i_bRobot_EStop                := GlobalVars.stExternal.i_bRobot_EStop,
    i_bRobot_CommErr              := GlobalVars.stExternal.i_bRobot_CommErr,

    i_bLocalReady                 := GlobalVars.stExternal.i_bLocalReady,
    i_bAnyAlarmActive            := GlobalVars.stExternal.i_bAnyAlarmActive,
    i_bSystemFault               := GlobalVars.stExternal.i_bSystemFault,

    q_bFrameMachine_RequestFeed   => GlobalVars.stExternal.o_bFrameMachine_RequestFeed,
    q_bFrameMachine_Pause         => GlobalVars.stExternal.o_bFrameMachine_Pause,
    q_bFrameMachine_EStop         => GlobalVars.stExternal.o_bFrameMachine_EStop,
    q_bDoorOpenRequest            => GlobalVars.stExternal.o_bDoorOpenRequest,
    q_bFrameMachine_Ready         => GlobalVars.stExternal.o_bFrameMachine_Ready,

    q_bGlueMachine_RequestRun     => GlobalVars.stExternal.o_bGlueMachine_RequestRun,
    q_bAllowPickup                => GlobalVars.stExternal.o_bAllowPickup,
    q_bSafetyZoneSignal           => GlobalVars.stExternal.o_bSafetyZoneSignal,
    q_bGlueMachine_ResetReq       => GlobalVars.stExternal.o_bGlueMachine_ResetReq,

    q_bRobot_AllowStacking        => GlobalVars.stExternal.o_bRobot_AllowStacking,
    q_bRobot_StopStacking         => GlobalVars.stExternal.o_bRobot_StopStacking,
    q_bRobot_ResetReq             => GlobalVars.stExternal.o_bRobot_ResetReq,

    q_bFrameMachine_EmergencyStop => GlobalVars.stExternal.o_bFrameMachine_EmergencyStop,
    q_bExternalDeviceFault        => GlobalVars.stExternal.o_bExternalDeviceFault,
    q_iExternalDeviceAlarmSummary => GlobalVars.stExternal.o_iExternalDeviceAlarmSummary,
    q_bSystemSafetyConditionMet   => GlobalVars.stExternal.o_bSystemSafetyConditionMet
);
END_REGION



// ============================================================================
// 第2部分：四层输送机 (4×FB_1002 展开调用 V7.0.0)
// ============================================================================
(* ===== 第1层 ===== *)
GlobalVars.fbConveyor_L1(
    i_bAutoMode             := GlobalVars.stConveyor.i_bAutoMode,
    i_bManualMode           := GlobalVars.stConveyor.i_bManualMode,
    i_bStart                := GlobalVars.stConveyor.i_bStart,
    i_bStop                 := GlobalVars.stConveyor.i_bStop,
    i_iLayerIndex           := 1,
    i_iSeparateTimeoutMs    := GlobalVars.stConveyor.i_iSeparateTimeoutMs,
    i_dSeparateTimeoutMs    := GlobalVars.stConveyor.i_dSeparateTimeoutMs,
    i_dDebounceMs           := GlobalVars.stConveyor.i_dDebounceMs,

    i_bPreSeparateSensor    := GlobalVars.stConveyor.i_aPreSeparateSensor[1],
    i_bPositionSensor1      := GlobalVars.stConveyor.i_aPositionSensor1[1],
    i_bPositionSensor2      := GlobalVars.stConveyor.i_aPositionSensor2[1],
    i_bBlockCylinderUp      := GlobalVars.stConveyor.i_aBlockCylinderUp[1],
    i_bBlockCylinderDown    := GlobalVars.stConveyor.i_aBlockCylinderDown[1],
    i_bSeparateCylinderUp   := GlobalVars.stConveyor.i_aSeparateCylinderUp[1],
    i_bSeparateCylinderDown := GlobalVars.stConveyor.i_aSeparateCylinderDown[1],

    i_bSafetyDoorOk         := GlobalVars.stConveyor.i_bSafetyDoorOk,
    i_bVfdFault             := GlobalVars.stConveyor.i_bVfdFault,
    i_bPickupConfirmed      := GlobalVars.stConveyor.i_aPickupConfirmed[1],

    i_bManBlockExtend       := GlobalVars.stConveyor.i_aManBlockExtend[1],
    i_bManBlockRetract      := GlobalVars.stConveyor.i_aManBlockRetract[1],
    i_bManSeparatePush      := GlobalVars.stConveyor.i_aManSeparatePush[1],
    i_bManConveyorFwd       := GlobalVars.stConveyor.i_aManConveyorFwd[1],
    i_bManConveyorRev       := GlobalVars.stConveyor.i_aManConveyorRev[1],
    i_bManConveyorSlow      := GlobalVars.stConveyor.i_aManConveyorSlow[1],

    q_bBlockSolenoid        => GlobalVars.stConveyor.q_aBlockSolenoid[1],
    q_bSeparateSolenoid     => GlobalVars.stConveyor.q_aSeparateSolenoid[1],
    q_bConveyorFwd          => GlobalVars.stConveyor.q_aConveyorFwd[1],
    q_bConveyorRev          => GlobalVars.stConveyor.q_aConveyorRev[1],
    q_bConveyorSlow         => GlobalVars.stConveyor.q_aConveyorSlow[1],
    q_iCurrentState         => GlobalVars.stConveyor.q_aLayerStep[1],
    q_iAlarmCode            => GlobalVars.stConveyor.q_aLayerAlarmCode[1],
    q_bRunning              => GlobalVars.stConveyor.q_aLayerRunning[1],
    q_bFault                => GlobalVars.stConveyor.q_aLayerFault[1],
    q_bLayerFeedDone        => GlobalVars.stConveyor.q_aLayerFeedDone[1],
    q_bAnySensorFault       => GlobalVars.stConveyor.q_aLayerSensorFault[1]
);

(* ===== 第2层 ===== *)
GlobalVars.fbConveyor_L2(
    i_bAutoMode             := GlobalVars.stConveyor.i_bAutoMode,
    i_bManualMode           := GlobalVars.stConveyor.i_bManualMode,
    i_bStart                := GlobalVars.stConveyor.i_bStart,
    i_bStop                 := GlobalVars.stConveyor.i_bStop,
    i_iLayerIndex           := 2,
    i_iSeparateTimeoutMs    := GlobalVars.stConveyor.i_iSeparateTimeoutMs,
    i_dSeparateTimeoutMs    := GlobalVars.stConveyor.i_dSeparateTimeoutMs,
    i_dDebounceMs           := GlobalVars.stConveyor.i_dDebounceMs,

    i_bPreSeparateSensor    := GlobalVars.stConveyor.i_aPreSeparateSensor[2],
    i_bPositionSensor1      := GlobalVars.stConveyor.i_aPositionSensor1[2],
    i_bPositionSensor2      := GlobalVars.stConveyor.i_aPositionSensor2[2],
    i_bBlockCylinderUp      := GlobalVars.stConveyor.i_aBlockCylinderUp[2],
    i_bBlockCylinderDown    := GlobalVars.stConveyor.i_aBlockCylinderDown[2],
    i_bSeparateCylinderUp   := GlobalVars.stConveyor.i_aSeparateCylinderUp[2],
    i_bSeparateCylinderDown := GlobalVars.stConveyor.i_aSeparateCylinderDown[2],

    i_bSafetyDoorOk         := GlobalVars.stConveyor.i_bSafetyDoorOk,
    i_bVfdFault             := GlobalVars.stConveyor.i_bVfdFault,
    i_bPickupConfirmed      := GlobalVars.stConveyor.i_aPickupConfirmed[2],

    i_bManBlockExtend       := GlobalVars.stConveyor.i_aManBlockExtend[2],
    i_bManBlockRetract      := GlobalVars.stConveyor.i_aManBlockRetract[2],
    i_bManSeparatePush      := GlobalVars.stConveyor.i_aManSeparatePush[2],
    i_bManConveyorFwd       := GlobalVars.stConveyor.i_aManConveyorFwd[2],
    i_bManConveyorRev       := GlobalVars.stConveyor.i_aManConveyorRev[2],
    i_bManConveyorSlow      := GlobalVars.stConveyor.i_aManConveyorSlow[2],

    q_bBlockSolenoid        => GlobalVars.stConveyor.q_aBlockSolenoid[2],
    q_bSeparateSolenoid     => GlobalVars.stConveyor.q_aSeparateSolenoid[2],
    q_bConveyorFwd          => GlobalVars.stConveyor.q_aConveyorFwd[2],
    q_bConveyorRev          => GlobalVars.stConveyor.q_aConveyorRev[2],
    q_bConveyorSlow         => GlobalVars.stConveyor.q_aConveyorSlow[2],
    q_iCurrentState         => GlobalVars.stConveyor.q_aLayerStep[2],
    q_iAlarmCode            => GlobalVars.stConveyor.q_aLayerAlarmCode[2],
    q_bRunning              => GlobalVars.stConveyor.q_aLayerRunning[2],
    q_bFault                => GlobalVars.stConveyor.q_aLayerFault[2],
    q_bLayerFeedDone        => GlobalVars.stConveyor.q_aLayerFeedDone[2],
    q_bAnySensorFault       => GlobalVars.stConveyor.q_aLayerSensorFault[2]
);

(* ===== 第3层 ===== *)
GlobalVars.fbConveyor_L3(
    i_bAutoMode             := GlobalVars.stConveyor.i_bAutoMode,
    i_bManualMode           := GlobalVars.stConveyor.i_bManualMode,
    i_bStart                := GlobalVars.stConveyor.i_bStart,
    i_bStop                 := GlobalVars.stConveyor.i_bStop,
    i_iLayerIndex           := 3,
    i_iSeparateTimeoutMs    := GlobalVars.stConveyor.i_iSeparateTimeoutMs,
    i_dSeparateTimeoutMs    := GlobalVars.stConveyor.i_dSeparateTimeoutMs,
    i_dDebounceMs           := GlobalVars.stConveyor.i_dDebounceMs,

    i_bPreSeparateSensor    := GlobalVars.stConveyor.i_aPreSeparateSensor[3],
    i_bPositionSensor1      := GlobalVars.stConveyor.i_aPositionSensor1[3],
    i_bPositionSensor2      := GlobalVars.stConveyor.i_aPositionSensor2[3],
    i_bBlockCylinderUp      := GlobalVars.stConveyor.i_aBlockCylinderUp[3],
    i_bBlockCylinderDown    := GlobalVars.stConveyor.i_aBlockCylinderDown[3],
    i_bSeparateCylinderUp   := GlobalVars.stConveyor.i_aSeparateCylinderUp[3],
    i_bSeparateCylinderDown := GlobalVars.stConveyor.i_aSeparateCylinderDown[3],

    i_bSafetyDoorOk         := GlobalVars.stConveyor.i_bSafetyDoorOk,
    i_bVfdFault             := GlobalVars.stConveyor.i_bVfdFault,
    i_bPickupConfirmed      := GlobalVars.stConveyor.i_aPickupConfirmed[3],

    i_bManBlockExtend       := GlobalVars.stConveyor.i_aManBlockExtend[3],
    i_bManBlockRetract      := GlobalVars.stConveyor.i_aManBlockRetract[3],
    i_bManSeparatePush      := GlobalVars.stConveyor.i_aManSeparatePush[3],
    i_bManConveyorFwd       := GlobalVars.stConveyor.i_aManConveyorFwd[3],
    i_bManConveyorRev       := GlobalVars.stConveyor.i_aManConveyorRev[3],
    i_bManConveyorSlow      := GlobalVars.stConveyor.i_aManConveyorSlow[3],

    q_bBlockSolenoid        => GlobalVars.stConveyor.q_aBlockSolenoid[3],
    q_bSeparateSolenoid     => GlobalVars.stConveyor.q_aSeparateSolenoid[3],
    q_bConveyorFwd          => GlobalVars.stConveyor.q_aConveyorFwd[3],
    q_bConveyorRev          => GlobalVars.stConveyor.q_aConveyorRev[3],
    q_bConveyorSlow         => GlobalVars.stConveyor.q_aConveyorSlow[3],
    q_iCurrentState         => GlobalVars.stConveyor.q_aLayerStep[3],
    q_iAlarmCode            => GlobalVars.stConveyor.q_aLayerAlarmCode[3],
    q_bRunning              => GlobalVars.stConveyor.q_aLayerRunning[3],
    q_bFault                => GlobalVars.stConveyor.q_aLayerFault[3],
    q_bLayerFeedDone        => GlobalVars.stConveyor.q_aLayerFeedDone[3],
    q_bAnySensorFault       => GlobalVars.stConveyor.q_aLayerSensorFault[3]
);

(* ===== 第4层 ===== *)
GlobalVars.fbConveyor_L4(
    i_bAutoMode             := GlobalVars.stConveyor.i_bAutoMode,
    i_bManualMode           := GlobalVars.stConveyor.i_bManualMode,
    i_bStart                := GlobalVars.stConveyor.i_bStart,
    i_bStop                 := GlobalVars.stConveyor.i_bStop,
    i_iLayerIndex           := 4,
    i_iSeparateTimeoutMs    := GlobalVars.stConveyor.i_iSeparateTimeoutMs,
    i_dSeparateTimeoutMs    := GlobalVars.stConveyor.i_dSeparateTimeoutMs,
    i_dDebounceMs           := GlobalVars.stConveyor.i_dDebounceMs,

    i_bPreSeparateSensor    := GlobalVars.stConveyor.i_aPreSeparateSensor[4],
    i_bPositionSensor1      := GlobalVars.stConveyor.i_aPositionSensor1[4],
    i_bPositionSensor2      := GlobalVars.stConveyor.i_aPositionSensor2[4],
    i_bBlockCylinderUp      := GlobalVars.stConveyor.i_aBlockCylinderUp[4],
    i_bBlockCylinderDown    := GlobalVars.stConveyor.i_aBlockCylinderDown[4],
    i_bSeparateCylinderUp   := GlobalVars.stConveyor.i_aSeparateCylinderUp[4],
    i_bSeparateCylinderDown := GlobalVars.stConveyor.i_aSeparateCylinderDown[4],

    i_bSafetyDoorOk         := GlobalVars.stConveyor.i_bSafetyDoorOk,
    i_bVfdFault             := GlobalVars.stConveyor.i_bVfdFault,
    i_bPickupConfirmed      := GlobalVars.stConveyor.i_aPickupConfirmed[4],

    i_bManBlockExtend       := GlobalVars.stConveyor.i_aManBlockExtend[4],
    i_bManBlockRetract      := GlobalVars.stConveyor.i_aManBlockRetract[4],
    i_bManSeparatePush      := GlobalVars.stConveyor.i_aManSeparatePush[4],
    i_bManConveyorFwd       := GlobalVars.stConveyor.i_aManConveyorFwd[4],
    i_bManConveyorRev       := GlobalVars.stConveyor.i_aManConveyorRev[4],
    i_bManConveyorSlow      := GlobalVars.stConveyor.i_aManConveyorSlow[4],

    q_bBlockSolenoid        => GlobalVars.stConveyor.q_aBlockSolenoid[4],
    q_bSeparateSolenoid     => GlobalVars.stConveyor.q_aSeparateSolenoid[4],
    q_bConveyorFwd          => GlobalVars.stConveyor.q_aConveyorFwd[4],
    q_bConveyorRev          => GlobalVars.stConveyor.q_aConveyorRev[4],
    q_bConveyorSlow         => GlobalVars.stConveyor.q_aConveyorSlow[4],
    q_iCurrentState         => GlobalVars.stConveyor.q_aLayerStep[4],
    q_iAlarmCode            => GlobalVars.stConveyor.q_aLayerAlarmCode[4],
    q_bRunning              => GlobalVars.stConveyor.q_aLayerRunning[4],
    q_bFault                => GlobalVars.stConveyor.q_aLayerFault[4],
    q_bLayerFeedDone        => GlobalVars.stConveyor.q_aLayerFeedDone[4],
    q_bAnySensorFault       => GlobalVars.stConveyor.q_aLayerSensorFault[4]
);

(* ===== 汇总 ===== *)
GlobalVars.stConveyor.q_bRunning :=
    GlobalVars.stConveyor.q_aLayerRunning[1] OR
    GlobalVars.stConveyor.q_aLayerRunning[2] OR
    GlobalVars.stConveyor.q_aLayerRunning[3] OR
    GlobalVars.stConveyor.q_aLayerRunning[4];

GlobalVars.stConveyor.q_bFault :=
    GlobalVars.stConveyor.q_aLayerFault[1] OR
    GlobalVars.stConveyor.q_aLayerFault[2] OR
    GlobalVars.stConveyor.q_aLayerFault[3] OR
    GlobalVars.stConveyor.q_aLayerFault[4];

IF GlobalVars.stConveyor.q_aLayerAlarmCode[1] > 0 THEN
    GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[1];
END_IF;
IF GlobalVars.stConveyor.q_aLayerAlarmCode[2] > 0 THEN
    IF GlobalVars.stConveyor.q_iAlarmCode = 0 THEN
        GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[2];
    ELSIF GlobalVars.stConveyor.q_aLayerAlarmCode[2] < GlobalVars.stConveyor.q_iAlarmCode THEN
        GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[2];
    END_IF;
END_IF;
IF GlobalVars.stConveyor.q_aLayerAlarmCode[3] > 0 THEN
    IF GlobalVars.stConveyor.q_iAlarmCode = 0 THEN
        GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[3];
    ELSIF GlobalVars.stConveyor.q_aLayerAlarmCode[3] < GlobalVars.stConveyor.q_iAlarmCode THEN
        GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[3];
    END_IF;
END_IF;
IF GlobalVars.stConveyor.q_aLayerAlarmCode[4] > 0 THEN
    IF GlobalVars.stConveyor.q_iAlarmCode = 0 THEN
        GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[4];
    ELSIF GlobalVars.stConveyor.q_aLayerAlarmCode[4] < GlobalVars.stConveyor.q_iAlarmCode THEN
        GlobalVars.stConveyor.q_iAlarmCode := GlobalVars.stConveyor.q_aLayerAlarmCode[4];
    END_IF;
END_IF;

// ============================================================================
// 第3部分：取放料机构 (FB_1003 V7.0.0, 6步S20~S25状态机)
// ============================================================================
// V7.0.0变更: 新增VAR_IN_OUT轴引用, 直连ST_ServoAxis V3.0结构体
//   io_stZAxis  => astServoAxis[1] (Z轴升降)
//   io_stX1Axis => astServoAxis[2] (X1轴取放料横移)
// ============================================================================
GlobalVars.fbPickPlace(
    i_bAutoMode                  := GlobalVars.stPickPlace.i_bAutoMode,
    i_bManualMode                := GlobalVars.stPickPlace.i_bManualMode,
    i_bStart                     := GlobalVars.stPickPlace.i_bStart,
    i_bStop                      := GlobalVars.stPickPlace.i_bStop,

    i_bLx_FrontClamp             := GlobalVars.stPickPlace.i_bLx_FrontClamp,
    i_bLx_RearClamp              := GlobalVars.stPickPlace.i_bLx_RearClamp,
    i_bLx_FrontClamp2            := GlobalVars.stPickPlace.i_bLx_FrontClamp2,
    i_bLx_RearClamp2             := GlobalVars.stPickPlace.i_bLx_RearClamp2,
    i_bLx_LiftUp                 := GlobalVars.stPickPlace.i_bLx_Lift_Up,
    i_bLx_LiftDown               := GlobalVars.stPickPlace.i_bLx_Lift_Down,

    i_iPickLayer                 := GlobalVars.stPickPlace.i_iPickLayer_Input,  // V7.1.1: 独立输入(断开输出反馈回路)
    i_rZSpeed                    := GlobalVars.stPickPlace.i_rZAxisSpeed,
    i_rX1Speed                   := GlobalVars.stPickPlace.i_rX1AxisSpeed,
    i_iClampConfirmTime          := GlobalVars.stPickPlace.i_iClampConfirmTime,
    i_iLiftActionTime            := GlobalVars.stPickPlace.i_iLiftActionTime,

    i_bLayerFeedDone             := GlobalVars.stConveyor.q_aLayerFeedDone,

    i_bLongEdge1Detect           := GlobalVars.stPickPlace.i_bLongEdge1Detect,
    i_bLongEdge2Detect           := GlobalVars.stPickPlace.i_bLongEdge2Detect,
    i_bShortEdge1Detect          := GlobalVars.stPickPlace.i_bShortEdge1Detect,
    i_bShortEdge2Detect          := GlobalVars.stPickPlace.i_bShortEdge2Detect,

    i_bFrontClampClosed          := GlobalVars.stPickPlace.i_bFrontClamp_Closed,
    i_bFrontClampOpened          := GlobalVars.stPickPlace.i_bFrontClamp_Opened,
    i_bRearClampClosed           := GlobalVars.stPickPlace.i_bRearClamp_Closed,
    i_bRearClampOpened           := GlobalVars.stPickPlace.i_bRearClamp_Opened,
    i_bFrontClamp2Closed         := GlobalVars.stPickPlace.i_bFrontClamp2_Closed,
    i_bFrontClamp2Opened         := GlobalVars.stPickPlace.i_bFrontClamp2_Opened,
    i_bRearClamp2Closed          := GlobalVars.stPickPlace.i_bRearClamp2_Closed,
    i_bRearClamp2Opened          := GlobalVars.stPickPlace.i_bRearClamp2_Opened,

    i_bLiftHomePos               := GlobalVars.stPickPlace.i_bLift_HomePos,
    i_bLiftWorkPoint             := GlobalVars.stPickPlace.i_bLift_WorkPoint,

    i_bFrameDetect1              := FALSE,
    i_bFrameDetect2              := FALSE,
    i_bFullMaterialDetect1       := FALSE,
    i_bFullMaterialDetect2       := FALSE,

    (* V7.0.0: VAR_IN_OUT轴引用 (ST_ServoAxis V3.0) - 必须在OUTPUT之前 *)
    io_stZAxis                  := GlobalVars.astServoAxis[1],
    io_stX1Axis                 := GlobalVars.astServoAxis[2],

    q_bFrontClamp                => GlobalVars.stPickPlace.o_bFrontClamp_Action,
    q_bRearClamp                 => GlobalVars.stPickPlace.o_bRearClamp_Action,
    q_bFrontClamp2               => GlobalVars.stPickPlace.o_bFrontClamp2_Action,
    q_bRearClamp2                => GlobalVars.stPickPlace.o_bRearClamp2_Action,
    q_bLiftUp                    => GlobalVars.stPickPlace.o_bLift_Up,
    q_bLiftDown                  => GlobalVars.stPickPlace.o_bLift_Down,

    q_iCurrentState              => GlobalVars.stPickPlace.o_iCurrentState,
    q_iCurrentPickLayer         => GlobalVars.stPickPlace.o_iCurrentPickLayer,
    q_iAlarmCode                 => GlobalVars.stPickPlace.o_iStationAlarmCode,
    q_bPlaceDoneToFeeder         => GlobalVars.stPickPlace.o_bPlaceComplete_ToFeeder,
    q_bRunning                   => GlobalVars.stPickPlace.o_bRunning
);

// --- PickPlace后处理: 双电磁阀松开输出 = NOT 夹紧输出 ---
GlobalVars.stPickPlace.o_bFrontClamp_Release  := NOT GlobalVars.stPickPlace.o_bFrontClamp_Action;
GlobalVars.stPickPlace.o_bRearClamp_Release   := NOT GlobalVars.stPickPlace.o_bRearClamp_Action;
GlobalVars.stPickPlace.o_bFrontClamp2_Release := NOT GlobalVars.stPickPlace.o_bFrontClamp2_Action;
GlobalVars.stPickPlace.o_bRearClamp2_Release   := NOT GlobalVars.stPickPlace.o_bRearClamp2_Action;

// ============================================================================
// 第4部分：打胶机送料机构 (FB_1004 V6.0.0, 4步D760状态机)
// ============================================================================
// --- 工站间信号: PickPlace放料完成 → Feeder接收 ---
GlobalVars.stFeeder.i_bPickPlace_FeedComplete := GlobalVars.stPickPlace.o_bPlaceComplete_ToFeeder;

GlobalVars.fbGlueFeeder(
    i_bAutoMode                  := GlobalVars.stFeeder.i_bAutoMode,
    i_bManualMode                := GlobalVars.stFeeder.i_bManualMode,
    i_bStart                     := GlobalVars.stFeeder.i_bStart,
    i_bStop                      := GlobalVars.stFeeder.i_bStop,

    i_bLx_X2JogPos               := GlobalVars.stFeeder.i_bLx_X2Axis_JogFwd,
    i_bLx_X2JogNeg               := GlobalVars.stFeeder.i_bLx_X2Axis_JogRev,

    i_bPlaceDone                 := GlobalVars.stFeeder.i_bPickPlace_FeedComplete,
    i_rX2Speed                   := GlobalVars.stFeeder.i_rFeedSpeed,

    i_bGlueMachineAllowFeed      := GlobalVars.stFeeder.i_bGlueMachine_AllowFeed,
    i_bGlueMachinePickupComplete := GlobalVars.stFeeder.i_bGlueMachine_PickupComplete,

    i_bX2ZoneSensor1             := FALSE,
    i_bX2ZoneSensor2             := FALSE,
    i_bX2ZoneSensor3             := FALSE,
    i_bX2ZoneSensor4             := FALSE,

    q_bX2AxisMoveAbsReq          => GlobalVars.stFeeder.o_bX2Axis_RequestFwd,
    q_bAllowPickup               => GlobalVars.stFeeder.o_bAllowPickup,
    q_bSafetyZoneSignal          => GlobalVars.stFeeder.o_bSafetyZoneSignal,
    q_iCurrentState              => GlobalVars.stFeeder.o_iCurrentState,
    q_iAlarmCode                 => GlobalVars.stFeeder.o_iStationAlarmCode,
    q_bRunning                   => GlobalVars.stFeeder.o_bRunning
);

// ============================================================================
// 第5部分：公共报警管理 (FB_2001 V2.1.0)
// ============================================================================
GlobalVars.fbCommonAlarm(
    i_iConveyorAlarm             := GlobalVars.stConveyor.q_iAlarmCode,
    i_iPickPlaceAlarm            := GlobalVars.stPickPlace.o_iStationAlarmCode,
    i_iFeederAlarm               := GlobalVars.stFeeder.o_iStationAlarmCode,
    i_bReset                     := GlobalVars.stGlobal.i_bReset,

    q_wGlobalAlarmWord           => GlobalVars.stGlobal.o_wGlobalAlarmWord,
    q_iCurrentAlarmCode          => GlobalVars.stGlobal.o_iCurrentAlarmCode,
    q_bAnyAlarmActive            => GlobalVars.stGlobal.o_bAnyAlarmActive,
    q_iMESAlarmCount             => GlobalVars.stGlobal.o_iMESAlarmCount,
    q_iMESAlarmQueue             => GlobalVars.stGlobal.o_iMESAlarmQueue,
    q_bNewAlarmFlag              => GlobalVars.stGlobal.o_bNewAlarmFlag,
    q_iStationAlarmStatus        => GlobalVars.stGlobal.o_iStationAlarmStatus,
    q_bConveyorAlarmActive       => GlobalVars.stGlobal.o_bConveyorAlarmActive,
    q_bPickPlaceAlarmActive      => GlobalVars.stGlobal.o_bPickPlaceAlarmActive,
    q_bFeederAlarmActive         => GlobalVars.stGlobal.o_bFeederAlarmActive
);

END_ORGANIZATION_BLOCK
