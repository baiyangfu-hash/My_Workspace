%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E3F2FD', 'primaryBorderColor': '#1976D2', 'lineColor': '#666', 'fontSize': '14px'}}}%%

flowchart TD

    %% ========== 系统初始化 ==========
    subgraph Init["系统初始化"]
        direction TB
        A3["系统初始化"] --> A4["1. 安全检查"]
        A4 --> A5["2. 轴回原点"]
        A5 --> A6["3. 系统就绪"]
        A6 --> A7["自动运行模式"]
    end

    %% ========== 1. 4层输送机 ==========
    subgraph Conveyor["1. 4层输送机"]
        direction TB
        B8["1. 4层输送机"] --> B9["1.1 检测材料到位"]
        B9 --> B10["1.2 阻挡气缸下降"]
        B10 --> B11["1.3 输送线正转"]
        B11 --> B12["1.4 到位检测"]
        B12 --> B13["1.5 阻挡气缸上升"]
        B13 --> B14["1.6 分料气缸动作"]
        B14 --> B15["1.7 慢速送出"]
        B15 --> B16["1.8 放料完成"]
        B16 --> B17["1.9 通知取放料机构"]
    end

    %% ========== 2. 取放料机构 ==========
    subgraph PickPlace["2. 取放料机构"]
        direction TB
        C18["2. 取放料机构"] --> C19["2.1 检测自身是否闲置"]
        C19 --> C20["2.2 接收输送机通知"]
        C20 --> C21["2.3 取料-升降下降"]
        C21 --> C22["2.4 取料-夹爪夹紧\n（一次两根）"]
        C22 --> C23["2.5 取料-升降上升"]
        C23 --> C24["2.6 移动到送料机构位置"]
        C24 --> C25["2.7 放料-升降下降"]
        C25 --> C26["2.8 放料-夹爪松开"]
        C26 --> C27["2.9 放料-升降上升"]
        C27 --> C28["2.10 取放料完成"]
        C28 --> C29["2.11 重复一次\n（4层取2次）"]
    end

    %% ========== 3. 给打胶机送料机构 ==========
    subgraph Feeder["3. 给打胶机送料机构"]
        direction TB
        D30["3. 给打胶机送料机构"] --> D31["3.1 接收取放料机构\n放置的边框"]
        D31 --> D32["3.2 移动到打胶机\n取料位置"]
        D32 --> D33["3.3 等待打胶机\n允许送料信号"]
        D33 --> D34["3.4 发送允许打胶机\n抓料信号"]
        D34 --> D35["3.5 等待打胶机\n取料完成信号"]
        D35 --> D36["3.6 返回待机位置"]
    end

    %% ========== 安全管理 ==========
    subgraph Safety["安全管理"]
        direction TB
        E37["安全管理"] --> E38["1. 急停检测"]
        E38 --> E39["2. 安全门检测"]
        E39 --> E40["3. 伺服故障检测"]
        E40 --> E41["4. 安全继电器控制"]
    end

    %% ========== 报警管理 ==========
    subgraph Alarm["报警管理"]
        direction TB
        F42["报警管理"] --> F43["1. 故障检测"]
        F43 --> F44["2. 报警触发"]
        F44 --> F45["3. 报警复位"]
    end

    %% ========== 主流程连接 ==========
    A7 --> B8
    B17 -->|通知| C19

    C29 -->|传递边框| D31

    D36 -->|循环| A7

    %% ========== 安全与报警连接 ==========
    A3 -.->|并行监控| E37
    E41 -.-> F42
    F45 -.->|复位后重启| A3

    %% ========== 样式定义 ==========
    classDef initStyle fill:#E3F2FD,stroke:#1976D2,stroke-width:2px,color:#0D47A1
    classDef conveyorStyle fill:#E1F5FE,stroke:#0288D1,stroke-width:2px,color:#01579B
    classDef pickPlaceStyle fill:#E8F5E8,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef feederStyle fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef safetyStyle fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C
    classDef alarmStyle fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C

    class A3,A4,A5,A6,A7 initStyle
    class B8,B9,B10,B11,B12,B13,B14,B15,B16,B17 conveyorStyle
    class C18,C19,C20,C21,C22,C23,C24,C25,C26,C27,C28,C29 pickPlaceStyle
    class D30,D31,D32,D33,D34,D35,D36 feederStyle
    class E37,E38,E39,E40,E41 safetyStyle
    class F42,F43,F44,F45 alarmStyle
