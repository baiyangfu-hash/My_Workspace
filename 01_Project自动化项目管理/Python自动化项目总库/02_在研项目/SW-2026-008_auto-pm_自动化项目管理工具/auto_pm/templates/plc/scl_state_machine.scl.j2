// 遵守规范: Siemens LSP 编程规范 (LSP-905 V1.1.0 / DJ-2026-005 标杆)
// 自动生成: 008 驾驶舱离线工艺矩阵代码生成器
// 生成时间: {{ generated_at }}
// ==============================================================================

FUNCTION_BLOCK "{{ fb_number }}_{{ fb_name }}_{{ station_name }}"
{ S7_Optimized_Block := 'TRUE' }
VERSION : 1.0

VAR_INPUT
    i_bEnable : BOOL; // 模块使能信号
    i_bReset : BOOL; // 故障复位信号
    i_bAutoMode : BOOL; // 自动模式标志
    {% for item in inputs %}
    {{ item.name }} : {{ item.type }}; // {{ item.comment }}
    {% endfor %}
END_VAR

VAR_OUTPUT
    o_bDone : BOOL; // 动作完成标志
    o_bBusy : BOOL; // 正在运行标志
    o_bError : BOOL; // 异常报警标志
    o_iErrorCode : INT; // 错误代码
    {% for item in outputs %}
    {{ item.name }} : {{ item.type }}; // {{ item.comment }}
    {% endfor %}
END_VAR

VAR_IN_OUT
    {% if in_outs %}
    {% for item in in_outs %}
    {{ item.name }} : {{ item.type }}; // {{ item.comment }}
    {% endfor %}
    {% else %}
    io_stStationData : ST_StationData; // 工站全局结构体数据
    {% endif %}
END_VAR

VAR
    s_iCurrentStep : INT := 0; // 当前状态机步序
    s_iNextStep : INT := 0; // 下一步步序
    s_bInitialized : BOOL := FALSE; // 静态初始化完成标志
    fb_tTimeoutTimer : TON; // 状态超时定时器
    {% for item in statics %}
    {{ item.name }} : {{ item.type }}; // {{ item.comment }}
    {% endfor %}
END_VAR

VAR_TEMP
    temp_iLoopIndex : INT;
END_VAR

CONST
    CONST_STATE_READY : INT := 0; // 准备/待命状态
    CONST_STATE_FAULT : INT := 99; // 故障报警状态
END_CONST

BEGIN
    // --------------------------------------------------------------------------
    // 1. 基础复位与使能检查
    // --------------------------------------------------------------------------
    IF i_bReset THEN
        o_bError := FALSE;
        o_iErrorCode := 0;
        s_iCurrentStep := CONST_STATE_READY;
    END_IF;

    IF NOT i_bEnable THEN
        o_bBusy := FALSE;
        o_bDone := FALSE;
        RETURN;
    END_IF;

    // --------------------------------------------------------------------------
    // 2. 核心状态机逻辑 (按工艺矩阵展开)
    // --------------------------------------------------------------------------
    CASE s_iCurrentStep OF
        CONST_STATE_READY: // 0: 待命准备状态
            o_bBusy := FALSE;
            o_bDone := FALSE;
            IF i_bAutoMode THEN
                s_iCurrentStep := 10;
            END_IF;

        {% for step in steps %}
        {{ step.step_id }}: // {{ step.name }}
            o_bBusy := TRUE;
            // 动作控制
            {% for act in step.actions %}
            {{ act }};
            {% endfor %}
            
            // 转移判定
            IF {{ step.trigger }} THEN
                {% if step.interlock %}
                IF {{ step.interlock }} THEN
                    s_iCurrentStep := {{ step.next_step }};
                ELSE
                    o_bError := TRUE;
                    o_iErrorCode := {{ step.step_id }}01; // 联锁违规报警
                    s_iCurrentStep := CONST_STATE_FAULT;
                END_IF;
                {% else %}
                s_iCurrentStep := {{ step.next_step }};
                {% endif %}
            END_IF;

        {% endfor %}

        CONST_STATE_FAULT: // 99: 故障保护状态
            o_bBusy := FALSE;
            o_bError := TRUE;

        ELSE // 安全自愈拦截：防止意外非法步序卡死
            o_bError := TRUE;
            o_iErrorCode := 9999;
            s_iCurrentStep := CONST_STATE_READY;
    END_CASE;

END_FUNCTION_BLOCK
