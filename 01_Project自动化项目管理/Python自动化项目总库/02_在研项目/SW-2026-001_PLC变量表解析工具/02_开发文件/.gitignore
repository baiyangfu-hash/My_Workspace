# Python项目通用忽略规则

# 编译生成的文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
env/
.env/

# 编辑器配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
Thumbs.db
.DS_Store

# 测试生成的文件
*.pytest_cache/
test-results/

# 日志文件
*.log

# 临时文件
temp/
tmp/

# 构建文件
build/
dist/
*.egg-info/

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
