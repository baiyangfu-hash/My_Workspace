# Python项目管理工具 - 环境变量配置
# 复制此文件为 .env 并修改配置

# ==================== 应用配置 ====================
APP_NAME=Python项目管理工具
APP_VERSION=1.1.0
DEBUG_MODE=false

# ==================== 安全配置（必填） ====================
# API密钥 - 生产环境必须修改！
# 可以使用以下命令生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your-secret-key-here-change-in-production

# JWT Token过期时间（小时）
API_TOKEN_EXPIRE_HOURS=24

# bcrypt密码加密轮数（默认12，越大越安全但越慢）
BCRYPT_ROUNDS=12

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///data/project_manager.db
DATABASE_ECHO=false

# MySQL配置（如果使用MySQL）
# DATABASE_TYPE=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=your-db-password
# DATABASE_NAME=project_manager

# ==================== API配置 ====================
API_HOST=127.0.0.1
API_PORT=5000
API_CORS_ENABLED=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==================== 用户配置（开发环境） ====================
# 格式：用户名=加密后的密码:角色
# 密码可以使用以下命令加密：
# python -c "from src.utils.security import hash_password; print(hash_password('your_password'))"
# 生产环境建议使用数据库管理用户

# 管理员用户（默认密码：admin123）
# USER_ADMIN=<bcrypt_hash>:admin

# 普通用户（默认密码：user123）
# USER_USER=<bcrypt_hash>:user
