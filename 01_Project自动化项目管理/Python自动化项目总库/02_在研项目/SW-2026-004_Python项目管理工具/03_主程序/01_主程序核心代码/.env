# Python项目管理工具 - 环境变量配置
# 注意：此文件包含敏感信息，请勿提交到版本控制！

# ==================== 应用配置 ====================
APP_NAME=Python项目管理工具
APP_VERSION=1.1.0
DEBUG_MODE=false

# ==================== 安全配置 ====================
# API密钥 - 请修改为随机生成的密钥
API_SECRET_KEY=pm-dev-secret-key-change-in-production-2024

# JWT Token过期时间（小时）
API_TOKEN_EXPIRE_HOURS=24

# bcrypt密码加密轮数
BCRYPT_ROUNDS=12

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///data/project_manager.db
DATABASE_ECHO=false

# ==================== API配置 ====================
API_HOST=127.0.0.1
API_PORT=5000
API_CORS_ENABLED=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
