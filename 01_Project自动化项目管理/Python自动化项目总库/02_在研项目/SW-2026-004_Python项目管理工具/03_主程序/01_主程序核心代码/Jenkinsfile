pipeline {
    agent any
    
    triggers {
        cron('H 2 * * *')  // 每天凌晨2点执行
    }
    
    environment {
        PYTHON_VERSION = '3.10'
        TEST_MODE = 'full'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Setup Environment') {
            steps {
                bat '''
                    python -m pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }
        
        stage('Run Tests') {
            steps {
                bat 'py run_full_test_suite.py --mode=%TEST_MODE% --notify'
            }
        }
        
        stage('Generate Reports') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'data/test_reports',
                    reportFiles: '*.md',
                    reportName: 'Test Reports'
                ])
            }
        }
        
        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'data/test_reports/**/*', 
                               fingerprint: true,
                               allowEmptyArchive: true
            }
        }
    }
    
    post {
        always {
            // 发送通知
            script {
                if (fileExists('data/test_reports/notification.txt')) {
                    def notification = readFile('data/test_reports/notification.txt')
                    echo notification
                    
                    // 如果测试失败，发送邮件通知
                    if (currentBuild.result == 'FAILURE') {
                        mail to: '${DEFAULT_RECIPIENTS}',
                             subject: "测试失败: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
                             body: notification
                    }
                }
            }
        }
        
        success {
            echo '所有测试通过！'
        }
        
        failure {
            echo '部分测试失败，请查看详细报告'
        }
    }
}