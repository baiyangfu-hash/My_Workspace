/* ============================================================
 * SW-2026-005 PLC项目管理工具 - Material Design 深色主题
 * ============================================================
 *
 * 色彩体系 (Dark Mode)
 * - 主色 (Primary):     #90CAF9 (Blue 200)
 * - 强调色 (Accent):    #FF8A65 (Deep Orange 300)
 * - 成功色 (Success):   #81C784 (Green 300)
 * - 警告色 (Warning):   #FFF176 (Yellow 200)
 * - 错误色 (Error):     #EF5350 (Red 400)
 * - 背景色 (Background): #121212 (Grey 900)
 * - 卡片背景:           #1E1E1E (Grey 800)
 * - 表面背景:           #2D2D2D (Grey 700)
 * - 主文本色:           #E0E0E0 (Grey 300)
 * - 次要文本色:         #9E9E9E (Grey 500)
 * - 边框/分割线:        #333333 (Grey 600)
 * ============================================================ */


/* ===== 全局基础 ===== */
* {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    outline: none;
}

QWidget {
    color: #E0E0E0;
}

QMainWindow {
    background-color: #121212;
}


/* ===== 标签页 QTabWidget ===== */
QTabWidget::pane {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 10px;
    margin: 6px;
    padding-top: 4px;
}

QTabBar::tab {
    background-color: transparent;
    color: #9E9E9E;
    padding: 10px 22px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 10pt;
    font-weight: 500;
    min-width: 80px;
    min-height: 32px;
}

QTabBar::tab:hover {
    background-color: #2D2D2D;
    color: #90CAF9;
}

QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #90CAF9;
    border-bottom: 3px solid #64B5F6;
    font-weight: bold;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}


/* ===== 工具箱 QToolBox ===== */
QToolBox {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 4px;
}

QToolBox::tab {
    background-color: #2D2D2D;
    color: #BDBDBD;
    padding: 14px 16px;
    font-size: 10pt;
    font-weight: bold;
    border-bottom: 1px solid #333333;
}

QToolBox::tab:selected {
    background-color: #1A237E30;
    color: #90CAF9;
    border-left: 4px solid #64B5F6;
}

QToolBox::tab:hover:!selected {
    background-color: #383838;
}


/* ===== 按钮 QPushButton ===== */
QPushButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-size: 9pt;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1976D2;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

QPushButton:disabled {
    background-color: #424242;
    color: #616161;
}

QPushButton[secondary="true"] {
    background-color: transparent;
    color: #90CAF9;
    border: 1px solid #64B5F6;
}

QPushButton[secondary="true"]:hover {
    background-color: #1A237E30;
}

QPushButton[danger="true"] {
    background-color: #C62828;
}

QPushButton[danger="true"]::hover {
    background-color: #D32F2F;
}


/* ===== 输入框 ===== */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #2D2D2D;
    border: 1.5px solid #424242;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 10pt;
    selection-background-color: #1A237E80;
    selection-color: #90CAF9;
    color: #E0E0E0;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #64B5F6;
    border-width: 2px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #555555;
}

QLineEdit:read-only {
    background-color: #212121;
    color: #757575;
}


/* ===== 下拉框 QComboBox ===== */
QComboBox {
    background-color: #2D2D2D;
    border: 1.5px solid #424242;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 10pt;
    min-height: 28px;
    color: #E0E0E0;
}

QComboBox:focus {
    border-color: #64B5F6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #9E9E9E;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    border: 1px solid #424242;
    border-radius: 6px;
    selection-background-color: #1A237E60;
    selection-color: #90CAF9;
    color: #E0E0E0;
}


/* ===== 表格 ===== */
QTableWidget,
QTableView {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
    gridline-color: #2D2D2D;
    alternate-background-color: #252525;
    font-size: 9pt;
}

QTableWidget::item,
QTableView::item {
    padding: 8px 6px;
    color: #E0E0E0;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #1A237E60;
    color: #90CAF9;
}

QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #252525;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #BDBDBD;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #424242;
    font-weight: bold;
    font-size: 9pt;
}

QHeaderView::section:hover {
    background-color: #383838;
}


/* ===== 树形视图 ===== */
QTreeWidget {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
    font-size: 9pt;
}

QTreeWidget::item {
    padding: 5px 4px;
    color: #E0E0E0;
}

QTreeWidget::item:selected {
    background-color: #1A237E60;
    color: #90CAF9;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #2D2D2D;
}


/* ===== 列表 ===== */
QListWidget {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
    font-size: 9pt;
}

QListWidget::item:selected {
    background-color: #1A237E60;
    color: #90CAF9;
}

QListWidget::item:hover {
    background-color: #2D2D2D;
}


/* ===== 菜单栏 ===== */
QMenuBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
    padding: 2px 0;
    font-size: 10pt;
}

QMenuBar::item {
    padding: 8px 16px;
    color: #BDBDBD;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #1A237E40;
    color: #90CAF9;
}

QMenu {
    background-color: #2D2D2D;
    border: 1px solid #424242;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu::item {
    padding: 8px 28px;
    color: #BDBDBD;
    font-size: 9pt;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1A237E60;
    color: #90CAF9;
}

QMenu::separator {
    height: 1px;
    background-color: #424242;
    margin: 4px 12px;
}


/* ===== 工具栏 ===== */
QToolBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
    padding: 6px 10px;
    spacing: 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    color: #BDBDBD;
}

QToolBar QToolButton:hover {
    background-color: #1A237E40;
    color: #90CAF9;
}

QToolBar separator {
    width: 1px;
    background-color: #424242;
    margin: 4px 6px;
}


/* ===== 状态栏 ===== */
QStatusBar {
    background-color: #1E1E1E;
    border-top: 1px solid #333333;
    padding: 5px 16px;
    font-size: 9pt;
    color: #757575;
}

QStatusLabel { border: none; }


/* ===== 滚动条 ===== */
QScrollBar:vertical {
    width: 10px;
    background-color: #1E1E1E;
    border: none;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 5px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #757575;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background-color: transparent; }

QScrollBar:horizontal {
    height: 10px;
    background-color: #1E1E1E;
    border: none;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 5px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #757575;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }


/* ===== 分割器 ===== */
QSplitter::handle {
    background-color: #333333;
}

QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QSplitter::handle:hover { background-color: #64B5F6; }


/* ===== 对话框 ===== */
QDialog { background-color: #1E1E1E; }


/* ===== 分组框 ===== */
QGroupBox {
    font-weight: bold;
    border: 1px solid #333333;
    border-radius: 8px;
    margin-top: 12px;
    padding: 20px 12px 12px 12px;
    background-color: #222222;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #64B5F6;
    font-size: 10pt;
}


/* ===== 复选框/单选框 ===== */
QCheckBox, QRadioButton { spacing: 8px; font-size: 10pt; }

QCheckBox::indicator,
QRadioButton::indicator { width: 18px; height: 18px; }

QCheckBox::indicator:unchecked {
    border: 2px solid #555555;
    border-radius: 4px;
    background-color: #2D2D2D;
}

QCheckBox::indicator:checked {
    border: 2px solid #64B5F6;
    border-radius: 4px;
    background-color: #1565C0;
}

QCheckBox::indicator:unchecked:hover { border-color: #64B5F6; }

QRadioButton::indicator:unchecked {
    border: 2px solid #555555;
    border-radius: 9px;
    background-color: #2D2D2D;
}

QRadioButton::indicator:checked {
    border: 2px solid #64B5F6;
    border-radius: 9px;
    background-color: #2D2D2D;
}


/* ===== 进度条 ===== */
QProgressBar {
    background-color: #333333;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    font-size: 8pt;
}

QProgressBar::chunk {
    background-color: #64B5F6;
    border-radius: 4px;
}


/* ===== 工具提示 ===== */
QToolTip {
    background-color: #424242;
    color: #E0E0E0;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 9pt;
}


/* ===== 消息框 ===== */
QMessageBox { background-color: #1E1E1E; }
QMessageBox QLabel { font-size: 10pt; padding: 8px; color: #E0E0E0; }
