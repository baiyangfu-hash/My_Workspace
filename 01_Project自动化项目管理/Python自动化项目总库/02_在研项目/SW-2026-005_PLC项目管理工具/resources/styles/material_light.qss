/* ============================================================
 * SW-2026-005 PLC项目管理工具 - Material Design 浅色主题
 * ============================================================
 *
 * 色彩体系 (基于Material Design 3)
 * - 主色 (Primary):     #1976D2 (Blue 700)
 * - 强调色 (Accent):    #FF5722 (Deep Orange)
 * - 成功色 (Success):   #4CAF50 (Green)
 * - 警告色 (Warning):   #FFC107 (Amber)
 * - 错误色 (Error):     #F44336 (Red)
 * - 背景色 (Background): #FAFAFA (Grey 50)
 * - 卡片背景:           #FFFFFF (White)
 * - 主文本色:           #212121 (Grey 900)
 * - 次要文本色:         #757575 (Grey 600)
 * - 边框/分割线:        #E0E0E0 (Grey 300)
 *
 * 圆角规范: border-radius: 4px (按钮) / 8px (卡片/面板)
 * 阴影效果: 微妙box-shadow用于卡片悬浮
 * 字体: Microsoft YaHei (中文), Segoe UI (英文)
 * ============================================================ */


/* ===== 全局基础 ===== */
QWidget {
    outline: none;
}

QWidget {
    color: #212121;
}

QMainWindow {
    background-color: #F5F5F5;
}


/* ===== 标签页 QTabWidget ===== */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    margin: 6px;
    padding-top: 4px;
}

QTabBar::tab {
    background-color: transparent;
    color: #757575;
    padding: 10px 22px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 10pt;
    font-weight: 500;
    min-width: 80px;
    min-height: 32px;
}

QTabBar::tab:hover {
    background-color: #E3F2FD;
    color: #1976D2;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1976D2;
    border-bottom: 3px solid #1976D2;
    font-weight: bold;
}

QTabBar::tab:!selected {
    margin-top: 3px; /* 未选中标签略下移 */
}


/* ===== 工具箱 QToolBox ===== */
QToolBox {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    padding: 4px;
}

QToolBox::tab {
    background-color: #F5F5F5;
    color: #424242;
    padding: 14px 16px;
    font-size: 10pt;
    font-weight: bold;
    border-bottom: 1px solid #EEEEEE;
}

QToolBox::tab:selected {
    background-color: #E3F2FD;
    color: #1976D2;
    border-left: 4px solid #1976D2;
}

QToolBox::tab:hover:!selected {
    background-color: #EEEEEE;
}


/* ===== 按钮 QPushButton ===== */
QPushButton {
    background-color: #1976D2;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-size: 9pt;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1565C0;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

QPushButton:disabled {
    background-color: #BDBDBD;
    color: #9E9E9E;
}

QPushButton:default {
    background-color: #1976D2;
}

/* 次要按钮风格 (通过objectName区分或flat属性) */
QPushButton[secondary="true"] {
    background-color: #FFFFFF;
    color: #1976D2;
    border: 1px solid #1976D2;
}

QPushButton[secondary="true"]:hover {
    background-color: #E3F2FD;
}

/* 危险操作按钮 */
QPushButton[danger="true"] {
    background-color: #F44336;
}

QPushButton[danger="true"]:hover {
    background-color: #D32F2F;
}


/* ===== 输入框 QLineEdit / QTextEdit / QPlainTextEdit ===== */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 10pt;
    selection-background-color: #BBDEFB;
    selection-color: #0D47A1;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #1976D2;
    border-width: 2px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #BDBDBD;
}

QLineEdit:read-only {
    background-color: #F5F5F5;
    color: #616161;
}


/* ===== 下拉框 QComboBox ===== */
QComboBox {
    background-color: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 10pt;
    min-height: 28px;
}

QComboBox:focus {
    border-color: #1976D2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #757575;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    selection-background-color: #E3F2FD;
    selection-color: #1976D2;
    outline: none;
}


/* ===== 表格 QTableWidget / QTableView ===== */
QTableWidget,
QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    gridline-color: #F5F5F5;
    alternate-background-color: #FAFAFA;
    font-size: 9pt;
}

QTableWidget::item,
QTableView::item {
    padding: 8px 6px;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #E3F2FD;
    color: #0D47A1;
}

/* 斑马纹效果 */
QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #FAFAFA;

}

QHeaderView::section {
    background-color: #F5F5F5;
    color: #424242;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    font-weight: bold;
    font-size: 9pt;
}

QHeaderView::section:hover {
    background-color: #EEEEEE;
}


/* ===== 树形视图 QTreeWidget ===== */
QTreeWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    show-decoration-selected: 1;
    font-size: 9pt;
}

QTreeWidget::item {
    padding: 5px 4px;
}

QTreeWidget::item:selected {
    background-color: #E3F2FD;
    color: #0D47A1;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #F5F5F5;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:!has-siblings {
    image: none;
    border-image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: none;
    border-image: none;
}


/* ===== 列表 QListWidget ===== */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    font-size: 9pt;
    outline: none;
}

QListWidget::item:selected {
    background-color: #E3F2FD;
    color: #0D47A1;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #F5F5F5;
}


/* ===== 菜单栏 QMenuBar ===== */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 2px 0;
    font-size: 10pt;
}

QMenuBar::item {
    padding: 8px 16px;
    color: #424242;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #E3F2FD;
    color: #1976D2;
}

/* 下拉菜单 QMenu */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu::item {
    padding: 8px 28px;
    color: #424242;
    font-size: 9pt;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E3F2FD;
    color: #0D47A1;
}

QMenu::separator {
    height: 1px;
    background-color: #EEEEEE;
    margin: 4px 12px;
}


/* ===== 工具栏 QToolBar ===== */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 6px 10px;
    spacing: 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    color: #424242;
}

QToolBar QToolButton:hover {
    background-color: #E3F2FD;
    color: #1976D2;
}

QToolBar QToolButton:pressed {
    background-color: #BBDEFB;
}

QToolBar separator {
    width: 1px;
    background-color: #E0E0E0;
    margin: 4px 6px;
}


/* ===== 状态栏 QStatusBar ===== */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E0E0E0;
    padding: 5px 16px;
    font-size: 9pt;
    color: #757575;
}

QStatusBar::item { border: none; }

QStatusBar QLabel {
    padding: 0 8px;
}


/* ===== 滚动条 QScrollBar ===== */

/* 垂直滚动条 */
QScrollBar:vertical {
    width: 10px;
    background-color: #F5F5F5;
    border: none;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #BDBDBD;
    border-radius: 5px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9E9E9E;
}

QScrollBar::handle:vertical:pressed {
    background-color: #757575;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    height: 10px;
    background-color: #F5F5F5;
    border: none;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #BDBDBD;
    border-radius: 5px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9E9E9E;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}


/* ===== 分割器 QSplitter ===== */
QSplitter::handle {
    background-color: #E0E0E0;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #1976D2;
}


/* ===== 对话框 QDialog ===== */
QDialog {
    background-color: #FFFFFF;
}


/* ===== 分组框 QGroupBox ===== */
QGroupBox {
    font-weight: bold;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 20px 12px 12px 12px;
    background-color: #FAFAFA;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #1976D2;
    font-size: 10pt;
}


/* ===== 复选框 QCheckBox / 单选框 QRadioButton ===== */
QCheckBox,
QRadioButton {
    spacing: 8px;
    font-size: 10pt;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #BDBDBD;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    border: 2px solid #1976D2;
    border-radius: 4px;
    background-color: #1976D2;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #1976D2;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #BDBDBD;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    border: 2px solid #1976D2;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #1976D2;
}


/* ===== 进度条 QProgressBar ===== */
QProgressBar {
    background-color: #E0E0E0;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    font-size: 8pt;
}

QProgressBar::chunk {
    background-color: #1976D2;
    border-radius: 4px;
}

QProgressBar[error="true"]::chunk {
    background-color: #F44336;
}


/* ===== 消息提示框 QMessageBox 特殊处理 ===== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    font-size: 10pt;
    padding: 8px;
}


/* ===== 工具提示 QToolTip ===== */
QToolTip {
    background-color: #424242;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 9pt;
}


/* ===== 占位符/空状态提示 ===== */
QLabel[emptyState="true"] {
    color: #9E9E9E;
    font-style: italic;
}


/* ===== 侧边栏专用样式 ===== */
QPushButton[SidebarBtn="true"] {
    text-align: left;
    padding: 8px 12px;
    border: none;
    border-radius: 4px;
    background-color: transparent;
    color: #424242;
    font-size: 9pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QPushButton[SidebarBtn="true"]:hover {
    background-color: #E3F2FD;
    color: #1976D2;
}

QLabel[SidebarHeader="true"] {
    font-size: 11pt;
    font-weight: bold;
    color: #424242;
    padding: 4px 0;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}


/* ===== 仪表盘统计卡片 ===== */
QFrame[StatCard="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 12px;
}

QFrame[StatCard="true"]:hover {
    border-color: #1976D2;
}


/* ===== 快捷操作按钮 ===== */
QPushButton[QuickAction="true"] {
    background-color: #FFFFFF;
    color: #424242;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    font-size: 10pt;
    text-align: left;
    padding-left: 12px;
    min-height: 48px;
}

QPushButton[QuickAction="true"]:hover {
    background-color: #E3F2FD;
    border-color: #1976D2;
    color: #1976D2;
}


/* ===== Dashboard 专用 ===== */
QLabel[dashboardTitle="true"] {
    font-size: 18pt;
    font-weight: bold;
    color: #212121;
}

QLabel[sectionTitle="true"] {
    font-size: 12pt;
    font-weight: bold;
    color: #424242;
}

QLabel[welcomeText="true"] {
    font-size: 11pt;
    color: #757575;
}

/* StatCard 内部标签 */
QLabel[statCardTitle="true"] {
    font-size: 10pt;
    color: #757575;
}

QFrame[StatCard="true"] QLabel[valueLabel="true"] {
    font-size: 22pt;
    font-weight: bold;
}

/* 最近项目列表项 */
QLabel[recentProjectItem="true"] {
    font-size: 10pt;
    color: #424242;
}

/* 面板标题 */
QLabel[panelTitle="true"] {
    color: #212121;
}

/* ProjectTree 标题和状态 */
QLabel[treeHeader="true"] {
    font-size: 10pt;
    font-weight: bold;
    color: #1976D2;
}

QLabel[treeStatus="true"] {
    font-size: 9pt;
    color: #9E9E9E;
}
