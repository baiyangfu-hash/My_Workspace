QMainWindow {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
}

/* ============================================================
   Title Bar (FramelessWindow)
   ============================================================ */
QWidget#TitleBar {
    background-color: #151515;
    border-bottom: 1px solid #3E3E42;
    min-height: 32px;
    max-height: 32px;
}

QLabel#TitleBarIcon {
    color: #E86100;
    font-size: 14px;
    background: transparent;
}

QLabel#TitleBarTitle {
    color: #999999;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QPushButton[TitleBarBtn="true"] {
    background: transparent;
    border: none;
    color: #999999;
    font-size: 12px;
    min-width: 46px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 0;
    padding: 0;
}
QPushButton[TitleBarBtn="true"]:hover {
    background-color: #2A2D2E;
    color: #CCCCCC;
}
QPushButton[TitleBarBtn="true"][CloseBtn="true"]:hover {
    background-color: #F44747;
    color: #FFFFFF;
}

QWidget {
    color: #D4D4D4;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    outline: none;
}

QFrame {
    border: none;
}

QFrame[StatCard="true"] {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 12px;
}

QFrame[StatCard="true"]:hover {
    border-color: #E86100;
}

QFrame[StatCardIcon="orange"] {
    background: rgba(232,97,0,0.15);
    color: #E86100;
    border-radius: 4px;
}

QFrame[StatCardIcon="blue"] {
    background: rgba(79,193,255,0.15);
    color: #4FC1FF;
    border-radius: 4px;
}

QFrame[StatCardIcon="green"] {
    background: rgba(78,201,176,0.15);
    color: #4EC9B0;
    border-radius: 4px;
}

QFrame[StatCardIcon="yellow"] {
    background: rgba(204,167,0,0.15);
    color: #CCA700;
    border-radius: 4px;
}

QFrame[IndustrialPanel="true"] {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px;
}

QFrame[IndustrialGroup="true"] {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 2px;
    padding: 8px;
}

QFrame[IndustrialSeparator="true"] {
    background-color: #555555;
    max-height: 1px;
    margin: 4px 0;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #555555;
    border-radius: 2px;
    margin-top: 14px;
    padding: 18px 10px 10px 10px;
    background-color: #2D2D30;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #4FC3F7;
    font-size: 10pt;
}

QGroupBox[IndustrialGroup="true"] {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 2px;
    margin-top: 14px;
    padding: 18px 10px 10px 10px;
}

QGroupBox[IndustrialGroup="true"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #4FC3F7;
    font-size: 10pt;
}

QLabel {
    color: #D4D4D4;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QLabel[panelTitle="true"] {
    color: #E0E0E0;
    font-size: 11pt;
    font-weight: bold;
}

QLabel[sectionTitle="true"] {
    color: #4FC3F7;
    font-size: 12pt;
    font-weight: bold;
}

QLabel[dashboardTitle="true"] {
    color: #E0E0E0;
    font-size: 18pt;
    font-weight: bold;
}

QLabel[DashboardHeroTitle="true"] {
    color: #E0E0E0;
    font-size: 26pt;
    font-weight: 300;
}

QLabel[DashboardHeroSubtitle="true"] {
    color: #999999;
    font-size: 12pt;
}

QLabel[welcomeText="true"] {
    color: #9E9E9E;
    font-size: 11pt;
}

QLabel[statCardTitle="true"] {
    color: #9E9E9E;
    font-size: 9pt;
    font-weight: bold;
}

QFrame[StatCard="true"] QLabel[valueLabel="true"] {
    color: #FF8C00;
    font-size: 22pt;
    font-weight: bold;
    font-family: Consolas, "Courier New", monospace;
}

QLabel[SidebarHeader="true"] {
    color: #FF8C00;
    font-size: 11pt;
    font-weight: bold;
    padding: 6px 4px;
    border-bottom: 2px solid #FF8C00;
    margin-bottom: 4px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QLabel[recentProjectItem="true"] {
    color: #D4D4D4;
    font-size: 10pt;
}

QLabel[SectionTitle="true"] {
    color: #4FC3F7;
    font-size: 12pt;
    font-weight: bold;
}

QWidget[RecentProjectItem="true"] {
    background-color: transparent;
    border-radius: 4px;
}

QWidget[RecentProjectItem="true"]:hover {
    background-color: #2D2D30;
}

QLabel[RecentName="true"] {
    color: #E0E0E0;
    font-size: 11pt;
}

QLabel[RecentPath="true"] {
    color: #888888;
    font-size: 9pt;
}

QLabel[ViewAllLink="true"] {
    color: #4FC3F7;
    font-size: 10pt;
}

QLabel[EmptyState="true"] {
    color: #666666;
    font-style: italic;
}

QLabel[treeHeader="true"] {
    color: #4FC3F7;
    font-size: 10pt;
    font-weight: bold;
}

QLabel[treeStatus="true"] {
    color: #9E9E9E;
    font-size: 9pt;
}

QLabel[emptyState="true"] {
    color: #666666;
    font-style: italic;
}

QLabel[LedIndicator="true"] {
    background-color: #66BB6A;
    border: 1px solid #888888;
    border-radius: 6px;
    min-width: 12px;
    min-height: 12px;
    max-width: 12px;
    max-height: 12px;
}

QLabel[Badge="true"] {
    background: #E86100;
    color: #fff;
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 10px;
}

QLabel[BadgeTrae="true"] {
    background: rgba(79,193,255,0.2);
    color: #4FC1FF;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 9px;
}

QLabel[BadgeHybrid="true"] {
    background: rgba(204,112,0,0.2);
    color: #CC7000;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 9px;
}

QLabel[DevBadge="true"] {
    background: rgba(153,153,153,0.15);
    color: #999;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 9px;
}

QLabel[StatusBadge="draft"] {
    background: rgba(153,153,153,0.2);
    color: #999;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
}

QLabel[StatusBadge="in-progress"] {
    background: rgba(79,193,255,0.2);
    color: #4FC1FF;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
}

QLabel[StatusBadge="approved"] {
    background: rgba(78,201,176,0.2);
    color: #4EC9B0;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
}

QLabel[StatusBadge="rejected"] {
    background: rgba(244,71,71,0.2);
    color: #F44747;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
}

QPushButton {
    background-color: #3E3E42;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 2px;
    padding: 8px 20px;
    font-size: 10pt;
    font-weight: 500;
    min-height: 32px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QPushButton:hover {
    background-color: #4E4E52;
    border-color: #666666;
}

QPushButton:pressed {
    background-color: #2D2D30;
    border-color: #4FC3F7;
}

QPushButton:disabled {
    background-color: #2D2D30;
    color: #555555;
    border-color: #3E3E42;
}

QPushButton[SidebarBtn="true"] {
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    background-color: transparent;
    color: #D4D4D4;
    font-size: 10pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QPushButton[SidebarBtn="true"]:hover {
    background-color: #2D2D30;
    color: #FF8C00;
    border-left: 3px solid #FF8C00;
}

QPushButton[SidebarBtn="true"]:checked {
    background-color: #2D2D30;
    color: #FF8C00;
    border-left: 3px solid #FF8C00;
}

QPushButton[SidebarBtn="true"]:pressed {
    background-color: #1A1A1A;
    color: #FFA033;
    border-left: 3px solid #FFA033;
}

QPushButton[SidebarBtnActive="true"] {
    background-color: #2D2D30;
    color: #FF8C00;
    border-left: 3px solid #FF8C00;
    font-weight: bold;
}

QPushButton[SidebarBtnActive="true"]:hover {
    background-color: #383838;
    color: #FFA033;
    border-left: 3px solid #FFA033;
}

QPushButton[ActiveActivity="true"] {
    border-left: 2px solid #E86100;
    color: #E86100;
    background-color: #1A1A1A;
}

QWidget[IndustrialSidebar="true"] {
    background-color: #1A1A1A;
    border-right: 2px solid #0D0D0D;
}

QPushButton[SidebarSectionHeader="true"] {
    text-align: left;
    padding: 7px 14px;
    border: none;
    border-bottom: 1px solid #333333;
    border-radius: 0px;
    background-color: #1A1A1A;
    color: #999999;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    min-height: 36px;
}

QPushButton[SidebarSectionHeader="true"]:hover {
    background-color: #252525;
    color: #CCC;
}

QWidget[SidebarSectionContent="true"] {
    background-color: #1A1A1A;
    border: none;
}

QPushButton[QuickAction="true"] {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 2px;
    font-size: 10pt;
    text-align: left;
    padding-left: 12px;
    min-height: 40px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QPushButton[QuickAction="true"]:hover {
    background-color: #3E3E42;
    border-color: #4FC3F7;
    color: #4FC3F7;
}

QPushButton[QuickActionBtn="true"] {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    font-size: 10pt;
    padding: 6px 16px;
    min-height: 36px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QPushButton[QuickActionBtn="true"]:hover {
    background-color: #3E3E42;
    border-color: #FF8C00;
    color: #FF8C00;
}

QPushButton[PrimaryBtn="true"] {
    background-color: #FF8C00;
    color: #1E1E1E;
    border: 1px solid #FF8C00;
    font-weight: bold;
}

QPushButton[PrimaryBtn="true"]:hover {
    background-color: #FFA033;
    border-color: #FFA033;
}

QPushButton[PrimaryBtn="true"]:pressed {
    background-color: #CC7000;
    border-color: #CC7000;
}

QPushButton[DangerBtn="true"] {
    background-color: #EF5350;
    color: #FFFFFF;
    border: 1px solid #EF5350;
    font-weight: bold;
}

QPushButton[DangerBtn="true"]:hover {
    background-color: #F44336;
    border-color: #F44336;
}

QPushButton[DangerBtn="true"]:pressed {
    background-color: #C62828;
    border-color: #C62828;
}

QPushButton[SuccessBtn="true"] {
    background-color: #66BB6A;
    color: #1E1E1E;
    border: 1px solid #66BB6A;
    font-weight: bold;
}

QPushButton[SuccessBtn="true"]:hover {
    background-color: #81C784;
    border-color: #81C784;
}

QPushButton[SuccessBtn="true"]:pressed {
    background-color: #4CAF50;
    border-color: #4CAF50;
}

QPushButton[WarningBtn="true"] {
    background-color: #FF8C00;
    color: #1E1E1E;
    border: 1px solid #FF8C00;
    font-weight: bold;
}

QPushButton[WarningBtn="true"]:hover {
    background-color: #FFA033;
    border-color: #FFA033;
}

QPushButton[WarningBtn="true"]:pressed {
    background-color: #CC7000;
    border-color: #CC7000;
}

QPushButton[ToolBtn="true"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 4px 8px;
    color: #D4D4D4;
    font-size: 9pt;
}

QPushButton[ToolBtn="true"]:hover {
    background-color: #3E3E42;
    border-color: #555555;
    color: #4FC3F7;
}

QPushButton[ToolBtn="true"]:pressed {
    background-color: #2D2D30;
    border-color: #4FC3F7;
}

QToolBox {
    background-color: #1A1A1A;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 0px;
}

QToolBox::tab {
    background-color: #1A1A1A;
    color: #9E9E9E;
    padding: 10px 14px;
    font-size: 10pt;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #333333;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QToolBox::tab:selected {
    background-color: #1A1A1A;
    color: #FF8C00;
    border-left: 3px solid #FF8C00;
    border-bottom: 1px solid #333333;
}

QToolBox::tab:hover:!selected {
    background-color: #222222;
    color: #D4D4D4;
}

QTabWidget::pane {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 0px;
    margin: 0px;
    padding-top: 2px;
}

QTabBar::tab {
    background-color: #2D2D30;
    color: #6A6A6A;
    padding: 10px 22px;
    margin-right: 0px;
    border: 1px solid #555555;
    border-bottom: none;
    border-top: none;
    font-size: 10pt;
    font-weight: 500;
    min-width: 80px;
    min-height: 34px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QTabBar::tab:hover {
    background-color: #2D2D30;
    color: #4FC3F7;
}

QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border-bottom: 2px solid #E86100;
    border-top: none;
    font-weight: bold;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTableWidget,
QTableView {
    background-color: #1E1E1E;
    alternate-background-color: #252527;
    border: 1px solid #555555;
    border-radius: 0px;
    gridline-color: #3E3E42;
    font-size: 10pt;
    font-family: Consolas, "Courier New", monospace;
    selection-background-color: #3E3E42;
    selection-color: #FF8C00;
}

QTableWidget::item,
QTableView::item {
    padding: 8px 10px;
    color: #D4D4D4;
    border-bottom: 1px solid #3E3E42;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #3E3E42;
    color: #FF8C00;
}

QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #252527;
}

QHeaderView::section {
    background-color: #2D2D30;
    color: #9E9E9E;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #FF8C00;
    border-right: 1px solid #3E3E42;
    font-weight: bold;
    font-size: 10pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QHeaderView::section:hover {
    background-color: #3E3E42;
    color: #E0E0E0;
}

QTreeWidget {
    background-color: #1E1E1E;
    border: 1px solid #555555;
    border-radius: 0px;
    show-decoration-selected: 1;
    font-size: 10pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    alternate-background-color: #252527;
}

QTreeWidget::item {
    padding: 6px 6px;
    color: #D4D4D4;
    border-bottom: 1px solid #333333;
}

QTreeWidget::item:selected {
    background-color: #3E3E42;
    color: #FF8C00;
    border-radius: 0px;
}

QTreeWidget::item:hover {
    background-color: #2D2D30;
    color: #E0E0E0;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:!has-siblings {
    image: none;
    border-image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTextEdit,
QPlainTextEdit {
    background-color: #1E1E1E;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 8px 10px;
    font-size: 11pt;
    font-family: Consolas, "Courier New", monospace;
    selection-background-color: #3E3E42;
    selection-color: #FF8C00;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #4FC3F7;
}

QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #666666;
}

QTextBrowser {
    background-color: #1E1E1E;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 6px 8px;
    font-size: 10pt;
    font-family: Consolas, "Courier New", monospace;
}

QLineEdit {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 8px 12px;
    font-size: 11pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    selection-background-color: #3E3E42;
    selection-color: #FF8C00;
}

QLineEdit:focus {
    border-color: #4FC3F7;
}

QLineEdit:hover {
    border-color: #666666;
}

QLineEdit:read-only {
    background-color: #252527;
    color: #666666;
}

QComboBox {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 8px 12px;
    font-size: 11pt;
    min-height: 28px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QComboBox:focus {
    border-color: #4FC3F7;
}

QComboBox:hover {
    border-color: #666666;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #555555;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9E9E9E;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 0px;
    selection-background-color: #3E3E42;
    selection-color: #FF8C00;
    color: #D4D4D4;
    outline: none;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    font-size: 11pt;
    color: #D4D4D4;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #666666;
    border-radius: 2px;
    background-color: #2D2D30;
}

QCheckBox::indicator:checked {
    border: 1px solid #4FC3F7;
    border-radius: 2px;
    background-color: #4FC3F7;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #4FC3F7;
}

QRadioButton::indicator:unchecked {
    border: 1px solid #666666;
    border-radius: 8px;
    background-color: #2D2D30;
}

QRadioButton::indicator:checked {
    border: 2px solid #4FC3F7;
    border-radius: 8px;
    background-color: #2D2D30;
}

QRadioButton::indicator:unchecked:hover {
    border-color: #4FC3F7;
}

QProgressBar {
    background-color: #3E3E42;
    border: 1px solid #555555;
    border-radius: 0px;
    height: 10px;
    text-align: center;
    font-size: 8pt;
    color: #D4D4D4;
    font-family: Consolas, "Courier New", monospace;
}

QProgressBar::chunk {
    background-color: #FF8C00;
    border-radius: 0px;
}

QSplitter::handle {
    background-color: #3E3E42;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #FF8C00;
}

QScrollArea {
    background-color: #1E1E1E;
    border: 1px solid #555555;
    border-radius: 0px;
}

QMenuBar {
    background-color: #2D2D30;
    border-bottom: 1px solid #555555;
    padding: 0px;
    font-size: 11pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QMenuBar::item {
    padding: 8px 16px;
    color: #D4D4D4;
    background-color: transparent;
    border-radius: 0px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #3E3E42;
    color: #FF8C00;
}

QMenu {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 8px 32px;
    color: #D4D4D4;
    font-size: 10pt;
    border-radius: 0px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QMenu::item:selected {
    background-color: #3E3E42;
    color: #FF8C00;
}

QMenu::item:disabled {
    color: #555555;
}

QMenu::separator {
    height: 1px;
    background-color: #555555;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

QToolBar {
    background-color: #2D2D30;
    border-bottom: 1px solid #555555;
    border-top: none;
    border-left: none;
    border-right: none;
    padding: 6px 10px;
    spacing: 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 6px 10px;
    color: #D4D4D4;
    font-size: 10pt;
}

QToolBar QToolButton:hover {
    background-color: #3E3E42;
    border-color: #555555;
    color: #4FC3F7;
}

QToolBar QToolButton:pressed {
    background-color: #1E1E1E;
    border-color: #4FC3F7;
}

QToolBar QToolButton:checked {
    background-color: #3E3E42;
    border-color: #FF8C00;
    color: #FF8C00;
}

QToolBar separator {
    width: 1px;
    background-color: #555555;
    margin: 4px 4px;
}

QStatusBar {
    background: #007ACC;
    color: #FFFFFF;
    font-size: 11px;
    border-top: none;
    padding: 6px 14px;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel[StatusBarReady="true"] {
    color: #4EC9B0;
    font-weight: 500;
}

QStatusBar QLabel[StatusBarItem="true"] {
    color: #FFFFFF;
    font-size: 11px;
    padding: 0 8px;
}

QStatusBar QWidget {
    background: transparent;
}

QStatusBar QLabel {
    padding: 0 6px;
    color: #FFFFFF;
}

QDockWidget {
    color: #D4D4D4;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QDockWidget::title {
    background-color: #2D2D30;
    color: #9E9E9E;
    padding: 6px 10px;
    border-bottom: 1px solid #555555;
    font-size: 9pt;
    font-weight: bold;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3E3E42;
}

QScrollBar:vertical {
    width: 10px;
    background-color: #1E1E1E;
    border: none;
    border-radius: 0px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 0px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666666;
}

QScrollBar::handle:vertical:pressed {
    background-color: #FF8C00;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background-color: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    height: 10px;
    background-color: #1E1E1E;
    border: none;
    border-radius: 0px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666666;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #FF8C00;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background-color: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QToolTip {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 8px 12px;
    font-size: 10pt;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QDialog {
    background-color: #2D2D30;
}

QMessageBox {
    background-color: #2D2D30;
}

QMessageBox QLabel {
    font-size: 10pt;
    padding: 8px;
    color: #D4D4D4;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QListWidget {
    background-color: #1E1E1E;
    border: 1px solid #555555;
    border-radius: 0px;
    font-size: 10pt;
    outline: none;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QListWidget::item {
    padding: 6px 8px;
    color: #D4D4D4;
    border-bottom: 1px solid #333333;
}

QListWidget::item:selected {
    background-color: #3E3E42;
    color: #FF8C00;
}

QListWidget::item:hover {
    background-color: #2D2D30;
}

QSpinBox,
QDoubleSpinBox {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 6px 10px;
    font-size: 11pt;
    font-family: Consolas, "Courier New", monospace;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #4FC3F7;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #555555;
    border-bottom: 1px solid #555555;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover {
    background-color: #3E3E42;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #555555;
}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #3E3E42;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #9E9E9E;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #9E9E9E;
}

QSlider::groove:horizontal {
    background-color: #3E3E42;
    height: 4px;
    border-radius: 0px;
}

QSlider::handle:horizontal {
    background-color: #FF8C00;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 1px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFA033;
}

QSlider::groove:vertical {
    background-color: #3E3E42;
    width: 4px;
    border-radius: 0px;
}

QSlider::handle:vertical {
    background-color: #FF8C00;
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    border-radius: 1px;
}

QSlider::handle:vertical:hover {
    background-color: #FFA033;
}

QDateEdit,
QTimeEdit {
    background-color: #2D2D30;
    color: #D4D4D4;
    border: 1px solid #555555;
    border-radius: 0px;
    padding: 4px 8px;
    font-size: 10pt;
    font-family: Consolas, "Courier New", monospace;
}

QDateEdit:focus,
QTimeEdit:focus {
    border-color: #4FC3F7;
}

QScrollBar::handle:vertical:disabled {
    background-color: #3E3E42;
}

QScrollBar::handle:horizontal:disabled {
    background-color: #3E3E42;
}

QFrame[BottomPanel="true"] {
    background-color: #252526;
    border-top: 1px solid #3E3E42;
}

QFrame[BottomPanelHeader="true"] {
    background-color: #252526;
    min-height: 32px;
    border-bottom: 1px solid #3E3E42;
}

QPushButton[BottomTabBtn="true"] {
    background-color: transparent;
    border: none;
    padding: 8px 16px;
    color: #999999;
    font-size: 10pt;
    border-bottom: 2px solid transparent;
}

QPushButton[BottomTabBtn="true"]:hover {
    color: #CCCCCC;
}

QPushButton[BottomTabBtn="true"][Active="true"] {
    color: #E86100;
    border-bottom: 2px solid #E86100;
    font-weight: 500;
}
