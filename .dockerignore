# ============================================
# Docker 构建忽略文件
# 排除不需要复制到镜像中的文件和目录
# ============================================

# 版本控制
.git/
.gitignore

# IDE 配置
.vscode/
.idea/

# 文档目录（.trae）
.trae/documents/
.trae/specs/

# Docker 相关文件（避免递归构建）
.devcontainer/
.dockerignore
Dockerfile*
docker-compose*.yml

# Python 编译产物
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
ENV/
env/
.venv/

# Node.js (如果有)
node_modules/
npm-debug.log*

# Go 编译产物
.plc-out/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# 测试覆盖率
coverage/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# 数据文件
*.csv
*.xlsx
*.xls
*.db
*.sqlite3

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 大型媒体文件
*.pdf
*.mp4
*.avi
*.mov

# 百度云同步盘临时文件
.baidusync/

# 系统文件
Desktop.ini
