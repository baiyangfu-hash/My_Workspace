// ============================================================================
// OB1.scl - 长边框堆垛机主组织块
// ============================================================================
// 项目: DJ-2026-009 长边框堆垛机
// 遵循规范: STD-820 / STD-901 / LSP-905
// ============================================================================

ORGANIZATION_BLOCK OB1
VAR_TEMP
    iIndex : INT;
END_VAR
BEGIN
    // ========================================================================
    // 第1部分: 外部设备 8 步交握与 4s ON / 4s OFF 心跳监视 (STD-820 / FB_3001)
    // ========================================================================
    GlobalVars.fbExternal(
        i_bEnable            := GlobalVars.stGlobal.bPowerOn,
        i_bAutoMode          := GlobalVars.stGlobal.bAutoRunning,
        i_bResetCmd          := GlobalVars.stGlobal.bResetCmd,
        i_bMachineReadyIn    := NOT GlobalVars.stDualInfeed.bRunning,
        i_bMachineReadyOut   := GlobalVars.stStackTransfer.bDone,
        i_bInfeedArrivedSens := GlobalVars.stDualInfeed.bInfeedReady,
        i_sSendModuleID      := "MODULE-DJ009-SAMPLE",
        io_stExternal        := GlobalVars.stExternal
    );

    // ========================================================================
    // 第2部分: 配方参数计算与全局报警分流 (FB_2001)
    // ========================================================================
    GlobalVars.fbRecipeAlarm(
        i_bEnable        := GlobalVars.stGlobal.bPowerOn,
        i_bAutoMode      := GlobalVars.stGlobal.bAutoRunning,
        i_bResetCmd      := GlobalVars.stGlobal.bResetCmd,
        i_bEmergencyStop := GlobalVars.stGlobal.bEmergencyStop AND GlobalVars.stGlobal.bSafetyLight
    );

    // ========================================================================
    // 第3部分: 双路入料输送与分料计数 (FB_1001)
    // ========================================================================
    GlobalVars.fbDualInfeed(
        i_bEnable        := GlobalVars.stGlobal.bPowerOn,
        i_bAutoMode      := GlobalVars.stGlobal.bAutoRunning,
        i_bResetCmd      := GlobalVars.stGlobal.bResetCmd,
        i_bEmergencyStop := GlobalVars.stGlobal.bEmergencyStop
    );

    // ========================================================================
    // 第4部分: 叠垛移载机械手 X/Z 轴联动控制 (FB_1002)
    // ========================================================================
    GlobalVars.fbStackTransfer(
        i_bEnable        := GlobalVars.stGlobal.bPowerOn,
        i_bAutoMode      := GlobalVars.stGlobal.bAutoRunning,
        i_bResetCmd      := GlobalVars.stGlobal.bResetCmd,
        i_bEmergencyStop := GlobalVars.stGlobal.bEmergencyStop
    );

    // ========================================================================
    // 第5部分: 隔纸架 Z 轴定位与自动裁切铺设 (FB_1003)
    // ========================================================================
    GlobalVars.fbPaperHolder(
        i_bEnable        := GlobalVars.stGlobal.bPowerOn,
        i_bAutoMode      := GlobalVars.stGlobal.bAutoRunning,
        i_bResetCmd      := GlobalVars.stGlobal.bResetCmd,
        i_bEmergencyStop := GlobalVars.stGlobal.bEmergencyStop
    );

    // ========================================================================
    // 第6部分: 边框长短边纠偏归正 (FB_1004)
    // ========================================================================
    GlobalVars.fbFrameAlign(
        i_bEnable        := GlobalVars.stGlobal.bPowerOn,
        i_bAutoMode      := GlobalVars.stGlobal.bAutoRunning,
        i_bResetCmd      := GlobalVars.stGlobal.bResetCmd,
        i_bEmergencyStop := GlobalVars.stGlobal.bEmergencyStop
    );

END_ORGANIZATION_BLOCK
