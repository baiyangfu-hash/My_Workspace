FUNCTION_BLOCK FB_1003_PaperHolder_Z
(* ==============================================================================
 * 隔纸放料架 Z 轴升降、换料点、拉隔纸与裁切铺设
 * 项目: DJ-2026-009 长边框堆垛机
 * 规范: LSP-905 西门子 SCL 编程规范 (带 ELSE 防死锁自愈)
 * ============================================================================== *)
VAR_INPUT
    i_bEnable       : BOOL;     (* 功能块总使能信号 *)
    i_bAutoMode     : BOOL;     (* 自动运行模式标志 *)
    i_bResetCmd     : BOOL;     (* 故障复位指令 *)
    i_bEmergencyStop: BOOL;     (* 安全急停联锁 (常闭触点, 1=正常, 0=急停) *)
END_VAR
VAR_OUTPUT
    q_bRunning      : BOOL;     (* 机构工位动作运行中 *)
    q_bDone         : BOOL;     (* 当前循环工步完成 *)
    q_bError        : BOOL;     (* 工位报警/超时故障 *)
    q_wErrorCode    : WORD;     (* 故障诊断代码 *)
END_VAR
VAR
    stat_iStep      : INT;      (* 工位状态机当前步序 *)
    stat_bInitialized: BOOL;    (* 初始化就绪标志 *)
END_VAR
BEGIN
    (* 0. 安全与急停联锁保护 *)
    IF NOT i_bEnable OR NOT i_bEmergencyStop THEN
        q_bRunning := FALSE;
        q_bDone := FALSE;
        q_bError := NOT i_bEmergencyStop;
        IF NOT i_bEmergencyStop THEN
            q_wErrorCode := 16#E001; (* 急停触发错误 *)
        END_IF;
        stat_iStep := 0;
        RETURN;
    END_IF;

    (* 1. 故障复位处理 *)
    IF i_bResetCmd THEN
        q_bError := FALSE;
        q_wErrorCode := 16#0000;
    END_IF;

    (* 2. 工序逻辑状态机调度 (严格遵循 LSP-905 ELSE 防死锁规范) *)
    CASE stat_iStep OF
        0: (* 待机就绪 *)
            q_bRunning := FALSE;
            q_bDone := FALSE;
            IF i_bAutoMode AND NOT q_bError THEN
                stat_iStep := 10;
            END_IF;

        10: (* 动作执行 *)
            q_bRunning := TRUE;
            stat_iStep := 20;

        20: (* 动作完成 *)
            q_bRunning := FALSE;
            q_bDone := TRUE;
            IF NOT i_bAutoMode THEN
                stat_iStep := 0;
            END_IF;

        ELSE (* 防死锁异常自愈分支 *)
            stat_iStep := 0;
            q_bRunning := FALSE;
            q_bDone := FALSE;
            q_bError := TRUE;
            q_wErrorCode := 16#E0FF; (* 未知步序异常代码 *)
    END_CASE;
END_FUNCTION_BLOCK
