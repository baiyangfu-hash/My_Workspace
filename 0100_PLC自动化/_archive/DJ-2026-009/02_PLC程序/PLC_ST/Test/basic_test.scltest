// ============================================================================
// basic_test.scltest - 长边框堆垛机 OB1 主程序集成回归测试
// ============================================================================
// 项目: DJ-2026-009 长边框堆垛机
// 覆盖: 全局安全、双路进料、移载XZ、隔纸裁切、长短边归正与配方报警 6 大核心场景
// ============================================================================

TEST_CASE "TC01_Global_EmergencyStop_Interlock"
    // 测试目标：触发全局急停时，切断全机使能并置位急停故障
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bAutoRunning := TRUE;
    SET GlobalVars.stGlobal.bEmergencyStop := FALSE; // 急停按下
    WAIT_CYCLES 3;
    ASSERT GlobalVars.fbDualInfeed.q_bRunning = FALSE;
    ASSERT GlobalVars.fbStackTransfer.q_bRunning = FALSE;
    ASSERT GlobalVars.fbDualInfeed.q_bError = TRUE;
END_TEST_CASE

TEST_CASE "TC02_Safety_LightCurtain_Tripped"
    // 测试目标：安全光幕遮挡时，报警激活并阻断移载动作
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bEmergencyStop := TRUE;
    SET GlobalVars.stGlobal.bSafetyLight := FALSE; // 光幕遮挡
    WAIT_CYCLES 3;
    ASSERT GlobalVars.fbRecipeAlarm.q_bError = TRUE;
END_TEST_CASE

TEST_CASE "TC03_DualInfeed_Count_And_Ready"
    // 测试目标：双路进料光电计数达到设定值时，触发取料就绪信号
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bEmergencyStop := TRUE;
    SET GlobalVars.stGlobal.bSafetyLight := TRUE;
    SET GlobalVars.stGlobal.bAutoRunning := TRUE;
    SET GlobalVars.stDualInfeed.iInfeedCount1 := 2;
    SET GlobalVars.stDualInfeed.iInfeedCount2 := 2;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.fbDualInfeed.q_bRunning = TRUE;
END_TEST_CASE

TEST_CASE "TC04_StackTransfer_PickAndPlace"
    // 测试目标：叠垛移载机械手收到取料就绪后，启动 X/Z 轴抓取循环
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bEmergencyStop := TRUE;
    SET GlobalVars.stGlobal.bSafetyLight := TRUE;
    SET GlobalVars.stGlobal.bAutoRunning := TRUE;
    SET GlobalVars.stDualInfeed.bInfeedReady := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.fbStackTransfer.q_bRunning = TRUE;
END_TEST_CASE

TEST_CASE "TC05_PaperHolder_Z_CutterAction"
    // 测试目标：层码满时触发隔纸架升降定位与气动切刀裁切
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bEmergencyStop := TRUE;
    SET GlobalVars.stGlobal.bAutoRunning := TRUE;
    SET GlobalVars.stStackTransfer.iCurrentLayer := 1;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.fbPaperHolder.q_bRunning = TRUE;
END_TEST_CASE

TEST_CASE "TC06_FrameAlign_PushAndClamp"
    // 测试目标：放料完成后，长短边纠偏拍齐气缸动作
    SET GlobalVars.stGlobal.bPowerOn := TRUE;
    SET GlobalVars.stGlobal.bEmergencyStop := TRUE;
    SET GlobalVars.stGlobal.bAutoRunning := TRUE;
    SET GlobalVars.stStackTransfer.bDone := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.fbFrameAlign.q_bRunning = TRUE;
END_TEST_CASE
