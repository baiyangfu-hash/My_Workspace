// ============================================================================
// GlobalVars.db - 全局变量数据块（Global Variable Data Block）
// ============================================================================
// 功能说明：
//   定义整个项目中使用的全局变量，包括：
//   1. HMI 按钮状态数组
//   2. 阀门控制相关变量
//   3. 阀门控制功能块实例
//   4. 定时器A和B的计数器和输出变量
//
// 变更记录：
//   V4.1.0 (2026-05-01): 初始版本
//          - 定义基本的全局变量结构
//          - 包含HMI接口、阀门控制和定时器变量
// ============================================================================

DATA_BLOCK GlobalVars
    VAR
        // =========================================================================
        // 第一部分：HMI 接口变量
        // =========================================================================
        Hmibutton : ARRAY[0..9] OF BOOL;  // HMI按钮状态数组
                                          // [0]=自动/手动  [1]=开阀命令  [2]=关阀命令
                                          // [3]=过流信号  [4]=开到位    [5]=关到位
                                          // [6]=故障复位  [7]=定时器A启动 [8]=定时器B启动

        // =========================================================================
        // 第二部分：阀门控制变量
        // =========================================================================
        ValveState : INT;     // 阀门当前状态 (0=关闭中/已关, 1=打开中/已开, 2=运动中)
        ValveOpen : BOOL;     // 阀门是否正在打开（或已打开）
        ValveClose : BOOL;    // 阀门是否正在关闭（或关闭）
        FaultStatus : BOOL;   // 当前是否有故障 (TRUE=有故障)

        // =========================================================================
        // 第三部分：功能块实例
        // =========================================================================
        FaultReset : BOOL;              // 故障复位信号
        ValveCtrl : FB_ValveControl;    // 阀门控制功能块实例
                                        // 包含阀门控制的所有内部状态

        // =========================================================================
        // 第四部分：定时器A - 手动计数器实现
        // =========================================================================
        Counter_A : DINT := 0;  // [内部] 定时器A的扫描周期计数器
                                //          每个周期+1，达到预设值后保持
                                //          预设值: 50 (对应约500ms)

        bStart_A : Bool;      // [输入] 定时器A启动信号 (来自 Hmibutton[7])
                             //          TRUE=开始计时, FALSE=复位清零

        bOut_A : Bool;        // [输出] 定时器A输出信号
                             //          FALSE=计时中, TRUE=已达预设时间(500ms)

        // =========================================================================
        // 第五部分：定时器B - 手动计数器实现
        // =========================================================================
        Counter_B : DINT := 0;  // [内部] 定时器B的扫描周期计数器
                                //          与定时器A完全对称，仅后缀不同

        bStart_B : Bool;      // [输入] 定时器B启动信号 (来自 Hmibutton[8])
        bOut_B : Bool;        // [输出] 定时器B输出信号
        ValveState : INT;     // [输出] 阀门当前状态机状态
                             //   0=关闭中/已关, 1=打开中, 2=已打开, 3=关闭中/已关
                            
    END_VAR
END_DATA_BLOCK
