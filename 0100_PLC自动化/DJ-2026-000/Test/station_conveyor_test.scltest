// ============================================================================
// station_conveyor_test.scltest - FB_1014_StationConveyor 功能测试
// ============================================================================
// 被测对象: SysLib/actuator/FB_1014_StationConveyor V6.0.0
// 测试实例: GlobalVars.StationConveyor
//
// 测试覆盖(基础状态转换 + 优先级):
//   test1 - 停止优先级(最高) → ST_FAULT(8)
//   test2 - VFD报警优先级(次高) → ST_FAULT(8)
//   test3 - 暂停优先级(第三) → ST_PAUSE(7)
//   test4 - 手动模式 → ST_IDLE(0)
//   test5 - IDLE→READY 转换
//   test6 - READY→INFEED 转换(B侧模式)
//
// 状态定义:
//   0=IDLE, 1=READY, 2=INFEED, 3=ALIGN, 4=PROCESSING,
//   5=DISCHARGE, 6=COMPLETE, 7=PAUSE, 8=FAULT
// ============================================================================

// ============================================================================
// test1: 停止优先级(最高)
// 预期: i_bStop=TRUE → q_iState=8(ST_FAULT), 所有输出停止
// ============================================================================
TEST_CASE "test1_stop_priority"
    // 先进入自动模式
    SET GlobalVars.st_bAutoMode := TRUE;
    SET GlobalVars.st_bSelected := TRUE;
    SET GlobalVars.st_iMode := 1;  // B侧双向
    SET GlobalVars.st_dDebounceMs := 0;  // 关闭去抖以加速测试

    WAIT_CYCLES 2;

    // 触发停止
    SET GlobalVars.st_bStop := TRUE;

    WAIT_CYCLES 1;

    // 断言: 进入故障状态, 电机停止
    ASSERT GlobalVars.st_iState = 8;
    ASSERT GlobalVars.st_bFwdCmd = FALSE;
    ASSERT GlobalVars.st_bRevCmd = FALSE;
    ASSERT GlobalVars.st_bInfeedActive = FALSE;
END_TEST_CASE

// ============================================================================
// test2: VFD报警优先级(次高)
// 预期: i_bVfdAlarm=TRUE → q_iState=8(ST_FAULT)
// ============================================================================
TEST_CASE "test2_vfd_alarm_priority"
    SET GlobalVars.st_bAutoMode := TRUE;
    SET GlobalVars.st_bSelected := TRUE;
    SET GlobalVars.st_bStop := FALSE;  // 确保停止未触发
    SET GlobalVars.st_dDebounceMs := 0;

    WAIT_CYCLES 2;

    // 触发VFD报警
    SET GlobalVars.st_bVfdAlarm := TRUE;

    WAIT_CYCLES 1;

    // 断言: 进入故障状态
    ASSERT GlobalVars.st_iState = 8;
    ASSERT GlobalVars.st_bFwdCmd = FALSE;
    ASSERT GlobalVars.st_bRevCmd = FALSE;
END_TEST_CASE

// ============================================================================
// test3: 暂停优先级(第三)
// 预期: i_bPause=TRUE → q_iState=7(ST_PAUSE), 电机停止但保留状态
// ============================================================================
TEST_CASE "test3_pause"
    SET GlobalVars.st_bAutoMode := TRUE;
    SET GlobalVars.st_bSelected := TRUE;
    SET GlobalVars.st_bStop := FALSE;
    SET GlobalVars.st_bVfdAlarm := FALSE;
    SET GlobalVars.st_dDebounceMs := 0;

    WAIT_CYCLES 2;

    // 触发暂停
    SET GlobalVars.st_bPause := TRUE;

    WAIT_CYCLES 1;

    // 断言: 进入暂停状态, 电机停止
    ASSERT GlobalVars.st_iState = 7;
    ASSERT GlobalVars.st_bFwdCmd = FALSE;
    ASSERT GlobalVars.st_bRevCmd = FALSE;
END_TEST_CASE

// ============================================================================
// test4: 手动模式(非自动)
// 预期: i_bAutoMode=FALSE → q_iState=0(ST_IDLE), 所有输出复位
// ============================================================================
TEST_CASE "test4_manual_mode"
    SET GlobalVars.st_bAutoMode := FALSE;  // 手动模式
    SET GlobalVars.st_bStop := FALSE;
    SET GlobalVars.st_bVfdAlarm := FALSE;
    SET GlobalVars.st_bPause := FALSE;

    WAIT_CYCLES 2;

    // 断言: 回到空闲状态
    ASSERT GlobalVars.st_iState = 0;
    ASSERT GlobalVars.st_bFwdCmd = FALSE;
    ASSERT GlobalVars.st_bRevCmd = FALSE;
    ASSERT GlobalVars.st_bInfeedActive = FALSE;
    ASSERT GlobalVars.st_bReplyUpstream = FALSE;
END_TEST_CASE

// ============================================================================
// test5: IDLE→READY 转换
// 预期: i_bAutoMode=TRUE + i_bSelected=TRUE → q_iState=1(ST_READY)
// ============================================================================
TEST_CASE "test5_idle_to_ready"
    // 确保从干净状态开始
    SET GlobalVars.st_bAutoMode := FALSE;
    SET GlobalVars.st_bStop := FALSE;
    SET GlobalVars.st_bVfdAlarm := FALSE;
    SET GlobalVars.st_bPause := FALSE;
    SET GlobalVars.st_dDebounceMs := 0;

    WAIT_CYCLES 2;  // 先回到IDLE

    // 进入自动模式 + 选中
    SET GlobalVars.st_bAutoMode := TRUE;
    SET GlobalVars.st_bSelected := TRUE;
    SET GlobalVars.st_iMode := 1;

    WAIT_CYCLES 2;

    // 断言: 进入就绪状态
    ASSERT GlobalVars.st_iState = 1;
END_TEST_CASE

// ============================================================================
// test6: READY→INFEED 转换(B侧模式)
// 预期: 在READY状态下, 上游请求+光电确认 → q_iState=2(ST_INFEED), 电机反转
// ============================================================================
TEST_CASE "test6_ready_to_infeed"
    // 前置: 先到READY状态
    SET GlobalVars.st_bAutoMode := FALSE;
    SET GlobalVars.st_bStop := FALSE;
    SET GlobalVars.st_bVfdAlarm := FALSE;
    SET GlobalVars.st_bPause := FALSE;
    SET GlobalVars.st_dDebounceMs := 0;
    SET GlobalVars.st_dInfeedDelayMs := 1;  // 极短延时加速测试

    WAIT_CYCLES 2;

    SET GlobalVars.st_bAutoMode := TRUE;
    SET GlobalVars.st_bSelected := TRUE;
    SET GlobalVars.st_iMode := 1;  // B侧双向

    WAIT_CYCLES 2;

    // 确认已在READY
    ASSERT GlobalVars.st_iState = 1;

    // 提供光电信号(三个光电全ON) + 上游请求
    SET GlobalVars.st_xInfeedStart := TRUE;
    SET GlobalVars.st_xPos1 := TRUE;
    SET GlobalVars.st_xPos2 := TRUE;
    SET GlobalVars.st_bUpstreamReq := TRUE;

    // 等待去抖确认 + 回应上游 + 入料延时
    WAIT_CYCLES 5;

    // 断言: 进入入料状态, B侧模式电机反转
    ASSERT GlobalVars.st_iState = 2;
    ASSERT GlobalVars.st_bRevCmd = TRUE;
    ASSERT GlobalVars.st_bInfeedActive = TRUE;
END_TEST_CASE
