// ============================================================================
// cylinder_test.scltest - FB_1011_CylinderControl 功能测试
// ============================================================================
// 被测对象: SysLib/actuator/FB_1011_CylinderControl V12.0.0
// 接口: stCmd(ST_CylinderCmd) + stSts(ST_CylinderSts)
// 测试实例: GlobalVars.CylinderSingle (单线圈)
//
// 测试覆盖:
//   test1 - 单线圈伸出到位 (自动模式)
//   test2 - 单线圈收回到位 (自动模式)
//   test3 - 单线圈超时检测 (自动模式)
//   test4 - 传感器冲突检测
//   test5 - 双线圈伸出 (自动模式)
//   test6 - 双线圈收回 (自动模式)
//   test7 - 极性取反
//   test8 - 手动模式跳过超时
// ============================================================================

// ============================================================================
// test1: 单线圈伸出到位
// 预期: Extend=TRUE + ExtendedPos=TRUE → SolenoidA=TRUE, IsExtended=TRUE
// ============================================================================
TEST_CASE "test1_single_extend"
    // 初始化: 单线圈模式, 无消抖, 短超时
    SET GlobalVars.cyl_stCmd.SolenoidType := 0;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 100;
    SET GlobalVars.cyl_stCmd.ExtendPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.RetractPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.Mode := 1;  // 自动模式

    // 发出伸出命令 + 到位信号
    SET GlobalVars.cyl_stCmd.Extend := TRUE;
    SET GlobalVars.cyl_stCmd.Retract := FALSE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := TRUE;
    SET GlobalVars.cyl_stCmd.RetractedPos := FALSE;

    WAIT_CYCLES 2;

    // 断言: 线圈A得电, 已到动点
    ASSERT GlobalVars.cyl_stSts.SolenoidA = TRUE;
    ASSERT GlobalVars.cyl_stSts.IsExtended = TRUE;
    ASSERT GlobalVars.cyl_stSts.IsRetracted = FALSE;
    ASSERT GlobalVars.cyl_stSts.Timeout = FALSE;
END_TEST_CASE

// ============================================================================
// test2: 单线圈收回到位
// 预期: Retract=TRUE + RetractedPos=TRUE → SolenoidA=FALSE, IsRetracted=TRUE
// ============================================================================
TEST_CASE "test2_single_retract"
    SET GlobalVars.cyl_stCmd.SolenoidType := 0;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 100;
    SET GlobalVars.cyl_stCmd.ExtendPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.Mode := 1;  // 自动模式

    SET GlobalVars.cyl_stCmd.Extend := FALSE;
    SET GlobalVars.cyl_stCmd.Retract := TRUE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := FALSE;
    SET GlobalVars.cyl_stCmd.RetractedPos := TRUE;

    WAIT_CYCLES 2;

    // 断言: 线圈A失电(弹簧复位), 已到原点
    ASSERT GlobalVars.cyl_stSts.SolenoidA = FALSE;
    ASSERT GlobalVars.cyl_stSts.IsRetracted = TRUE;
    ASSERT GlobalVars.cyl_stSts.IsExtended = FALSE;
    ASSERT GlobalVars.cyl_stSts.Timeout = FALSE;
END_TEST_CASE

// ============================================================================
// test3: 单线圈超时检测
// 预期: Extend=TRUE + 不给到位 + 超时 → Timeout=TRUE
// ============================================================================
TEST_CASE "test3_single_timeout"
    SET GlobalVars.cyl_stCmd.SolenoidType := 0;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 10;  // 短超时(10ms)
    SET GlobalVars.cyl_stCmd.Mode := 1;  // 自动模式, 超时才生效

    SET GlobalVars.cyl_stCmd.Extend := TRUE;
    SET GlobalVars.cyl_stCmd.Retract := FALSE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := FALSE;  // 不给到位
    SET GlobalVars.cyl_stCmd.RetractedPos := FALSE;

    // 等待超时(10ms = 约10个周期, 留余量等20个)
    WAIT_CYCLES 20;

    // 断言: 超时报警触发
    ASSERT GlobalVars.cyl_stSts.Timeout = TRUE;
    ASSERT GlobalVars.cyl_stSts.IsExtended = FALSE;
END_TEST_CASE

// ============================================================================
// test4: 传感器冲突检测
// 预期: 两点同时ON → SensorFault=TRUE
// ============================================================================
TEST_CASE "test4_sensor_fault"
    SET GlobalVars.cyl_stCmd.SolenoidType := 0;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.Mode := 1;

    SET GlobalVars.cyl_stCmd.ExtendedPos := TRUE;
    SET GlobalVars.cyl_stCmd.RetractedPos := TRUE;  // 两点同时ON

    WAIT_CYCLES 2;

    // 断言: 传感器冲突
    ASSERT GlobalVars.cyl_stSts.SensorFault = TRUE;
END_TEST_CASE

// ============================================================================
// test5: 双线圈伸出
// 预期: SolenoidType=1 + Extend=TRUE → SolenoidA=TRUE, SolenoidB=FALSE
// ============================================================================
TEST_CASE "test5_dual_extend"
    SET GlobalVars.cyl_stCmd.SolenoidType := 1;  // 双线圈模式
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 100;
    SET GlobalVars.cyl_stCmd.ExtendPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.RetractPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.Mode := 1;  // 自动模式

    SET GlobalVars.cyl_stCmd.Extend := TRUE;
    SET GlobalVars.cyl_stCmd.Retract := FALSE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := TRUE;
    SET GlobalVars.cyl_stCmd.RetractedPos := FALSE;

    WAIT_CYCLES 2;

    // 断言: 到位后中封保持, 线圈A/B均OFF; IsExtended=TRUE
    ASSERT GlobalVars.cyl_stSts.SolenoidA = FALSE;
    ASSERT GlobalVars.cyl_stSts.SolenoidB = FALSE;
    ASSERT GlobalVars.cyl_stSts.IsExtended = TRUE;
END_TEST_CASE

// ============================================================================
// test6: 双线圈收回
// 预期: SolenoidType=1 + Retract=TRUE → SolenoidB=TRUE, SolenoidA=FALSE(运行中)
//        到位后中封保持, 线圈A/B均OFF
// ============================================================================
TEST_CASE "test6_dual_retract"
    SET GlobalVars.cyl_stCmd.SolenoidType := 1;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 100;
    SET GlobalVars.cyl_stCmd.ExtendPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.RetractPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.Mode := 1;  // 自动模式

    SET GlobalVars.cyl_stCmd.Extend := FALSE;
    SET GlobalVars.cyl_stCmd.Retract := TRUE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := FALSE;
    SET GlobalVars.cyl_stCmd.RetractedPos := TRUE;

    WAIT_CYCLES 2;

    // 断言: 到位后中封保持, 线圈A/B均OFF; IsRetracted=TRUE
    ASSERT GlobalVars.cyl_stSts.SolenoidB = FALSE;
    ASSERT GlobalVars.cyl_stSts.SolenoidA = FALSE;
    ASSERT GlobalVars.cyl_stSts.IsRetracted = TRUE;
END_TEST_CASE

// ============================================================================
// test7: 极性取反(单线圈伸出方向)
// 预期: ExtendPolarity=TRUE + Extend=TRUE → SolenoidA=FALSE
// ============================================================================
TEST_CASE "test7_polarity_invert"
    SET GlobalVars.cyl_stCmd.SolenoidType := 0;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 100;
    SET GlobalVars.cyl_stCmd.ExtendPolarity := TRUE;  // 极性取反
    SET GlobalVars.cyl_stCmd.Mode := 1;  // 自动模式

    SET GlobalVars.cyl_stCmd.Extend := TRUE;
    SET GlobalVars.cyl_stCmd.Retract := FALSE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := FALSE;
    SET GlobalVars.cyl_stCmd.RetractedPos := TRUE;   // 原点到位(极性映射后=动点)

    WAIT_CYCLES 2;

    // 断言: 极性取反后线圈A失电
    ASSERT GlobalVars.cyl_stSts.SolenoidA = FALSE;
    ASSERT GlobalVars.cyl_stSts.SolenoidB = FALSE;
END_TEST_CASE

// ============================================================================
// test8: 手动模式跳过超时
// 预期: Mode=0 + Extend=TRUE + 不给到位 + 超时 → Timeout仍为FALSE
// ============================================================================
TEST_CASE "test8_manual_no_timeout"
    SET GlobalVars.cyl_stCmd.SolenoidType := 0;
    SET GlobalVars.cyl_stCmd.DebounceMs := 0;
    SET GlobalVars.cyl_stCmd.TimeoutMs := 10;  // 短超时(10ms), 手动模式应忽略
    SET GlobalVars.cyl_stCmd.ExtendPolarity := FALSE;
    SET GlobalVars.cyl_stCmd.Mode := 0;  // 手动模式

    // 先清空之前的运动状态
    SET GlobalVars.cyl_stCmd.Extend := FALSE;
    SET GlobalVars.cyl_stCmd.Retract := FALSE;
    WAIT_CYCLES 2;

    SET GlobalVars.cyl_stCmd.Extend := TRUE;
    SET GlobalVars.cyl_stCmd.Retract := FALSE;
    SET GlobalVars.cyl_stCmd.ExtendedPos := FALSE;  // 不给到位
    SET GlobalVars.cyl_stCmd.RetractedPos := FALSE;

    // 等待超时(10ms = 约10个周期, 留余量等20个)
    WAIT_CYCLES 20;

    // 断言: 手动模式不触发超时, 线圈仍输出
    ASSERT GlobalVars.cyl_stSts.Timeout = FALSE;
    ASSERT GlobalVars.cyl_stSts.SolenoidA = TRUE;
END_TEST_CASE