// ============================================================================
// conveyor_motor_test.scltest - FB_1012_ConveyorMotor 功能测试
// ============================================================================
// 被测对象: SysLib/actuator/FB_1012_ConveyorMotor V9.0.0
// 测试实例: GlobalVars.ConveyorMotor
//
// 测试覆盖:
//   test1 - 正转命令
//   test2 - 反转命令
//   test3 - 方向互斥(Fwd优先)
//   test4 - 慢速修饰(配合方向)
//   test5 - 慢速无效(无方向)
//   test6 - VFD故障优先级
// ============================================================================

// ============================================================================
// test1: 正转命令
// 预期: i_bFwdCmd=TRUE → q_bFwdOut=TRUE, q_bRunning=TRUE
// ============================================================================
TEST_CASE "test1_fwd"
    SET GlobalVars.conv_bFwdCmd := TRUE;
    SET GlobalVars.conv_bRevCmd := FALSE;
    SET GlobalVars.conv_bSlowCmd := FALSE;
    SET GlobalVars.conv_bVfdFault := FALSE;

    WAIT_CYCLES 1;

    ASSERT GlobalVars.conv_bFwdOut = TRUE;
    ASSERT GlobalVars.conv_bRevOut = FALSE;
    ASSERT GlobalVars.conv_bSlowOut = FALSE;
    ASSERT GlobalVars.conv_bRunning = TRUE;
    ASSERT GlobalVars.conv_bVfdAlarm = FALSE;
END_TEST_CASE

// ============================================================================
// test2: 反转命令
// 预期: i_bRevCmd=TRUE → q_bRevOut=TRUE, q_bRunning=TRUE
// ============================================================================
TEST_CASE "test2_rev"
    SET GlobalVars.conv_bFwdCmd := FALSE;
    SET GlobalVars.conv_bRevCmd := TRUE;
    SET GlobalVars.conv_bSlowCmd := FALSE;
    SET GlobalVars.conv_bVfdFault := FALSE;

    WAIT_CYCLES 1;

    ASSERT GlobalVars.conv_bFwdOut = FALSE;
    ASSERT GlobalVars.conv_bRevOut = TRUE;
    ASSERT GlobalVars.conv_bSlowOut = FALSE;
    ASSERT GlobalVars.conv_bRunning = TRUE;
END_TEST_CASE

// ============================================================================
// test3: 方向互斥(Fwd优先)
// 预期: i_bFwdCmd=TRUE + i_bRevCmd=TRUE → q_bFwdOut=TRUE, q_bRevOut=FALSE
// ============================================================================
TEST_CASE "test3_fwd_priority"
    SET GlobalVars.conv_bFwdCmd := TRUE;
    SET GlobalVars.conv_bRevCmd := TRUE;   // 同时按下
    SET GlobalVars.conv_bSlowCmd := FALSE;
    SET GlobalVars.conv_bVfdFault := FALSE;

    WAIT_CYCLES 1;

    // Fwd优先, Rev被抑制
    ASSERT GlobalVars.conv_bFwdOut = TRUE;
    ASSERT GlobalVars.conv_bRevOut = FALSE;
    ASSERT GlobalVars.conv_bRunning = TRUE;
END_TEST_CASE

// ============================================================================
// test4: 慢速修饰(配合方向)
// 预期: i_bFwdCmd=TRUE + i_bSlowCmd=TRUE → q_bSlowOut=TRUE
// ============================================================================
TEST_CASE "test4_slow_with_fwd"
    SET GlobalVars.conv_bFwdCmd := TRUE;
    SET GlobalVars.conv_bRevCmd := FALSE;
    SET GlobalVars.conv_bSlowCmd := TRUE;
    SET GlobalVars.conv_bVfdFault := FALSE;

    WAIT_CYCLES 1;

    ASSERT GlobalVars.conv_bFwdOut = TRUE;
    ASSERT GlobalVars.conv_bSlowOut = TRUE;
    ASSERT GlobalVars.conv_bRunning = TRUE;
END_TEST_CASE

// ============================================================================
// test5: 慢速无效(无方向命令)
// 预期: i_bSlowCmd=TRUE + 无方向 → q_bSlowOut=FALSE
// ============================================================================
TEST_CASE "test5_slow_no_direction"
    SET GlobalVars.conv_bFwdCmd := FALSE;
    SET GlobalVars.conv_bRevCmd := FALSE;
    SET GlobalVars.conv_bSlowCmd := TRUE;   // 只有慢速, 无方向
    SET GlobalVars.conv_bVfdFault := FALSE;

    WAIT_CYCLES 1;

    // 无方向命令时慢速无效
    ASSERT GlobalVars.conv_bFwdOut = FALSE;
    ASSERT GlobalVars.conv_bRevOut = FALSE;
    ASSERT GlobalVars.conv_bSlowOut = FALSE;
    ASSERT GlobalVars.conv_bRunning = FALSE;
END_TEST_CASE

// ============================================================================
// test6: VFD故障优先级(最高)
// 预期: i_bVfdFault=TRUE → 所有输出FALSE, q_bVfdAlarm=TRUE
// ============================================================================
TEST_CASE "test6_vfd_fault"
    SET GlobalVars.conv_bFwdCmd := TRUE;    // 即使有正转命令
    SET GlobalVars.conv_bRevCmd := FALSE;
    SET GlobalVars.conv_bSlowCmd := TRUE;
    SET GlobalVars.conv_bVfdFault := TRUE;  // VFD故障

    WAIT_CYCLES 1;

    // VFD故障优先, 所有输出停止
    ASSERT GlobalVars.conv_bVfdAlarm = TRUE;
    ASSERT GlobalVars.conv_bFwdOut = FALSE;
    ASSERT GlobalVars.conv_bRevOut = FALSE;
    ASSERT GlobalVars.conv_bSlowOut = FALSE;
    ASSERT GlobalVars.conv_bRunning = FALSE;
END_TEST_CASE
