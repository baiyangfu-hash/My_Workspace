FUNCTION_BLOCK "FB_Handshake_8Step"
VAR_INPUT
    i_Req : BOOL;
    i_Ack : BOOL;
    i_Heartbeat : BOOL;
    i_Reset : BOOL;
END_VAR
VAR_OUTPUT
    q_Ready : BOOL;
    q_Done : BOOL;
    q_HeartbeatErr : BOOL;
    q_Error : BOOL;
END_VAR
VAR
    s_iStep : INT;
    fb_tHeartbeatTimer : "FB_TON";
    s_bHeartbeatPrev : BOOL;
    s_bHeartbeatTrigger : BOOL;
    s_dHeartbeatEt : DINT;
    s_bHeartbeatQ : BOOL;
END_VAR

BEGIN
    // 1. Heartbeat Logic
    s_bHeartbeatTrigger := (i_Heartbeat = s_bHeartbeatPrev);
    
    // Top unconditional timer call (LSP-906)
    fb_tHeartbeatTimer(
        i_IN := s_bHeartbeatTrigger,
        i_PT := 4000,
        q_Q => s_bHeartbeatQ,
        q_ET => s_dHeartbeatEt
    );
    
    q_HeartbeatErr := s_bHeartbeatQ;
    s_bHeartbeatPrev := i_Heartbeat;

    IF i_Reset THEN
        s_iStep := 0;
        q_Ready := FALSE;
        q_Done := FALSE;
        q_Error := FALSE;
    END_IF;

    // 2. 8-Step Handshake State Machine (STD-820)
    CASE s_iStep OF
        0: // Idle
            q_Ready := FALSE;
            q_Done := FALSE;
            IF i_Req THEN
                s_iStep := 10;
            END_IF;
            
        10: // Step 1: Detect REQ, assert READY
            q_Ready := TRUE;
            s_iStep := 20;
            
        20: // Step 2: Wait for ACK from peer
            IF i_Ack THEN
                s_iStep := 30;
            END_IF;
            
        30: // Step 3: Wait for REQ to drop
            IF NOT i_Req THEN
                s_iStep := 40;
            END_IF;
            
        40: // Step 4: Drop READY
            q_Ready := FALSE;
            s_iStep := 50;
            
        50: // Step 5: Wait for ACK to drop
            IF NOT i_Ack THEN
                s_iStep := 60;
            END_IF;
            
        60: // Step 6: Assert DONE
            q_Done := TRUE;
            s_iStep := 70;
            
        70: // Step 7: Cleanup cycle
            q_Done := FALSE;
            s_iStep := 0;
            
        ELSE
            // Anti-deadlock (LSP-905)
            s_iStep := 0;
    END_CASE;

END_FUNCTION_BLOCK
