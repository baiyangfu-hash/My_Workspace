// ============================================================================
// basic_test.scltest - OB1主程序集成测试 (V7.0.1)
// ============================================================================
// 功能说明：
//   包含 10 个测试用例，覆盖 OB1 调用的 5 个 FB：
//
//   TC01 - 外部设备: 自动模式+使能 → 组框机就绪
//   TC02 - 外部设备: 组框机急停 → 紧急停止联锁
//   TC03 - 外部设备: 打胶机故障 → 报警码300
//   TC04 - 外部设备: 安全条件满足 → SafetyConditionMet
//   TC05 - 外部设备: 开门请求 → 暂停+开门确认
//   TC06 - 取放料: 手动夹紧 → Action=TRUE + Release=FALSE
//   TC07 - 取放料: 手动上升 → LiftUp=TRUE
//   TC08 - 取放料: 无操作 → Release=TRUE (NOT-Action逻辑)
//   TC09 - 公共报警: 复位 → 所有输出清零
//   TC10 - 公共报警: 全站手动 → 无报警激活
//
// V7.0.0变更说明 (FB_1003):
//   - 新增 VAR_IN_OUT io_stZAxis/io_stX1Axis (ST_ServoAxis V3.0)
//   - 删除 6 个间接轴请求输出 (q_bZAxis*/q_bX1Axis*)
//   - 手动模式测试 (TC06-TC08) 不受影响，仍有效
//   - 自动模式伺服控制需额外测试用例 (待补充)
//
// OB1信号流(按调用顺序):
//   1. fbExternalDevice  ← stExternal.i_*  → stExternal.o_*
//   2. fbConveyor4Layer  ← stConveyor.i_*  → stConveyor.o_*
//   3. fbPickPlace       ← stPickPlace.i_*  → stPickPlace.o_*
//       → VAR_IN_OUT: io_stZAxis => astServoAxis[1]
//       → VAR_IN_OUT: io_stX1Axis => astServoAxis[2]
//       → 后处理: o_*_Release := NOT o_*_Action
//   4. stFeeder.i_bPickPlace_FeedComplete := stPickPlace.o_bPlaceComplete_ToFeeder
//      fbGlueFeeder      ← stFeeder.i_*    → stFeeder.o_*
//   5. fbCommonAlarm     ← 各站报警码       → stGlobal.o_*
// ============================================================================

TEST_CASE "TC01_External_Ready"
    // ============================================================================
    // 测试目标：自动模式+使能+无报警 → 组框机就绪
    // ============================================================================
    // FB逻辑: q_bFrameMachine_Ready := Auto AND Enable AND (NOT AnyAlarm) AND (NOT EmergencyStop)
    // ============================================================================

    SET GlobalVars.stExternal.i_bEnable := TRUE;
    SET GlobalVars.stExternal.i_bAutoMode := TRUE;
    SET GlobalVars.stExternal.i_bAnyAlarmActive := FALSE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stExternal.o_bFrameMachine_Ready = TRUE;          // 本机就绪,可接收边框
END_TEST_CASE

TEST_CASE "TC02_External_EStop"
    // ============================================================================
    // 测试目标：组框机急停 → 紧急停止联锁
    // ============================================================================
    // FB逻辑: IF FrameMachine_EStop THEN EmergencyStop := TRUE
    // ============================================================================

    SET GlobalVars.stExternal.i_bFrameMachine_EStop := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stExternal.o_bFrameMachine_EmergencyStop = TRUE;   // 组框机急停/安全错误时强制本机停止
END_TEST_CASE

TEST_CASE "TC03_External_Alarm"
    // ============================================================================
    // 测试目标：打胶机故障 → 报警汇总码300
    // ============================================================================
    // FB逻辑: IF GlueMachine_Fault THEN AlarmCode := 300
    // ============================================================================

    SET GlobalVars.stExternal.i_bGlueMachine_Fault := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stExternal.o_iExternalDeviceAlarmSummary = 300;       // 外部设备故障报警代码(300~399范围)
END_TEST_CASE

TEST_CASE "TC04_External_Safety"
    // ============================================================================
    // 测试目标：无急停无故障 → 安全条件满足
    // ============================================================================
    // FB逻辑: 所有设备EStop和Fault都为FALSE时 SafetyConditionMet := TRUE
    // ============================================================================

    WAIT_CYCLES 3;
    ASSERT GlobalVars.stExternal.o_bSystemSafetyConditionMet = TRUE;        // 系统安全条件满足
END_TEST_CASE

TEST_CASE "TC05_External_DoorOpen"
    // ============================================================================
    // 测试目标：组框机开门请求 → 本机暂停+确认开门
    // ============================================================================
    // FB逻辑: IF DoorOpenRequest THEN Pause:=TRUE AND DoorOpen:=TRUE
    // ============================================================================

    SET GlobalVars.stExternal.i_bDoorOpenRequest := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stExternal.o_bFrameMachine_Pause = TRUE;             // 向组框机发送暂停命令
    ASSERT GlobalVars.stExternal.o_bDoorOpenRequest = TRUE;                 // 向组框机请求开门操作
END_TEST_CASE

TEST_CASE "TC06_PickPlace_Clamp"
    // ============================================================================
    // 测试目标：取放料手动模式前夹紧 → Action=TRUE + Release=FALSE
    // ============================================================================
    // FB_1003手动: IF i_bLx_FrontClamp THEN q_bFrontClamp:=TRUE
    // OB1后处理:  o_bFrontClamp_Release := NOT o_bFrontClamp_Action
    // ============================================================================

    SET GlobalVars.stPickPlace.i_bManualMode := TRUE;
    SET GlobalVars.stPickPlace.i_bLx_FrontClamp := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stPickPlace.o_bFrontClamp_Action = TRUE;             // 前夹爪夹紧电磁阀
    ASSERT GlobalVars.stPickPlace.o_bFrontClamp_Release = FALSE;            // 前夹爪松开电磁阀
END_TEST_CASE

TEST_CASE "TC07_PickPlace_LiftUp"
    // ============================================================================
    // 测试目标：取放料手动模式上升 → LiftUp=TRUE + LiftDown=FALSE
    // ============================================================================
    // FB_1003手动: IF LiftUp AND NOT LiftDown THEN q_bLiftUp:=TRUE
    // ============================================================================

    SET GlobalVars.stPickPlace.i_bManualMode := TRUE;
    SET GlobalVars.stPickPlace.i_bLx_Lift_Up := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stPickPlace.o_bLift_Up = TRUE;                        // 升降气缸上升电磁阀
    ASSERT GlobalVars.stPickPlace.o_bLift_Down = FALSE;                      // 升降气缸下降电磁阀
END_TEST_CASE

TEST_CASE "TC08_PickPlace_Unclamp"
    // ============================================================================
    // 测试目标：取放料手动模式无操作 → Release=TRUE (NOT-Action)
    // ============================================================================
    // FB_1003手动: 无按钮 → q_bFrontClamp:=FALSE
    // OB1后处理:   o_bFrontClamp_Release := NOT FALSE = TRUE
    // ============================================================================

    SET GlobalVars.stPickPlace.i_bManualMode := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stPickPlace.o_bFrontClamp_Action = FALSE;            // 前夹爪夹紧电磁阀
    ASSERT GlobalVars.stPickPlace.o_bFrontClamp_Release = TRUE;              // 前夹爪松开电磁阀
    ASSERT GlobalVars.stPickPlace.o_bRearClamp_Action = FALSE;               // 后夹爪夹紧电磁阀
    ASSERT GlobalVars.stPickPlace.o_bRearClamp_Release = TRUE;               // 后夹爪松开电磁阀
END_TEST_CASE

TEST_CASE "TC09_CommonAlarm_Reset"
    // ============================================================================
    // 测试目标：复位 → 所有报警输出清零
    // ============================================================================
    // FB_2001: IF i_bReset THEN 清零所有输出 + RETURN
    // ============================================================================

    SET GlobalVars.stGlobal.i_bReset := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stGlobal.o_wGlobalAlarmWord = 0;                     // 全局报警字(D400,HMI报警灯)
    ASSERT GlobalVars.stGlobal.o_iCurrentAlarmCode = 0;                      // 最高优先级报警代码(D402,HMI文本显示)
    ASSERT GlobalVars.stGlobal.o_bAnyAlarmActive = FALSE;                    // 全局报警激活标志(M200,所有工站停止)
    ASSERT GlobalVars.stGlobal.o_iMESAlarmCount = 0;                         // MES报警累计计数(D404)
END_TEST_CASE

TEST_CASE "TC10_CommonAlarm_NoAlarm"
    // ============================================================================
    // 测试目标：全站手动模式健康 → 无报警激活
    // ============================================================================
    // 所有FB在手动模式输出报警码=0 → FB_2001汇总无报警
    // ============================================================================

    SET GlobalVars.stConveyor.i_bManualMode := TRUE;
    SET GlobalVars.stPickPlace.i_bManualMode := TRUE;
    SET GlobalVars.stFeeder.i_bManualMode := TRUE;
    SET GlobalVars.stGlobal.i_bReset := FALSE;
    WAIT_CYCLES 5;
    ASSERT GlobalVars.stGlobal.o_bAnyAlarmActive = FALSE;                   // 全局报警激活标志(M200,所有工站停止)
    ASSERT GlobalVars.stGlobal.o_bConveyorAlarmActive = FALSE;               // 输送机站有报警标志
    ASSERT GlobalVars.stGlobal.o_bPickPlaceAlarmActive = FALSE;              // 取放料站有报警标志
    ASSERT GlobalVars.stGlobal.o_bFeederAlarmActive = FALSE;                 // 送料站有报警标志
END_TEST_CASE

TEST_CASE "TC11_PickPlace_Auto_ZAxis_Move"
    // ============================================================================
    // 测试目标：自动模式 Z 轴绝对定位 (S20_IDLE → S21_UP_TO_PICK → S22_CLAMP_AND_DETECT)
    // ============================================================================
    // FB_1003 V7.0 逻辑 (V7.1.1 修复版):
    //   S20_IDLE: 检查 stPower.Status → 设置 stPower.Enable (Z轴+X1轴)
    //            检查 stSensor.ServoAlarm → 报警73
    //            启动触发(i_bStart上升沿) + i_iPickLayer有效(1~4) → S21_UP_TO_PICK
    //   S21_UP_TO_PICK: 限位互锁 → 设置 stAbs.Position/Velocity/Execute
    //                  启动升降超时定时器
    //                  等待 stAbs.Done OR i_bLiftHomePos → S22
    //                  超时 OR stAbs.Error → 报警71/75 + S20
    //
    // V7.1.1 修复: i_iPickLayer 接线从 o_iCurrentPickLayer(输出)
    //             改为 i_iPickLayer_Input(独立输入), 断开反馈回路
    //
    // ⚠️ VAR_IN_OUT 限制说明 (LSP测试框架):
    //   io_stZAxis/io_stX1Axis 是 VAR_IN_OUT 参数, LSP采用值拷贝传递。
    //   FB内部对 io_stZAxis.stPower.Enable / io_stZAxis.stAbs.Execute 等的写入
    //   不会回写到 GlobalVars.astServoAxis[]。
    //   因此: 轴状态只能 SET(输入) 不能 ASSERT(输出),
    //        轴操作是否成功需通过 FB 自身输出(o_iCurrentState等)间接验证。
    // ============================================================================

    // --- 前置条件: 自动模式 + 层号有效 (使用独立输入变量) ---
    SET GlobalVars.stPickPlace.i_bAutoMode := TRUE;
    SET GlobalVars.stPickPlace.i_bManualMode := FALSE;
    SET GlobalVars.stPickPlace.i_bStart := TRUE;
    SET GlobalVars.stPickPlace.i_iPickLayer_Input := 1;       // V7.1.1: 独立输入, 不被FB覆盖

    // --- 显式设置速度参数 ---
    SET GlobalVars.stPickPlace.i_rZAxisSpeed := 100.0;
    SET GlobalVars.stPickPlace.i_rX1AxisSpeed := 150.0;

    // --- 模拟 Z/X1 轴初始状态 (ST_ServoAxis V3.0) [仅输入方向有效] ---
    SET GlobalVars.astServoAxis[1].stPower.Status := FALSE;     // Z轴未使能
    SET GlobalVars.astServoAxis[2].stPower.Status := FALSE;     // X1轴未使能
    SET GlobalVars.astServoAxis[1].stSensor.ServoAlarm := FALSE;
    SET GlobalVars.astServoAxis[2].stSensor.ServoAlarm := FALSE;
    SET GlobalVars.astServoAxis[1].stSensor.FwdLimit := FALSE;
    SET GlobalVars.astServoAxis[1].stSensor.RevLimit := FALSE;
    SET GlobalVars.stPickPlace.i_bLift_HomePos := FALSE;

    WAIT_CYCLES 3;

    // --- 验证 S20 → S21 转换 [通过FB自身输出间接验证] ---
    // 注: astServoAxis[*] 输出字段不可断言(VAR_IN_OUT值拷贝, 修改不回写)
    //     以下状态转换成功 = 间接证明 S20 中轴使能 + S21 中定位命令均已执行
    ASSERT GlobalVars.stPickPlace.o_iCurrentState = 1;                      // 当前状态机步骤(0~10,99=故障) [S21_UP_TO_PICK]
    ASSERT GlobalVars.stPickPlace.o_bRunning = FALSE;                         // 本站当前自动运行中

    // --- 模拟 Z 轴定位完成 (PLCopen MC_MoveAbsolute.Done) [输入方向SET有效] ---
    SET GlobalVars.astServoAxis[1].stAbs.Done := TRUE;

    WAIT_CYCLES 2;

    // --- 验证 S21 → S22 转换 [通过FB自身输出验证] ---
    ASSERT GlobalVars.stPickPlace.o_iCurrentState = 2;                        // 当前状态机步骤(0~10,99=故障) [S22_CLAMP_AND_DETECT]
    ASSERT GlobalVars.stPickPlace.o_bFrontClamp_Action = TRUE;                // 前夹爪夹紧电磁阀
    ASSERT GlobalVars.stPickPlace.o_bRearClamp_Action = TRUE;                 // 后夹爪夹紧电磁阀
END_TEST_CASE
