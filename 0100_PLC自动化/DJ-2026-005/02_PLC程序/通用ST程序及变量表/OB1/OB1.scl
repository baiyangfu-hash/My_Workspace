// ============================================================================
// OB1.scl - 边框缓存机主组织块 (V6.0.1)
// ============================================================================
// 描述:
//   DJ-2026-005 边框缓存机 PLC 控制系统主循环程序。
//   负责实例化并按工艺顺序调用各工站功能块。
//
// 架构:
//   "主控 + 功能块"模式，OB1 作为调度中心:
//   - 不包含业务逻辑
//   - 仅负责 FB 实例化与调用顺序管理
//   - 所有 I/O 映射通过 GlobalVars 数据块完成
//
// FB 调用顺序（按工艺流程）:
//   1. FB_ExternalDeviceInteraction   - 外部设备交互/安全门/急停
//   2. FB_1001_Conveyor4Layer         - 四层输送机控制
//   3. FB_1003_PickPlace              - 取放料机构
//   4. FB_1004_GlueMachineFeeder      - 打胶机送料机构
//   5. FB_2001_CommonAlarm            - 公共报警管理
//
// 变更记录:
//   V6.0.1 (2026-05-18): 修复 - 所有GlobalVars成员引用对齐GlobalVars.db实际定义
//          - stExternal: 匹配FB_ExternalDeviceInteraction实际27输入/16输出引脚
//          - stConveyor: 匹配FB_1001实际34输入/30输出(含ARRAY[1..4])引脚
//          - stPickPlace: 匹配FB_1003 V6.0.0实际51输入/20输出引脚
//          - stFeeder: 匹配FB_1004 V6.0.0实际14输入/9输出引脚
//          - stGlobal: 匹配FB_2001实际3-INT输入/10输出引脚
//   V6.0.0 (2026-05-18): Phase 3全部重写 - 同步所有FB V6.0.0新接口
// ============================================================================

ORGANIZATION_BLOCK OB1

BEGIN
    // ============================================================================
    // 第1部分：外部设备交互 (组框机/打胶机/机器人)
    // ============================================================================
    GlobalVars.fbExternalDevice(
        i_bEnable                    := GlobalVars.stExternal.i_bEnable,
        i_bAutoMode                  := GlobalVars.stExternal.i_bAutoMode,
        i_bManualMode                := GlobalVars.stExternal.i_bManualMode,
        i_bStart                     := GlobalVars.stExternal.i_bStart,
        i_bStop                      := GlobalVars.stExternal.i_bStop,
        i_bReset                     := GlobalVars.stExternal.i_bReset,

        i_bFrameMachine_AutoRunning   := GlobalVars.stExternal.i_bFrameMachine_AutoRunning,
        i_bFrameMachine_AllowFeed     := GlobalVars.stExternal.i_bFrameMachine_AllowFeed,
        i_bFrameMaterialRequest      := GlobalVars.stExternal.i_bFrameMaterialRequest,
        i_bDoorOpenRequest           := GlobalVars.stExternal.i_bDoorOpenRequest,
        i_bFrameMachine_EStop        := GlobalVars.stExternal.i_bFrameMachine_EStop,
        i_bFrameMachine_SafetyErr    := GlobalVars.stExternal.i_bFrameMachine_SafetyErr,
        i_bFrameMachine_CommErr      := GlobalVars.stExternal.i_bFrameMachine_CommErr,

        i_bGlueMachine_AutoRunning    := GlobalVars.stExternal.i_bGlueMachine_AutoRunning,
        i_bGlueMachine_AllowFeed      := GlobalVars.stExternal.i_bGlueMachine_AllowFeed,
        i_bGlueMachine_PickComplete   := GlobalVars.stExternal.i_bGlueMachine_PickComplete,
        i_bGlueMachine_Fault          := GlobalVars.stExternal.i_bGlueMachine_Fault,
        i_bGlueMachine_EStop          := GlobalVars.stExternal.i_bGlueMachine_EStop,
        i_bGlueMachine_CommErr        := GlobalVars.stExternal.i_bGlueMachine_CommErr,

        i_bRobot_AutoRunning          := GlobalVars.stExternal.i_bRobot_AutoRunning,
        i_bRobot_StackComplete        := GlobalVars.stExternal.i_bRobot_StackComplete,
        i_bRobot_Fault                := GlobalVars.stExternal.i_bRobot_Fault,
        i_bRobot_EStop                := GlobalVars.stExternal.i_bRobot_EStop,
        i_bRobot_CommErr              := GlobalVars.stExternal.i_bRobot_CommErr,

        i_bLocalReady                 := GlobalVars.stExternal.i_bLocalReady,
        i_bAnyAlarmActive            := GlobalVars.stExternal.i_bAnyAlarmActive,
        i_bSystemFault               := GlobalVars.stExternal.i_bSystemFault,

        q_bFrameMachine_RequestFeed   => GlobalVars.stExternal.o_bFrameMachine_RequestFeed,
        q_bFrameMachine_Pause         => GlobalVars.stExternal.o_bFrameMachine_Pause,
        q_bFrameMachine_EStop         => GlobalVars.stExternal.o_bFrameMachine_EStop,
        q_bDoorOpenRequest            => GlobalVars.stExternal.o_bDoorOpenRequest,
        q_bFrameMachine_Ready         => GlobalVars.stExternal.o_bFrameMachine_Ready,

        q_bGlueMachine_RequestRun     => GlobalVars.stExternal.o_bGlueMachine_RequestRun,
        q_bAllowPickup                => GlobalVars.stExternal.o_bAllowPickup,
        q_bSafetyZoneSignal           => GlobalVars.stExternal.o_bSafetyZoneSignal,
        q_bGlueMachine_ResetReq       => GlobalVars.stExternal.o_bGlueMachine_ResetReq,

        q_bRobot_AllowStacking        => GlobalVars.stExternal.o_bRobot_AllowStacking,
        q_bRobot_StopStacking         => GlobalVars.stExternal.o_bRobot_StopStacking,
        q_bRobot_ResetReq             => GlobalVars.stExternal.o_bRobot_ResetReq,

        q_bFrameMachine_EmergencyStop => GlobalVars.stExternal.o_bFrameMachine_EmergencyStop,
        q_bExternalDeviceFault        => GlobalVars.stExternal.o_bExternalDeviceFault,
        q_iExternalDeviceAlarmSummary => GlobalVars.stExternal.o_iExternalDeviceAlarmSummary,
        q_bSystemSafetyConditionMet   => GlobalVars.stExternal.o_bSystemSafetyConditionMet
    );

    // ============================================================================
    // 第2部分：四层输送机 (FB_1001容器 → 内部4×FB_1002)
    // ============================================================================
    GlobalVars.fbConveyor4Layer(
        i_bEnable                    := GlobalVars.stConveyor.i_bEnable,
        i_bAutoMode                  := GlobalVars.stConveyor.i_bAutoMode,
        i_bManualMode                := GlobalVars.stConveyor.i_bManualMode,
        i_bStart                     := GlobalVars.stConveyor.i_bStart,
        i_bStop                      := GlobalVars.stConveyor.i_bStop,
        i_bReset                     := GlobalVars.stConveyor.i_bReset,

        i_rConveyorSpeed             := GlobalVars.stConveyor.i_rConveyorSpeed,
        i_iSeparateTime              := GlobalVars.stConveyor.i_iSeparateTime,
        i_iBlockWaitTime             := GlobalVars.stConveyor.i_iBlockWaitTime,

        i_bLx_BlockDown              := GlobalVars.stConveyor.i_bLx_BlockDown,
        i_bLx_BlockUp                := GlobalVars.stConveyor.i_bLx_BlockUp,
        i_bLx_SeparatePush           := GlobalVars.stConveyor.i_bLx_SeparatePush,
        i_bLx_SeparateReset          := GlobalVars.stConveyor.i_bLx_SeparateReset,
        i_bLx_ConveyorFwd            := GlobalVars.stConveyor.i_bLx_ConveyorFwd,
        i_bLx_ConveyorRev            := GlobalVars.stConveyor.i_bLx_ConveyorRev,

        i_bPreSeparateSensor         := GlobalVars.stConveyor.i_bPreSeparateSensor,
        i_bPositionSensor1           := GlobalVars.stConveyor.i_bPositionSensor1,
        i_bPositionSensor2           := GlobalVars.stConveyor.i_bPositionSensor2,
        i_bBlockCylinderUp           := GlobalVars.stConveyor.i_bBlockCylinderUp,
        i_bBlockCylinderDown         := GlobalVars.stConveyor.i_bBlockCylinderDown,
        i_bSeparateCylinderUp        := GlobalVars.stConveyor.i_bSeparateCylinderUp,
        i_bSeparateCylinderDown      := GlobalVars.stConveyor.i_bSeparateCylinderDown,

        i_bFeedComplete              := GlobalVars.stConveyor.i_bFeedComplete,

        o_bBlockSolenoid             => GlobalVars.stConveyor.o_bBlockSolenoid,
        o_bSeparateSolenoid          => GlobalVars.stConveyor.o_bSeparateSolenoid,
        o_bConveyorFwd               => GlobalVars.stConveyor.o_bConveyorFwd,
        o_bConveyorSlow              => GlobalVars.stConveyor.o_bConveyorSlow,
        o_bConveyorRev               => GlobalVars.stConveyor.o_bConveyorRev,

        o_bFeedComplete              => GlobalVars.stConveyor.o_bFeedComplete,

        o_bRunning                   => GlobalVars.stConveyor.o_bRunning,
        o_bFault                     => GlobalVars.stConveyor.o_bFault,
        o_iCurrentState              => GlobalVars.stConveyor.o_iCurrentState,
        o_LxCurrentStep              => GlobalVars.stConveyor.o_LxCurrentStep,
        o_iAlarmCode                 => GlobalVars.stConveyor.o_iAlarmCode
    );

    // ============================================================================
    // 第3部分：取放料机构 (FB_1003 V6.0.0, 6步S20~S25状态机)
    // ============================================================================
    GlobalVars.fbPickPlace(
        i_bAutoMode                  := GlobalVars.stPickPlace.i_bAutoMode,
        i_bManualMode                := GlobalVars.stPickPlace.i_bManualMode,
        i_bStart                     := GlobalVars.stPickPlace.i_bStart,
        i_bStop                      := GlobalVars.stPickPlace.i_bStop,

        i_bLx_FrontClamp             := GlobalVars.stPickPlace.i_bLx_FrontClamp,
        i_bLx_RearClamp              := GlobalVars.stPickPlace.i_bLx_RearClamp,
        i_bLx_FrontClamp2            := GlobalVars.stPickPlace.i_bLx_FrontClamp2,
        i_bLx_RearClamp2             := GlobalVars.stPickPlace.i_bLx_RearClamp2,
        i_bLx_LiftUp                 := GlobalVars.stPickPlace.i_bLx_Lift_Up,
        i_bLx_LiftDown               := GlobalVars.stPickPlace.i_bLx_Lift_Down,

        i_iPickLayer                 := GlobalVars.stPickPlace.o_iCurrentPickLayer,
        i_rZSpeed                    := GlobalVars.stPickPlace.i_rZAxisSpeed,
        i_rX1Speed                   := GlobalVars.stPickPlace.i_rX1AxisSpeed,
        i_iClampConfirmTime          := GlobalVars.stPickPlace.i_iClampConfirmTime,
        i_iLiftActionTime            := GlobalVars.stPickPlace.i_iLiftActionTime,

        i_bLayerFeedDone             := GlobalVars.stConveyor.o_bFeedComplete,

        i_bLongEdge1Detect           := GlobalVars.stPickPlace.i_bLongEdge1Detect,
        i_bLongEdge2Detect           := GlobalVars.stPickPlace.i_bLongEdge2Detect,
        i_bShortEdge1Detect          := GlobalVars.stPickPlace.i_bShortEdge1Detect,
        i_bShortEdge2Detect          := GlobalVars.stPickPlace.i_bShortEdge2Detect,

        i_bFrontClampClosed          := GlobalVars.stPickPlace.i_bFrontClamp_Closed,
        i_bFrontClampOpened          := GlobalVars.stPickPlace.i_bFrontClamp_Opened,
        i_bRearClampClosed           := GlobalVars.stPickPlace.i_bRearClamp_Closed,
        i_bRearClampOpened           := GlobalVars.stPickPlace.i_bRearClamp_Opened,
        i_bFrontClamp2Closed         := GlobalVars.stPickPlace.i_bFrontClamp2_Closed,
        i_bFrontClamp2Opened         := GlobalVars.stPickPlace.i_bFrontClamp2_Opened,
        i_bRearClamp2Closed          := GlobalVars.stPickPlace.i_bRearClamp2_Closed,
        i_bRearClamp2Opened          := GlobalVars.stPickPlace.i_bRearClamp2_Opened,

        i_bLiftHomePos               := GlobalVars.stPickPlace.i_bLift_HomePos,
        i_bLiftWorkPoint             := GlobalVars.stPickPlace.i_bLift_WorkPoint,

        i_bFrameDetect1              := FALSE,
        i_bFrameDetect2              := FALSE,
        i_bFullMaterialDetect1       := FALSE,
        i_bFullMaterialDetect2       := FALSE,

        q_bFrontClamp                => GlobalVars.stPickPlace.o_bFrontClamp_Action,
        q_bRearClamp                 => GlobalVars.stPickPlace.o_bRearClamp_Action,
        q_bFrontClamp2               => GlobalVars.stPickPlace.o_bFrontClamp2_Action,
        q_bRearClamp2                => GlobalVars.stPickPlace.o_bRearClamp2_Action,
        q_bLiftUp                    => GlobalVars.stPickPlace.o_bLift_Up,
        q_bLiftDown                  => GlobalVars.stPickPlace.o_bLift_Down,

        q_iCurrentState              => GlobalVars.stPickPlace.o_iCurrentState,
        q_iCurrentPickLayer         => GlobalVars.stPickPlace.o_iCurrentPickLayer,
        q_iAlarmCode                 => GlobalVars.stPickPlace.o_iStationAlarmCode,
        q_bPlaceDoneToFeeder         => GlobalVars.stPickPlace.o_bPlaceComplete_ToFeeder,
        q_bRunning                   => GlobalVars.stPickPlace.o_bRunning
    );

    // --- PickPlace后处理: 双电磁阀松开输出 = NOT 夹紧输出 ---
    GlobalVars.stPickPlace.o_bFrontClamp_Release  := NOT GlobalVars.stPickPlace.o_bFrontClamp_Action;
    GlobalVars.stPickPlace.o_bRearClamp_Release   := NOT GlobalVars.stPickPlace.o_bRearClamp_Action;
    GlobalVars.stPickPlace.o_bFrontClamp2_Release := NOT GlobalVars.stPickPlace.o_bFrontClamp2_Action;
    GlobalVars.stPickPlace.o_bRearClamp2_Release   := NOT GlobalVars.stPickPlace.o_bRearClamp2_Action;

    // ============================================================================
    // 第4部分：打胶机送料机构 (FB_1004 V6.0.0, 4步D760状态机)
    // ============================================================================
    // --- 工站间信号: PickPlace放料完成 → Feeder接收 ---
    GlobalVars.stFeeder.i_bPickPlace_FeedComplete := GlobalVars.stPickPlace.o_bPlaceComplete_ToFeeder;

    GlobalVars.fbGlueFeeder(
        i_bAutoMode                  := GlobalVars.stFeeder.i_bAutoMode,
        i_bManualMode                := GlobalVars.stFeeder.i_bManualMode,
        i_bStart                     := GlobalVars.stFeeder.i_bStart,
        i_bStop                      := GlobalVars.stFeeder.i_bStop,

        i_bLx_X2JogPos               := GlobalVars.stFeeder.i_bLx_X2Axis_JogFwd,
        i_bLx_X2JogNeg               := GlobalVars.stFeeder.i_bLx_X2Axis_JogRev,

        i_bPlaceDone                 := GlobalVars.stFeeder.i_bPickPlace_FeedComplete,
        i_rX2Speed                   := GlobalVars.stFeeder.i_rFeedSpeed,

        i_bGlueMachineAllowFeed      := GlobalVars.stFeeder.i_bGlueMachine_AllowFeed,
        i_bGlueMachinePickupComplete := GlobalVars.stFeeder.i_bGlueMachine_PickupComplete,

        i_bX2ZoneSensor1             := FALSE,
        i_bX2ZoneSensor2             := FALSE,
        i_bX2ZoneSensor3             := FALSE,
        i_bX2ZoneSensor4             := FALSE,

        q_bX2AxisMoveAbsReq          => GlobalVars.stFeeder.o_bX2Axis_RequestFwd,
        q_bAllowPickup               => GlobalVars.stFeeder.o_bAllowPickup,
        q_bSafetyZoneSignal          => GlobalVars.stFeeder.o_bSafetyZoneSignal,
        q_iCurrentState              => GlobalVars.stFeeder.o_iCurrentState,
        q_iAlarmCode                 => GlobalVars.stFeeder.o_iStationAlarmCode,
        q_bRunning                   => GlobalVars.stFeeder.o_bRunning
    );

    // ============================================================================
    // 第5部分：公共报警管理 (FB_2001 V2.1.0)
    // ============================================================================
    GlobalVars.fbCommonAlarm(
        i_iConveyorAlarm             := GlobalVars.stConveyor.o_iAlarmCode,
        i_iPickPlaceAlarm            := GlobalVars.stPickPlace.o_iStationAlarmCode,
        i_iFeederAlarm               := GlobalVars.stFeeder.o_iStationAlarmCode,
        i_bReset                     := GlobalVars.stGlobal.i_bReset,

        o_wGlobalAlarmWord           => GlobalVars.stGlobal.o_wGlobalAlarmWord,
        o_iCurrentAlarmCode          => GlobalVars.stGlobal.o_iCurrentAlarmCode,
        o_bAnyAlarmActive            => GlobalVars.stGlobal.o_bAnyAlarmActive,
        o_iMESAlarmCount             => GlobalVars.stGlobal.o_iMESAlarmCount,
        o_iMESAlarmQueue             => GlobalVars.stGlobal.o_iMESAlarmQueue,
        o_bNewAlarmFlag              => GlobalVars.stGlobal.o_bNewAlarmFlag,
        o_iStationAlarmStatus        => GlobalVars.stGlobal.o_iStationAlarmStatus,
        o_bConveyorAlarmActive       => GlobalVars.stGlobal.o_bConveyorAlarmActive,
        o_bPickPlaceAlarmActive      => GlobalVars.stGlobal.o_bPickPlaceAlarmActive,
        o_bFeederAlarmActive         => GlobalVars.stGlobal.o_bFeederAlarmActive
    );

END_ORGANIZATION_BLOCK
