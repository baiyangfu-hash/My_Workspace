// ============================================================================
// FB_1002_SingleLayerConveyor_BufferFraming
// 描述：边框缓存机单层输送机控制
// 项目：DJ-2026-005
// 版本：V1.0.0
// 日期：2026-05-04
// ============================================================================
//
// 功能：
//   1. 自动模式：单层分料的 8 步状态机
//   2. 手动模式：各执行器直接控制
//   3. 报警检测：7 种报警类型（1~7）
//   4. 定时器：使用 SysLib FB_TON（PT/ET 为 DINT，不用 TIME）
//
// 状态机步骤：
//   0 = 空闲
//   1 = 等待分料前光电
//   2 = 阻挡气缸下降
//   3 = 分料气缸推出（保持 SeparateTime）
//   4 = 分料气缸复位
//   5 = 等待到位光电
//   6 = 输送前进
//   7 = 等待上游允许放料
//   8 = 放料完成信号
//
// 报警码（1~7）：
//   1 = 阻挡气缸动作超时
//   2 = 分料气缸推出超时
//   3 = 分料气缸复位超时
//   4 = 到位光电等待超时
//   5 = 输送前进超时
//   6 = 阻挡气缸传感器冲突（上位+下位同时为TRUE）
//   7 = 分料气缸传感器冲突（上位+下位同时为TRUE）
// ============================================================================

FUNCTION_BLOCK FB_1002_SingleLayerConveyor_BufferFraming

//#region 100_VAR_INPUT
VAR_INPUT
    // 系统控制信号
    i_bEnable           : BOOL;    // 总使能
    i_bAutoMode         : BOOL;    // 自动模式选择
    i_bManualMode       : BOOL;    // 手动调试模式选择
    i_bStart            : BOOL;    // 自动启动按钮
    i_bStop             : BOOL;    // 自动停止按钮
    i_bReset            : BOOL;    // 故障复位/初始化按钮

    // 工艺参数
    i_rConveyorSpeed    : REAL;    // 输送速度设定（Hz 或 m/min）
    i_iSeparateTime     : INT;     // 分料动作保持时间（ms）
    i_iBlockWaitTime    : INT;     // 阻挡气缸动作等待时间（ms）

    // 手动操作信号
    i_bLx_BlockDown     : BOOL;    // 手动-阻挡下降
    i_bLx_BlockUp       : BOOL;    // 手动-阻挡上升
    i_bLx_SeparatePush  : BOOL;    // 手动-分料推出
    i_bLx_SeparateReset : BOOL;    // 手动-分料复位
    i_bLx_ConveyorFwd   : BOOL;    // 手动-输送正转
    i_bLx_ConveyorRev   : BOOL;    // 手动-输送反转

    // 传感器输入
    i_bPreSeparateSensor    : BOOL;    // 分料前到料检测
    i_bPositionSensor1      : BOOL;    // 到位光电1
    i_bPositionSensor2      : BOOL;    // 到位光电2
    i_bBlockCylinderUp      : BOOL;    // 阻挡气缸上位（放行位）
    i_bBlockCylinderDown    : BOOL;    // 阻挡气缸下位（阻挡位）
    i_bSeparateCylinderUp   : BOOL;    // 分料气缸上位（缩回位）
    i_bSeparateCylinderDown : BOOL;    // 分料气缸下位（伸出位）

    // 上游/下游信号
    i_bUpstreamAllowFeed    : BOOL;    // 下游允许本层放料
END_VAR
//#endregion 100_VAR_INPUT

//#region 200_VAR_OUTPUT
VAR_OUTPUT
    // 执行器输出
    o_bBlockSolenoid    : BOOL;    // TRUE=下降（阻挡），FALSE=上升（放行）
    o_bSeparateSolenoid : BOOL;    // TRUE=推出（分料），FALSE=复位
    o_bConveyorFwd      : BOOL;    // 输送正转
    o_bConveyorSlow     : BOOL;    // 输送慢速
    o_bConveyorRev      : BOOL;    // 输送反转

    // 下游信号
    o_bFeedComplete     : BOOL;    // 本层放料完成

    // 状态输出
    o_bRunning          : BOOL;    // 自动运行中
    o_bFault            : BOOL;    // 本层故障
    o_iCurrentState     : INT;     // 当前状态（0=空闲，1~8=步骤，99=故障）
    o_iAlarmCode        : INT;     // 报警码（0=无，1~7=报警类型）
END_VAR
//#endregion 200_VAR_OUTPUT

//#region 300_VAR
VAR
    // 状态机核心
    s_iCurrentStep      : INT;     // 当前状态机步骤
    s_bRunning          : BOOL;    // 自动运行标志
    s_bFault            : BOOL;    // 故障标志
    s_iActiveAlarmCode  : INT;     // 当前激活报警码

    // 定时器（SysLib FB_TON，PT/ET 为 DINT）
    fb_tBlockTimer      : FB_TON;  // 阻挡气缸动作定时
    fb_tSeparateTimer   : FB_TON;  // 分料动作保持定时
    fb_tSeparateResetTimer : FB_TON; // 分料复位定时
    fb_tPositionTimer   : FB_TON;  // 到位等待定时
    fb_tConveyorTimer   : FB_TON;  // 输送前进定时

    // 定时器 Q 输出
    s_bBlockTimer_Q         : BOOL;
    s_bSeparateTimer_Q      : BOOL;
    s_bSeparateResetTimer_Q : BOOL;
    s_bPositionTimer_Q      : BOOL;
    s_bConveyorTimer_Q      : BOOL;

    // 定时器 ET 输出（DINT，扫描周期数）
    s_diBlockTimer_ET          : DINT;
    s_diSeparateTimer_ET       : DINT;
    s_diSeparateResetTimer_ET  : DINT;
    s_diPositionTimer_ET       : DINT;
    s_diConveyorTimer_ET       : DINT;

    // 物料存在标志
    s_bMaterialPresent   : BOOL;   // 到位处检测到物料
END_VAR
//#endregion 300_VAR

//#region 400_VAR_CONSTANT
VAR CONSTANT
    // 状态机步骤
    STP_Idle            : INT := 0;   // 空闲
    STP_WaitPreSeparate : INT := 1;   // 等待分料前光电
    STP_BlockDown       : INT := 2;   // 阻挡气缸下降
    STP_SeparatePush    : INT := 3;   // 分料气缸推出
    STP_SeparateReset   : INT := 4;   // 分料气缸复位
    STP_WaitPosition    : INT := 5;   // 等待到位光电
    STP_ConveyorFwd     : INT := 6;   // 输送前进
    STP_WaitAllowFeed   : INT := 7;   // 等待允许放料
    STP_FeedComplete    : INT := 8;   // 放料完成信号

    // 报警码（1~7）
    ALM_BlockTimeout        : INT := 1;  // 阻挡气缸动作超时
    ALM_SeparatePushTimeout : INT := 2;  // 分料推出超时
    ALM_SeparateResetTimeout : INT := 3; // 分料复位超时
    ALM_PositionTimeout     : INT := 4;  // 到位光电等待超时
    ALM_ConveyorTimeout     : INT := 5;  // 输送前进超时
    ALM_BlockSensorConflict : INT := 6;  // 阻挡传感器冲突
    ALM_SeparateSensorConflict : INT := 7; // 分料传感器冲突

    // 默认定时参数（DINT，扫描周期数，假设 1ms/周期）
    T_DEF_BlockAction    : DINT := 3000;   // 阻挡气缸超时（3s）
    T_DEF_SeparateHold   : DINT := 500;    // 分料保持时间
    T_DEF_SeparateReset  : DINT := 500;    // 分料复位时间
    T_DEF_PositionWait   : DINT := 5000;   // 到位等待（5s）
    T_DEF_ConveyorRun    : DINT := 3000;   // 输送前进时间（3s）
END_VAR
//#endregion 400_VAR_CONSTANT

// ============================================================================
// 主程序逻辑
// ============================================================================

// --- 使能关闭：进入安全状态，所有输出清零 ---
IF NOT i_bEnable THEN
    o_bBlockSolenoid := FALSE;
    o_bSeparateSolenoid := FALSE;
    o_bConveyorFwd := FALSE;
    o_bConveyorSlow := FALSE;
    o_bConveyorRev := FALSE;
    o_bFeedComplete := FALSE;
    s_iCurrentStep := STP_Idle;
    s_bRunning := FALSE;
    s_bFault := FALSE;
    s_iActiveAlarmCode := 0;
    s_bMaterialPresent := FALSE;
    o_bRunning := FALSE;
    o_bFault := FALSE;
    o_iCurrentState := STP_Idle;
    o_iAlarmCode := 0;

    fb_tBlockTimer(IN := FALSE, PT := 0, Q => s_bBlockTimer_Q, ET => s_diBlockTimer_ET);
    fb_tSeparateTimer(IN := FALSE, PT := 0, Q => s_bSeparateTimer_Q, ET => s_diSeparateTimer_ET);
    fb_tSeparateResetTimer(IN := FALSE, PT := 0, Q => s_bSeparateResetTimer_Q, ET => s_diSeparateResetTimer_ET);
    fb_tPositionTimer(IN := FALSE, PT := 0, Q => s_bPositionTimer_Q, ET => s_diPositionTimer_ET);
    fb_tConveyorTimer(IN := FALSE, PT := 0, Q => s_bConveyorTimer_Q, ET => s_diConveyorTimer_ET);
    RETURN;
END_IF;

// --- 传感器冲突检测 ---
IF i_bBlockCylinderUp AND i_bBlockCylinderDown THEN
    s_iActiveAlarmCode := ALM_BlockSensorConflict;
    s_bFault := TRUE;
END_IF;
IF i_bSeparateCylinderUp AND i_bSeparateCylinderDown THEN
    s_iActiveAlarmCode := ALM_SeparateSensorConflict;
    s_bFault := TRUE;
END_IF;

// --- 故障处理 ---
IF s_bFault THEN
    o_bBlockSolenoid := FALSE;
    o_bSeparateSolenoid := FALSE;
    o_bConveyorFwd := FALSE;
    o_bConveyorSlow := FALSE;
    o_bConveyorRev := FALSE;
    o_bFeedComplete := FALSE;
    s_bRunning := FALSE;
    fb_tBlockTimer(IN := FALSE, PT := 0, Q => s_bBlockTimer_Q, ET => s_diBlockTimer_ET);
    fb_tSeparateTimer(IN := FALSE, PT := 0, Q => s_bSeparateTimer_Q, ET => s_diSeparateTimer_ET);
    fb_tSeparateResetTimer(IN := FALSE, PT := 0, Q => s_bSeparateResetTimer_Q, ET => s_diSeparateResetTimer_ET);
    fb_tPositionTimer(IN := FALSE, PT := 0, Q => s_bPositionTimer_Q, ET => s_diPositionTimer_ET);
    fb_tConveyorTimer(IN := FALSE, PT := 0, Q => s_bConveyorTimer_Q, ET => s_diConveyorTimer_ET);

    // 复位处理
    IF i_bReset THEN
        s_iActiveAlarmCode := 0;
        s_bFault := FALSE;
        s_iCurrentStep := STP_Idle;
        s_bMaterialPresent := FALSE;
    END_IF;

    o_bRunning := FALSE;
    o_bFault := TRUE;
    o_iCurrentState := 99;
    o_iAlarmCode := s_iActiveAlarmCode;
    RETURN;
END_IF;

// --- 停止处理 ---
IF i_bStop AND s_bRunning THEN
    s_iCurrentStep := STP_Idle;
    s_bRunning := FALSE;
    o_bBlockSolenoid := FALSE;
    o_bSeparateSolenoid := FALSE;
    o_bConveyorFwd := FALSE;
    o_bConveyorSlow := FALSE;
    o_bConveyorRev := FALSE;
    o_bFeedComplete := FALSE;
    fb_tBlockTimer(IN := FALSE, PT := 0, Q => s_bBlockTimer_Q, ET => s_diBlockTimer_ET);
    fb_tSeparateTimer(IN := FALSE, PT := 0, Q => s_bSeparateTimer_Q, ET => s_diSeparateTimer_ET);
    fb_tSeparateResetTimer(IN := FALSE, PT := 0, Q => s_bSeparateResetTimer_Q, ET => s_diSeparateResetTimer_ET);
    fb_tPositionTimer(IN := FALSE, PT := 0, Q => s_bPositionTimer_Q, ET => s_diPositionTimer_ET);
    fb_tConveyorTimer(IN := FALSE, PT := 0, Q => s_bConveyorTimer_Q, ET => s_diConveyorTimer_ET);
END_IF;

// --- 模式分发 ---
IF i_bAutoMode THEN
    // ========================================================================
    // 自动模式：8步状态机
    // ========================================================================
    CASE s_iCurrentStep OF

    STP_Idle:
        o_bBlockSolenoid := FALSE;
        o_bSeparateSolenoid := FALSE;
        o_bConveyorFwd := FALSE;
        o_bConveyorSlow := FALSE;
        o_bConveyorRev := FALSE;
        o_bFeedComplete := FALSE;
        s_bMaterialPresent := FALSE;

        IF i_bStart THEN
            s_iCurrentStep := STP_WaitPreSeparate;
            s_bRunning := TRUE;
        END_IF;

    STP_WaitPreSeparate:
        IF i_bPreSeparateSensor THEN
            s_iCurrentStep := STP_BlockDown;
            o_bBlockSolenoid := TRUE;
            fb_tBlockTimer(IN := TRUE, PT := T_DEF_BlockAction, Q => s_bBlockTimer_Q, ET => s_diBlockTimer_ET);
        END_IF;

    STP_BlockDown:
        o_bBlockSolenoid := TRUE;
        IF i_bBlockCylinderDown THEN
            fb_tBlockTimer(IN := FALSE, PT := 0, Q => s_bBlockTimer_Q, ET => s_diBlockTimer_ET);
            s_iCurrentStep := STP_SeparatePush;
            o_bSeparateSolenoid := TRUE;
            fb_tSeparateTimer(IN := TRUE, PT := i_iSeparateTime, Q => s_bSeparateTimer_Q, ET => s_diSeparateTimer_ET);
        ELSIF s_bBlockTimer_Q THEN
            fb_tBlockTimer(IN := FALSE, PT := 0, Q => s_bBlockTimer_Q, ET => s_diBlockTimer_ET);
            s_iActiveAlarmCode := ALM_BlockTimeout;
            s_bFault := TRUE;
        END_IF;

    STP_SeparatePush:
        o_bBlockSolenoid := TRUE;
        o_bSeparateSolenoid := TRUE;
        IF s_bSeparateTimer_Q THEN
            fb_tSeparateTimer(IN := FALSE, PT := 0, Q => s_bSeparateTimer_Q, ET => s_diSeparateTimer_ET);
            s_iCurrentStep := STP_SeparateReset;
            o_bSeparateSolenoid := FALSE;
            fb_tSeparateResetTimer(IN := TRUE, PT := T_DEF_SeparateReset, Q => s_bSeparateResetTimer_Q, ET => s_diSeparateResetTimer_ET);
        END_IF;

    STP_SeparateReset:
        o_bBlockSolenoid := TRUE;
        o_bSeparateSolenoid := FALSE;
        IF i_bSeparateCylinderUp OR s_bSeparateResetTimer_Q THEN
            fb_tSeparateResetTimer(IN := FALSE, PT := 0, Q => s_bSeparateResetTimer_Q, ET => s_diSeparateResetTimer_ET);
            s_iCurrentStep := STP_WaitPosition;
            fb_tPositionTimer(IN := TRUE, PT := T_DEF_PositionWait, Q => s_bPositionTimer_Q, ET => s_diPositionTimer_ET);
        END_IF;

    STP_WaitPosition:
        o_bBlockSolenoid := TRUE;
        s_bMaterialPresent := i_bPositionSensor1 AND i_bPositionSensor2;
        IF s_bMaterialPresent THEN
            fb_tPositionTimer(IN := FALSE, PT := 0, Q => s_bPositionTimer_Q, ET => s_diPositionTimer_ET);
            s_iCurrentStep := STP_ConveyorFwd;
            o_bConveyorFwd := TRUE;
            fb_tConveyorTimer(IN := TRUE, PT := T_DEF_ConveyorRun, Q => s_bConveyorTimer_Q, ET => s_diConveyorTimer_ET);
        ELSIF s_bPositionTimer_Q THEN
            fb_tPositionTimer(IN := FALSE, PT := 0, Q => s_bPositionTimer_Q, ET => s_diPositionTimer_ET);
            s_iActiveAlarmCode := ALM_PositionTimeout;
            s_bFault := TRUE;
        END_IF;

    STP_ConveyorFwd:
        o_bConveyorFwd := TRUE;
        o_bBlockSolenoid := FALSE;
        IF s_bConveyorTimer_Q THEN
            fb_tConveyorTimer(IN := FALSE, PT := 0, Q => s_bConveyorTimer_Q, ET => s_diConveyorTimer_ET);
            s_iCurrentStep := STP_WaitAllowFeed;
            o_bConveyorFwd := FALSE;
        END_IF;

    STP_WaitAllowFeed:
        IF i_bUpstreamAllowFeed THEN
            s_iCurrentStep := STP_FeedComplete;
            o_bFeedComplete := TRUE;
        END_IF;

    STP_FeedComplete:
        o_bFeedComplete := TRUE;
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
        o_bFeedComplete := FALSE;

    ELSE
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
    END_CASE;

ELSIF i_bManualMode THEN
    // ========================================================================
    // 手动模式：直接控制
    // ========================================================================
    s_bRunning := FALSE;
    s_iCurrentStep := STP_Idle;
    o_bFeedComplete := FALSE;

    // 阻挡气缸手动
    IF i_bLx_BlockDown AND NOT i_bLx_BlockUp THEN
        o_bBlockSolenoid := TRUE;
    ELSIF i_bLx_BlockUp AND NOT i_bLx_BlockDown THEN
        o_bBlockSolenoid := FALSE;
    END_IF;

    // 分料气缸手动
    IF i_bLx_SeparatePush AND NOT i_bLx_SeparateReset THEN
        o_bSeparateSolenoid := TRUE;
    ELSIF i_bLx_SeparateReset AND NOT i_bLx_SeparatePush THEN
        o_bSeparateSolenoid := FALSE;
    END_IF;

    // 输送手动
    IF i_bLx_ConveyorFwd AND NOT i_bLx_ConveyorRev THEN
        o_bConveyorFwd := TRUE;
        o_bConveyorRev := FALSE;
    ELSIF i_bLx_ConveyorRev AND NOT i_bLx_ConveyorFwd THEN
        o_bConveyorRev := TRUE;
        o_bConveyorFwd := FALSE;
    ELSE
        o_bConveyorFwd := FALSE;
        o_bConveyorRev := FALSE;
    END_IF;

    o_bConveyorSlow := FALSE;

ELSE
    // 无效模式：安全状态
    o_bBlockSolenoid := FALSE;
    o_bSeparateSolenoid := FALSE;
    o_bConveyorFwd := FALSE;
    o_bConveyorSlow := FALSE;
    o_bConveyorRev := FALSE;
    o_bFeedComplete := FALSE;
    IF NOT s_bFault THEN
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
    END_IF;
END_IF;

// --- 状态输出 ---
o_bRunning := s_bRunning;
o_bFault := s_bFault;
IF s_bFault THEN
    o_iCurrentState := 99;
ELSE
    o_iCurrentState := s_iCurrentStep;
END_IF;
o_iAlarmCode := s_iActiveAlarmCode;

END_FUNCTION_BLOCK
