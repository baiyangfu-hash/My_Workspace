(* ================================================================= *)
(*  功能块名称：FB_1002_SingleLayerConveyor_BufferFraming              *)
(*  功能描述：单层输送机编排器 - 9步状态机+手动模式分发（纯调度）    *)
(*  版本号：V9.0.0                                                    *)
(*  创建日期：2026-06-16                                              *)
(*  编制人：Trae                                                      *)
(*  审核人：人工                                                      *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - LSP-905-V1.0.2 SCL编程规范                                    *)
(*    - LSP-904-V1.2.0 SCL注释规范                                    *)
(*    - LSP-903-V2.1.0 定时器使用规范                                *)
(*                                                                     *)
(*  V9.0.0变更 (2026-06-16, Breaking Change):                         *)
(*    - 适配: FB_1011/FB_1012 V9.0.0 扁平化接口变更                   *)
(*    - 移除: VAR_IN_OUT 结构体参数, 改为独立参数调用                 *)
(*    - 新增: i_dSeparateTimeoutMs DINT 类型超时参数                  *)
(*    - 新增: i_dDebounceMs DINT 类型消抖参数                         *)
(*    - 修复: 类型不匹配问题 (INT -> DINT)                            *)
(*                                                                     *)
(*  V8.0.0变更 (2026-05-27):                                          *)
(*    - 重构: FB_1011/FB_1012 改用 VAR_IN_OUT 结构体参数             *)
(*    - 新增: stBlockCyl/stSeparateCyl : ST_Cylinder 结构体实例       *)
(*    - 新增: stConveyorMotor : ST_ConveyorMotor 结构体实例           *)
(*    - 删除: 逐字段赋值调用, 改为结构体字段直接操作                  *)
(*    - 参考: FB_1003 VAR_IN_OUT io_stZAxis:ST_ServoAxis 模式        *)
(*                                                                     *)
(*  V7.0.0变更:                                                        *)
(*    - 取消 FB_1001 容器,OB1 FOR循环直接实例化                      *)
(*    - FB_1002 瘦身为纯编排器,不包含执行器控制细节                 *)
(*    - 气缸控制→FB_1011_CylinderControl (fbBlock/fbSeparate)        *)
(*    - 电机控制→FB_1012_ConveyorMotor (fbMotor)                      *)
(*    - 删除4个内部TONR定时器,时序委托子FB                          *)
(*    - 删除4路传感器冗余检测,委托FB_1011                           *)
(*    - 报警自包含编码: 10x/11x/12x/13x/14x                          *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1002_SingleLayerConveyor_BufferFraming

(* ==================== VAR_INPUT ==================== *)
VAR_INPUT
    (* 模式与控制 *)
    i_bAutoMode                 : BOOL;     // 自动运行模式
    i_bManualMode               : BOOL;     // 手动调试模式
    i_bStart                    : BOOL;     // 自动循环启动 上升沿
    i_bStop                     : BOOL;     // 停止 电平有效

    (* 配置参数 *)
    i_iLayerIndex               : INT;      // 层编号 1~4 报警编码用
    i_iSeparateTimeoutMs        : INT;      // 分料超时时间(ms), 兼容旧接口
    i_dSeparateTimeoutMs        : DINT := 5000;  // 分料超时时间(ms), DINT类型
    i_dDebounceMs               : DINT := 0;  // 传感器消抖时间(ms), 0=关闭

    (* 传感器输入 *)
    i_bPreSeparateSensor        : BOOL;     // 分料前接近开关
    i_bPositionSensor1          : BOOL;     // 到位传感器1
    i_bPositionSensor2          : BOOL;     // 到位传感器2 冗余
    i_bBlockCylinderUp          : BOOL;     // 阻挡气缸上位
    i_bBlockCylinderDown        : BOOL;     // 阻挡气缸下位
    i_bSeparateCylinderUp       : BOOL;     // 分料气缸上位
    i_bSeparateCylinderDown     : BOOL;     // 分料气缸下位

    (* 安全与外部联锁 *)
    i_bSafetyDoorOk             : BOOL;     // 安全门状态 TRUE=关闭OK (FB_1012不处理)
    i_bVfdFault                 : BOOL;     // 变频器故障
    i_bPickupConfirmed          : BOOL;     // 取料机构已取走物料

    (* 手动操作命令 *)
    i_bManBlockExtend           : BOOL;     // 手动:阻挡下降
    i_bManBlockRetract          : BOOL;     // 手动:阻挡上升
    i_bManSeparatePush          : BOOL;     // 手动:分料推出 TRUE=推出
    i_bManConveyorFwd           : BOOL;     // 手动:输送正转
    i_bManConveyorRev           : BOOL;     // 手动:输送反转
    i_bManConveyorSlow          : BOOL;     // 手动:输送慢速
END_VAR

(* ==================== VAR_OUTPUT ==================== *)
VAR_OUTPUT
    (* 执行器输出 *)
    q_bBlockSolenoid            : BOOL;     // 阻挡电磁阀 TRUE=下降
    q_bSeparateSolenoid         : BOOL;     // 分料电磁阀 TRUE=推出
    q_bConveyorFwd              : BOOL;     // 输送带正转
    q_bConveyorRev              : BOOL;     // 输送带反转
    q_bConveyorSlow             : BOOL;     // 输送带慢速

    (* 状态与报警 *)
    q_iCurrentState             : INT;      // 当前步序 0~70
    q_iAlarmCode                : INT;      // 本层报警码 0=正常
    q_bRunning                  : BOOL;     // 自动运行中
    q_bFault                    : BOOL;     // 本层有故障
    q_bLayerFeedDone            : BOOL;     // 本层放料完成 脉冲
    q_bAnySensorFault           : BOOL;     // 任一气缸传感器故障
END_VAR

(* ==================== VAR ==================== *)
VAR
    (* 子功能块实例 *)
    fbBlock                     : FB_1011_CylinderControl;  // 阻挡气缸
    fbSeparate                  : FB_1011_CylinderControl;  // 分料气缸
    fbMotor                     : FB_1012_ConveyorMotor;    // 输送电机

    (* 内部命令变量 *)
    bBlockExtend                : BOOL;     // 阻挡气缸伸出命令
    bBlockRetract               : BOOL;     // 阻挡气缸收回命令
    bSeparateExtend             : BOOL;     // 分料气缸伸出命令
    bSeparateRetract            : BOOL;     // 分料气缸收回命令
    bMotorFwd                   : BOOL;     // 电机正转命令
    bMotorRev                   : BOOL;     // 电机反转命令
    bMotorSlow                  : BOOL;     // 电机慢速命令

    (* 内部状态变量 *)
    bBlockIsExtended            : BOOL;     // 阻挡气缸已伸出
    bBlockIsRetracted           : BOOL;     // 阻挡气缸已收回
    bBlockTimeout               : BOOL;     // 阻挡气缸超时
    bBlockSensorFault           : BOOL;     // 阻挡气缸传感器故障
    bSeparateIsExtended         : BOOL;     // 分料气缸已伸出
    bSeparateIsRetracted        : BOOL;     // 分料气缸已收回
    bSeparateTimeout            : BOOL;     // 分料气缸超时
    bSeparateSensorFault        : BOOL;     // 分料气缸传感器故障
    bMotorRunning               : BOOL;     // 电机运行中
    bMotorVfdAlarm              : BOOL;     // 电机VFD报警

    (* 状态机变量 *)
    bStepEntry                  : BOOL;     // 新步入口标志
    bRunning                    : BOOL;     // 运行标志 内部
    bStartTriggered             : BOOL;     // 启动上升沿锁存
    iCurrentState               : INT;      // 当前步序 内部
    iAlarmCode                  : INT;      // 报警码 内部
    dSeparateTimeoutMs          : DINT;     // 实际使用的超时时间 DINT
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    STEP_INIT                   : INT := 0;   // 初始化反转
    STEP_WAIT_MATERIAL          : INT := 1;   // 等待来料
    STEP_BLOCK_DOWN             : INT := 2;   // 阻挡下降
    STEP_CONVEYOR_FWD           : INT := 10;  // 输送正转
    STEP_POSITION_CHECK_BLOCK_UP : INT := 20; // 到位检测+阻挡上升
    STEP_SEPARATE_PUSH          : INT := 30;  // 分料推出
    STEP_CONVEYOR_SLOW          : INT := 50;  // 慢速送出
    STEP_REQUEST_PICKUP         : INT := 60;  // 请求取料
    STEP_SEPARATE_RETURN        : INT := 70;  // 分料复位
END_VAR

(* ==================== 超时参数转换: 兼容旧接口 ==================== *)
IF i_dSeparateTimeoutMs > 0 THEN
    dSeparateTimeoutMs := i_dSeparateTimeoutMs;
ELSIF i_iSeparateTimeoutMs > 0 THEN
    dSeparateTimeoutMs := DINT#(i_iSeparateTimeoutMs);
ELSE
    dSeparateTimeoutMs := DINT#5000;
END_IF;

(* ==================== 模式使能检查 ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    bBlockExtend := FALSE;
    bBlockRetract := FALSE;
    bSeparateExtend := FALSE;
    bSeparateRetract := FALSE;
    bMotorFwd := FALSE;
    bMotorRev := FALSE;
    bMotorSlow := FALSE;

    q_bLayerFeedDone := FALSE;
    q_iAlarmCode := 0;
    q_bAnySensorFault := FALSE;
    q_bFault := FALSE;
    q_bRunning := FALSE;

    iCurrentState := STEP_INIT;
    bRunning := FALSE;
    bStartTriggered := FALSE;
    bStepEntry := TRUE;
    iAlarmCode := 0;

    (* 调用子FB *)
    fbBlock(
        i_bExtend := FALSE,
        i_bRetract := FALSE,
        i_bExtendedPos := i_bBlockCylinderDown,
        i_bRetractedPos := i_bBlockCylinderUp,
        i_dTimeoutMs := dSeparateTimeoutMs,
        i_dDebounceMs := i_dDebounceMs,
        i_iSolenoidType := INT#0,
        i_bExtendPolarity := FALSE,
        q_bSolenoid => q_bBlockSolenoid,
        q_bIsExtended => bBlockIsExtended,
        q_bIsRetracted => bBlockIsRetracted,
        q_bTimeout => bBlockTimeout,
        q_bSensorFault => bBlockSensorFault
    );

    fbSeparate(
        i_bExtend := FALSE,
        i_bRetract := FALSE,
        i_bExtendedPos := i_bSeparateCylinderDown,
        i_bRetractedPos := i_bSeparateCylinderUp,
        i_dTimeoutMs := dSeparateTimeoutMs,
        i_dDebounceMs := i_dDebounceMs,
        i_iSolenoidType := INT#0,
        i_bExtendPolarity := FALSE,
        q_bSolenoid => q_bSeparateSolenoid,
        q_bIsExtended => bSeparateIsExtended,
        q_bIsRetracted => bSeparateIsRetracted,
        q_bTimeout => bSeparateTimeout,
        q_bSensorFault => bSeparateSensorFault
    );

    fbMotor(
        i_bFwdCmd := FALSE,
        i_bRevCmd := FALSE,
        i_bSlowCmd := FALSE,
        i_bVfdFault := i_bVfdFault,
        i_iCtrlMode := INT#0,
        i_rSpeed := REAL#100.0,
        q_bFwdOut => q_bConveyorFwd,
        q_bRevOut => q_bConveyorRev,
        q_bSlowOut => q_bConveyorSlow,
        q_bRunning => bMotorRunning,
        q_bVfdAlarm => bMotorVfdAlarm
    );

    RETURN;
END_IF;

(* ==================== 停止处理 ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := STEP_INIT;
    bRunning := FALSE;
    bStepEntry := TRUE;

    bBlockExtend := FALSE;
    bBlockRetract := TRUE;
    bSeparateExtend := FALSE;
    bSeparateRetract := TRUE;
    bMotorFwd := FALSE;
    bMotorRev := FALSE;
    bMotorSlow := FALSE;

    q_bLayerFeedDone := FALSE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* VFD故障互锁 *)
    IF i_bVfdFault THEN
        bMotorFwd := FALSE;
        bMotorRev := FALSE;
        bMotorSlow := FALSE;
        iAlarmCode := 100 + i_iLayerIndex;
    END_IF;

    (* 启动触发 *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
        bRunning := TRUE;
    END_IF;

    (* ==================== 9步状态机 ==================== *)
    CASE iCurrentState OF

        STEP_INIT:
            IF bStepEntry THEN
                bBlockExtend := FALSE;
                bBlockRetract := TRUE;
                bSeparateExtend := FALSE;
                bSeparateRetract := TRUE;
                bMotorFwd := FALSE;
                bMotorSlow := FALSE;
                bMotorRev := TRUE;
                q_bLayerFeedDone := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF bBlockIsRetracted THEN
                bMotorRev := FALSE;
                bStepEntry := TRUE;
                iCurrentState := STEP_WAIT_MATERIAL;
            END_IF;

        STEP_WAIT_MATERIAL:
            IF bStepEntry THEN
                bStepEntry := FALSE;
            END_IF;

            IF i_bPreSeparateSensor THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_BLOCK_DOWN;
            END_IF;

        STEP_BLOCK_DOWN:
            IF bStepEntry THEN
                bBlockExtend := TRUE;
                bBlockRetract := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF bBlockIsExtended THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_CONVEYOR_FWD;
            END_IF;

        STEP_CONVEYOR_FWD:
            IF bStepEntry THEN
                bMotorFwd := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPositionSensor1 AND i_bPositionSensor2 THEN
                bMotorFwd := FALSE;
                bStepEntry := TRUE;
                iCurrentState := STEP_POSITION_CHECK_BLOCK_UP;
            END_IF;

        STEP_POSITION_CHECK_BLOCK_UP:
            IF bStepEntry THEN
                bBlockExtend := FALSE;
                bBlockRetract := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF bBlockIsRetracted THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_SEPARATE_PUSH;
            END_IF;

        STEP_SEPARATE_PUSH:
            IF bStepEntry THEN
                bSeparateExtend := TRUE;
                bSeparateRetract := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF bSeparateTimeout THEN
                iAlarmCode := 130 + i_iLayerIndex;
            END_IF;

            IF bSeparateIsExtended THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_CONVEYOR_SLOW;
            END_IF;

        STEP_CONVEYOR_SLOW:
            IF bStepEntry THEN
                bMotorSlow := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPositionSensor1 AND i_bPositionSensor2 THEN
                bMotorSlow := FALSE;
                bStepEntry := TRUE;
                iCurrentState := STEP_REQUEST_PICKUP;
            END_IF;

        STEP_REQUEST_PICKUP:
            IF bStepEntry THEN
                q_bLayerFeedDone := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPickupConfirmed THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_SEPARATE_RETURN;
            END_IF;

        STEP_SEPARATE_RETURN:
            IF bStepEntry THEN
                bSeparateExtend := FALSE;
                bSeparateRetract := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF bSeparateTimeout THEN
                iAlarmCode := 130 + i_iLayerIndex;
            END_IF;

            IF bSeparateIsRetracted THEN
                q_bLayerFeedDone := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_INIT;
            END_IF;

        ELSE
            iCurrentState := STEP_INIT;
            bRunning := FALSE;
            bStepEntry := TRUE;

    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE;
    iCurrentState := STEP_INIT;
    bStepEntry := TRUE;
    q_bLayerFeedDone := FALSE;

    bBlockExtend := i_bManBlockExtend;
    bBlockRetract := i_bManBlockRetract AND NOT i_bManBlockExtend;

    bSeparateExtend := i_bManSeparatePush;
    bSeparateRetract := NOT i_bManSeparatePush;

    bMotorFwd := i_bManConveyorFwd;
    bMotorRev := i_bManConveyorRev;
    bMotorSlow := i_bManConveyorSlow;

END_IF;

(* ==================== 调用子FB ==================== *)
fbBlock(
    i_bExtend := bBlockExtend,
    i_bRetract := bBlockRetract,
    i_bExtendedPos := i_bBlockCylinderDown,
    i_bRetractedPos := i_bBlockCylinderUp,
    i_dTimeoutMs := dSeparateTimeoutMs,
    i_dDebounceMs := i_dDebounceMs,
    i_iSolenoidType := INT#0,
    i_bExtendPolarity := FALSE,
    q_bSolenoid => q_bBlockSolenoid,
    q_bIsExtended => bBlockIsExtended,
    q_bIsRetracted => bBlockIsRetracted,
    q_bTimeout => bBlockTimeout,
    q_bSensorFault => bBlockSensorFault
);

fbSeparate(
    i_bExtend := bSeparateExtend,
    i_bRetract := bSeparateRetract,
    i_bExtendedPos := i_bSeparateCylinderDown,
    i_bRetractedPos := i_bSeparateCylinderUp,
    i_dTimeoutMs := dSeparateTimeoutMs,
    i_dDebounceMs := i_dDebounceMs,
    i_iSolenoidType := INT#0,
    i_bExtendPolarity := FALSE,
    q_bSolenoid => q_bSeparateSolenoid,
    q_bIsExtended => bSeparateIsExtended,
    q_bIsRetracted => bSeparateIsRetracted,
    q_bTimeout => bSeparateTimeout,
    q_bSensorFault => bSeparateSensorFault
);

fbMotor(
    i_bFwdCmd := bMotorFwd,
    i_bRevCmd := bMotorRev,
    i_bSlowCmd := bMotorSlow,
    i_bVfdFault := i_bVfdFault,
    i_iCtrlMode := INT#0,
    i_rSpeed := REAL#100.0,
    q_bFwdOut => q_bConveyorFwd,
    q_bRevOut => q_bConveyorRev,
    q_bSlowOut => q_bConveyorSlow,
    q_bRunning => bMotorRunning,
    q_bVfdAlarm => bMotorVfdAlarm
);

(* ==================== 报警编码 自包含 ==================== *)
iAlarmCode := 0;

IF bMotorVfdAlarm THEN
    iAlarmCode := 100 + i_iLayerIndex;
END_IF;

IF bBlockTimeout THEN
    iAlarmCode := 110 + i_iLayerIndex;
END_IF;

IF bBlockSensorFault THEN
    IF iAlarmCode = 0 THEN
        iAlarmCode := 120 + i_iLayerIndex;
    END_IF;
END_IF;

IF bSeparateTimeout THEN
    iAlarmCode := 130 + i_iLayerIndex;
END_IF;

IF bSeparateSensorFault THEN
    IF iAlarmCode = 0 THEN
        iAlarmCode := 140 + i_iLayerIndex;
    END_IF;
END_IF;

q_iAlarmCode := iAlarmCode;
q_bAnySensorFault := bBlockSensorFault OR bSeparateSensorFault;
q_bFault := (iAlarmCode > 0);

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;

END_FUNCTION_BLOCK