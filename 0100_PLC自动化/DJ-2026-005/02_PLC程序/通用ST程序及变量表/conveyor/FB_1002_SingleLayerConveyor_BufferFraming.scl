(* ================================================================= *)
(*  功能块名称：FB_1002_SingleLayerConveyor_BufferFraming              *)
(*  功能描述：单层输送机控制 - 9步Step_S状态机（先输送再分料）      *)
(*  创建日期：2026-05-04                                              *)
(*  版本号：V6.0.0                                                    *)
(*  编制人：Trae                                                      *)
(*  审核人：人工                                                      *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - 801_PLC变量命名与功能块命名规范_DEV-V1.0.5                    *)
(*    - 810_PLC编程规范_DEV-V1.0.2                                    *)
(*                                                                     *)
(*  变更记录：                                                          *)
(* ---------------------------------------------------------------- *)
(*  V6.0.0 (2026-05-18) Trae                                         *)
(*  - 重写: 8步→9步Step_S状态机，先输送再分料（对齐源程序）        *)
(*  - 重写: o_前缀→q_前缀，s_前缀改为纯前缀（801规范）             *)
(*  - 新增: STEP_INIT初始化反转步                                     *)
(*  - 新增: VFD故障检测、安全门互锁、取料安全区互锁                 *)
(*  - 新增: 传感器双通道冗余一致性检查(阻挡/分料上下位)            *)
(*  - 新增: 分料超时报警(100~103)，冗余不一致报警(130~163)         *)
(*  - 新增: 4个TONR定时器（tIn/tQ/tR/tPt/tEt简化命名）             *)
(* ---------------------------------------------------------------- *)
(*  V1.0.0 (2026-05-04)                                              *)
(*  - 初始版本创建（8步先分料后输送，已废弃）                      *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1002_SingleLayerConveyor_BufferFraming

(* ==================== VAR_INPUT ==================== *)
VAR_INPUT
    i_bAutoMode                 : BOOL;     (* 自动运行模式 *)
    i_bManualMode               : BOOL;     (* 手动调试模式 *)
    i_bStart                    : BOOL;     (* 启动信号 *)
    i_bStop                     : BOOL;     (* 停止信号 *)

    i_bLx_BlockDown             : BOOL;     (* 手动:阻挡下降 *)
    i_bLx_SeparatePush          : BOOL;     (* 手动:分料推出 *)
    i_bLx_ConveyorFwd           : BOOL;     (* 手动:输送正转 *)
    i_bLx_ConveyorRev           : BOOL;     (* 手动:输送反转 *)
    i_bLx_ConveyorSlow          : BOOL;     (* 手动:输送慢速 *)
    i_bLx_BlockUp               : BOOL;     (* 手动:阻挡上升 *)

    i_rConveyorSpeed            : REAL;     (* 输送自动速度(mm/s) *)
    i_iSeparateTime             : INT;      (* 分料动作超时时间(ms) *)
    i_iBlockWaitTime            : INT;      (* 阻挡等待时间(ms) *)

    i_bSafetyDoorOk             : BOOL;     (* 安全门状态(TRUE=OK) *)
    i_bPickPlaceSafeZone        : BOOL;     (* 取料机构安全区(TRUE=安全) *)
    i_iLayerIndex               : INT;      (* 当前层编号(1~4) *)

    i_bPreSeparateSensor        : BOOL;     (* 分料前接近开关 *)
    i_bPositionSensor1          : BOOL;     (* 到位传感器1 *)
    i_bPositionSensor2          : BOOL;     (* 到位传感器2 *)
    i_bBlockCylinderUp          : BOOL;     (* 阻挡气缸上位 *)
    i_bBlockCylinderDown        : BOOL;     (* 阻挡气缸下位 *)
    i_bSeparateCylinderUp       : BOOL;     (* 分料气缸上位 *)
    i_bSeparateCylinderDown     : BOOL;     (* 分料气缸下位 *)

    i_bVfdFault                 : BOOL;     (* 变频器异常 *)
    i_bPickupConfirmed          : BOOL;     (* FB_1003取料确认 *)
END_VAR

(* ==================== VAR_OUTPUT ==================== *)
VAR_OUTPUT
    q_bBlockSolenoid            : BOOL;     (* 阻挡气缸(ON=下降) *)
    q_bSeparateSolenoid         : BOOL;     (* 分料气缸(ON=推出) *)
    q_bConveyorFwd              : BOOL;     (* 输送正转 *)
    q_bConveyorRev              : BOOL;     (* 输送反转 *)
    q_bConveyorSlow             : BOOL;     (* 输送慢速 *)

    q_iCurrentState             : INT;      (* 当前步序值(0~70) *)
    q_iAlarmCode                : INT;      (* 当前报警码(0=正常) *)
    q_bLayerFeedDone            : BOOL;     (* 本层放料完成脉冲 *)
    q_bSensorFaultBlockUp       : BOOL;     (* 阻挡上位传感器冗余不一致 *)
    q_bSensorFaultBlockDown     : BOOL;     (* 阻挡下位传感器冗余不一致 *)
    q_bSensorFaultSeparateUp    : BOOL;     (* 分料上位传感器冗余不一致 *)
    q_bSensorFaultSeparateDown  : BOOL;     (* 分料下位传感器冗余不一致 *)
    q_bSeparateTimeout          : BOOL;     (* 分料动作超时 *)
    q_bRunning                  : BOOL;     (* 运行中 *)
END_VAR

(* ==================== VAR ==================== *)
VAR
    bStepEntry              : BOOL;         (* 新步入口标志 *)

    tIn                     : ARRAY[0..3] OF BOOL;   (* 定时器输入 *)
    tQ                      : ARRAY[0..3] OF BOOL;   (* 定时器输出 *)
    tR                      : ARRAY[0..3] OF BOOL;   (* 定时器复位 *)
    tPt                     : ARRAY[0..3] OF DINT;   (* 定时器预设值 *)
    tEt                     : ARRAY[0..3] OF DINT;   (* 定时器当前值 *)

    tSeparateTimer          : FB_TONR;       (* 分料超时 *)
    tSlowTimer              : FB_TONR;       (* 慢速送出 *)
    tConvFwdTimer           : FB_TONR;       (* 输送正转 *)
    tInitTimer              : FB_TONR;       (* 初始化反转 *)

    bSensorFaultBlockUp     : BOOL;          (* 阻挡上位冗余不一致内部 *)
    bSensorFaultBlockDown   : BOOL;          (* 阻挡下位冗余不一致内部 *)
    bSensorFaultSeparateUp  : BOOL;          (* 分料上位冗余不一致内部 *)
    bSensorFaultSeparateDown: BOOL;          (* 分料下位冗余不一致内部 *)
    bSeparateTimeout        : BOOL;          (* 分料超时内部 *)
    iAlarmCode              : INT;           (* 报警码内部 *)
    iCurrentState           : INT;           (* 当前状态内部 *)
    bRunning                : BOOL;          (* 运行标志 *)
    bStartTriggered         : BOOL;          (* 启动上升沿锁存 *)
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    STEP_INIT                   : INT := 0;   (* 初始化反转 *)
    STEP_WAIT_MATERIAL          : INT := 1;   (* 等待来料 *)
    STEP_BLOCK_DOWN             : INT := 2;   (* 阻挡下降 *)
    STEP_CONVEYOR_FWD           : INT := 10;  (* 输送正转 *)
    STEP_POSITION_CHECK_BLOCK_UP : INT := 20; (* 到位检测+阻挡上升 *)
    STEP_SEPARATE_PUSH          : INT := 30;  (* 分料推出 *)
    STEP_CONVEYOR_SLOW          : INT := 50;  (* 慢速送出 *)
    STEP_REQUEST_PICKUP         : INT := 60;  (* 请求取料 *)
    STEP_SEPARATE_RETURN        : INT := 70;  (* 分料复位 *)

    T_INIT_REVERSE              : DINT := 3000;  (* 初始化反转3s *)
    T_CONVEYOR_FWD              : DINT := 5000;  (* 输送正转5s *)
    T_SLOW                      : DINT := 2000;  (* 慢速送出2s *)
END_VAR

(* ==================== 定时器调用 ==================== *)
tSeparateTimer(IN := tIn[0], R := tR[0], PT := tPt[0], Q => tQ[0], ET => tEt[0]);
tSlowTimer(IN := tIn[1], R := tR[1], PT := tPt[1], Q => tQ[1], ET => tEt[1]);
tConvFwdTimer(IN := tIn[2], R := tR[2], PT := tPt[2], Q => tQ[2], ET => tEt[2]);
tInitTimer(IN := tIn[3], R := tR[3], PT := tPt[3], Q => tQ[3], ET => tEt[3]);

(* ==================== 使能关闭：安全状态 ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    q_bBlockSolenoid := FALSE;
    q_bSeparateSolenoid := FALSE;
    q_bConveyorFwd := FALSE;
    q_bConveyorRev := FALSE;
    q_bConveyorSlow := FALSE;
    q_bLayerFeedDone := FALSE;
    q_iAlarmCode := 0;
    q_bSensorFaultBlockUp := FALSE;
    q_bSensorFaultBlockDown := FALSE;
    q_bSensorFaultSeparateUp := FALSE;
    q_bSensorFaultSeparateDown := FALSE;
    q_bSeparateTimeout := FALSE;
    q_bRunning := FALSE;
    iCurrentState := STEP_INIT;
    bRunning := FALSE;
    bStartTriggered := FALSE;
    bStepEntry := TRUE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
    tIn[3] := FALSE; tR[3] := TRUE;
    RETURN;
END_IF;

(* ==================== 传感器冗余一致性检查 ==================== *)
(* 注：实际冗余传感器需在 DB1 中做双通道一致性比对后
   以独立 BOOL 信号传入。以下占位逻辑检测上下位同时ON冲突 *)
bSensorFaultBlockUp    := i_bBlockCylinderUp AND i_bBlockCylinderDown;
bSensorFaultBlockDown  := bSensorFaultBlockUp;
bSensorFaultSeparateUp := i_bSeparateCylinderUp AND i_bSeparateCylinderDown;
bSensorFaultSeparateDown := bSensorFaultSeparateUp;

q_bSensorFaultBlockUp := bSensorFaultBlockUp;
q_bSensorFaultBlockDown := bSensorFaultBlockDown;
q_bSensorFaultSeparateUp := bSensorFaultSeparateUp;
q_bSensorFaultSeparateDown := bSensorFaultSeparateDown;

(* ==================== 停止处理 ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := STEP_INIT;
    bRunning := FALSE;
    bStepEntry := TRUE;
    q_bBlockSolenoid := FALSE;
    q_bSeparateSolenoid := FALSE;
    q_bConveyorFwd := FALSE;
    q_bConveyorSlow := FALSE;
    q_bConveyorRev := FALSE;
    q_bLayerFeedDone := FALSE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
    tIn[3] := FALSE; tR[3] := TRUE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* --- VFD故障、安全门、取料安全区互锁 --- *)
    IF i_bVfdFault THEN
        q_bConveyorFwd := FALSE;
        q_bConveyorRev := FALSE;
        q_bConveyorSlow := FALSE;
        iAlarmCode := i_iLayerIndex * 10 + 5; (* VFD报警 *)
    END_IF;

    (* --- 启动触发 --- *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
        bRunning := TRUE;
    END_IF;

    (* ==================== 9步状态机 ==================== *)
    CASE iCurrentState OF

        STEP_INIT: (* 0 - 初始化反转 *)
            IF bStepEntry THEN
                q_bBlockSolenoid := FALSE;
                q_bSeparateSolenoid := FALSE;
                q_bConveyorFwd := FALSE;
                q_bConveyorSlow := FALSE;
                q_bLayerFeedDone := FALSE;
                IF i_bSafetyDoorOk THEN
                    q_bConveyorRev := TRUE;
                END_IF;
                tIn[3] := TRUE; tR[3] := FALSE;
                tPt[3] := T_INIT_REVERSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[3] THEN
                q_bConveyorRev := FALSE;
                tIn[3] := FALSE; tR[3] := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_WAIT_MATERIAL;
            END_IF;

        STEP_WAIT_MATERIAL: (* 1 - 等待来料 *)
            IF bStepEntry THEN
                bStepEntry := FALSE;
            END_IF;

            IF i_bPreSeparateSensor THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_BLOCK_DOWN;
            END_IF;

        STEP_BLOCK_DOWN: (* 2 - 阻挡下降 *)
            IF bStepEntry THEN
                q_bBlockSolenoid := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bBlockCylinderDown THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_CONVEYOR_FWD;
            END_IF;

        STEP_CONVEYOR_FWD: (* 10 - 输送正转 *)
            IF bStepEntry THEN
                IF i_bSafetyDoorOk THEN
                    q_bConveyorFwd := TRUE;
                END_IF;
                tIn[2] := TRUE; tR[2] := FALSE;
                tPt[2] := T_CONVEYOR_FWD;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[2] THEN
                q_bConveyorFwd := FALSE;
                tIn[2] := FALSE; tR[2] := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_POSITION_CHECK_BLOCK_UP;
            END_IF;

        STEP_POSITION_CHECK_BLOCK_UP: (* 20 - 到位检测+阻挡上升 *)
            IF bStepEntry THEN
                q_bBlockSolenoid := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPositionSensor1 AND i_bPositionSensor2 AND i_bBlockCylinderUp THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_SEPARATE_PUSH;
            END_IF;

        STEP_SEPARATE_PUSH: (* 30 - 分料推出 *)
            IF bStepEntry THEN
                q_bSeparateSolenoid := TRUE;
                IF i_iSeparateTime > 0 THEN
                    tPt[0] := INT_TO_DINT(i_iSeparateTime);
                ELSE
                    tPt[0] := 2000;
                END_IF;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[0] THEN
                iAlarmCode := 100 + i_iLayerIndex;
                bSeparateTimeout := TRUE;
                q_bSeparateTimeout := TRUE;
            END_IF;

            IF i_bSeparateCylinderDown THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_CONVEYOR_SLOW;
            END_IF;

        STEP_CONVEYOR_SLOW: (* 50 - 慢速送出 *)
            IF bStepEntry THEN
                IF i_bSafetyDoorOk THEN
                    q_bConveyorSlow := TRUE;
                END_IF;
                tIn[1] := TRUE; tR[1] := FALSE;
                tPt[1] := T_SLOW;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[1] THEN
                q_bConveyorSlow := FALSE;
                tIn[1] := FALSE; tR[1] := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_REQUEST_PICKUP;
            END_IF;

        STEP_REQUEST_PICKUP: (* 60 - 请求取料 *)
            IF bStepEntry THEN
                q_bLayerFeedDone := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPickupConfirmed THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_SEPARATE_RETURN;
            END_IF;

        STEP_SEPARATE_RETURN: (* 70 - 分料复位 *)
            IF bStepEntry THEN
                q_bSeparateSolenoid := FALSE;
                IF i_iSeparateTime > 0 THEN
                    tPt[0] := INT_TO_DINT(i_iSeparateTime);
                ELSE
                    tPt[0] := 2000;
                END_IF;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[0] THEN
                iAlarmCode := 100 + i_iLayerIndex;
                bSeparateTimeout := TRUE;
                q_bSeparateTimeout := TRUE;
            END_IF;

            IF i_bSeparateCylinderUp THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bLayerFeedDone := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_INIT;
            END_IF;

        ELSE
            iCurrentState := STEP_INIT;
            bRunning := FALSE;
            bStepEntry := TRUE;
    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE;
    iCurrentState := STEP_INIT;
    bStepEntry := TRUE;
    q_bLayerFeedDone := FALSE;

    IF i_bLx_BlockDown AND NOT i_bLx_BlockUp THEN
        q_bBlockSolenoid := TRUE;
    ELSIF i_bLx_BlockUp AND NOT i_bLx_BlockDown THEN
        q_bBlockSolenoid := FALSE;
    END_IF;

    IF i_bLx_SeparatePush THEN
        q_bSeparateSolenoid := TRUE;
    ELSE
        q_bSeparateSolenoid := FALSE;
    END_IF;

    IF i_bLx_ConveyorFwd AND NOT i_bLx_ConveyorRev THEN
        IF i_bSafetyDoorOk THEN
            q_bConveyorFwd := TRUE;
        END_IF;
        q_bConveyorRev := FALSE;
    ELSIF i_bLx_ConveyorRev AND NOT i_bLx_ConveyorFwd THEN
        IF i_bSafetyDoorOk THEN
            q_bConveyorRev := TRUE;
        END_IF;
        q_bConveyorFwd := FALSE;
    ELSE
        q_bConveyorFwd := FALSE;
        q_bConveyorRev := FALSE;
    END_IF;

    q_bConveyorSlow := i_bLx_ConveyorSlow;

    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
    tIn[3] := FALSE; tR[3] := TRUE;

ELSE
    q_bBlockSolenoid := FALSE;
    q_bSeparateSolenoid := FALSE;
    q_bConveyorFwd := FALSE;
    q_bConveyorSlow := FALSE;
    q_bConveyorRev := FALSE;
    q_bLayerFeedDone := FALSE;
END_IF;

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;
q_iAlarmCode := iAlarmCode;

IF bSeparateTimeout AND (iCurrentState <> STEP_SEPARATE_PUSH) AND (iCurrentState <> STEP_SEPARATE_RETURN) THEN
    bSeparateTimeout := FALSE;
    q_bSeparateTimeout := FALSE;
END_IF;

END_FUNCTION_BLOCK
