(* ================================================================= *)
(*  功能块名称：FB_1002_SingleLayerConveyor_BufferFraming              *)
(*  功能描述：单层输送机编排器 - 9步状态机+手动模式分发（纯调度）    *)
(*  版本号：V7.0.0                                                    *)
(*  创建日期：2026-05-18                                              *)
(*  编制人：Trae                                                      *)
(*  审核人：人工                                                      *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - 801_PLC变量命名与功能块命名规范_DEV-V1.0.5                    *)
(*    - 810_PLC编程规范_DEV-V1.0.2                                    *)
(*                                                                     *)
(*  架构变化 V6→V7:                                                    *)
(*    - 取消 FB_1001 容器，OB1 FOR循环直接实例化                      *)
(*    - FB_1002 瘦身为纯编排器，不包含执行器控制细节                 *)
(*    - 气缸控制→FB_1011_CylinderControl (fbBlock/fbSeparate)        *)
(*    - 电机控制→FB_1012_ConveyorMotor (fbMotor)                      *)
(*    - 删除4个内部TONR定时器，时序委托子FB                          *)
(*    - 删除4路传感器冗余检测，委托FB_1011                           *)
(*    - 报警自包含编码: 10x/11x/12x/13x/14x                          *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1002_SingleLayerConveyor_BufferFraming

(* ==================== VAR_INPUT ==================== *)
VAR_INPUT
    (* 模式与控制 *)
    i_bAutoMode                 : BOOL;     (* 自动运行模式 *)
    i_bManualMode               : BOOL;     (* 手动调试模式 *)
    i_bStart                    : BOOL;     (* 自动循环启动 上升沿 *)
    i_bStop                     : BOOL;     (* 停止 电平有效 *)

    (* 配置参数 *)
    i_iLayerIndex               : INT;      (* 层编号 1~4 报警编码用 *)
    i_iSeparateTimeoutMs        : INT;      (* 分料超时时间(ms) *)

    (* 传感器输入 *)
    i_bPreSeparateSensor        : BOOL;     (* 分料前接近开关 *)
    i_bPositionSensor1          : BOOL;     (* 到位传感器1 *)
    i_bPositionSensor2          : BOOL;     (* 到位传感器2 冗余 *)
    i_bBlockCylinderUp          : BOOL;     (* 阻挡气缸上位 *)
    i_bBlockCylinderDown        : BOOL;     (* 阻挡气缸下位 *)
    i_bSeparateCylinderUp       : BOOL;     (* 分料气缸上位 *)
    i_bSeparateCylinderDown     : BOOL;     (* 分料气缸下位 *)

    (* 安全与外部联锁 *)
    i_bSafetyDoorOk             : BOOL;     (* 安全门状态 TRUE=关闭OK *)
    i_bVfdFault                 : BOOL;     (* 变频器故障 *)
    i_bPickupConfirmed          : BOOL;     (* 取料机构已取走物料 *)

    (* 手动操作命令 *)
    i_bManBlockExtend           : BOOL;     (* 手动:阻挡下降 *)
    i_bManBlockRetract          : BOOL;     (* 手动:阻挡上升 *)
    i_bManSeparatePush          : BOOL;     (* 手动:分料推出 TRUE=推出 *)
    i_bManConveyorFwd           : BOOL;     (* 手动:输送正转 *)
    i_bManConveyorRev           : BOOL;     (* 手动:输送反转 *)
    i_bManConveyorSlow          : BOOL;     (* 手动:输送慢速 *)
END_VAR

(* ==================== VAR_OUTPUT ==================== *)
VAR_OUTPUT
    (* 执行器输出 *)
    q_bBlockSolenoid            : BOOL;     (* 阻挡电磁阀 TRUE=下降 *)
    q_bSeparateSolenoid         : BOOL;     (* 分料电磁阀 TRUE=推出 *)
    q_bConveyorFwd              : BOOL;     (* 输送带正转 *)
    q_bConveyorRev              : BOOL;     (* 输送带反转 *)
    q_bConveyorSlow             : BOOL;     (* 输送带慢速 *)

    (* 状态与报警 *)
    q_iCurrentState             : INT;      (* 当前步序 0~70 *)
    q_iAlarmCode                : INT;      (* 本层报警码 0=正常 *)
    q_bRunning                  : BOOL;     (* 自动运行中 *)
    q_bFault                    : BOOL;     (* 本层有故障 *)
    q_bLayerFeedDone            : BOOL;     (* 本层放料完成 脉冲 *)
    q_bAnySensorFault           : BOOL;     (* 任一气缸传感器故障 *)
END_VAR

(* ==================== VAR ==================== *)
VAR
    (* 子功能块实例 *)
    fbBlock                     : FB_1011_CylinderControl;  (* 阻挡气缸 *)
    fbSeparate                  : FB_1011_CylinderControl;  (* 分料气缸 *)
    fbMotor                     : FB_1012_ConveyorMotor;    (* 输送电机 *)

    (* 状态机变量 *)
    bStepEntry                  : BOOL;     (* 新步入口标志 *)
    bRunning                    : BOOL;     (* 运行标志 内部 *)
    bStartTriggered             : BOOL;     (* 启动上升沿锁存 *)
    iCurrentState               : INT;      (* 当前步序 内部 *)
    iAlarmCode                  : INT;      (* 报警码 内部 *)
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    STEP_INIT                   : INT := 0;   (* 初始化反转 *)
    STEP_WAIT_MATERIAL          : INT := 1;   (* 等待来料 *)
    STEP_BLOCK_DOWN             : INT := 2;   (* 阻挡下降 *)
    STEP_CONVEYOR_FWD           : INT := 10;  (* 输送正转 *)
    STEP_POSITION_CHECK_BLOCK_UP : INT := 20; (* 到位检测+阻挡上升 *)
    STEP_SEPARATE_PUSH          : INT := 30;  (* 分料推出 *)
    STEP_CONVEYOR_SLOW          : INT := 50;  (* 慢速送出 *)
    STEP_REQUEST_PICKUP         : INT := 60;  (* 请求取料 *)
    STEP_SEPARATE_RETURN        : INT := 70;  (* 分料复位 *)
END_VAR

(* ==================== 子FB: 静态信号连线 ==================== *)
fbBlock.i_bUpSensor             := i_bBlockCylinderUp;
fbBlock.i_bDownSensor           := i_bBlockCylinderDown;

fbSeparate.i_bUpSensor          := i_bSeparateCylinderUp;
fbSeparate.i_bDownSensor        := i_bSeparateCylinderDown;

fbMotor.i_bSafetyDoorOk         := i_bSafetyDoorOk;
fbMotor.i_bVfdFault             := i_bVfdFault;

(* ==================== 模式使能检查 ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    fbBlock.i_bExtend := FALSE;
    fbBlock.i_bRetract := FALSE;
    fbSeparate.i_bExtend := FALSE;
    fbSeparate.i_bRetract := FALSE;
    fbMotor.i_bFwd := FALSE;
    fbMotor.i_bRev := FALSE;
    fbMotor.i_bSlow := FALSE;

    q_bLayerFeedDone := FALSE;
    q_iAlarmCode := 0;
    q_bAnySensorFault := FALSE;
    q_bFault := FALSE;
    q_bRunning := FALSE;

    iCurrentState := STEP_INIT;
    bRunning := FALSE;
    bStartTriggered := FALSE;
    bStepEntry := TRUE;
    iAlarmCode := 0;

    fbBlock(i_bExtend := fbBlock.i_bExtend, i_bRetract := fbBlock.i_bRetract,
            i_bUpSensor := fbBlock.i_bUpSensor, i_bDownSensor := fbBlock.i_bDownSensor,
            i_iTimeoutMs := fbBlock.i_iTimeoutMs);
    fbSeparate(i_bExtend := fbSeparate.i_bExtend, i_bRetract := fbSeparate.i_bRetract,
               i_bUpSensor := fbSeparate.i_bUpSensor, i_bDownSensor := fbSeparate.i_bDownSensor,
               i_iTimeoutMs := fbSeparate.i_iTimeoutMs);
    fbMotor(i_bFwd := fbMotor.i_bFwd, i_bRev := fbMotor.i_bRev,
            i_bSlow := fbMotor.i_bSlow, i_bSafetyDoorOk := fbMotor.i_bSafetyDoorOk,
            i_bVfdFault := fbMotor.i_bVfdFault, i_rSpeed := fbMotor.i_rSpeed);

    q_bBlockSolenoid := fbBlock.q_bSolenoid;
    q_bSeparateSolenoid := fbSeparate.q_bSolenoid;
    q_bConveyorFwd := fbMotor.q_bFwd;
    q_bConveyorRev := fbMotor.q_bRev;
    q_bConveyorSlow := fbMotor.q_bSlow;
    RETURN;
END_IF;

(* ==================== 停止处理 ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := STEP_INIT;
    bRunning := FALSE;
    bStepEntry := TRUE;

    fbBlock.i_bExtend := FALSE;
    fbBlock.i_bRetract := TRUE;
    fbSeparate.i_bExtend := FALSE;
    fbSeparate.i_bRetract := TRUE;
    fbMotor.i_bFwd := FALSE;
    fbMotor.i_bRev := FALSE;
    fbMotor.i_bSlow := FALSE;

    q_bLayerFeedDone := FALSE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* VFD故障互锁 *)
    IF i_bVfdFault THEN
        fbMotor.i_bFwd := FALSE;
        fbMotor.i_bRev := FALSE;
        fbMotor.i_bSlow := FALSE;
        iAlarmCode := 100 + i_iLayerIndex;
    END_IF;

    (* 启动触发 *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
        bRunning := TRUE;
    END_IF;

    (* ==================== 9步状态机 ==================== *)
    CASE iCurrentState OF

        STEP_INIT:
            IF bStepEntry THEN
                fbBlock.i_bExtend := FALSE;
                fbBlock.i_bRetract := TRUE;
                fbSeparate.i_bExtend := FALSE;
                fbSeparate.i_bRetract := TRUE;
                fbMotor.i_bFwd := FALSE;
                fbMotor.i_bSlow := FALSE;
                fbMotor.i_bRev := TRUE;
                q_bLayerFeedDone := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF fbBlock.q_bIsRetracted THEN
                fbMotor.i_bRev := FALSE;
                bStepEntry := TRUE;
                iCurrentState := STEP_WAIT_MATERIAL;
            END_IF;

        STEP_WAIT_MATERIAL:
            IF bStepEntry THEN
                bStepEntry := FALSE;
            END_IF;

            IF i_bPreSeparateSensor THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_BLOCK_DOWN;
            END_IF;

        STEP_BLOCK_DOWN:
            IF bStepEntry THEN
                fbBlock.i_bExtend := TRUE;
                fbBlock.i_bRetract := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF fbBlock.q_bIsExtended THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_CONVEYOR_FWD;
            END_IF;

        STEP_CONVEYOR_FWD:
            IF bStepEntry THEN
                fbMotor.i_bFwd := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPositionSensor1 AND i_bPositionSensor2 THEN
                fbMotor.i_bFwd := FALSE;
                bStepEntry := TRUE;
                iCurrentState := STEP_POSITION_CHECK_BLOCK_UP;
            END_IF;

        STEP_POSITION_CHECK_BLOCK_UP:
            IF bStepEntry THEN
                fbBlock.i_bExtend := FALSE;
                fbBlock.i_bRetract := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF fbBlock.q_bIsRetracted THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_SEPARATE_PUSH;
            END_IF;

        STEP_SEPARATE_PUSH:
            IF bStepEntry THEN
                fbSeparate.i_bExtend := TRUE;
                fbSeparate.i_bRetract := FALSE;
                fbSeparate.i_iTimeoutMs := i_iSeparateTimeoutMs;
                bStepEntry := FALSE;
            END_IF;

            IF fbSeparate.q_bTimeout THEN
                iAlarmCode := 130 + i_iLayerIndex;
            END_IF;

            IF fbSeparate.q_bIsExtended THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_CONVEYOR_SLOW;
            END_IF;

        STEP_CONVEYOR_SLOW:
            IF bStepEntry THEN
                fbMotor.i_bSlow := TRUE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPositionSensor1 AND i_bPositionSensor2 THEN
                fbMotor.i_bSlow := FALSE;
                bStepEntry := TRUE;
                iCurrentState := STEP_REQUEST_PICKUP;
            END_IF;

        STEP_REQUEST_PICKUP:
            IF bStepEntry THEN
                q_bLayerFeedDone := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bPickupConfirmed THEN
                bStepEntry := TRUE;
                iCurrentState := STEP_SEPARATE_RETURN;
            END_IF;

        STEP_SEPARATE_RETURN:
            IF bStepEntry THEN
                fbSeparate.i_bExtend := FALSE;
                fbSeparate.i_bRetract := TRUE;
                fbSeparate.i_iTimeoutMs := i_iSeparateTimeoutMs;
                bStepEntry := FALSE;
            END_IF;

            IF fbSeparate.q_bTimeout THEN
                iAlarmCode := 130 + i_iLayerIndex;
            END_IF;

            IF fbSeparate.q_bIsRetracted THEN
                q_bLayerFeedDone := TRUE;
                bStepEntry := TRUE;
                iCurrentState := STEP_INIT;
            END_IF;

        ELSE
            iCurrentState := STEP_INIT;
            bRunning := FALSE;
            bStepEntry := TRUE;

    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE;
    iCurrentState := STEP_INIT;
    bStepEntry := TRUE;
    q_bLayerFeedDone := FALSE;

    fbBlock.i_bExtend := i_bManBlockExtend;
    fbBlock.i_bRetract := i_bManBlockRetract AND NOT i_bManBlockExtend;

    fbSeparate.i_bExtend := i_bManSeparatePush;
    fbSeparate.i_bRetract := NOT i_bManSeparatePush;

    fbMotor.i_bFwd := i_bManConveyorFwd;
    fbMotor.i_bRev := i_bManConveyorRev;
    fbMotor.i_bSlow := i_bManConveyorSlow;

END_IF;

(* ==================== 调用子FB ==================== *)
fbBlock(i_bExtend := fbBlock.i_bExtend, i_bRetract := fbBlock.i_bRetract,
        i_bUpSensor := fbBlock.i_bUpSensor, i_bDownSensor := fbBlock.i_bDownSensor,
        i_iTimeoutMs := fbBlock.i_iTimeoutMs);

fbSeparate(i_bExtend := fbSeparate.i_bExtend, i_bRetract := fbSeparate.i_bRetract,
           i_bUpSensor := fbSeparate.i_bUpSensor, i_bDownSensor := fbSeparate.i_bDownSensor,
           i_iTimeoutMs := fbSeparate.i_iTimeoutMs);

fbMotor(i_bFwd := fbMotor.i_bFwd, i_bRev := fbMotor.i_bRev,
        i_bSlow := fbMotor.i_bSlow, i_bSafetyDoorOk := fbMotor.i_bSafetyDoorOk,
        i_bVfdFault := fbMotor.i_bVfdFault, i_rSpeed := fbMotor.i_rSpeed);

(* ==================== 执行器输出收集 ==================== *)
q_bBlockSolenoid := fbBlock.q_bSolenoid;
q_bSeparateSolenoid := fbSeparate.q_bSolenoid;
q_bConveyorFwd := fbMotor.q_bFwd;
q_bConveyorRev := fbMotor.q_bRev;
q_bConveyorSlow := fbMotor.q_bSlow;

(* ==================== 报警编码 自包含 ==================== *)
iAlarmCode := 0;

IF fbMotor.q_bVfdAlarm THEN
    iAlarmCode := 100 + i_iLayerIndex;
END_IF;

IF fbBlock.q_bTimeout THEN
    iAlarmCode := 110 + i_iLayerIndex;
END_IF;

IF fbBlock.q_bSensorFault THEN
    IF iAlarmCode = 0 THEN
        iAlarmCode := 120 + i_iLayerIndex;
    END_IF;
END_IF;

IF fbSeparate.q_bTimeout THEN
    iAlarmCode := 130 + i_iLayerIndex;
END_IF;

IF fbSeparate.q_bSensorFault THEN
    IF iAlarmCode = 0 THEN
        iAlarmCode := 140 + i_iLayerIndex;
    END_IF;
END_IF;

q_iAlarmCode := iAlarmCode;
q_bAnySensorFault := fbBlock.q_bSensorFault OR fbSeparate.q_bSensorFault;
q_bFault := (iAlarmCode > 0);

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;

END_FUNCTION_BLOCK
