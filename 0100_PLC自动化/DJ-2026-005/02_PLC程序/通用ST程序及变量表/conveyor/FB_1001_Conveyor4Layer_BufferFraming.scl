(* ============================================================================
 功能块名称: FB_1001_Conveyor4Layer_BufferFraming
 功能描述: 边框缓存机 - 四层输送机容器功能块(纯容器,无业务逻辑)
 ============================================================================
 项目: DJ-2026-005 边框缓存机
 版本: V4.2.0 -> V4.3.0 (内部变量名标准化修复)
 创建日期: 2026-04-23
 规范化修订日期: 2026-05-03
 编制人: [待填写]
 审核人: [待填写]

 遵循规范:
   - 801_PLC变量命名与功能块命名规范_DEV-V1.0.5
   - 810_PLC编程规范_DEV-V1.0.3

 说明: 容器功能块 - 四层输送机控制(纯容器,无业务逻辑)
       内部实例化4个 FB_1002_SingleLayerConveyor_BufferFraming,负责输入分发和输出收集
       所有输入来自主控(已映射的逻辑变量), 所有输出给主控(由主控映射到Y地址)

 功能:
   1. 容器模式: 内部实例化4个独立 FB_1002_SingleLayerConveyor_BufferFraming
   2. 输入分发: 将ARRAY输入拆分为单个信号,分别传给各层实例
   3. 输出收集: 将4个实例的输出汇聚为ARRAY,供主控读取
   4. 状态汇总: 运行中/故障/报警码的汇总逻辑
   5. 完全解耦: 无业务逻辑,仅做信号路由和数据聚合

 架构特点:
   - 纯容器块: 不包含任何业务逻辑或状态机
   - 实例化设计: 4个独立的 FB_1002_SingleLayerConveyor_BufferFraming 实例
   - 接口兼容: 外部接口保持ARRAY[1..4]形式,与原版本完全兼容
   - 职责单一: 只做输入分发->调用实例->输出收集
   - 可维护性: 业务逻辑全部在 FB_1002_SingleLayerConveyor_BufferFraming 中,此处只做路由

 调用关系:
   主控/HMI -> [FB_1001_Conveyor4Layer_BufferFraming (容器)] -> [fbLayer1~4: FB_1002_SingleLayerConveyor_BufferFraming]
                    | 输入分发                    ^ 输出收集
               ARRAY[1..4] -> 4个单实例        4个单实例 -> ARRAY[1..4]

 #region 编号规范:
   1xx = VAR_INPUT 变量组  |  2xx = VAR_OUTPUT 变量组  |  3xx = VAR 内部变量组
   8xx = 输入分发逻辑     |  4xx = 调用/自动运行       |  9xx = 输出收集逻辑

 变更记录:
   V4.3.0 (2026-05-03): 内部变量名标准化修复
          - 修复内部变量s_i活跃报警未替换的问题(共10处:1声明+9使用)
          - 统一改为s_iActiveAlarmCode,符合801规范V1.0.5英文命名要求
          - 解决"assignment to undeclared symbol"编译错误(TC001)
   V4.2.0 (2026-05-03): 变量名标准化修复
          - 修复所有接口变量名与FB_1002不匹配的问题(共55+处)
          - 统一采用英文变量名,符合Siemens TIA Portal最佳实践
          - 解决"unsupported assignment target"编译错误
   V4.1.0 (2026-04-25): 规范化修订
          - 文件头格式统一为标准SCL块注释格式
          - 注释风格统一: 段落分隔符改为等号线格式
          - 规范引用更新至最新版本号(V1.0.5/V1.0.3)
          - 新增 #region 折叠导航标记(编号体系)
   V4.0.0 (2026-04-23): 初始版本(容器模式重写)
          - 采用容器模式重写四层输送机控制
          - 内部实例化4个单层输送机功能块
          - 实现输入分发和输出收集的纯路由逻辑
 ============================================================================*)

FUNCTION_BLOCK FB_1001_Conveyor4Layer_BufferFraming

(* #region 100_VAR_INPUT 输入变量定义 *)
VAR_INPUT
    (* #region 110_系统控制信号 来自主控HMI公共透传 *)
    (*==========================================================================
      一.系统控制信号 (来自主控/HMI M区) - 公共信号,透传给所有层
      ==========================================================================*)
    i_bEnable               : BOOL;    // 总使能信号(主控系统就绪后置位)

    (*-------------------------------------------------------------------------
      模式选择 (互斥信号,来自HMI M区)
      -------------------------------------------------------------------------*)
    i_bAutoMode           : BOOL;    // 自动运行模式选择
    i_bManualMode           : BOOL;    // 手动调试模式选择

    (*-------------------------------------------------------------------------
      操作按钮 (来自HMI,边沿触发)
      -------------------------------------------------------------------------*)
    i_bStart               : BOOL;    // 自动循环启动按钮
    i_bStop               : BOOL;    // 自动循环停止按钮
    i_bReset               : BOOL;    // 故障复位/初始化按钮
    (* #endregion 110_系统控制信号 *)

    (* #region 120_工艺参数 来自HMI设定或配方 *)
    (*==========================================================================
      二.工艺参数 (来自HMI设定或配方) - 公共参数,透传给所有层
      ==========================================================================*)
    i_rConveyorSpeed           : REAL;    // 输送带速度设定(Hz或m/min,给变频器用)
    i_iSeparateTime           : INT;     // 分料动作保持时间(ms)
    i_iBlockWaitTime        : INT;     // 阻挡气缸动作等待时间(ms)
    (* #endregion 120_工艺参数 *)

    (* #region 130_手动操作信号 每层6个操作共24个BOOL *)
    (*==========================================================================
      三.手动操作信号 (每层6个操作,共24个BOOL,来自HMI)
      索引说明: [1]=第1层(底层), [2]=第2层, [3]=第3层, [4]=第4层(顶层)
      ==========================================================================*)
    i_bLx_BlockDown           : ARRAY[1..4] OF BOOL;  // 手动-阻挡气缸下降
    i_bLx_BlockUp           : ARRAY[1..4] OF BOOL;  // 手动-阻挡气缸上升
    i_bLx_SeparatePush           : ARRAY[1..4] OF BOOL;  // 手动-分料气缸推出
    i_bLx_SeparateReset           : ARRAY[1..4] OF BOOL;  // 手动-分料气缸复位
    i_bLx_ConveyorFwd           : ARRAY[1..4] OF BOOL;  // 手动-输送带正转
    i_bLx_ConveyorRev           : ARRAY[1..4] OF BOOL;  // 手动-输送带反转
    (* #endregion 130_手动操作信号 *)

    (* #region 140_传感器输入 4层x7类28个BOOL全部来自主控映射 *)
    (*==========================================================================
      四.传感器输入 (4层x7类=28个BOOL,全部来自主控映射)
      注: 放料完成感应器通过下游信号o_bFeedComplete反馈
      ==========================================================================*)
    (*--- 分料前感应器: 检测材料是否到达分料工位入口 ---*)
    i_bPreSeparateSensor         : ARRAY[1..4] OF BOOL;

    (*--- 到位感应器1/2: 双传感器冗余检测材料到位 ---*)
    i_bPositionSensor1          : ARRAY[1..4] OF BOOL;
    i_bPositionSensor2          : ARRAY[1..4] OF BOOL;

    (*--- 阻挡气缸位置反馈 ---*)
    i_bBlockCylinderUp         : ARRAY[1..4] OF BOOL;  // 阻挡升起(释放)位置
    i_bBlockCylinderDown         : ARRAY[1..4] OF BOOL;  // 阻挡下降(阻挡)位置

    (*--- 分料气缸位置反馈 ---*)
    i_bSeparateCylinderUp         : ARRAY[1..4] OF BOOL;  // 分料收回位置
    i_bSeparateCylinderDown         : ARRAY[1..4] OF BOOL;  // 分料推出位置
    (* #endregion 140_传感器输入 *)

    (* #region 150_下游反馈信号 取放料机构已取走该层物料 *)
    (*==========================================================================
      五.下游反馈信号 (取放料机构已取走该层物料)
      映射关系: 此信号 -> 各层实例的 i_bUpstreamAllowFeed
      ==========================================================================*)
    i_bFeedComplete          : ARRAY[1..4] OF BOOL;  // 取放料机构已取走该层物料
    (* #endregion 150_下游反馈信号 *)
END_VAR
(* #endregion 100_VAR_INPUT *)


(* #region 200_VAR_OUTPUT 输出变量定义 *)
VAR_OUTPUT
    (* #region 210_执行器请求输出 4层x5=20个BOOL全部给主控由主控映射到Y地址 *)
    (*==========================================================================
      一.执行器请求输出 (4层x5=20个BOOL,全部给主控,由主控映射到Y地址)
      ==========================================================================*)
    o_bBlockSolenoid           : ARRAY[1..4] OF BOOL;  // TRUE=下降(阻挡), FALSE=上升(释放)
    o_bSeparateSolenoid           : ARRAY[1..4] OF BOOL;  // TRUE=推出(分料), FALSE=复位
    o_bConveyorFwd           : ARRAY[1..4] OF BOOL;  // 输送带正向运转
    o_bConveyorSlow           : ARRAY[1..4] OF BOOL;  // 输送带慢速运转(精确定位用)
    o_bConveyorRev           : ARRAY[1..4] OF BOOL;  // 输送带反向运转(退料用)
    (* #endregion 210_执行器请求输出 *)

    (* #region 220_下游信号输出 给取放料机构和打胶机 *)
    (*==========================================================================
      二.下游信号输出 (给取放料机构/打胶机)
      ==========================================================================*)
    o_bFeedComplete            : ARRAY[1..4] OF BOOL;  // 该层放料完成,可取料
    (* #endregion 220_下游信号输出 *)

    (* #region 230_状态与HMI显示输出 *)
    (*==========================================================================
      三.状态/HMI显示输出
      ==========================================================================*)
    o_bRunning              : BOOL;    // 任一层正在自动运行
    o_bFault                : BOOL;    // 本站有故障(任一报警激活)
    o_iCurrentState            : INT;     // 当前主要状态码(0=空闲,1-8=步序,99=故障)
    o_LxCurrentStep           : ARRAY[1..4] OF INT;   // 每层当前步序(0-8)
    (* #endregion 230_状态与HMI显示输出 *)

    (* #region 240_报警输出 给公共报警管理器 *)
    (*==========================================================================
      四.报警输出 (给公共报警管理器)
      ==========================================================================*)
    o_iAlarmCode        : INT;     // 本站当前有效报警代码(0=无报警,1-7=报警类型)
    (* #endregion 240_报警输出 *)
END_VAR
(* #endregion 200_VAR_OUTPUT *)


(* #region 300_VAR 内部变量定义 *)
(*==============================================================================
 内部变量定义 (容器专用: 4个单层实例 + 汇总辅助变量)
 ==============================================================================*)
VAR
    (* #region 310_4个单层输送机实例 核心业务逻辑在此 *)
    (*--------------------------------------------------------------------------
      一.4个单层输送机实例 (核心: 所有业务逻辑在此)
      --------------------------------------------------------------------------*)
    fbLayer1 : FB_1002_SingleLayerConveyor_BufferFraming;  // 第1层(底层)
    fbLayer2 : FB_1002_SingleLayerConveyor_BufferFraming;  // 第2层
    fbLayer3 : FB_1002_SingleLayerConveyor_BufferFraming;  // 第3层
    fbLayer4 : FB_1002_SingleLayerConveyor_BufferFraming;  // 第4层(顶层)
    (* #endregion 310_4个单层输送机实例 *)

    (* #region 320_汇总辅助变量 用于输出收集 *)
    (*--------------------------------------------------------------------------
      二.汇总辅助变量 (用于输出收集)
      --------------------------------------------------------------------------*)
    s_iActiveAlarmCode             : INT;     // Current highest priority alarm code (temporary calculation)
    s_iLayerIdx             : INT;     // FOR循环索引(层号1-4)
    (* #endregion 320_汇总辅助变量 *)
END_VAR
(* #endregion 300_VAR *)


(*==============================================================================
 主程序开始 - 容器逻辑: 输入分发 -> 调用实例 -> 输出收集
 ==============================================================================*)

(* #region 800_第一部分 输入分发 将公共信号和每层独立信号分配到4个实例 *)
(* ============================================================================
 第一部分: 输入分发 - 将公共信号和每层独立信号分配到4个实例
 ============================================================================ *)

(* #region 810_公共信号分发 使能模式启停参数 所有4个实例相同 *)
(*------------------------------------------------------------------------------
  1.1 公共信号分发 (使能/模式/启停/参数) -> 所有4个实例相同
 ------------------------------------------------------------------------------*)

(*--- 第1层公共信号 ---*)
fbLayer1.i_bEnable         := i_bEnable;
fbLayer1.i_bAutoMode     := i_bAutoMode;
fbLayer1.i_bManualMode     := i_bManualMode;
fbLayer1.i_bStart         := i_bStart;
fbLayer1.i_bStop         := i_bStop;
fbLayer1.i_bReset         := i_bReset;
fbLayer1.i_rConveyorSpeed     := i_rConveyorSpeed;
fbLayer1.i_iSeparateTime     := i_iSeparateTime;
fbLayer1.i_iBlockWaitTime  := i_iBlockWaitTime;

(*--- 第2层公共信号 ---*)
fbLayer2.i_bEnable         := i_bEnable;
fbLayer2.i_bAutoMode     := i_bAutoMode;
fbLayer2.i_bManualMode     := i_bManualMode;
fbLayer2.i_bStart         := i_bStart;
fbLayer2.i_bStop         := i_bStop;
fbLayer2.i_bReset         := i_bReset;
fbLayer2.i_rConveyorSpeed     := i_rConveyorSpeed;
fbLayer2.i_iSeparateTime     := i_iSeparateTime;
fbLayer2.i_iBlockWaitTime  := i_iBlockWaitTime;

(*--- 第3层公共信号 ---*)
fbLayer3.i_bEnable         := i_bEnable;
fbLayer3.i_bAutoMode     := i_bAutoMode;
fbLayer3.i_bManualMode     := i_bManualMode;
fbLayer3.i_bStart         := i_bStart;
fbLayer3.i_bStop         := i_bStop;
fbLayer3.i_bReset         := i_bReset;
fbLayer3.i_rConveyorSpeed     := i_rConveyorSpeed;
fbLayer3.i_iSeparateTime     := i_iSeparateTime;
fbLayer3.i_iBlockWaitTime  := i_iBlockWaitTime;

(*--- 第4层公共信号 ---*)
fbLayer4.i_bEnable         := i_bEnable;
fbLayer4.i_bAutoMode     := i_bAutoMode;
fbLayer4.i_bManualMode     := i_bManualMode;
fbLayer4.i_bStart         := i_bStart;
fbLayer4.i_bStop         := i_bStop;
fbLayer4.i_bReset         := i_bReset;
fbLayer4.i_rConveyorSpeed     := i_rConveyorSpeed;
fbLayer4.i_iSeparateTime     := i_iSeparateTime;
fbLayer4.i_iBlockWaitTime  := i_iBlockWaitTime;
(* #endregion 810_公共信号分发 *)

(* #region 820_手动操作信号分发 6类x4层 每层的独立手动操作 *)
(*------------------------------------------------------------------------------
  1.2 手动操作信号分发 (6类x4层) -> 每层的独立手动操作
 ------------------------------------------------------------------------------*)

(*--- 第1层手动操作 ---*)
fbLayer1.i_bLx_BlockDown     := i_bLx_BlockDown[1];
fbLayer1.i_bLx_BlockUp     := i_bLx_BlockUp[1];
fbLayer1.i_bLx_SeparatePush     := i_bLx_SeparatePush[1];
fbLayer1.i_bLx_SeparateReset     := i_bLx_SeparateReset[1];
fbLayer1.i_bLx_ConveyorFwd     := i_bLx_ConveyorFwd[1];
fbLayer1.i_bLx_ConveyorRev     := i_bLx_ConveyorRev[1];

(*--- 第2层手动操作 ---*)
fbLayer2.i_bLx_BlockDown     := i_bLx_BlockDown[2];
fbLayer2.i_bLx_BlockUp     := i_bLx_BlockUp[2];
fbLayer2.i_bLx_SeparatePush     := i_bLx_SeparatePush[2];
fbLayer2.i_bLx_SeparateReset     := i_bLx_SeparateReset[2];
fbLayer2.i_bLx_ConveyorFwd     := i_bLx_ConveyorFwd[2];
fbLayer2.i_bLx_ConveyorRev     := i_bLx_ConveyorRev[2];

(*--- 第3层手动操作 ---*)
fbLayer3.i_bLx_BlockDown     := i_bLx_BlockDown[3];
fbLayer3.i_bLx_BlockUp     := i_bLx_BlockUp[3];
fbLayer3.i_bLx_SeparatePush     := i_bLx_SeparatePush[3];
fbLayer3.i_bLx_SeparateReset     := i_bLx_SeparateReset[3];
fbLayer3.i_bLx_ConveyorFwd     := i_bLx_ConveyorFwd[3];
fbLayer3.i_bLx_ConveyorRev     := i_bLx_ConveyorRev[3];

(*--- 第4层手动操作 ---*)
fbLayer4.i_bLx_BlockDown     := i_bLx_BlockDown[4];
fbLayer4.i_bLx_BlockUp     := i_bLx_BlockUp[4];
fbLayer4.i_bLx_SeparatePush     := i_bLx_SeparatePush[4];
fbLayer4.i_bLx_SeparateReset     := i_bLx_SeparateReset[4];
fbLayer4.i_bLx_ConveyorFwd     := i_bLx_ConveyorFwd[4];
fbLayer4.i_bLx_ConveyorRev     := i_bLx_ConveyorRev[4];
(* #endregion 820_手动操作信号分发 *)

(* #region 830_传感器信号分发 7类x4层 每层的独立传感器输入 *)
(*------------------------------------------------------------------------------
  1.3 传感器信号分发 (7类x4层) -> 每层的独立传感器输入
 ------------------------------------------------------------------------------*)

(*--- 第1层传感器 ---*)
fbLayer1.i_bPreSeparateSensor   := i_bPreSeparateSensor[1];
fbLayer1.i_bPositionSensor1    := i_bPositionSensor1[1];
fbLayer1.i_bPositionSensor2    := i_bPositionSensor2[1];
fbLayer1.i_bBlockCylinderUp   := i_bBlockCylinderUp[1];
fbLayer1.i_bBlockCylinderDown   := i_bBlockCylinderDown[1];
fbLayer1.i_bSeparateCylinderUp   := i_bSeparateCylinderUp[1];
fbLayer1.i_bSeparateCylinderDown   := i_bSeparateCylinderDown[1];

(*--- 第2层传感器 ---*)
fbLayer2.i_bPreSeparateSensor   := i_bPreSeparateSensor[2];
fbLayer2.i_bPositionSensor1    := i_bPositionSensor1[2];
fbLayer2.i_bPositionSensor2    := i_bPositionSensor2[2];
fbLayer2.i_bBlockCylinderUp   := i_bBlockCylinderUp[2];
fbLayer2.i_bBlockCylinderDown   := i_bBlockCylinderDown[2];
fbLayer2.i_bSeparateCylinderUp   := i_bSeparateCylinderUp[2];
fbLayer2.i_bSeparateCylinderDown   := i_bSeparateCylinderDown[2];

(*--- 第3层传感器 ---*)
fbLayer3.i_bPreSeparateSensor   := i_bPreSeparateSensor[3];
fbLayer3.i_bPositionSensor1    := i_bPositionSensor1[3];
fbLayer3.i_bPositionSensor2    := i_bPositionSensor2[3];
fbLayer3.i_bBlockCylinderUp   := i_bBlockCylinderUp[3];
fbLayer3.i_bBlockCylinderDown   := i_bBlockCylinderDown[3];
fbLayer3.i_bSeparateCylinderUp   := i_bSeparateCylinderUp[3];
fbLayer3.i_bSeparateCylinderDown   := i_bSeparateCylinderDown[3];

(*--- 第4层传感器 ---*)
fbLayer4.i_bPreSeparateSensor   := i_bPreSeparateSensor[4];
fbLayer4.i_bPositionSensor1    := i_bPositionSensor1[4];
fbLayer4.i_bPositionSensor2    := i_bPositionSensor2[4];
fbLayer4.i_bBlockCylinderUp   := i_bBlockCylinderUp[4];
fbLayer4.i_bBlockCylinderDown   := i_bBlockCylinderDown[4];
fbLayer4.i_bSeparateCylinderUp   := i_bSeparateCylinderUp[4];
fbLayer4.i_bSeparateCylinderDown   := i_bSeparateCylinderDown[4];
(* #endregion 830_传感器信号分发 *)

(* #region 840_下游反馈信号分发 取放料完成到上游允许放料 *)
(*------------------------------------------------------------------------------
  1.4 下游反馈信号分发 (取放料完成 -> 上游允许放料)
  映射关系: i_bFeedComplete[层号] -> fbLayerX.i_bUpstreamAllowFeed
  说明: 取放料机构已取走该层物料后,允许该层继续放下一批料
 ------------------------------------------------------------------------------*)

fbLayer1.i_bUpstreamAllowFeed := i_bFeedComplete[1];
fbLayer2.i_bUpstreamAllowFeed := i_bFeedComplete[2];
fbLayer3.i_bUpstreamAllowFeed := i_bFeedComplete[3];
fbLayer4.i_bUpstreamAllowFeed := i_bFeedComplete[4];
(* #endregion 840_下游反馈信号分发 *)
(* #endregion 800_第一部分 输入分发 *)


(* #region 410_第二部分 调用4个单层实例 执行业务逻辑 *)
(* ============================================================================
 第二部分: 调用4个单层实例 (执行业务逻辑)
 注意: FB_1002_SingleLayerConveyor_BufferFraming 是完整的功能块,赋值输入后会自动执行内部逻辑
 ============================================================================ *)

(*--- 实例会自动执行: 在输入赋值完成后,PLC会在本扫描周期末自动调用
     功能块的内部逻辑(包括状态机,定时器,报警检测等)
     无需显式CALL语句,这是IEC 61131-3的标准行为 ---*)
(* #endregion 410_第二部分 调用实例 *)


(* #region 900_第三部分 输出收集 将4个实例的输出汇聚为ARRAY和汇总信号 *)
(* ============================================================================
 第三部分: 输出收集 - 将4个实例的输出汇聚为ARRAY和汇总信号
 ============================================================================ *)

(* #region 910_执行器输出收集 5类x4层 各实例o_xxx *)
(*------------------------------------------------------------------------------
  3.1 执行器输出收集 (5类x4层) <- 各实例.o_xxx
 -----------------------------------------------------------------------------*)

(*--- 阻挡电磁阀 ---*)
o_bBlockSolenoid[1] := fbLayer1.o_bBlockSolenoid;
o_bBlockSolenoid[2] := fbLayer2.o_bBlockSolenoid;
o_bBlockSolenoid[3] := fbLayer3.o_bBlockSolenoid;
o_bBlockSolenoid[4] := fbLayer4.o_bBlockSolenoid;

(*--- 分料电磁阀 ---*)
o_bSeparateSolenoid[1] := fbLayer1.o_bSeparateSolenoid;
o_bSeparateSolenoid[2] := fbLayer2.o_bSeparateSolenoid;
o_bSeparateSolenoid[3] := fbLayer3.o_bSeparateSolenoid;
o_bSeparateSolenoid[4] := fbLayer4.o_bSeparateSolenoid;

(*--- 输送带正转 ---*)
o_bConveyorFwd[1] := fbLayer1.o_bConveyorFwd;
o_bConveyorFwd[2] := fbLayer2.o_bConveyorFwd;
o_bConveyorFwd[3] := fbLayer3.o_bConveyorFwd;
o_bConveyorFwd[4] := fbLayer4.o_bConveyorFwd;

(*--- 输送带慢速 ---*)
o_bConveyorSlow[1] := fbLayer1.o_bConveyorSlow;
o_bConveyorSlow[2] := fbLayer2.o_bConveyorSlow;
o_bConveyorSlow[3] := fbLayer3.o_bConveyorSlow;
o_bConveyorSlow[4] := fbLayer4.o_bConveyorSlow;

(*--- 输送带反转 ---*)
o_bConveyorRev[1] := fbLayer1.o_bConveyorRev;
o_bConveyorRev[2] := fbLayer2.o_bConveyorRev;
o_bConveyorRev[3] := fbLayer3.o_bConveyorRev;
o_bConveyorRev[4] := fbLayer4.o_bConveyorRev;
(* #endregion 910_执行器输出收集 *)

(* #region 920_下游信号输出收集 放料完成 各实例o_bFeedComplete *)
(*------------------------------------------------------------------------------
  3.2 下游信号输出收集 (放料完成) <- 各实例.o_bFeedComplete
 -----------------------------------------------------------------------------*)

o_bFeedComplete[1] := fbLayer1.o_bFeedComplete;
o_bFeedComplete[2] := fbLayer2.o_bFeedComplete;
o_bFeedComplete[3] := fbLayer3.o_bFeedComplete;
o_bFeedComplete[4] := fbLayer4.o_bFeedComplete;
(* #endregion 920_下游信号输出收集 *)

(* #region 930_每层步序输出收集 各实例o_iCurrentState *)
(*------------------------------------------------------------------------------
  3.3 每层步序输出收集 <- 各实例.o_iCurrentState
 -----------------------------------------------------------------------------*)

o_LxCurrentStep[1] := fbLayer1.o_iCurrentState;
o_LxCurrentStep[2] := fbLayer2.o_iCurrentState;
o_LxCurrentStep[3] := fbLayer3.o_iCurrentState;
o_LxCurrentStep[4] := fbLayer4.o_iCurrentState;
(* #endregion 930_每层步序输出收集 *)

(* #region 940_汇总状态输出 运行中故障当前状态报警码 *)
(*------------------------------------------------------------------------------
  3.4 汇总状态输出 (运行中/故障/当前状态/报警码)
 -----------------------------------------------------------------------------*)

(*--- 运行中标志: 任一层在自动运行则TRUE ---*)
o_bRunning := fbLayer1.o_bRunning OR fbLayer2.o_bRunning
          OR fbLayer3.o_bRunning OR fbLayer4.o_bRunning;

(*--- 故障标志: 任一层有故障则TRUE ---*)
o_bFault := fbLayer1.o_bFault OR fbLayer2.o_bFault
         OR fbLayer3.o_bFault OR fbLayer4.o_bFault;

(*--- 当前状态显示优先级:
     1. 如果任一有故障 -> 返回99
     2. 否则返回第一个非空闲层的步序
     3. 全部空闲则返回0
 ---*)
IF o_bFault THEN
    (* 有故障: 显示故障状态码99 *)
    o_iCurrentState := 99;
ELSE
    (* 无故障: 显示最高优先级(最先找到)的非空闲层步序 *)
    o_iCurrentState := 0;  (* 默认空闲 *)
    IF fbLayer1.o_iCurrentState > 0 THEN
        o_iCurrentState := fbLayer1.o_iCurrentState;
    ELSIF fbLayer2.o_iCurrentState > 0 THEN
        o_iCurrentState := fbLayer2.o_iCurrentState;
    ELSIF fbLayer3.o_iCurrentState > 0 THEN
        o_iCurrentState := fbLayer3.o_iCurrentState;
    ELSIF fbLayer4.o_iCurrentState > 0 THEN
        o_iCurrentState := fbLayer4.o_iCurrentState;
    END_IF;
END_IF;

(*--- 本站报警代码: 取最高优先级(最小编号)的非零报警码
     报警优先级: 1>2>3>4>5>6>7 (数字越小优先级越高)
 ---*)
s_iActiveAlarmCode := 0;  (* 初始化为无报警 *)

(* 第1层报警检查 *)
IF fbLayer1.o_iAlarmCode > 0 THEN
    IF s_iActiveAlarmCode = 0 OR fbLayer1.o_iAlarmCode < s_iActiveAlarmCode THEN
        s_iActiveAlarmCode := fbLayer1.o_iAlarmCode;
    END_IF;
END_IF;

(* 第2层报警检查 *)
IF fbLayer2.o_iAlarmCode > 0 THEN
    IF s_iActiveAlarmCode = 0 OR fbLayer2.o_iAlarmCode < s_iActiveAlarmCode THEN
        s_iActiveAlarmCode := fbLayer2.o_iAlarmCode;
    END_IF;
END_IF;

(* 第3层报警检查 *)
IF fbLayer3.o_iAlarmCode > 0 THEN
    IF s_iActiveAlarmCode = 0 OR fbLayer3.o_iAlarmCode < s_iActiveAlarmCode THEN
        s_iActiveAlarmCode := fbLayer3.o_iAlarmCode;
    END_IF;
END_IF;

(* 第4层报警检查 *)
IF fbLayer4.o_iAlarmCode > 0 THEN
    IF s_iActiveAlarmCode = 0 OR fbLayer4.o_iAlarmCode < s_iActiveAlarmCode THEN
        s_iActiveAlarmCode := fbLayer4.o_iAlarmCode;
    END_IF;
END_IF;

(* 输出最终报警代码 *)
o_iAlarmCode := s_iActiveAlarmCode;
(* #endregion 940_汇总状态输出 *)
(* #endregion 900_第三部分 输出收集 *)


END_FUNCTION_BLOCK

(* ============================================================================
 程序结束
 ============================================================================ *)