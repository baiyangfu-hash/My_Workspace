// ============================================================================
// GlobalVars.db - 边框缓存机全局变量数据块
// ============================================================================
// 功能说明:
//   定义 DJ-2026-005 边框缓存机 PLC 控制系统的所有全局变量.
//   作为 OB1 主程序与各功能块之间的数据交换中心, 实现统一的数据管理.
//
// 数据组织:
//   采用结构化分组方式, 按功能模块划分变量区域:
//   - stGlobal:    全局控制信号和系统状态 (来自FB_2001_CommonAlarm)
//   - stExternal:  外部设备交互信号 (组框机/打胶机/机器人)
//   - stConveyor:  四层输送机系统信号 (含4层数组, ARRAY[1..4])
//   - stPickPlace: 取放料机构信号 (V6.0.0版本, 55输入/30输出)
//   - stFeeder:    打胶机送料机构信号 (17输入/14输出)
//
// 设计原则:
//   1. 所有 I/O 映射集中在此数据块, 功能块不直接访问物理地址
//   2. 使用 STRUCT 类型实现逻辑分组, 提高可读性
//   3. 变量命名遵循 801_PLC变量命名规范_DEV-V1.0.5
//   4. 初始值设置为安全状态 (FALSE/0), 防止上电误动作
//   5. 完全基于实际FB定义生成, 与OB1调用100%同步
//
// 变更记录:
//   V7.0.0 (2026-05-18): Conveyor子系统V7.0.0重构对齐
//          - stConveyor结构完全重写: FB_1001容器取消, 适配FB_1002 V7.0.0编排器接口
//          - 变量命名: 逐层数组加_a前缀(i_a/q_a), 汇总变量用q_b/q_i前缀
//          - FB实例: fbConveyor4Layer(FB_1001) → 4×fbConveyor_L1~L4(FB_1002)
//          - 新增汇总字段: q_bRunning(OR), q_bFault(OR), q_iAlarmCode(MIN)
//   V6.0.0 (2026-05-04): 同步FB_1003 V6.0.0接口重命名
//          - stPickPlace变量重命名47处, 匹配FB_1003 V6.0.0新接口
//          - Grip→Clamp/Unclamp语义统一 (夹爪→夹紧/松开)
//          - HomePoint→HomePos, WorkPoint→Closed/Opened (位置状态语义)
//          - Forward/Reverse→Fwd/Rev缩写统一
//          - 定时器调试输出TIME→DINT (8处, 便于HMI数值显示)
//          - 删除死代码TON1: FB_TON
//          - 修复中文标点符号为英文标点
//   V3.0.0 (2026-05-03): V5.0.0全面重写 - 变量名100%英文化
//          - 替换所有220+处中文变量名为英文(符合801规范V1.0.5)
//          - 统一命名语义: 设备名_功能描述 格式(如FrameMachine_AutoRunning)
//          - 解决OB1↔FB接口不匹配问题, 消除TC001/TC002编译错误
//          - 与OB1.scl V5.0.0 100%同步, 支持VS Code PLC调试器验证
//   V2.0.0 (2026-05-03): 基于OB1 V2.0.0完全重写
//          - 修正所有146处接口不匹配问题
//          - 精确匹配6个功能块的所有输入/输出引脚
//          - 支持V4.2.0版本的FB_1003_PickPlace新接口 (14手动操作+26传感器)
//          - 支持FB_1001_Conveyor4Layer的完整容器接口 (7类传感器)
//          - 新增MES报警队列、定时器调试输出等高级功能变量
//   V1.0.0 (2026-05-02): 初始版本
//          - 配合 OB1 V1.0.0 标准化主程序创建
// ============================================================================

DATA_BLOCK GlobalVars

VAR
    // =========================================================================
    // 第一部分: 全局控制信号与系统状态 (FB_2001_CommonAlarm 输出)
    // =========================================================================
    // 说明: 存储公共报警管理功能块的输出信号
    //       包括全局报警字、优先级报警、互锁信号、MES数据接口等
    //       接口统计: 0输入 + 16输出 (HMI显示2 + 全局互锁1 + MES数据3 + 多报警9)
    // =========================================================================
    stGlobal : STRUCT
        // --- 操作控制 (传给FB_2001) ---
        i_bReset           : BOOL := FALSE;    // 全局复位按钮

        // --- HMI显示输出 (来自FB_2001) ---
        o_wGlobalAlarmWord     : WORD := 0;        // 全局报警字 (D400, HMI报警灯)
        o_iCurrentAlarmCode   : INT := 0;         // 最高优先级报警代码 (D402, HMI文本显示)

        // --- 全局互锁输出 (来自FB_2001) ---
        o_bAnyAlarmActive   : BOOL := FALSE;    // 全局报警激活标志 (M200, 所有工站停止)

        // --- MES数据接口输出 (来自FB_2001) ---
        o_iMESAlarmCount    : INT := 0;         // MES报警累计计数 (D404)
        o_iMESAlarmQueue    : ARRAY[0..9] OF INT;  // MES报警队列 (D406~D425, 最近10条去重记录)
        o_bNewAlarmFlag     : BOOL := FALSE;    // 新报警检测脉冲 (触发MES上传)

        // --- 多报警状态输出 (来自FB_2001) ---
        o_iStationAlarmStatus   : ARRAY[1..3] OF INT;  // 三站报警状态数组 [1]输送机 [2]取放料 [3]送料
        o_bConveyorAlarmActive : BOOL := FALSE;    // 输送机站有报警标志
        o_bPickPlaceAlarmActive : BOOL := FALSE;    // 取放料站有报警标志
        o_bFeederAlarmActive : BOOL := FALSE;  // 送料站有报警标志
    END_STRUCT;

    // =========================================================================
    // 第二部分: 外部设备交互信号 (FB_ExternalDeviceInteraction)
    // =========================================================================
    // 说明: 处理与组框机、打胶机和机器人的所有交互逻辑
    //       接口统计: 27输入 + 20输出 = 47个信号
    // =========================================================================
    stExternal : STRUCT
        // === 输入信号 (27个) ===
        // --- 系统控制信号 (6个) ---
        i_bEnable           : BOOL := FALSE;    // 系统使能
        i_bAutoMode       : BOOL := FALSE;    // 自动模式选择
        i_bManualMode       : BOOL := FALSE;    // 手动模式选择
        i_bStart           : BOOL := FALSE;    // 启动按钮
        i_bStop           : BOOL := FALSE;    // 停止按钮
        i_bReset           : BOOL := FALSE;    // 复位按钮

        // --- 组框机输入信号 (7个) ---
        i_bFrameMachine_AutoRunning   : BOOL := FALSE;   // 组框机自动运行中
        i_bFrameMachine_AllowFeed : BOOL := FALSE;   // 组框机允许向缓存送料
        i_bFrameMaterialRequest : BOOL := FALSE;   // 组框机有料待送入
        i_bDoorOpenRequest : BOOL := FALSE;   // 组框机开门请求 (需暂停)
        i_bFrameMachine_EStop     : BOOL := FALSE;   // 组框机急停 (需互锁)
        i_bFrameMachine_SafetyErr : BOOL := FALSE;   // 组框机安全系统错误
        i_bFrameMachine_CommErr : BOOL := FALSE;   // 与组框机通信错误

        // --- 打胶机输入信号 (6个) ---
        i_bGlueMachine_AutoRunning   : BOOL := FALSE;   // 打胶机自动运行中
        i_bGlueMachine_AllowFeed : BOOL := FALSE;   // 打胶机准备好接收边框
        i_bGlueMachine_PickComplete : BOOL := FALSE;   // 打胶机取料完成
        i_bGlueMachine_Fault     : BOOL := FALSE;   // 打胶机设备故障报警
        i_bGlueMachine_EStop     : BOOL := FALSE;   // 打胶机急停状态
        i_bGlueMachine_CommErr : BOOL := FALSE;   // 与打胶机通信中断

        // --- 机器人输入信号 (5个, 预留) ---
        i_bRobot_AutoRunning   : BOOL := FALSE;   // 机器人自动运行中
        i_bRobot_StackComplete : BOOL := FALSE;   // 机器人堆垛完成
        i_bRobot_Fault     : BOOL := FALSE;   // 机器人设备故障
        i_bRobot_EStop     : BOOL := FALSE;   // 机器人急停状态
        i_bRobot_CommErr : BOOL := FALSE;   // 与机器人通信错误

        // --- 本机状态信号 (3个) ---
        i_bLocalReady       : BOOL := FALSE;    // 本机就绪状态 (发送给外部设备)
        i_bAnyAlarmActive   : BOOL := FALSE;    // 本机有任何报警激活 (独立报警检测)
        i_bSystemFault       : BOOL := FALSE;    // 本机系统故障 (独立故障检测)

        // === 输出信号 (20个) ===
        // --- 组框机输出信号 (5个) ---
        o_bFrameMachine_RequestFeed : BOOL := FALSE;   // 请求组框机送料
        o_bFrameMachine_Pause     : BOOL := FALSE;   // 向组框机发送暂停命令
        o_bFrameMachine_EStop     : BOOL := FALSE;   // 向组框机发送急停互锁信号
        o_bDoorOpenRequest        : BOOL := FALSE;   // 向组框机请求开门操作
        o_bFrameMachine_Ready     : BOOL := FALSE;   // 本机就绪, 可接收边框

        // --- 打胶机输出信号 (4个) ---
        o_bGlueMachine_RequestRun : BOOL := FALSE;   // 请求打胶机启动运行
        o_bAllowPickup        : BOOL := FALSE;   // 通知打胶机可取料
        o_bSafetyZoneSignal      : BOOL := FALSE;   // 安全区开/关信号
        o_bGlueMachine_ResetReq : BOOL := FALSE;   // 向打胶机发送复位请求

        // --- 机器人输出信号 (3个, 预留) ---
        o_bRobot_AllowStacking : BOOL := FALSE;   // 允许机器人执行堆垛
        o_bRobot_StopStacking : BOOL := FALSE;   // 停止机器人堆垛
        o_bRobot_ResetReq : BOOL := FALSE;   // 向机器人发送复位请求

        // --- 状态与报警输出 (4个) ---
        o_bFrameMachine_EmergencyStop  : BOOL := FALSE;   // 组框机急停/安全错误时强制本机停止
        o_bExternalDeviceFault    : BOOL := FALSE;   // 外部设备故障标志
        o_iExternalDeviceAlarmSummary : INT := 0;       // 外部设备故障报警代码 (300~399范围)
        o_bSystemSafetyConditionMet : BOOL := FALSE;  // 系统安全条件满足
    END_STRUCT;

    // =========================================================================
    // 第三部分: 四层输送机系统信号 (4×FB_1002 展开调用, V7.0.0)
    // =========================================================================
    // 说明: FB_1001 容器已取消, OB1 展开调用 4 个 FB_1002 实例
    //       每层共用信号为标量, 逐层信号为 ARRAY[1..4]
    //       FB_1002 接口: 22输入 + 11输出 = 33 (V7.0.0 编排器架构)
    //       FB_1002 内部委托: fbBlock(FB_1011) + fbSeparate(FB_1011) + fbMotor(FB_1012)
    // =========================================================================
    stConveyor : STRUCT
        // === 共享信号 (6个标量, 4层共用) ===
        i_bAutoMode              : BOOL := FALSE;    // 自动运行模式
        i_bManualMode            : BOOL := FALSE;    // 手动调试模式
        i_bStart                 : BOOL := FALSE;    // 自动循环启动 (上升沿)
        i_bStop                  : BOOL := FALSE;    // 停止 (电平有效)

        i_iSeparateTimeoutMs     : INT := 5000;      // 分料超时时间 (ms)
        i_bSafetyDoorOk          : BOOL := TRUE;     // 安全门状态 (TRUE=关闭OK)
        i_bVfdFault              : BOOL := FALSE;    // 变频器故障

        // === 逐层输入 ARRAY[1..4] (传感器 + 手动操作 + 取料确认, 共14组) ===
        i_aPreSeparateSensor     : ARRAY[1..4] OF BOOL;  // 分料前接近开关
        i_aPositionSensor1       : ARRAY[1..4] OF BOOL;  // 到位传感器1
        i_aPositionSensor2       : ARRAY[1..4] OF BOOL;  // 到位传感器2 (冗余)
        i_aBlockCylinderUp       : ARRAY[1..4] OF BOOL;  // 阻挡气缸上位
        i_aBlockCylinderDown     : ARRAY[1..4] OF BOOL;  // 阻挡气缸下位
        i_aSeparateCylinderUp    : ARRAY[1..4] OF BOOL;  // 分料气缸上位
        i_aSeparateCylinderDown  : ARRAY[1..4] OF BOOL;  // 分料气缸下位

        i_aPickupConfirmed       : ARRAY[1..4] OF BOOL;  // 取料机构已取走物料 (←FB_1003)

        i_aManBlockExtend        : ARRAY[1..4] OF BOOL;  // 手动: 阻挡下降
        i_aManBlockRetract       : ARRAY[1..4] OF BOOL;  // 手动: 阻挡上升
        i_aManSeparatePush       : ARRAY[1..4] OF BOOL;  // 手动: 分料推出
        i_aManConveyorFwd        : ARRAY[1..4] OF BOOL;  // 手动: 输送正转
        i_aManConveyorRev        : ARRAY[1..4] OF BOOL;  // 手动: 输送反转
        i_aManConveyorSlow       : ARRAY[1..4] OF BOOL;  // 手动: 输送慢速

        // === 逐层输出 ARRAY[1..4] (执行器 + HMI显示, 共10组) ===
        q_aBlockSolenoid         : ARRAY[1..4] OF BOOL;  // 阻挡电磁阀 (TRUE=下降)
        q_aSeparateSolenoid      : ARRAY[1..4] OF BOOL;  // 分料电磁阀 (TRUE=推出)
        q_aConveyorFwd           : ARRAY[1..4] OF BOOL;  // 输送带正转
        q_aConveyorRev           : ARRAY[1..4] OF BOOL;  // 输送带反转
        q_aConveyorSlow          : ARRAY[1..4] OF BOOL;  // 输送带慢速

        q_aLayerStep             : ARRAY[1..4] OF INT;   // 各层当前步序 0~70 (HMI)
        q_aLayerAlarmCode        : ARRAY[1..4] OF INT;   // 各层报警码 0=正常 (HMI)
        q_aLayerRunning          : ARRAY[1..4] OF BOOL;  // 各层运行中 (HMI)
        q_aLayerFault            : ARRAY[1..4] OF BOOL;  // 各层故障 (HMI)
        q_aLayerFeedDone         : ARRAY[1..4] OF BOOL;  // 各层放料完成 脉冲 (→FB_1003)
        q_aLayerSensorFault      : ARRAY[1..4] OF BOOL;  // 各层传感器故障 (→FB_2001)

        // === 汇总变量 (OB1计算后回写) ===
        q_bRunning               : BOOL := FALSE;    // 4层 OR → HMI "输送机运行中"
        q_bFault                 : BOOL := FALSE;    // 4层 OR → HMI + 全局互锁
        q_iAlarmCode             : INT := 0;         // 4层报警码优先级 MIN → HMI + FB_2001
    END_STRUCT;

    // =========================================================================
    // 第四部分: 取放料机构信号 (FB_1003_PickPlace 11步状态机, V6.0.0版本)
    // =========================================================================
    // 说明: Z轴升降 + X1轴横移 + 夹爪控制的 11 步状态机
    //       一次取两根边框 (前后夹紧同时动作), 4层循环2次完成全部取料
    //       V6.0.0重大更新: 变量重命名匹配FB_1003 V6.0.0新接口
    //       接口统计: 55输入(8系统+14手动+6工艺+26传感器+4上游) + 30输出
    // =========================================================================
    stPickPlace : STRUCT
        // === 输入信号 (55个) ===
        // --- 系统控制信号 (8个) ---
        i_bEnable               : BOOL := FALSE;    // 总使能信号
        i_bAutoMode           : BOOL := FALSE;    // 自动运行模式选择
        i_bManualMode           : BOOL := FALSE;    // 手动调试模式选择
        i_bStart               : BOOL := FALSE;    // 自动循环启动按钮 (上升沿触发)
        i_bStop               : BOOL := FALSE;    // 自动循环停止按钮 (电平有效)
        i_bReset               : BOOL := FALSE;    // 故障复位/初始化按钮 (电平有效)

        // --- 手动操作信号 (14个BOOL) ---
        // 伺服点动控制 (4个)
        i_bLx_ZAxis_JogUp          : BOOL := FALSE;    // 手动-Z轴点动上升
        i_bLx_ZAxis_JogDown          : BOOL := FALSE;    // 手动-Z轴点动下降
        i_bLx_X1Axis_JogFwd         : BOOL := FALSE;    // 手动-X1轴点动前进 (取料方向)
        i_bLx_X1Axis_JogRev         : BOOL := FALSE;    // 手动-X1轴点动后退 (放料方向)

        // 气缸手动控制 (10个, 双电磁阀)
        i_bLx_Lift_Up           : BOOL := FALSE;    // 手动-升降气缸上升
        i_bLx_Lift_Down           : BOOL := FALSE;    // 手动-升降气缸下降
        i_bLx_FrontClamp         : BOOL := FALSE;    // 手动-前夹爪夹紧
        i_bLx_FrontUnclamp         : BOOL := FALSE;    // 手动-前夹爪松开
        i_bLx_RearClamp         : BOOL := FALSE;    // 手动-后夹爪夹紧
        i_bLx_RearUnclamp         : BOOL := FALSE;    // 手动-后夹爪松开
        i_bLx_FrontClamp2        : BOOL := FALSE;    // 手动-前夹爪2夹紧 (第二前夹爪)
        i_bLx_FrontUnclamp2        : BOOL := FALSE;    // 手动-前夹爪2松开
        i_bLx_RearClamp2        : BOOL := FALSE;    // 手动-后夹爪2夹紧 (第二后夹爪)
        i_bLx_RearUnclamp2        : BOOL := FALSE;    // 手动-后夹爪2松开

        // --- 工艺参数 (6个, REAL/INT类型) ---
        // 运动速度参数 (4个REAL)
        i_rPickupSpeed           : REAL := 100.0;    // 取料过程Z轴升降速度 (mm/s 或 %)
        i_rPlaceSpeed           : REAL := 80.0;     // 放料过程Z轴升降速度 (mm/s 或 %)
        i_rZAxisSpeed            : REAL := 100.0;    // Z轴通用运动速度设定 (mm/s)
        i_rX1AxisSpeed           : REAL := 150.0;    // X1轴通用运动速度设定 (mm/s)

        // 动作时间参数 (2个INT)
        i_iClampConfirmTime       : INT := 500;       // 夹爪夹紧确认等待时间 (ms)
        i_iLiftActionTime       : INT := 3000;      // 升降气缸动作超时时间 (ms)

        // --- 传感器输入 (26个BOOL) ---
        // 气缸位置传感器 (10个磁性开关)
        i_bLift_WorkPoint           : BOOL := FALSE;    // 升降气缸下降位 (工作点)
        i_bLift_HomePos           : BOOL := FALSE;    // 升降气缸上升位 (原点)
        i_bFrontClamp_Closed         : BOOL := FALSE;    // 前夹爪夹紧位 (工作点)
        i_bFrontClamp_Opened         : BOOL := FALSE;    // 前夹爪松开位 (原点)
        i_bRearClamp_Closed         : BOOL := FALSE;    // 后夹爪夹紧位 (工作点)
        i_bRearClamp_Opened         : BOOL := FALSE;    // 后夹爪松开位 (原点)
        i_bFrontClamp2_Closed        : BOOL := FALSE;    // 前夹爪2夹紧位 (工作点)
        i_bFrontClamp2_Opened        : BOOL := FALSE;    // 前夹爪2松开位 (原点)
        i_bRearClamp2_Closed        : BOOL := FALSE;    // 后夹爪2夹紧位 (工作点)
        i_bRearClamp2_Opened        : BOOL := FALSE;    // 后夹爪2松开位 (原点)

        // 产品检测传感器 (4个光电传感器)
        i_bLongEdge1Detect           : BOOL := FALSE;    // 长边1到位检测 (光电传感器)
        i_bLongEdge2Detect           : BOOL := FALSE;    // 长边2到位检测 (光电传感器)
        i_bShortEdge1Detect           : BOOL := FALSE;    // 短边1到位检测 (光电传感器)
        i_bShortEdge2Detect           : BOOL := FALSE;    // 短边2到位检测 (光电传感器)

        // 伺服轴状态信号 (12个, 来自驱动器和限位开关)
        // 原点信号 (3个)
        i_bZAxis_HomePos            : BOOL := FALSE;    // Z轴伺服原点信号 (Home/ORG)
        i_bX1Axis_HomePos           : BOOL := FALSE;    // X1轴伺服原点信号
        i_bX2Axis_HomePos           : BOOL := FALSE;    // X2轴伺服原点信号 (预留)

        // 伺服故障报警 (3个)
        i_bZAxis_ServoFault        : BOOL := FALSE;    // Z轴伺服驱动器故障 (ALM输出)
        i_bX1Axis_ServoFault       : BOOL := FALSE;    // X1轴伺服驱动器故障 (ALM输出)
        i_bX2Axis_ServoFault       : BOOL := FALSE;    // X2轴伺服驱动器故障 (预留)

        // 限位开关信号 (6个)
        i_bZAxis_FwdLimit        : BOOL := FALSE;    // Z轴正限位 (上限位)
        i_bZAxis_RevLimit        : BOOL := FALSE;    // Z轴负限位 (下限位)
        i_bX1Axis_FwdLimit       : BOOL := FALSE;    // X1轴正限位 (取料侧限位)
        i_bX1Axis_RevLimit       : BOOL := FALSE;    // X1轴负限位 (放料侧限位)
        i_bX2Axis_FwdLimit       : BOOL := FALSE;    // X2轴正限位 (预留)
        i_bX2Axis_RevLimit       : BOOL := FALSE;    // X2轴负限位 (预留)

        // --- 上游信号 (4个BOOL, 来自四层输送机的放料完成信号) ---
        i_bConveyor_L1_FeedComplete  : BOOL := FALSE;    // 输送机第1层送料完成
        i_bConveyor_L2_FeedComplete  : BOOL := FALSE;    // 输送机第2层送料完成
        i_bConveyor_L3_FeedComplete  : BOOL := FALSE;    // 输送机第3层送料完成
        i_bConveyor_L4_FeedComplete  : BOOL := FALSE;    // 输送机第4层送料完成

        // === 输出信号 (30个) ===
        // --- 气缸控制输出 (10个BOOL, 双电磁阀) ---
        o_bLift_Up           : BOOL := FALSE;    // 升降气缸上升电磁阀 -> Y地址
        o_bLift_Down           : BOOL := FALSE;    // 升降气缸下降电磁阀 -> Y地址
        o_bFrontClamp_Action         : BOOL := FALSE;    // 前夹爪夹紧电磁阀 -> Y地址
        o_bFrontClamp_Release         : BOOL := FALSE;    // 前夹爪松开电磁阀 -> Y地址
        o_bRearClamp_Action         : BOOL := FALSE;    // 后夹爪夹紧电磁阀 -> Y地址
        o_bRearClamp_Release         : BOOL := FALSE;    // 后夹爪松开电磁阀 -> Y地址
        o_bFrontClamp2_Action        : BOOL := FALSE;    // 前夹爪2夹紧电磁阀 -> Y地址
        o_bFrontClamp2_Release        : BOOL := FALSE;    // 前夹爪2松开电磁阀 -> Y地址
        o_bRearClamp2_Action        : BOOL := FALSE;    // 后夹爪2夹紧电磁阀 -> Y地址
        o_bRearClamp2_Release        : BOOL := FALSE;    // 后夹爪2松开电磁阀 -> Y地址

        // --- 伺服控制输出 (3个BOOL, 仅Z轴由本功能块直接控制) ---
        o_bZAxis_PulseOutput        : BOOL := FALSE;    // Z轴脉冲输出使能 -> Y0 (PULSE)
        o_bZAxis_DirectionOutput        : BOOL := FALSE;    // Z轴方向控制 -> Y4 (SIGN)
        o_bZAxis_Enable        : BOOL := FALSE;    // Z轴伺服使能 (SON) -> Y10

        // --- 下游信号输出 (1个BOOL) ---
        o_bPlaceComplete_ToFeeder  : BOOL := FALSE;    // 放料完成通知下游 (打胶机可取料)

        // --- 状态/HMI显示输出 (7个) ---
        o_bRunning              : BOOL := FALSE;    // 本站当前自动运行中
        o_bFault                : BOOL := FALSE;    // 本站有故障 (任意报警激活)
        o_iCurrentState            : INT := 0;         // 当前状态机步骤 (0~10, 99=故障)
        o_rZAxisCurrentPos         : REAL := 0.0;      // Z轴当前位置反馈 (mm, 来自主控映射)
        o_rX1AxisCurrentPos        : REAL := 0.0;      // X1轴当前位置反馈 (mm, 来自主控映射)
        o_rX2AxisCurrentPos        : REAL := 0.0;      // X2轴当前位置反馈 (mm, 预留, 来自主控映射)
        o_iCurrentPickLayer        : INT := 0;         // 当前取料层号 (0=空闲, 1~4=层号)

        // --- 报警输出 (1个) ---
        o_iStationAlarmCode        : INT := 0;         // 本站当前有效报警代码 (0=无报警, 101~199=报警类型)

        // --- 定时器调试输出 (4个DINT, 给HMI显示已耗时间ms) ---
        q_ePlaceCompleteHold_Elapsed : DINT;   // 放料完成保持定时器已耗时间 (ms)
        q_eAction_Elapsed         : DINT;   // 通用动作定时器已耗时间 (ms)
        q_eProductDetectStable_Elapsed : DINT;   // 产品检测稳定定时器已耗时间 (ms)
        q_eInit_Elapsed       : DINT;   // 初始化定时器已耗时间 (ms)
    END_STRUCT;

    // =========================================================================
    // 第五部分: 打胶机送料机构信号 (FB_1004_GlueMachineFeeder 6步状态机)
    // =========================================================================
    // 说明: 接收取放料机构的放料完成信号后, X2轴移动到打胶机取料位置
    //       包含与取放料机构的安全区互锁逻辑
    //       接口统计: 17输入(6系统+2手动+3工艺+4传感器+2打胶+1上游) + 14输出
    // =========================================================================
    stFeeder : STRUCT
        // === 输入信号 (17个) ===
        // --- 系统控制信号 (6个) ---
        i_bEnable               : BOOL := FALSE;    // 总使能信号
        i_bAutoMode           : BOOL := FALSE;    // 自动运行模式选择
        i_bManualMode           : BOOL := FALSE;    // 手动调试模式选择
        i_bStart               : BOOL := FALSE;    // 自动循环启动按钮 (上升沿触发)
        i_bStop               : BOOL := FALSE;    // 自动循环停止按钮 (电平有效)
        i_bReset               : BOOL := FALSE;    // 故障复位/初始化按钮 (电平有效)

        // --- 手动操作信号 (2个BOOL, X2轴点动) ---
        i_bLx_X2Axis_JogFwd         : BOOL := FALSE;    // 手动-X2轴点动前进 (至打胶机取料位置)
        i_bLx_X2Axis_JogRev         : BOOL := FALSE;    // 手动-X2轴点动后退 (返回待机位置)

        // --- 工艺参数 (3个REAL) ---
        i_rFeedSpeed           : REAL := 120.0;    // X2轴送料运动速度 (mm/s 或 %)
        rStandbyPosition           : REAL := 0.0;      // X2轴待机位置坐标 (mm, 安全等待位置)
        rPickupPosition           : REAL := 300.0;    // X2轴取料位置坐标 (mm, 打胶机取料口位置)

        // --- 传感器/伺服信号 (4个BOOL) ---
        i_bX2Axis_Home           : BOOL := FALSE;    // X2轴伺服原点信号 (Home/ORG)
        i_bX2Axis_ForwardLimit       : BOOL := FALSE;    // X2轴正限位 (向打胶机侧限位)
        i_bX2Axis_ReverseLimit       : BOOL := FALSE;    // X2轴负限位 (待机位置侧限位)
        i_bX2Axis_ServoFault      : BOOL := FALSE;    // X2轴伺服驱动器故障 (ALM输出)

        // --- 打胶机交互信号 (2个BOOL) ---
        i_bGlueMachine_AllowFeed     : BOOL := FALSE;    // 打胶机允许送料信号 (对应物理地址 X76)
        i_bGlueMachine_PickupComplete     : BOOL := FALSE;    // 打胶机取料完成信号 (对应物理地址 X102)

        // --- 上游信号 (1个BOOL, 来自取放料机构) ---
        i_bPickPlace_FeedComplete    : BOOL := FALSE;    // 取放料机构送料完成信号

        // === 输出信号 (14个) ===
        // --- 执行器请求输出 (3个BOOL) ---
        o_bAllowPickup            : BOOL := FALSE;    // 允许取料信号 -> 主控映射至 Y44
        o_bX2Axis_RequestFwd        : BOOL := FALSE;    // X2轴正转移动请求 (至打胶机取料位置)
        o_bX2Axis_RequestRev        : BOOL := FALSE;    // X2轴反转移动请求 (返回待机位置)

        // --- 安全区管理信号 (1个BOOL) ---
        o_bSafetyZoneSignal          : BOOL := FALSE;    // 安全区信号 -> 主控映射至 Y47

        // --- 状态/HMI显示输出 (4个) ---
        o_bRunning              : BOOL := FALSE;    // 本站当前自动运行中
        o_bFault                : BOOL := FALSE;    // 本站有故障 (任意报警激活)
        o_iCurrentState            : INT := 0;         // 当前状态机步骤 (0~5, 99=故障)
        o_rX2Axis_CurrentPosition        : REAL := 0.0;      // X2轴当前位置反馈 (mm, 来自主控映射)

        // --- 报警输出 (1个) ---
        o_iStationAlarmCode        : INT := 0;         // 本站当前有效报警代码 (0=无报警, 201~299=报警类型)

        // --- 定时器调试输出 (4个DINT, 给HMI显示已耗时间ms) ---
        q_eCommTimeout_Elapsed    : DINT;    // 通信超时定时器已耗时间 (ms)
        q_eAction_Elapsed        : DINT;    // 动作定时器已耗时间 (ms)
        q_eInit_Elapsed      : DINT;    // 初始化定时器已耗时间 (ms)
        q_ePickupHold_Elapsed    : DINT;    // 取料保持定时器已耗时间 (ms)
    END_STRUCT;

    // =========================================================================
    // 第六部分: 功能块实例
    // =========================================================================
    // 说明: 所有功能块实例必须定义在此处, 以便测试框架和HMI能够正确识别
    //       V7.0.0: fbConveyor4Layer (FB_1001) 取消, 改为4×FB_1002 展开实例
    // =========================================================================
    fbExternalDevice      : FB_ExternalDeviceInteraction;
    fbConveyor_L1         : FB_1002_SingleLayerConveyor_BufferFraming;
    fbConveyor_L2         : FB_1002_SingleLayerConveyor_BufferFraming;
    fbConveyor_L3         : FB_1002_SingleLayerConveyor_BufferFraming;
    fbConveyor_L4         : FB_1002_SingleLayerConveyor_BufferFraming;
    fbPickPlace           : FB_1003_PickPlace_BufferFraming;
    fbGlueFeeder          : FB_1004_GlueMachineFeeder_BufferFraming;
    fbCommonAlarm         : FB_2001_CommonAlarm_AllStation;
END_VAR

END_DATA_BLOCK
