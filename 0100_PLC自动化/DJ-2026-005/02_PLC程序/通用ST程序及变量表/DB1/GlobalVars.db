// ============================================================================
// GlobalVars.db - 边框缓存机全局变量数据块 (Global Variable Data Block)
// ============================================================================
// 功能说明:
//   定义 DJ-2026-005 边框缓存机 PLC 控制系统的所有全局变量.
//   作为 OB1 主程序与各功能块之间的数据交换中心, 实现统一的数据管理.
//
// 数据组织:
//   采用结构化分组方式, 按功能模块划分变量区域:
//   - stGlobal:    全局控制信号和系统状态 (来自FB_2001_CommonAlarm)
//   - stExternal:  外部设备交互信号 (组框机/打胶机/机器人)
//   - stConveyor:  四层输送机系统信号 (含4层数组, ARRAY[1..4])
//   - stPickPlace: 取放料机构信号 (V6.0.0版本, 55输入/30输出)
//   - stFeeder:    打胶机送料机构信号 (17输入/14输出)
//
// 设计原则:
//   1. 所有 I/O 映射集中在此数据块, 功能块不直接访问物理地址
//   2. 使用 STRUCT 类型实现逻辑分组, 提高可读性
//   3. 变量命名遵循 801_PLC变量命名规范_DEV-V1.0.5
//   4. 初始值设置为安全状态 (FALSE/0), 防止上电误动作
//   5. 完全基于实际FB定义生成, 与OB1调用100%同步
//
// 变更记录:
//   V6.0.0 (2026-05-04): 同步FB_1003 V6.0.0接口重命名
//          - stPickPlace变量重命名47处, 匹配FB_1003 V6.0.0新接口
//          - Grip→Clamp/Unclamp语义统一 (夹爪→夹紧/松开)
//          - HomePoint→HomePos, WorkPoint→Closed/Opened (位置状态语义)
//          - Forward/Reverse→Fwd/Rev缩写统一
//          - 定时器调试输出TIME→DINT (8处, 便于HMI数值显示)
//          - 删除死代码TON1: FB_TON
//          - 修复中文标点符号为英文标点
//   V3.0.0 (2026-05-03): V5.0.0全面重写 - 变量名100%英文化
//          - 替换所有220+处中文变量名为英文(符合801规范V1.0.5)
//          - 统一命名语义: 设备名_功能描述 格式(如FrameMachine_AutoRunning)
//          - 解决OB1↔FB接口不匹配问题, 消除TC001/TC002编译错误
//          - 与OB1.scl V5.0.0 100%同步, 支持VS Code PLC调试器验证
//   V2.0.0 (2026-05-03): 基于OB1 V2.0.0完全重写
//          - 修正所有146处接口不匹配问题
//          - 精确匹配6个功能块的所有输入/输出引脚
//          - 支持V4.2.0版本的FB_1003_PickPlace新接口 (14手动操作+26传感器)
//          - 支持FB_1001_Conveyor4Layer的完整容器接口 (7类传感器)
//          - 新增MES报警队列、定时器调试输出等高级功能变量
//   V1.0.0 (2026-05-02): 初始版本
//          - 配合 OB1 V1.0.0 标准化主程序创建
// ============================================================================

DATA_BLOCK GlobalVars

VAR
    // =========================================================================
    // 第一部分: 全局控制信号与系统状态 (FB_2001_CommonAlarm 输出)
    // =========================================================================
    // 说明: 存储公共报警管理功能块的输出信号
    //       包括全局报警字、优先级报警、互锁信号、MES数据接口等
    //       接口统计: 0输入 + 16输出 (HMI显示2 + 全局互锁1 + MES数据3 + 多报警9)
    // =========================================================================
    stGlobal : STRUCT
        // --- 操作控制 (传给FB_2001) ---
        i_bReset           : BOOL := FALSE;    // Global reset button

        // --- HMI显示输出 (来自FB_2001) ---
        o_wGlobalAlarmWord     : WORD := 0;        // Global alarm word (D400, HMI alarm light)
        o_iCurrentAlarmCode   : INT := 0;         // Highest priority alarm code (D402, HMI text display)

        // --- 全局互锁输出 (来自FB_2001) ---
        o_bAnyAlarmActive   : BOOL := FALSE;    // Global alarm active flag (M200, all stations stop)

        // --- MES数据接口输出 (来自FB_2001) ---
        o_iMESAlarmCount    : INT := 0;         // MES alarm cumulative count (D404)
        o_iMESAlarmQueue    : ARRAY[0..9] OF INT;  // MES alarm queue (D406~D425, last 10 dedup records)
        o_bNewAlarmFlag     : BOOL := FALSE;    // New alarm detection pulse (trigger MES upload)

        // --- 多报警状态输出 (来自FB_2001) ---
        o_iStationAlarmStatus   : ARRAY[1..3] OF INT;  // Three-station alarm status array [1]Conveyor [2]PickPlace [3]Feeder
        o_bConveyorAlarmActive : BOOL := FALSE;    // Conveyor station has alarm flag
        o_bPickPlaceAlarmActive : BOOL := FALSE;    // PickPlace station has alarm flag
        o_bFeederAlarmActive : BOOL := FALSE;  // Feeder station has alarm flag
    END_STRUCT;

    // =========================================================================
    // 第二部分: 外部设备交互信号 (FB_ExternalDeviceInteraction)
    // =========================================================================
    // 说明: 处理与组框机、打胶机和机器人的所有交互逻辑
    //       接口统计: 27输入 + 20输出 = 47个信号
    // =========================================================================
    stExternal : STRUCT
        // === 输入信号 (27个) ===
        // --- 系统控制信号 (6个) ---
        i_bEnable           : BOOL := FALSE;    // System enable
        i_bAutoMode       : BOOL := FALSE;    // Auto mode selection
        i_bManualMode       : BOOL := FALSE;    // Manual mode selection
        i_bStart           : BOOL := FALSE;    // Start button
        i_bStop           : BOOL := FALSE;    // Stop button
        i_bReset           : BOOL := FALSE;    // Reset button

        // --- 组框机输入信号 (7个) ---
        i_bFrameMachine_AutoRunning   : BOOL := FALSE;   // Frame machine auto running
        i_bFrameMachine_AllowFeed : BOOL := FALSE;   // Frame machine allow feeding to buffer
        i_bFrameMaterialRequest : BOOL := FALSE;   // Frame machine has material to feed
        i_bDoorOpenRequest : BOOL := FALSE;   // Frame machine door open request (need pause)
        i_bFrameMachine_EStop     : BOOL := FALSE;   // Frame machine emergency stop (need interlock)
        i_bFrameMachine_SafetyErr : BOOL := FALSE;   // Frame machine safety system error
        i_bFrameMachine_CommErr : BOOL := FALSE;   // Communication error with frame machine

        // --- 打胶机输入信号 (6个) ---
        i_bGlueMachine_AutoRunning   : BOOL := FALSE;   // Glue machine auto running
        i_bGlueMachine_AllowFeed : BOOL := FALSE;   // Glue machine ready to receive frame
        i_bGlueMachine_PickComplete : BOOL := FALSE;   // Glue machine completed pickup
        i_bGlueMachine_Fault     : BOOL := FALSE;   // Glue machine equipment fault alarm
        i_bGlueMachine_EStop     : BOOL := FALSE;   // Glue machine emergency stop status
        i_bGlueMachine_CommErr : BOOL := FALSE;   // Communication interrupted with glue machine

        // --- 机器人输入信号 (5个, 预留) ---
        i_bRobot_AutoRunning   : BOOL := FALSE;   // Robot auto running
        i_bRobot_StackComplete : BOOL := FALSE;   // Robot completed stacking
        i_bRobot_Fault     : BOOL := FALSE;   // Robot equipment fault
        i_bRobot_EStop     : BOOL := FALSE;   // Robot emergency stop status
        i_bRobot_CommErr : BOOL := FALSE;   // Communication error with robot

        // --- 本机状态信号 (3个) ---
        i_bLocalReady       : BOOL := FALSE;    // Local ready status (send to external devices)
        i_bAnyAlarmActive   : BOOL := FALSE;    // Local has any alarm active (independent alarm detection)
        i_bSystemFault       : BOOL := FALSE;    // Local system fault (independent fault detection)

        // === 输出信号 (20个) ===
        // --- 组框机输出信号 (5个) ---
        o_bFrameMachine_RequestFeed : BOOL := FALSE;   // Request frame machine to feed frames
        o_bFrameMachine_Pause     : BOOL := FALSE;   // Send pause command to frame machine
        o_bFrameMachine_EStop     : BOOL := FALSE;   // Send emergency stop interlock signal to frame machine
        o_bDoorOpenRequest        : BOOL := FALSE;   // Request door open operation from frame machine
        o_bFrameMachine_Ready     : BOOL := FALSE;   // Local ready, can receive frames

        // --- 打胶机输出信号 (4个) ---
        o_bGlueMachine_RequestRun : BOOL := FALSE;   // Request glue machine to start running
        o_bAllowPickup        : BOOL := FALSE;   // Notify glue machine can pick up frames
        o_bSafetyZoneSignal      : BOOL := FALSE;   // Safety zone open/close signal
        o_bGlueMachine_ResetReq : BOOL := FALSE;   // Send reset request to glue machine

        // --- 机器人输出信号 (3个, 预留) ---
        o_bRobot_AllowStacking : BOOL := FALSE;   // Allow robot to perform stacking
        o_bRobot_StopStacking : BOOL := FALSE;   // Stop robot stacking
        o_bRobot_ResetReq : BOOL := FALSE;   // Send reset request to robot

        // --- 状态与报警输出 (4个) ---
        o_bFrameMachine_EmergencyStop  : BOOL := FALSE;   // Force local stop when frame machine E-stop/safety error
        o_bExternalDeviceFault    : BOOL := FALSE;   // External device fault flag
        o_iExternalDeviceAlarmSummary : INT := 0;       // External device fault alarm code (300~399 range)
        o_bSystemSafetyConditionMet : BOOL := FALSE;  // System safety condition satisfied
    END_STRUCT;

    // =========================================================================
    // 第三部分: 四层输送机系统信号 (FB_1001_Conveyor4Layer 容器块)
    // =========================================================================
    // 说明: 四层输送机容器块, 内部实例化4个单层输送机 (FB_1002)
    //       所有手动操作和传感器都是 ARRAY[1..4] 类型, 对应4个独立层
    //       接口统计: 34输入(9公共+3工艺+24手动+28传感器-重复) + 30输出
    // =========================================================================
    stConveyor : STRUCT
        // === 输入信号 ===
        // --- 系统控制信号 (9个, 含工艺参数) ---
        i_bEnable               : BOOL := FALSE;    // Total enable signal
        i_bAutoMode           : BOOL := FALSE;    // Auto running mode selection
        i_bManualMode           : BOOL := FALSE;    // Manual debug mode selection
        i_bStart               : BOOL := FALSE;    // Auto cycle start button
        i_bStop               : BOOL := FALSE;    // Auto cycle stop button
        i_bReset               : BOOL := FALSE;    // Fault reset/init button

        // --- 工艺参数 (3个, REAL/INT类型) ---
        i_rConveyorSpeed           : REAL := 50.0;     // Conveyor speed setting (Hz or m/min)
        i_iSeparateTime           : INT := 500;       // Separate action hold time (ms)
        i_iBlockWaitTime        : INT := 200;       // Block cylinder action wait time (ms)

        // --- 手动操作信号 (6类 × 4层 = 24个BOOL, ARRAY[1..4]) ---
        i_bLx_BlockDown           : ARRAY[1..4] OF BOOL;  // Manual-block cylinder down
        i_bLx_BlockUp           : ARRAY[1..4] OF BOOL;  // Manual-block cylinder up
        i_bLx_SeparatePush           : ARRAY[1..4] OF BOOL;  // Manual-separate cylinder push
        i_bLx_SeparateReset           : ARRAY[1..4] OF BOOL;  // Manual-separate cylinder reset
        i_bLx_ConveyorFwd           : ARRAY[1..4] OF BOOL;  // Manual-conveyor forward
        i_bLx_ConveyorRev           : ARRAY[1..4] OF BOOL;  // Manual-conveyor reverse

        // --- 传感器输入 (7类 × 4层 = 28个BOOL, ARRAY[1..4]) ---
        i_bPreSeparateSensor       : ARRAY[1..4] OF BOOL;  // Pre-separate material arrival sensor
        i_bPositionSensor1        : ARRAY[1..4] OF BOOL;  // Position sensor 1 (redundant detection)
        i_bPositionSensor2        : ARRAY[1..4] OF BOOL;  // Position sensor 2 (redundant detection)
        i_bBlockCylinderUp       : ARRAY[1..4] OF BOOL;  // Block cylinder up(release) position feedback
        i_bBlockCylinderDown       : ARRAY[1..4] OF BOOL;  // Block down(block) position feedback
        i_bSeparateCylinderUp       : ARRAY[1..4] OF BOOL;  // Separate cylinder retract position feedback
        i_bSeparateCylinderDown       : ARRAY[1..4] OF BOOL;  // Separate cylinder extend position feedback

        // --- 下游反馈信号 (4个BOOL, ARRAY[1..4]) ---
        i_bFeedComplete         : ARRAY[1..4] OF BOOL;  // PickPlace mechanism has picked this layer material

        // === 输出信号 (30个) ===
        // --- 执行器请求输出 (5类 × 4层 = 20个BOOL, ARRAY[1..4]) ---
        o_bBlockSolenoid         : ARRAY[1..4] OF BOOL;  // TRUE=down(block), FALSE=up(release)
        o_bSeparateSolenoid         : ARRAY[1..4] OF BOOL;  // TRUE=push(separate), FALSE=reset
        o_bConveyorFwd         : ARRAY[1..4] OF BOOL;  // Conveyor forward rotation
        o_bConveyorSlow         : ARRAY[1..4] OF BOOL;  // Conveyor slow speed (for precise positioning)
        o_bConveyorRev         : ARRAY[1..4] OF BOOL;  // Conveyor reverse rotation (for unloading)

        // --- 下游信号输出 (4个BOOL, ARRAY[1..4]) ---
        o_bFeedComplete           : ARRAY[1..4] OF BOOL;  // This layer feed complete, ready for pickup

        // --- 状态/HMI显示输出 (4个) ---
        o_bRunning             : BOOL := FALSE;        // Any layer is currently auto running
        o_bFault               : BOOL := FALSE;        // This station has fault (any alarm active)
        o_iCurrentState           : INT := 0;             // Current main state code (0=idle, 1-8=step, 99=fault)
        o_LxCurrentStep          : ARRAY[1..4] OF INT;   // Each layer current step (0-8)

        // --- 报警输出 (1个) ---
        o_iAlarmCode       : INT := 0;             // This station current valid alarm code (0=no alarm, 1-7=alarm type)
    END_STRUCT;

    // =========================================================================
    // 第四部分: 取放料机构信号 (FB_1003_PickPlace 11步状态机, V6.0.0版本)
    // =========================================================================
    // 说明: Z轴升降 + X1轴横移 + 夹爪控制的 11 步状态机
    //       一次取两根边框 (前后夹紧同时动作), 4层循环2次完成全部取料
    //       V6.0.0重大更新: 变量重命名匹配FB_1003 V6.0.0新接口
    //       接口统计: 55输入(8系统+14手动+6工艺+26传感器+4上游) + 30输出
    // =========================================================================
    stPickPlace : STRUCT
        // === 输入信号 (55个) ===
        // --- 系统控制信号 (8个) ---
        i_bEnable               : BOOL := FALSE;    // Total enable signal
        i_bAutoMode           : BOOL := FALSE;    // Auto running mode selection
        i_bManualMode           : BOOL := FALSE;    // Manual debug mode selection
        i_bStart               : BOOL := FALSE;    // Auto cycle start button (rising edge trigger)
        i_bStop               : BOOL := FALSE;    // Auto cycle stop button (level effective)
        i_bReset               : BOOL := FALSE;    // Fault reset/init button (level effective)

        // --- 手动操作信号 (14个BOOL) ---
        // 伺服点动控制 (4个)
        i_bLx_ZAxis_JogUp          : BOOL := FALSE;    // Manual-Z axis jog up
        i_bLx_ZAxis_JogDown          : BOOL := FALSE;    // Manual-Z axis jog down
        i_bLx_X1Axis_JogFwd         : BOOL := FALSE;    // Manual-X1 axis jog forward (pickup direction)
        i_bLx_X1Axis_JogRev         : BOOL := FALSE;    // Manual-X1 axis jog reverse (place direction)

        // 气缸手动控制 (10个, 双电磁阀)
        i_bLx_Lift_Up           : BOOL := FALSE;    // Manual-lift cylinder up
        i_bLx_Lift_Down           : BOOL := FALSE;    // Manual-lift cylinder down
        i_bLx_FrontClamp         : BOOL := FALSE;    // Manual-front clamp action
        i_bLx_FrontUnclamp         : BOOL := FALSE;    // Manual-front clamp release
        i_bLx_RearClamp         : BOOL := FALSE;    // Manual-rear clamp action
        i_bLx_RearUnclamp         : BOOL := FALSE;    // Manual-rear clamp release
        i_bLx_FrontClamp2        : BOOL := FALSE;    // Manual-front clamp2 action (second front clamp)
        i_bLx_FrontUnclamp2        : BOOL := FALSE;    // Manual-front clamp2 release
        i_bLx_RearClamp2        : BOOL := FALSE;    // Manual-rear clamp2 action (second rear clamp)
        i_bLx_RearUnclamp2        : BOOL := FALSE;    // Manual-rear clamp2 release

        // --- 工艺参数 (6个, REAL/INT类型) ---
        // 运动速度参数 (4个REAL)
        i_rPickupSpeed           : REAL := 100.0;    // Pickup process Z axis down/up speed (mm/s or %)
        i_rPlaceSpeed           : REAL := 80.0;     // Place process Z axis down/up speed (mm/s or %)
        i_rZAxisSpeed            : REAL := 100.0;    // Z axis general motion speed setting (mm/s)
        i_rX1AxisSpeed           : REAL := 150.0;    // X1 axis general motion speed setting (mm/s)

        // 动作时间参数 (2个INT)
        i_iClampConfirmTime       : INT := 500;       // Clamp close confirm wait time (ms)
        i_iLiftActionTime       : INT := 3000;      // Lift cylinder action timeout time (ms)

        // --- 传感器输入 (26个BOOL) ---
        // 气缸位置传感器 (10个磁性开关)
        i_bLift_WorkPoint           : BOOL := FALSE;    // Lift cylinder down position (work point)
        i_bLift_HomePos           : BOOL := FALSE;    // Lift cylinder up position (home position)
        i_bFrontClamp_Closed         : BOOL := FALSE;    // Front clamp closed position (work point)
        i_bFrontClamp_Opened         : BOOL := FALSE;    // Front clamp opened position (home point)
        i_bRearClamp_Closed         : BOOL := FALSE;    // Rear clamp closed position (work point)
        i_bRearClamp_Opened         : BOOL := FALSE;    // Rear clamp opened position (home point)
        i_bFrontClamp2_Closed        : BOOL := FALSE;    // Front clamp2 closed position (work point)
        i_bFrontClamp2_Opened        : BOOL := FALSE;    // Front clamp2 opened position (home point)
        i_bRearClamp2_Closed        : BOOL := FALSE;    // Rear clamp2 closed position (work point)
        i_bRearClamp2_Opened        : BOOL := FALSE;    // Rear clamp2 opened position (home point)

        // 产品检测传感器 (4个光电传感器)
        i_bLongEdge1Detect           : BOOL := FALSE;    // Long edge 1 presence detection (photoelectric sensor)
        i_bLongEdge2Detect           : BOOL := FALSE;    // Long edge 2 presence detection (photoelectric sensor)
        i_bShortEdge1Detect           : BOOL := FALSE;    // Short edge 1 presence detection (photoelectric sensor)
        i_bShortEdge2Detect           : BOOL := FALSE;    // Short edge 2 presence detection (photoelectric sensor)

        // 伺服轴状态信号 (12个, 来自驱动器和限位开关)
        // 原点信号 (3个)
        i_bZAxis_HomePos            : BOOL := FALSE;    // Z axis servo home position signal (Home/ORG)
        i_bX1Axis_HomePos           : BOOL := FALSE;    // X1 axis servo home position signal
        i_bX2Axis_HomePos           : BOOL := FALSE;    // X2 axis servo home position signal (reserved)

        // 伺服故障报警 (3个)
        i_bZAxis_ServoFault        : BOOL := FALSE;    // Z axis servo drive fault (ALM output)
        i_bX1Axis_ServoFault       : BOOL := FALSE;    // X1 axis servo drive fault (ALM output)
        i_bX2Axis_ServoFault       : BOOL := FALSE;    // X2 axis servo drive fault (reserved)

        // 限位开关信号 (6个)
        i_bZAxis_FwdLimit        : BOOL := FALSE;    // Z axis forward limit (upper limit)
        i_bZAxis_RevLimit        : BOOL := FALSE;    // Z axis reverse limit (lower limit)
        i_bX1Axis_FwdLimit       : BOOL := FALSE;    // X1 axis forward limit (pickup side limit)
        i_bX1Axis_RevLimit       : BOOL := FALSE;    // X1 axis reverse limit (place side limit)
        i_bX2Axis_FwdLimit       : BOOL := FALSE;    // X2 axis forward limit (reserved)
        i_bX2Axis_RevLimit       : BOOL := FALSE;    // X2 axis reverse limit (reserved)

        // --- 上游信号 (4个BOOL, 来自四层输送机的放料完成信号) ---
        i_bConveyor_L1_FeedComplete  : BOOL := FALSE;    // Conveyor layer 1 feed complete
        i_bConveyor_L2_FeedComplete  : BOOL := FALSE;    // Conveyor layer 2 feed complete
        i_bConveyor_L3_FeedComplete  : BOOL := FALSE;    // Conveyor layer 3 feed complete
        i_bConveyor_L4_FeedComplete  : BOOL := FALSE;    // Conveyor layer 4 feed complete

        // === 输出信号 (30个) ===
        // --- 气缸控制输出 (10个BOOL, 双电磁阀) ---
        o_bLift_Up           : BOOL := FALSE;    // Lift cylinder up solenoid -> Y address
        o_bLift_Down           : BOOL := FALSE;    // Lift cylinder down solenoid -> Y address
        o_bFrontClamp_Action         : BOOL := FALSE;    // Front clamp action solenoid -> Y address
        o_bFrontClamp_Release         : BOOL := FALSE;    // Front clamp release solenoid -> Y address
        o_bRearClamp_Action         : BOOL := FALSE;    // Rear clamp action solenoid -> Y address
        o_bRearClamp_Release         : BOOL := FALSE;    // Rear clamp release solenoid -> Y address
        o_bFrontClamp2_Action        : BOOL := FALSE;    // Front clamp2 action solenoid -> Y address
        o_bFrontClamp2_Release        : BOOL := FALSE;    // Front clamp2 release solenoid -> Y address
        o_bRearClamp2_Action        : BOOL := FALSE;    // Rear clamp2 action solenoid -> Y address
        o_bRearClamp2_Release        : BOOL := FALSE;    // Rear clamp2 release solenoid -> Y address

        // --- 伺服控制输出 (3个BOOL, 仅Z轴由本功能块直接控制) ---
        o_bZAxis_PulseOutput        : BOOL := FALSE;    // Z axis pulse output enable -> Y0 (PULSE)
        o_bZAxis_DirectionOutput        : BOOL := FALSE;    // Z axis direction control -> Y4 (SIGN)
        o_bZAxis_Enable        : BOOL := FALSE;    // Z axis servo enable (SON) -> Y10

        // --- 下游信号输出 (1个BOOL) ---
        o_bPlaceComplete_ToFeeder  : BOOL := FALSE;    // Place complete notify downstream (glue machine can pickup)

        // --- 状态/HMI显示输出 (7个) ---
        o_bRunning              : BOOL := FALSE;    // This station is currently auto running
        o_bFault                : BOOL := FALSE;    // This station has fault (any alarm active)
        o_iCurrentState            : INT := 0;         // Current state machine step (0~10, 99=fault)
        o_rZAxisCurrentPos         : REAL := 0.0;      // Z axis current position feedback (mm, from main control mapping)
        o_rX1AxisCurrentPos        : REAL := 0.0;      // X1 axis current position feedback (mm, from main control mapping)
        o_rX2AxisCurrentPos        : REAL := 0.0;      // X2 axis current position feedback (mm, reserved, from main control mapping)
        o_iCurrentPickLayer        : INT := 0;         // Current processing layer number (0=idle, 1~4=layer number)

        // --- 报警输出 (1个) ---
        o_iStationAlarmCode        : INT := 0;         // This station current valid alarm code (0=no alarm, 101~199=alarm type)

        // --- 定时器调试输出 (4个DINT, 给HMI显示已耗时间ms) ---
        q_ePlaceCompleteHold_Elapsed : DINT;   // Place complete hold timer elapsed time (ms)
        q_eAction_Elapsed         : DINT;   // General action timer elapsed time (ms)
        q_eProductDetectStable_Elapsed : DINT;   // Product detect stable timer elapsed time (ms)
        q_eInit_Elapsed       : DINT;   // Init timer elapsed time (ms)
    END_STRUCT;

    // =========================================================================
    // 第五部分: 打胶机送料机构信号 (FB_1004_GlueMachineFeeder 6步状态机)
    // =========================================================================
    // 说明: 接收取放料机构的放料完成信号后, X2轴移动到打胶机取料位置
    //       包含与取放料机构的安全区互锁逻辑
    //       接口统计: 17输入(6系统+2手动+3工艺+4传感器+2打胶+1上游) + 14输出
    // =========================================================================
    stFeeder : STRUCT
        // === 输入信号 (17个) ===
        // --- 系统控制信号 (6个) ---
        i_bEnable               : BOOL := FALSE;    // Total enable signal
        i_bAutoMode           : BOOL := FALSE;    // Auto running mode selection
        i_bManualMode           : BOOL := FALSE;    // Manual debug mode selection
        i_bStart               : BOOL := FALSE;    // Auto cycle start button (rising edge trigger)
        i_bStop               : BOOL := FALSE;    // Auto cycle stop button (level effective)
        i_bReset               : BOOL := FALSE;    // Fault reset/init button (level effective)

        // --- 手动操作信号 (2个BOOL, X2轴点动) ---
        i_bLx_X2Axis_JogFwd         : BOOL := FALSE;    // Manual-X2 axis jog forward (to glue machine pickup position)
        i_bLx_X2Axis_JogRev         : BOOL := FALSE;    // Manual-X2 axis jog reverse (return to standby position)

        // --- 工艺参数 (3个REAL) ---
        i_rFeedSpeed           : REAL := 120.0;    // X2 axis feed motion speed (mm/s or %)
        rStandbyPosition           : REAL := 0.0;      // X2 axis standby position coordinate (mm, safe waiting position)
        rPickupPosition           : REAL := 300.0;    // X2 axis pickup position coordinate (mm, glue machine pickup port position)

        // --- 传感器/伺服信号 (4个BOOL) ---
        i_bX2Axis_Home           : BOOL := FALSE;    // X2 axis servo home signal (Home/ORG)
        i_bX2Axis_ForwardLimit       : BOOL := FALSE;    // X2 axis forward limit (to glue machine side limit)
        i_bX2Axis_ReverseLimit       : BOOL := FALSE;    // X2 axis reverse limit (standby position side limit)
        i_bX2Axis_ServoFault      : BOOL := FALSE;    // X2 axis servo drive fault (ALM output)

        // --- 打胶机交互信号 (2个BOOL) ---
        i_bGlueMachine_AllowFeed     : BOOL := FALSE;    // Glue machine allow feed signal (corresponding to physical address X76)
        i_bGlueMachine_PickupComplete     : BOOL := FALSE;    // Glue machine pickup complete signal (corresponding to physical address X102)

        // --- 上游信号 (1个BOOL, 来自取放料机构) ---
        i_bPickPlace_FeedComplete    : BOOL := FALSE;    // PickPlace mechanism feed complete signal

        // === 输出信号 (14个) ===
        // --- 执行器请求输出 (3个BOOL) ---
        o_bAllowPickup            : BOOL := FALSE;    // Allow pickup signal -> main control mapping to Y44
        o_bX2Axis_RequestFwd        : BOOL := FALSE;    // X2 axis forward move request (to glue machine pickup position)
        o_bX2Axis_RequestRev        : BOOL := FALSE;    // X2 axis reverse move request (return to standby position)

        // --- 安全区管理信号 (1个BOOL) ---
        o_bSafetyZoneSignal          : BOOL := FALSE;    // Safety zone signal -> main control mapping to Y47

        // --- 状态/HMI显示输出 (4个) ---
        o_bRunning              : BOOL := FALSE;    // This station is currently auto running
        o_bFault                : BOOL := FALSE;    // This station has fault (any alarm active)
        o_iCurrentState            : INT := 0;         // Current state machine step (0~5, 99=fault)
        o_rX2Axis_CurrentPosition        : REAL := 0.0;      // X2 axis current position feedback (mm, from main control mapping)

        // --- 报警输出 (1个) ---
        o_iStationAlarmCode        : INT := 0;         // This station current valid alarm code (0=no alarm, 201~299=alarm type)

        // --- 定时器调试输出 (4个DINT, 给HMI显示已耗时间ms) ---
        q_eCommTimeout_Elapsed    : DINT;    // Communication timeout timer elapsed time (ms)
        q_eAction_Elapsed        : DINT;    // Action timer elapsed time (ms)
        q_eInit_Elapsed      : DINT;    // Init timer elapsed time (ms)
        q_ePickupHold_Elapsed    : DINT;    // Pickup hold timer elapsed time (ms)
    END_STRUCT;

    // =========================================================================
    // 第六部分: 功能块实例
    // =========================================================================
    // 说明: 所有功能块实例必须定义在此处, 以便测试框架能够正确识别
    // =========================================================================
    fbExternalDevice      : FB_ExternalDeviceInteraction;
    fbConveyor4Layer      : FB_1001_Conveyor4Layer_BufferFraming;
    fbPickPlace           : FB_1003_PickPlace_BufferFraming;
    fbGlueFeeder          : FB_1004_GlueMachineFeeder_BufferFraming;
    fbCommonAlarm         : FB_2001_CommonAlarm_AllStation;
END_VAR

END_DATA_BLOCK
