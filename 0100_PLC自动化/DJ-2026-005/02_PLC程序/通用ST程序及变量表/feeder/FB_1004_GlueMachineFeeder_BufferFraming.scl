(* ================================================================= *)
(*  功能块名称：FB_1004_GlueMachineFeeder_BufferFraming               *)
(*  功能描述：打胶机送料机构 - 4步D760状态机(X2横移+打胶机交互)    *)
(*  创建日期：2026-05-04                                              *)
(*  版本号：V6.0.0                                                    *)
(*  编制人：Trae                                                      *)
(*  审核人：人工                                                      *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - 801_PLC变量命名与功能块命名规范_DEV-V1.0.5                    *)
(*    - 810_PLC编程规范_DEV-V1.0.2                                    *)
(*                                                                     *)
(*  变更记录：                                                          *)
(* ---------------------------------------------------------------- *)
(*  V6.0.0 (2026-05-18) Trae                                         *)
(*  - 重写: 6步→4步D760状态机（对齐源程序D760~D763）               *)
(*  - 重写: o_前缀→q_前缀（801规范）                               *)
(*  - 新增: 轴抽象请求接口(q_bXxxReq+q_rTargetPos)                  *)
(*  - 新增: 安全区信号(Y47)与打胶机允许取料(Y44)                   *)
(*  - 新增: 送料平台边框检测(F81)                                  *)
(*  - 新增: TONR定时器（tIn/tQ/tR/tPt/tEt简化命名）               *)
(* ---------------------------------------------------------------- *)
(*  V1.0.0 (2026-05-04)                                              *)
(*  - 6步版本，含直接伺服控制（已废弃）                            *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1004_GlueMachineFeeder_BufferFraming

(* ==================== VAR_INPUT ==================== *)
VAR_INPUT
    i_bAutoMode                 : BOOL;     (* 自动模式 *)
    i_bManualMode               : BOOL;     (* 手动模式 *)
    i_bStart                    : BOOL;     (* 启动 *)
    i_bStop                     : BOOL;     (* 停止 *)

    i_bLx_X2JogPos              : BOOL;     (* 手动:X2正向点动 *)
    i_bLx_X2JogNeg              : BOOL;     (* 手动:X2反向点动 *)

    i_bPlaceDone                : BOOL;     (* FB_1003放料完成脉冲 *)
    i_rX2Speed                  : REAL;     (* X2轴速度 *)

    i_bGlueMachineAllowFeed     : BOOL;     (* 打胶机允许送料(X76) *)
    i_bGlueMachinePickupComplete : BOOL;    (* 打胶机取料完成(X102) *)

    i_bX2ZoneSensor1            : BOOL;     (* X2区域前传感器1(X72) *)
    i_bX2ZoneSensor2            : BOOL;     (* X2区域前传感器2(X73) *)
    i_bX2ZoneSensor3            : BOOL;     (* X2区域后传感器1(X74) *)
    i_bX2ZoneSensor4            : BOOL;     (* X2区域后传感器2(X75) *)
END_VAR

(* ==================== VAR_OUTPUT ==================== *)
VAR_OUTPUT
    q_bX2AxisHomeRequest        : BOOL;     (* X2回原点请求 *)
    q_bX2AxisMoveAbsReq         : BOOL;     (* X2绝对定位请求 *)
    q_rX2AxisTargetPos          : REAL;     (* X2目标位置 *)
    q_bAllowPickup              : BOOL;     (* 允许打胶机抓料(Y44) *)
    q_bSafetyZoneSignal         : BOOL;     (* 打胶机安全区(Y47) *)
    q_iCurrentState             : INT;      (* 当前D760值(0~3) *)
    q_iAlarmCode                : INT;      (* 当前报警码 *)
    q_bFrameOnFeedPlatform      : BOOL;     (* 送料平台有边框(F81) *)
    q_bRunning                  : BOOL;     (* 运行中 *)
END_VAR

(* ==================== VAR ==================== *)
VAR
    bStepEntry              : BOOL;         (* 新步入口标志 *)
    bRunning                : BOOL;         (* 运行标志 *)
    iCurrentState           : INT;          (* 当前状态内部 *)
    iAlarmCode              : INT;          (* 报警码内部 *)
    bStartTriggered         : BOOL;         (* 启动锁存 *)

    tIn                     : ARRAY[0..1] OF BOOL;
    tQ                      : ARRAY[0..1] OF BOOL;
    tR                      : ARRAY[0..1] OF BOOL;
    tPt                     : ARRAY[0..1] OF DINT;
    tEt                     : ARRAY[0..1] OF DINT;

    tMoveTimer              : FB_TONR;      (* X2移动超时 *)
    tCommTimer              : FB_TONR;      (* 打胶机通信超时 *)

    bPlaceDoneMem           : BOOL;         (* 放料完成记忆 *)
    bFrameOnPlatform        : BOOL;         (* 平台有边框 *)

    rPickupPos              : REAL := 620.0;   (* D620取料点 *)
    rGluePlacePos           : REAL := 630.0;   (* D630打胶机送料点 *)
    rStandbyPos             : REAL := 610.0;   (* D610待机位 *)
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    D760_IDLE               : INT := 0;     (* 空闲待机 *)
    D760_MOVE_TO_PICKUP     : INT := 1;     (* X2→取料位D620 *)
    D760_MOVE_TO_GLUE       : INT := 2;     (* X2→打胶机送料D630 *)
    D760_RETURN_STANDBY     : INT := 3;     (* X2→待机位D610 *)

    T_MOVE_DEFAULT          : DINT := 20000;   (* 移动超时默认20s *)
    T_COMM_DEFAULT          : DINT := 10000;  (* 通信超时默认10s *)
END_VAR

(* ==================== 定时器调用 ==================== *)
tMoveTimer(IN := tIn[0], R := tR[0], PT := tPt[0], Q => tQ[0], ET => tEt[0]);
tCommTimer(IN := tIn[1], R := tR[1], PT := tPt[1], Q => tQ[1], ET => tEt[1]);

(* ==================== 使能关闭 ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    q_bX2AxisHomeRequest := FALSE; q_bX2AxisMoveAbsReq := FALSE;
    q_rX2AxisTargetPos := 0.0;
    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
    q_iAlarmCode := 0; q_bFrameOnFeedPlatform := FALSE;
    q_bRunning := FALSE;
    iCurrentState := D760_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    bPlaceDoneMem := FALSE;
    RETURN;
END_IF;

(* ==================== 停止处理 ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := D760_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    q_bX2AxisMoveAbsReq := FALSE;
    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    bPlaceDoneMem := FALSE;
END_IF;

(* ==================== 放料完成脉冲记忆 ==================== *)
IF i_bPlaceDone THEN
    bPlaceDoneMem := TRUE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* --- 启动触发 --- *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
        bRunning := TRUE;
    END_IF;

    CASE iCurrentState OF

        D760_IDLE: (* 0 - 空闲待机 *)
            IF bStepEntry THEN
                q_bX2AxisMoveAbsReq := FALSE;
                q_bAllowPickup := FALSE;
                q_bSafetyZoneSignal := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* 检查送料平台是否有残留边框 *)
            IF i_bX2ZoneSensor1 OR i_bX2ZoneSensor2 THEN
                q_bFrameOnFeedPlatform := TRUE;
                bFrameOnPlatform := TRUE;
                iAlarmCode := 81;
            END_IF;

            IF bPlaceDoneMem AND bStartTriggered THEN
                bPlaceDoneMem := FALSE;
                bStepEntry := TRUE;
                iCurrentState := D760_MOVE_TO_PICKUP;
            END_IF;

        D760_MOVE_TO_PICKUP: (* 1 - X2→取料点D620 *)
            IF bStepEntry THEN
                q_rX2AxisTargetPos := rPickupPos;
                q_bX2AxisMoveAbsReq := TRUE;
                tPt[0] := T_MOVE_DEFAULT;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* X2到达取料点 *)
            IF i_bX2ZoneSensor1 AND i_bX2ZoneSensor2 THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                bStepEntry := TRUE;
                iCurrentState := D760_MOVE_TO_GLUE;
            ELSIF tQ[0] THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bX2AxisMoveAbsReq := FALSE;
                iAlarmCode := 203;
                iCurrentState := D760_IDLE;
                bRunning := FALSE;
            END_IF;

        D760_MOVE_TO_GLUE: (* 2 - X2→放料点D630，与打胶机交互 *)
            IF bStepEntry THEN
                q_rX2AxisTargetPos := rGluePlacePos;
                q_bX2AxisMoveAbsReq := TRUE;
                tPt[0] := T_MOVE_DEFAULT;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bX2ZoneSensor3 OR i_bX2ZoneSensor4 THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bSafetyZoneSignal := TRUE;
            ELSIF tQ[0] THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bX2AxisMoveAbsReq := FALSE;
                iAlarmCode := 203;
                iCurrentState := D760_IDLE;
                bRunning := FALSE;
            END_IF;

            IF q_bSafetyZoneSignal THEN
                IF i_bGlueMachineAllowFeed THEN
                    q_bAllowPickup := TRUE;
                END_IF;
                IF i_bGlueMachinePickupComplete THEN
                    q_bAllowPickup := FALSE;
                    bStepEntry := TRUE;
                    iCurrentState := D760_RETURN_STANDBY;
                END_IF;
            END_IF;

        D760_RETURN_STANDBY: (* 3 - X2→待机位D610 *)
            IF bStepEntry THEN
                q_rX2AxisTargetPos := rStandbyPos;
                q_bX2AxisMoveAbsReq := TRUE;
                tPt[0] := T_MOVE_DEFAULT;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bX2ZoneSensor1 AND i_bX2ZoneSensor2 THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bSafetyZoneSignal := FALSE;
                bStepEntry := TRUE;
                iCurrentState := D760_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            ELSIF tQ[0] THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bX2AxisMoveAbsReq := FALSE;
                q_bSafetyZoneSignal := FALSE;
                iAlarmCode := 203;
                iCurrentState := D760_IDLE;
                bRunning := FALSE;
            END_IF;

        ELSE
            iCurrentState := D760_IDLE;
            bRunning := FALSE; bStartTriggered := FALSE;
    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE; iCurrentState := D760_IDLE;
    bStepEntry := TRUE; bStartTriggered := FALSE;
    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
    bPlaceDoneMem := FALSE;

    IF i_bLx_X2JogPos AND NOT i_bLx_X2JogNeg THEN
        q_bX2AxisMoveAbsReq := TRUE;
        q_rX2AxisTargetPos := rGluePlacePos;
    ELSIF i_bLx_X2JogNeg AND NOT i_bLx_X2JogPos THEN
        q_bX2AxisMoveAbsReq := TRUE;
        q_rX2AxisTargetPos := rStandbyPos;
    ELSE
        q_bX2AxisMoveAbsReq := FALSE;
    END_IF;

    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;

ELSE
    q_bX2AxisMoveAbsReq := FALSE;
    q_bAllowPickup := FALSE; q_bSafetyZoneSignal := FALSE;
END_IF;

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;
q_iAlarmCode := iAlarmCode;

END_FUNCTION_BLOCK
