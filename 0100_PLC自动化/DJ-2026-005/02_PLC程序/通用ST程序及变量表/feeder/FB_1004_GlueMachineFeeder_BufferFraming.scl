// ============================================================================
// FB_1004_GlueMachineFeeder_BufferFraming
// Description: Glue machine feeder mechanism for buffer framing machine
// Project: DJ-2026-005
// Version: V6.0.0
// Date: 2026-05-04
// ============================================================================
//
// Function:
//   1. Auto mode: 6-step state machine for X2 axis feeding
//   2. Manual mode: X2 axis jog control
//   3. Safety zone management (interlock with PickPlace)
//   4. Glue machine interaction (allow pickup, comm timeout)
//   5. Alarm detection: 5 alarm types (201-205 range)
//   6. Timer: uses SysLib FB_TON (DINT PT/ET, not TIME)
//
// State Machine Steps:
//   0 = Idle
//   1 = Wait for PickPlace feed complete
//   2 = Move X2 axis to pickup position
//   3 = Wait for glue machine allow feed
//   4 = Send allow pickup signal (hold for timer)
//   5 = Return X2 axis to standby position
//
// Alarm Codes (201-205):
//   201 = Communication timeout with glue machine
//   202 = Safety zone conflict
//   203 = X2 axis servo fault
//   204 = X2 axis move timeout
//   205 = Pickup position arrival timeout
// ============================================================================

FUNCTION_BLOCK FB_1004_GlueMachineFeeder_BufferFraming

//#region 100_VAR_INPUT
VAR_INPUT
    // System control signals (6)
    i_bEnable                   : BOOL;    // Total enable signal
    i_bAutoMode                 : BOOL;    // Auto running mode selection
    i_bManualMode               : BOOL;    // Manual debug mode selection
    i_bStart                    : BOOL;    // Auto cycle start button
    i_bStop                     : BOOL;    // Auto cycle stop button
    i_bReset                    : BOOL;    // Fault reset/init button

    // Manual operation signals (2)
    i_bLx_X2Axis_JogFwd         : BOOL;    // Manual-X2 axis jog forward
    i_bLx_X2Axis_JogRev         : BOOL;    // Manual-X2 axis jog reverse

    // Process parameters (3 REAL)
    i_rFeedSpeed                : REAL;    // X2 axis feed speed (mm/s or %)
    rStandbyPosition            : REAL;    // X2 axis standby position (mm)
    rPickupPosition             : REAL;    // X2 axis pickup position (mm)

    // X2 axis servo status (4)
    i_bX2Axis_Home              : BOOL;    // X2 axis servo home signal
    i_bX2Axis_ForwardLimit      : BOOL;    // X2 axis forward limit
    i_bX2Axis_ReverseLimit      : BOOL;    // X2 axis reverse limit
    i_bX2Axis_ServoFault        : BOOL;    // X2 axis servo drive fault

    // Glue machine interaction (2)
    i_bGlueMachine_AllowFeed    : BOOL;    // Glue machine ready to receive
    i_bGlueMachine_PickupComplete : BOOL;  // Glue machine completed pickup

    // Upstream signal (1)
    i_bPickPlace_FeedComplete   : BOOL;    // PickPlace feed complete signal
END_VAR
//#endregion 100_VAR_INPUT

//#region 200_VAR_OUTPUT
VAR_OUTPUT
    // Downstream signal (1)
    o_bAllowPickup              : BOOL;    // Allow pickup signal -> Y44

    // Motion request (2)
    o_bX2Axis_RequestFwd        : BOOL;    // X2 axis forward move request
    o_bX2Axis_RequestRev        : BOOL;    // X2 axis reverse move request

    // Safety zone management (1)
    o_bSafetyZoneSignal         : BOOL;    // Safety zone signal -> Y47

    // Status/HMI display (5)
    o_bRunning                  : BOOL;    // Currently auto running
    o_bFault                    : BOOL;    // This station has fault
    o_iCurrentState             : INT;     // Current state (0-5, 99=fault)
    o_rX2Axis_CurrentPosition   : REAL;    // X2 axis current position (mm)
    o_iStationAlarmCode         : INT;     // Alarm code (0=none, 201-205)

    // Timer debug outputs (4 DINT, scan cycles)
    q_eCommTimeout_Elapsed      : DINT;    // Comm timeout timer elapsed
    q_eAction_Elapsed           : DINT;    // Action timer elapsed
    q_eInit_Elapsed             : DINT;    // Init timer elapsed
    q_ePickupHold_Elapsed       : DINT;    // Pickup hold timer elapsed
END_VAR
//#endregion 200_VAR_OUTPUT

//#region 300_VAR
VAR
    // State machine core
    s_iCurrentStep          : INT;     // Current state machine step
    s_bRunning              : BOOL;    // Auto running flag
    s_bFault                : BOOL;    // Fault flag
    s_iActiveAlarmCode      : INT;     // Active alarm code
    s_bStartTriggered       : BOOL;    // Start signal latched

    // Timers (SysLib FB_TON, PT/ET are DINT)
    fb_tCommTimeoutTimer    : FB_TON;  // Communication timeout timer
    fb_tActionTimer         : FB_TON;  // X2 axis move action timer
    fb_tInitTimer           : FB_TON;  // Initialization timer
    fb_tPickupHoldTimer     : FB_TON;  // Allow pickup hold timer

    // Timer Q output variables
    s_bCommTimeoutTimer_Q   : BOOL;
    s_bActionTimer_Q        : BOOL;
    s_bInitTimer_Q          : BOOL;
    s_bPickupHoldTimer_Q    : BOOL;

    // Safety zone management
    s_bSafetyZoneActive     : BOOL;    // Safety zone is active (X2 in motion)

    // Initialization
    s_bInitComplete         : BOOL;    // Initialization complete flag
    s_bInitializing         : BOOL;    // Currently initializing
END_VAR
//#endregion 300_VAR

//#region 400_VAR_CONSTANT
VAR CONSTANT
    // State machine steps
    STP_Idle            : INT := 0;   // Idle
    STP_WaitFeed        : INT := 1;   // Wait for PickPlace feed complete
    STP_MoveToPickup    : INT := 2;   // Move X2 to pickup position
    STP_WaitAllowFeed   : INT := 3;   // Wait for glue machine allow feed
    STP_SendAllowPickup : INT := 4;   // Send allow pickup signal
    STP_ReturnStandby   : INT := 5;   // Return X2 to standby position

    // Alarm codes (201-205)
    ALM_CommTimeout         : INT := 201;  // Communication timeout
    ALM_SafetyZoneConflict  : INT := 202;  // Safety zone conflict
    ALM_X2AxisServoFault    : INT := 203;  // X2 axis servo fault
    ALM_X2AxisMoveTimeout   : INT := 204;  // X2 axis move timeout
    ALM_PickupPosTimeout    : INT := 205;  // Pickup position timeout

    // Default timer values (DINT, scan cycles)
    T_DEF_CommTimeout       : DINT := 10000;  // Comm timeout (10s)
    T_DEF_MoveTimeout       : DINT := 5000;   // Move timeout (5s)
    T_DEF_InitTimeout       : DINT := 10000;  // Init timeout (10s)
    T_DEF_PickupHoldTime    : DINT := 500;    // Pickup hold time
END_VAR
//#endregion 400_VAR_CONSTANT

// ============================================================================
// Main program logic
// ============================================================================

// --- Enable off: safe state ---
IF NOT i_bEnable THEN
    o_bAllowPickup := FALSE;
    o_bX2Axis_RequestFwd := FALSE;
    o_bX2Axis_RequestRev := FALSE;
    o_bSafetyZoneSignal := FALSE;
    o_bRunning := FALSE;
    o_bFault := FALSE;
    o_iCurrentState := STP_Idle;
    o_rX2Axis_CurrentPosition := 0.0;
    o_iStationAlarmCode := 0;
    s_iCurrentStep := STP_Idle;
    s_bRunning := FALSE;
    s_bFault := FALSE;
    s_iActiveAlarmCode := 0;
    s_bStartTriggered := FALSE;
    s_bSafetyZoneActive := FALSE;
    s_bInitComplete := FALSE;
    s_bInitializing := FALSE;
    fb_tCommTimeoutTimer(IN := FALSE, PT := 0, Q => s_bCommTimeoutTimer_Q, ET => q_eCommTimeout_Elapsed);
    fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
    fb_tInitTimer(IN := FALSE, PT := 0, Q => s_bInitTimer_Q, ET => q_eInit_Elapsed);
    fb_tPickupHoldTimer(IN := FALSE, PT := 0, Q => s_bPickupHoldTimer_Q, ET => q_ePickupHold_Elapsed);
    RETURN;
END_IF;

// --- X2 axis servo fault detection (highest priority) ---
IF i_bX2Axis_ServoFault THEN
    IF s_iActiveAlarmCode <> ALM_X2AxisServoFault THEN
        s_iActiveAlarmCode := ALM_X2AxisServoFault;
        s_bFault := TRUE;
    END_IF;
    o_bX2Axis_RequestFwd := FALSE;
    o_bX2Axis_RequestRev := FALSE;
ELSIF s_iActiveAlarmCode = ALM_X2AxisServoFault THEN
    s_iActiveAlarmCode := 0;
    s_bFault := FALSE;
END_IF;

// --- Fault handling ---
IF s_bFault THEN
    o_bAllowPickup := FALSE;
    o_bX2Axis_RequestFwd := FALSE;
    o_bX2Axis_RequestRev := FALSE;
    o_bSafetyZoneSignal := FALSE;
    s_bRunning := FALSE;
    s_bSafetyZoneActive := FALSE;
    fb_tCommTimeoutTimer(IN := FALSE, PT := 0, Q => s_bCommTimeoutTimer_Q, ET => q_eCommTimeout_Elapsed);
    fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
    fb_tPickupHoldTimer(IN := FALSE, PT := 0, Q => s_bPickupHoldTimer_Q, ET => q_ePickupHold_Elapsed);

    IF i_bReset THEN
        s_iActiveAlarmCode := 0;
        s_bFault := FALSE;
        s_iCurrentStep := STP_Idle;
        s_bStartTriggered := FALSE;
        s_bInitComplete := FALSE;
    END_IF;

    o_bRunning := FALSE;
    o_bFault := TRUE;
    o_iCurrentState := 99;
    o_iStationAlarmCode := s_iActiveAlarmCode;
    RETURN;
END_IF;

// --- Stop handling ---
IF i_bStop AND s_bRunning THEN
    s_iCurrentStep := STP_Idle;
    s_bRunning := FALSE;
    s_bStartTriggered := FALSE;
    o_bAllowPickup := FALSE;
    o_bX2Axis_RequestFwd := FALSE;
    o_bX2Axis_RequestRev := FALSE;
    o_bSafetyZoneSignal := FALSE;
    s_bSafetyZoneActive := FALSE;
    fb_tCommTimeoutTimer(IN := FALSE, PT := 0, Q => s_bCommTimeoutTimer_Q, ET => q_eCommTimeout_Elapsed);
    fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
    fb_tPickupHoldTimer(IN := FALSE, PT := 0, Q => s_bPickupHoldTimer_Q, ET => q_ePickupHold_Elapsed);
END_IF;

// --- Initialization ---
IF NOT s_bInitComplete THEN
    s_bInitializing := TRUE;
    fb_tInitTimer(IN := TRUE, PT := T_DEF_InitTimeout, Q => s_bInitTimer_Q, ET => q_eInit_Elapsed);

    // Wait for X2 axis at home position or timeout
    IF i_bX2Axis_Home OR s_bInitTimer_Q THEN
        s_bInitComplete := TRUE;
        s_bInitializing := FALSE;
        fb_tInitTimer(IN := FALSE, PT := 0, Q => s_bInitTimer_Q, ET => q_eInit_Elapsed);
    END_IF;

    o_bRunning := FALSE;
    o_iCurrentState := STP_Idle;
    RETURN;
END_IF;

// --- Mode dispatch ---
IF i_bAutoMode THEN
    // ========================================================================
    // Auto mode: 6-step state machine
    // ========================================================================

    // Start trigger detection
    IF i_bStart AND NOT s_bStartTriggered THEN
        s_bStartTriggered := TRUE;
    END_IF;

    CASE s_iCurrentStep OF

    STP_Idle:
        o_bAllowPickup := FALSE;
        o_bX2Axis_RequestFwd := FALSE;
        o_bX2Axis_RequestRev := FALSE;
        o_bSafetyZoneSignal := FALSE;
        s_bSafetyZoneActive := FALSE;

        IF s_bStartTriggered THEN
            s_iCurrentStep := STP_WaitFeed;
            s_bRunning := TRUE;
        END_IF;

    STP_WaitFeed:
        // Wait for PickPlace feed complete signal
        IF i_bPickPlace_FeedComplete THEN
            s_iCurrentStep := STP_MoveToPickup;
            // Start X2 axis forward move
            o_bX2Axis_RequestFwd := TRUE;
            o_bX2Axis_RequestRev := FALSE;
            s_bSafetyZoneActive := TRUE;
            o_bSafetyZoneSignal := TRUE;
            fb_tActionTimer(IN := TRUE, PT := T_DEF_MoveTimeout, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
        END_IF;

    STP_MoveToPickup:
        // X2 axis moving to pickup position
        o_bX2Axis_RequestFwd := TRUE;
        o_bSafetyZoneSignal := TRUE;

        IF i_bX2Axis_ForwardLimit THEN
            // Arrived at pickup position
            fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
            o_bX2Axis_RequestFwd := FALSE;
            s_iCurrentStep := STP_WaitAllowFeed;
            // Start comm timeout timer
            fb_tCommTimeoutTimer(IN := TRUE, PT := T_DEF_CommTimeout, Q => s_bCommTimeoutTimer_Q, ET => q_eCommTimeout_Elapsed);
        ELSIF s_bActionTimer_Q THEN
            // Move timeout
            fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
            s_iActiveAlarmCode := ALM_X2AxisMoveTimeout;
            s_bFault := TRUE;
            o_bX2Axis_RequestFwd := FALSE;
        END_IF;

    STP_WaitAllowFeed:
        // Wait for glue machine to allow feed
        o_bSafetyZoneSignal := TRUE;

        IF i_bGlueMachine_AllowFeed THEN
            fb_tCommTimeoutTimer(IN := FALSE, PT := 0, Q => s_bCommTimeoutTimer_Q, ET => q_eCommTimeout_Elapsed);
            s_iCurrentStep := STP_SendAllowPickup;
            o_bAllowPickup := TRUE;
            fb_tPickupHoldTimer(IN := TRUE, PT := T_DEF_PickupHoldTime, Q => s_bPickupHoldTimer_Q, ET => q_ePickupHold_Elapsed);
        ELSIF s_bCommTimeoutTimer_Q THEN
            // Communication timeout
            fb_tCommTimeoutTimer(IN := FALSE, PT := 0, Q => s_bCommTimeoutTimer_Q, ET => q_eCommTimeout_Elapsed);
            s_iActiveAlarmCode := ALM_CommTimeout;
            s_bFault := TRUE;
        END_IF;

    STP_SendAllowPickup:
        // Hold allow pickup signal for timer duration
        o_bAllowPickup := TRUE;
        o_bSafetyZoneSignal := TRUE;

        IF i_bGlueMachine_PickupComplete OR s_bPickupHoldTimer_Q THEN
            fb_tPickupHoldTimer(IN := FALSE, PT := 0, Q => s_bPickupHoldTimer_Q, ET => q_ePickupHold_Elapsed);
            o_bAllowPickup := FALSE;
            s_iCurrentStep := STP_ReturnStandby;
            // Start X2 axis reverse move
            o_bX2Axis_RequestRev := TRUE;
            o_bX2Axis_RequestFwd := FALSE;
            fb_tActionTimer(IN := TRUE, PT := T_DEF_MoveTimeout, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
        END_IF;

    STP_ReturnStandby:
        // X2 axis returning to standby position
        o_bX2Axis_RequestRev := TRUE;
        o_bSafetyZoneSignal := TRUE;

        IF i_bX2Axis_ReverseLimit OR i_bX2Axis_Home THEN
            // Arrived at standby position
            fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
            o_bX2Axis_RequestRev := FALSE;
            o_bSafetyZoneSignal := FALSE;
            s_bSafetyZoneActive := FALSE;
            s_iCurrentStep := STP_Idle;
            s_bRunning := FALSE;
            s_bStartTriggered := FALSE;
        ELSIF s_bActionTimer_Q THEN
            // Move timeout
            fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
            s_iActiveAlarmCode := ALM_X2AxisMoveTimeout;
            s_bFault := TRUE;
            o_bX2Axis_RequestRev := FALSE;
        END_IF;

    ELSE
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
    END_CASE;

ELSIF i_bManualMode THEN
    // ========================================================================
    // Manual mode: X2 axis jog control
    // ========================================================================
    s_bRunning := FALSE;
    s_iCurrentStep := STP_Idle;
    s_bStartTriggered := FALSE;
    o_bAllowPickup := FALSE;
    o_bSafetyZoneSignal := FALSE;
    s_bSafetyZoneActive := FALSE;

    // X2 axis jog: forward/reverse interlock
    IF i_bLx_X2Axis_JogFwd AND NOT i_bLx_X2Axis_JogRev THEN
        IF NOT i_bX2Axis_ForwardLimit THEN
            o_bX2Axis_RequestFwd := TRUE;
            o_bX2Axis_RequestRev := FALSE;
        END_IF;
    ELSIF i_bLx_X2Axis_JogRev AND NOT i_bLx_X2Axis_JogFwd THEN
        IF NOT i_bX2Axis_ReverseLimit THEN
            o_bX2Axis_RequestRev := TRUE;
            o_bX2Axis_RequestFwd := FALSE;
        END_IF;
    ELSE
        o_bX2Axis_RequestFwd := FALSE;
        o_bX2Axis_RequestRev := FALSE;
    END_IF;

ELSE
    // Invalid mode: safe state
    o_bAllowPickup := FALSE;
    o_bX2Axis_RequestFwd := FALSE;
    o_bX2Axis_RequestRev := FALSE;
    o_bSafetyZoneSignal := FALSE;
    s_bSafetyZoneActive := FALSE;
    IF NOT s_bFault THEN
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
    END_IF;
END_IF;

// --- Status output ---
o_bRunning := s_bRunning;
o_bFault := s_bFault;
IF s_bFault THEN
    o_iCurrentState := 99;
ELSE
    o_iCurrentState := s_iCurrentStep;
END_IF;
o_iStationAlarmCode := s_iActiveAlarmCode;

END_FUNCTION_BLOCK
