// ============================================================================
// FB_1003_PickPlace_BufferFraming
// 描述：边框缓存机取放料机构
// 项目：DJ-2026-005
// 版本：V6.0.0
// 日期：2026-05-04
// ============================================================================
//
// 功能：
//   1. 自动模式：取/放循环的 11 步状态机
//   2. 手动模式：14 个手动操作并带互锁
//   3. 初始化：气缸复位、伺服使能、状态清零
//   4. 报警检测：8 种报警类型（101~108）
//   5. 4层循环计数（每次取2层，共2次循环）
//   6. 定时器：使用 SysLib FB_TON（PT/ET 为 DINT，不用 TIME）
//
// 状态机步骤：
//   0 = 空闲
//   1 = 等待输送机放料完成
//   2 = Z轴下降至取料高度
//   3 = 夹爪夹紧（前+后同时）
//   4 = 产品检测确认
//   5 = Z轴上升至安全高度
//   6 = X1轴移动到放料位置
//   7 = Z轴下降至放料高度
//   8 = 夹爪松开（前+后同时）
//   9 = Z轴上升至安全高度
//   10 = 放料完成通知下游
//
// 报警码（101~108）：
//   101 = Z轴伺服故障
//   102 = X1轴伺服故障
//   103 = 升降下降超时
//   104 = 升降上升超时
//   105 = 夹紧超时
//   106 = 松开超时
//   107 = 产品检测失败
//   108 = X1轴移动超时
//
// V6.0.0 变更（相对 V4.2.0）：
//   - 移除 METHOD 语法（Siemens LSP 不兼容）→ 改为内联代码
//   - 移除方法名 CALL_ 前缀
//   - 所有 T#0ms → 0（FB_TON 的 PT 为 DINT，不用 TIME）
//   - 所有定时器调用统一使用 4 参数（IN/PT/Q/ET）
//   - 定时器 Q 读取统一通过 s_bXxx_Q 变量
//   - 定时器常量类型 INT → DINT
//   - 删除重复的输出赋值
//   - 补齐空闲步骤缺失的输出赋值
//   - 修复夹紧/松开超时逻辑（IF/ELSIF）
// ============================================================================

FUNCTION_BLOCK FB_1003_PickPlace_BufferFraming

//#region 100_VAR_INPUT
VAR_INPUT
    // 系统控制信号（6）
    i_bEnable               : BOOL;    // 总使能
    i_bAutoMode             : BOOL;    // 自动模式选择
    i_bManualMode           : BOOL;    // 手动调试模式选择
    i_bStart                : BOOL;    // 自动启动按钮（上升沿）
    i_bStop                 : BOOL;    // 自动停止按钮（电平）
    i_bReset                : BOOL;    // 故障复位/初始化按钮（电平）

    // 手动操作信号（14个BOOL）
    // 伺服点动控制（4）
    i_bLx_ZAxis_JogUp       : BOOL;    // 手动-Z轴上点动
    i_bLx_ZAxis_JogDown     : BOOL;    // 手动-Z轴下点动
    i_bLx_X1Axis_JogFwd     : BOOL;    // 手动-X1轴前点动
    i_bLx_X1Axis_JogRev     : BOOL;    // 手动-X1轴后点动

    // 气缸手动控制（10，双电磁阀）
    i_bLx_Lift_Up           : BOOL;    // 手动-升降上升
    i_bLx_Lift_Down         : BOOL;    // 手动-升降下降
    i_bLx_FrontClamp        : BOOL;    // 手动-前夹紧夹紧
    i_bLx_FrontUnclamp      : BOOL;    // 手动-前夹紧松开
    i_bLx_RearClamp         : BOOL;    // 手动-后夹紧夹紧
    i_bLx_RearUnclamp       : BOOL;    // 手动-后夹紧松开
    i_bLx_FrontClamp2       : BOOL;    // 手动-前夹紧2夹紧
    i_bLx_FrontUnclamp2     : BOOL;    // 手动-前夹紧2松开
    i_bLx_RearClamp2        : BOOL;    // 手动-后夹紧2夹紧
    i_bLx_RearUnclamp2      : BOOL;    // 手动-后夹紧2松开

    // 工艺参数（6，REAL/INT）
    // 速度参数（4个REAL）
    i_rPickupSpeed          : REAL;    // 取料Z轴速度（mm/s 或 %）
    i_rPlaceSpeed           : REAL;    // 放料Z轴速度（mm/s 或 %）
    i_rZAxisSpeed           : REAL;    // Z轴通用速度（mm/s）
    i_rX1AxisSpeed          : REAL;    // X1轴通用速度（mm/s）

    // 动作时间参数（2个INT）
    i_iClampConfirmTime     : INT;     // 夹紧确认等待时间（ms）
    i_iLiftActionTime       : INT;     // 升降动作超时（ms）

    // 传感器输入（26个BOOL）
    // 气缸位置传感器（10个磁性开关）
    i_bLift_WorkPoint       : BOOL;    // 升降气缸下位
    i_bLift_HomePos         : BOOL;    // 升降气缸上位
    i_bFrontClamp_Closed    : BOOL;    // 前夹紧夹紧到位
    i_bFrontClamp_Opened    : BOOL;    // 前夹紧松开到位
    i_bRearClamp_Closed     : BOOL;    // 后夹紧夹紧到位
    i_bRearClamp_Opened     : BOOL;    // 后夹紧松开到位
    i_bFrontClamp2_Closed   : BOOL;    // 前夹紧2夹紧到位
    i_bFrontClamp2_Opened   : BOOL;    // 前夹紧2松开到位
    i_bRearClamp2_Closed    : BOOL;    // 后夹紧2夹紧到位
    i_bRearClamp2_Opened    : BOOL;    // 后夹紧2松开到位

    // 产品检测传感器（4个光电）
    i_bLongEdge1Detect      : BOOL;    // 长边1存在检测
    i_bLongEdge2Detect      : BOOL;    // 长边2存在检测
    i_bShortEdge1Detect     : BOOL;    // 短边1存在检测
    i_bShortEdge2Detect     : BOOL;    // 短边2存在检测

    // 伺服轴状态（12）
    // 原点信号（3）
    i_bZAxis_HomePos        : BOOL;    // Z轴伺服原点信号
    i_bX1Axis_HomePos       : BOOL;    // X1轴伺服原点信号
    i_bX2Axis_HomePos       : BOOL;    // X2轴伺服原点信号（预留）

    // 伺服故障报警（3）
    i_bZAxis_ServoFault     : BOOL;    // Z轴伺服驱动故障
    i_bX1Axis_ServoFault    : BOOL;    // X1轴伺服驱动故障
    i_bX2Axis_ServoFault    : BOOL;    // X2轴伺服驱动故障（预留）

    // 限位开关信号（6）
    i_bZAxis_FwdLimit       : BOOL;    // Z轴正向限位（上限）
    i_bZAxis_RevLimit       : BOOL;    // Z轴反向限位（下限）
    i_bX1Axis_FwdLimit      : BOOL;    // X1轴正向限位
    i_bX1Axis_RevLimit      : BOOL;    // X1轴反向限位
    i_bX2Axis_FwdLimit      : BOOL;    // X2轴正向限位（预留）
    i_bX2Axis_RevLimit      : BOOL;    // X2轴反向限位（预留）

    // 上游信号（4个BOOL，来自输送机）
    i_bConveyor_L1_FeedComplete : BOOL; // 输送机1层放料完成
    i_bConveyor_L2_FeedComplete : BOOL; // 输送机2层放料完成
    i_bConveyor_L3_FeedComplete : BOOL; // 输送机3层放料完成
    i_bConveyor_L4_FeedComplete : BOOL; // 输送机4层放料完成
END_VAR
//#endregion 100_VAR_INPUT

//#region 200_VAR_OUTPUT
VAR_OUTPUT
    // 气缸控制输出（10个BOOL，双电磁阀）
    o_bLift_Up              : BOOL;    // 升降上升电磁阀
    o_bLift_Down            : BOOL;    // 升降下降电磁阀
    o_bFrontClamp_Action    : BOOL;    // 前夹紧夹紧电磁阀
    o_bFrontClamp_Release   : BOOL;    // 前夹紧松开电磁阀
    o_bRearClamp_Action     : BOOL;    // 后夹紧夹紧电磁阀
    o_bRearClamp_Release    : BOOL;    // 后夹紧松开电磁阀
    o_bFrontClamp2_Action   : BOOL;    // 前夹紧2夹紧电磁阀
    o_bFrontClamp2_Release  : BOOL;    // 前夹紧2松开电磁阀
    o_bRearClamp2_Action    : BOOL;    // 后夹紧2夹紧电磁阀
    o_bRearClamp2_Release   : BOOL;    // 后夹紧2松开电磁阀

    // 伺服控制输出（3个BOOL，仅Z轴）
    o_bZAxis_PulseOutput    : BOOL;    // Z轴脉冲输出使能
    o_bZAxis_DirectionOutput : BOOL;   // Z轴方向控制
    o_bZAxis_Enable         : BOOL;    // Z轴伺服使能（SON）

    // 下游信号输出（1个BOOL）
    o_bPlaceComplete_ToFeeder : BOOL;   // 放料完成通知下游

    // 状态/HMI显示输出（7）
    o_bRunning              : BOOL;    // 自动运行中
    o_bFault                : BOOL;    // 本工站故障
    o_iCurrentState         : INT;     // 当前状态（0~10，99=故障）
    o_rZAxisCurrentPos      : REAL;    // Z轴当前位置（mm）
    o_rX1AxisCurrentPos     : REAL;    // X1轴当前位置（mm）
    o_rX2AxisCurrentPos     : REAL;    // X2轴当前位置（mm，预留）
    o_iCurrentPickLayer     : INT;     // 当前处理层（0=空闲，1~4）

    // 报警输出（1）
    o_iStationAlarmCode     : INT;     // 报警码（0=无，101~108）

    // 定时器调试输出（4个DINT，扫描周期数）
    q_ePlaceCompleteHold_Elapsed : DINT; // 放料完成保持定时累计
    q_eAction_Elapsed       : DINT;     // 动作定时累计
    q_eProductDetectStable_Elapsed : DINT; // 产品检测稳定定时累计
    q_eInit_Elapsed         : DINT;     // 初始化定时累计
END_VAR
//#endregion 200_VAR_OUTPUT

//#region 300_VAR
VAR
    // 状态机核心
    s_iCurrentStep          : INT;     // 当前状态机步骤（0~10）
    s_bRunning              : BOOL;    // 自动运行标志
    s_bFault                : BOOL;    // 故障标志
    s_bStartTriggered       : BOOL;    // 启动信号锁存

    // 4层循环计数
    s_iCompletedLayers      : INT;     // 已完成层数（0~4）
    s_iCurrentPickLayerNum  : INT;     // 当前取料层号（1~4）
    s_iPickCount            : INT;     // 当前取料次数（1或2）

    // 放料完成脉冲
    s_bPlaceCompletePulse   : BOOL;    // 放料完成单周期脉冲

    // 定时器（SysLib FB_TON，PT/ET 为 DINT）
    fb_tPlaceCompleteHoldTimer : FB_TON; // 放料完成保持定时器
    fb_tActionTimer         : FB_TON;  // 通用动作定时器
    fb_tProductDetectStableTimer : FB_TON; // 产品检测稳定定时器
    fb_tInitTimer           : FB_TON;  // 初始化定时器

    // 定时器 Q 输出
    s_bPlaceCompleteHoldTimer_Q : BOOL;
    s_bActionTimer_Q        : BOOL;
    s_bProductDetectStableTimer_Q : BOOL;
    s_bInitTimer_Q          : BOOL;

    // 系统级内部变量
    s_bInitComplete         : BOOL;    // 上电初始化完成
    s_bInitializing         : BOOL;    // 初始化进行中
    s_bProductDetected      : BOOL;    // 产品检测结果

    // 报警
    s_iActiveAlarmCode      : INT;     // 当前最高优先级报警码

    // 伺服运动请求标志
    s_bZAxis_RequestDown    : BOOL;    // Z轴下降请求
    s_bZAxis_RequestUp      : BOOL;    // Z轴上升请求
    s_bX1Axis_RequestFwd    : BOOL;    // X1轴前移请求
    s_bX1Axis_RequestRev    : BOOL;    // X1轴后移请求
    s_bX1AxisAtPickupPos    : BOOL;    // X1轴在取料位标志
    s_bX1AxisAtPlacePos     : BOOL;    // X1轴在放料位标志

    // 传感器冲突检测
    s_bLiftConflict         : BOOL;    // 升降上位+下位同时为TRUE
    s_bFrontClampConflict   : BOOL;    // 前夹紧夹紧到位+松开到位同时为TRUE
    s_bRearClampConflict    : BOOL;    // 后夹紧夹紧到位+松开到位同时为TRUE
    s_bFrontClamp2Conflict  : BOOL;    // 前夹紧2夹紧到位+松开到位同时为TRUE
    s_bRearClamp2Conflict   : BOOL;    // 后夹紧2夹紧到位+松开到位同时为TRUE

    // 手动操作互锁
    s_bManualAllowed        : BOOL;    // 允许手动操作标志
END_VAR
//#endregion 300_VAR

//#region 400_VAR_CONSTANT
VAR CONSTANT
    // 状态机步骤（11：0空闲 + 10个工作步骤）
    STP_Idle                : INT := 0;   // 空闲
    STP_WaitingFeedComplete : INT := 1;   // 等待输送机放料完成
    STP_PickupDown          : INT := 2;   // Z轴下降至取料高度
    STP_GripClamp           : INT := 3;   // 夹爪夹紧（前+后）
    STP_ProductDetect       : INT := 4;   // 产品检测确认
    STP_PickupUp            : INT := 5;   // Z轴上升至安全高度
    STP_MovingToPlacePos    : INT := 6;   // X1轴移动到放料位置
    STP_PlaceDown           : INT := 7;   // Z轴下降至放料高度
    STP_GripUnclamp         : INT := 8;   // 夹爪松开（前+后）
    STP_PlaceUp             : INT := 9;   // Z轴上升至安全高度
    STP_PlaceCompleteNotify : INT := 10;  // 发送放料完成信号

    // 报警码（101~108）
    ALM_ZAxisServoFault     : INT := 101;  // Z轴伺服故障
    ALM_X1AxisServoFault    : INT := 102;  // X1轴伺服故障
    ALM_LiftDownTimeout     : INT := 103;  // 升降下降未到位
    ALM_LiftUpTimeout       : INT := 104;  // 升降上升未到位
    ALM_ClampTimeout        : INT := 105;  // 夹紧确认超时
    ALM_UnclampTimeout      : INT := 106;  // 松开确认超时
    ALM_ProductDetectFail   : INT := 107;  // 产品检测失败
    ALM_MovementTimeout     : INT := 108;  // X1轴移动超时

    // 默认定时参数（DINT，扫描周期数）
    T_DEF_LiftActionTime        : DINT := 2000;   // 升降动作时间
    T_DEF_ClampConfirmTime      : DINT := 800;    // 夹紧确认时间
    T_DEF_UnclampConfirmTime    : DINT := 800;    // 松开确认时间
    T_DEF_ProductDetectStableTime : DINT := 300;  // 产品检测稳定时间
    T_DEF_MovementTimeoutTime   : DINT := 5000;   // X1轴移动超时
    T_DEF_PlaceCompleteHoldTime : DINT := 500;    // 放料完成保持时间
    T_DEF_InitTimeout           : DINT := 10000;  // 初始化总超时（10s）

    // 层相关常量
    LAYER_TOTAL             : INT := 4;       // 总层数
    PICK_TIMES              : INT := 2;       // 取料次数（每次取2层）
END_VAR
//#endregion 400_VAR_CONSTANT

// ============================================================================
// 主程序逻辑
// ============================================================================

// --- 使能关闭：进入安全状态，所有输出清零 ---
IF NOT i_bEnable THEN
    o_bLift_Up := FALSE;
    o_bLift_Down := FALSE;
    o_bFrontClamp_Action := FALSE;
    o_bFrontClamp_Release := FALSE;
    o_bRearClamp_Action := FALSE;
    o_bRearClamp_Release := FALSE;
    o_bFrontClamp2_Action := FALSE;
    o_bFrontClamp2_Release := FALSE;
    o_bRearClamp2_Action := FALSE;
    o_bRearClamp2_Release := FALSE;
    o_bZAxis_PulseOutput := FALSE;
    o_bZAxis_DirectionOutput := FALSE;
    o_bZAxis_Enable := FALSE;
    o_bPlaceComplete_ToFeeder := FALSE;
    s_iCurrentStep := STP_Idle;
    s_bRunning := FALSE;
    s_bFault := FALSE;
    s_bStartTriggered := FALSE;
    s_iCompletedLayers := 0;
    s_iCurrentPickLayerNum := 0;
    s_iPickCount := 0;
    s_bPlaceCompletePulse := FALSE;
    s_bProductDetected := FALSE;
    s_bZAxis_RequestDown := FALSE;
    s_bZAxis_RequestUp := FALSE;
    s_bX1Axis_RequestFwd := FALSE;
    s_bX1Axis_RequestRev := FALSE;
    s_bX1AxisAtPickupPos := FALSE;
    s_bX1AxisAtPlacePos := FALSE;
    s_iActiveAlarmCode := 0;
    o_iStationAlarmCode := 0;
    o_bFault := FALSE;
    s_bInitComplete := FALSE;
    s_bInitializing := FALSE;
    o_bRunning := FALSE;
    o_iCurrentState := STP_Idle;
    o_iCurrentPickLayer := 0;

    fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
    fb_tProductDetectStableTimer(IN := FALSE, PT := 0, Q => s_bProductDetectStableTimer_Q, ET => q_eProductDetectStable_Elapsed);
    fb_tInitTimer(IN := FALSE, PT := 0, Q => s_bInitTimer_Q, ET => q_eInit_Elapsed);
    fb_tPlaceCompleteHoldTimer(IN := FALSE, PT := 0, Q => s_bPlaceCompleteHoldTimer_Q, ET => q_ePlaceCompleteHold_Elapsed);
    RETURN;
END_IF;

// --- 初始化（上电或复位后） ---
IF NOT s_bInitComplete THEN
    s_bInitializing := TRUE;
    fb_tInitTimer(IN := TRUE, PT := T_DEF_InitTimeout, Q => s_bInitTimer_Q, ET => q_eInit_Elapsed);

    // 气缸安全位：升降上升，所有夹爪松开
    o_bLift_Up := TRUE;
    o_bLift_Down := FALSE;
    o_bFrontClamp_Action := FALSE;
    o_bFrontClamp_Release := TRUE;
    o_bRearClamp_Action := FALSE;
    o_bRearClamp_Release := TRUE;
    o_bFrontClamp2_Action := FALSE;
    o_bFrontClamp2_Release := TRUE;
    o_bRearClamp2_Action := FALSE;
    o_bRearClamp2_Release := TRUE;

    // 伺服使能
    o_bZAxis_Enable := TRUE;
    o_bZAxis_PulseOutput := FALSE;
    o_bZAxis_DirectionOutput := FALSE;
    o_bPlaceComplete_ToFeeder := FALSE;

    s_iCurrentStep := STP_Idle;
    s_bFault := FALSE;
    s_iActiveAlarmCode := 0;

    // 初始化完成条件：升降在原点 + 所有夹爪已松开，或初始化超时
    IF (i_bLift_HomePos AND
        i_bFrontClamp_Opened AND i_bRearClamp_Opened AND
        i_bFrontClamp2_Opened AND i_bRearClamp2_Opened)
       OR s_bInitTimer_Q THEN
        s_bInitComplete := TRUE;
        s_bInitializing := FALSE;
        fb_tInitTimer(IN := FALSE, PT := 0, Q => s_bInitTimer_Q, ET => q_eInit_Elapsed);
        // 初始化后关闭气缸输出（进入空闲安全状态）
        o_bLift_Up := FALSE;
        o_bFrontClamp_Release := FALSE;
        o_bRearClamp_Release := FALSE;
        o_bFrontClamp2_Release := FALSE;
        o_bRearClamp2_Release := FALSE;
    END_IF;

    o_bRunning := FALSE;
    o_iCurrentState := STP_Idle;
    o_iCurrentPickLayer := 0;
    RETURN;
END_IF;

// --- 伺服故障检测（全模式，最高优先级） ---
IF i_bZAxis_ServoFault THEN
    IF s_iActiveAlarmCode <> ALM_ZAxisServoFault THEN
        s_iActiveAlarmCode := ALM_ZAxisServoFault;
        s_bFault := TRUE;
    END_IF;
    o_bZAxis_PulseOutput := FALSE;
ELSIF s_iActiveAlarmCode = ALM_ZAxisServoFault THEN
    s_iActiveAlarmCode := 0;
    s_bFault := FALSE;
END_IF;

IF i_bX1Axis_ServoFault THEN
    IF s_iActiveAlarmCode <> ALM_X1AxisServoFault THEN
        s_iActiveAlarmCode := ALM_X1AxisServoFault;
        s_bFault := TRUE;
    END_IF;
ELSIF s_iActiveAlarmCode = ALM_X1AxisServoFault THEN
    s_iActiveAlarmCode := 0;
    s_bFault := FALSE;
END_IF;

// --- 传感器冲突检测（全模式） ---
s_bLiftConflict := i_bLift_WorkPoint AND i_bLift_HomePos;
s_bFrontClampConflict := i_bFrontClamp_Closed AND i_bFrontClamp_Opened;
s_bRearClampConflict := i_bRearClamp_Closed AND i_bRearClamp_Opened;
s_bFrontClamp2Conflict := i_bFrontClamp2_Closed AND i_bFrontClamp2_Opened;
s_bRearClamp2Conflict := i_bRearClamp2_Closed AND i_bRearClamp2_Opened;

// --- 模式分发 ---
IF i_bAutoMode THEN
    // ========================================================================
    // 自动模式：11步取放状态机（内联实现，无 METHOD）
    // ========================================================================

    // 故障：停止状态机
    IF s_bFault THEN
        s_bRunning := FALSE;
        o_bLift_Up := FALSE;
        o_bLift_Down := FALSE;
        o_bFrontClamp_Action := FALSE;
        o_bFrontClamp_Release := FALSE;
        o_bRearClamp_Action := FALSE;
        o_bRearClamp_Release := FALSE;
        o_bFrontClamp2_Action := FALSE;
        o_bFrontClamp2_Release := FALSE;
        o_bRearClamp2_Action := FALSE;
        o_bRearClamp2_Release := FALSE;
        o_bZAxis_PulseOutput := FALSE;
        o_bZAxis_DirectionOutput := FALSE;
        o_bPlaceComplete_ToFeeder := FALSE;
        s_bZAxis_RequestDown := FALSE;
        s_bZAxis_RequestUp := FALSE;
        s_bX1Axis_RequestFwd := FALSE;
        s_bX1Axis_RequestRev := FALSE;
        fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
        fb_tProductDetectStableTimer(IN := FALSE, PT := 0, Q => s_bProductDetectStableTimer_Q, ET => q_eProductDetectStable_Elapsed);
    ELSE
        // 启动触发检测（上升沿）
        IF i_bStart AND NOT s_bStartTriggered THEN
            s_bStartTriggered := TRUE;
            IF s_iCompletedLayers >= LAYER_TOTAL THEN
                s_iCompletedLayers := 0;
            END_IF;
            s_iPickCount := (s_iCompletedLayers / 2) + 1;
            IF s_iPickCount > PICK_TIMES THEN
                s_iPickCount := 1;
                s_iCompletedLayers := 0;
            END_IF;
        END_IF;

        // 状态机
        CASE s_iCurrentStep OF

        STP_Idle:
            s_bRunning := FALSE;
            o_bLift_Up := FALSE;
            o_bLift_Down := FALSE;
            o_bFrontClamp_Action := FALSE;
            o_bFrontClamp_Release := FALSE;
            o_bRearClamp_Action := FALSE;
            o_bRearClamp_Release := FALSE;
            o_bFrontClamp2_Action := FALSE;
            o_bFrontClamp2_Release := FALSE;
            o_bRearClamp2_Action := FALSE;
            o_bRearClamp2_Release := FALSE;
            o_bZAxis_PulseOutput := FALSE;
            o_bZAxis_DirectionOutput := FALSE;
            o_bPlaceComplete_ToFeeder := FALSE;
            s_bZAxis_RequestDown := FALSE;
            s_bZAxis_RequestUp := FALSE;
            s_bX1Axis_RequestFwd := FALSE;
            s_bX1Axis_RequestRev := FALSE;
            s_iCurrentPickLayerNum := 0;

            IF s_bStartTriggered THEN
                s_iCurrentStep := STP_WaitingFeedComplete;
                s_bRunning := TRUE;
                IF s_iCompletedLayers < 2 THEN
                    s_iCurrentPickLayerNum := 1;
                ELSE
                    s_iCurrentPickLayerNum := 3;
                END_IF;
            END_IF;

        STP_WaitingFeedComplete:
            IF s_iCompletedLayers < 2 THEN
                IF i_bConveyor_L1_FeedComplete AND i_bConveyor_L2_FeedComplete THEN
                    s_iCurrentStep := STP_PickupDown;
                    fb_tActionTimer(IN := TRUE, PT := i_iLiftActionTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                    s_bZAxis_RequestDown := TRUE;
                    s_bZAxis_RequestUp := FALSE;
                    o_bZAxis_PulseOutput := TRUE;
                    o_bZAxis_DirectionOutput := TRUE;
                END_IF;
            ELSE
                IF i_bConveyor_L3_FeedComplete AND i_bConveyor_L4_FeedComplete THEN
                    s_iCurrentStep := STP_PickupDown;
                    fb_tActionTimer(IN := TRUE, PT := i_iLiftActionTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                    s_bZAxis_RequestDown := TRUE;
                    s_bZAxis_RequestUp := FALSE;
                    o_bZAxis_PulseOutput := TRUE;
                    o_bZAxis_DirectionOutput := TRUE;
                END_IF;
            END_IF;

        STP_PickupDown:
            o_bZAxis_PulseOutput := TRUE;
            o_bZAxis_DirectionOutput := TRUE;
            o_bLift_Down := TRUE;
            o_bLift_Up := FALSE;

            IF i_bLift_WorkPoint THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bZAxis_RequestDown := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Down := FALSE;
                s_iCurrentStep := STP_GripClamp;
                fb_tActionTimer(IN := TRUE, PT := i_iClampConfirmTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                o_bFrontClamp_Action := TRUE;
                o_bRearClamp_Action := TRUE;
            ELSIF s_bActionTimer_Q THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_LiftDownTimeout;
                s_bFault := TRUE;
                s_bZAxis_RequestDown := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Down := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_GripClamp:
            o_bFrontClamp_Action := TRUE;
            o_bRearClamp_Action := TRUE;
            o_bFrontClamp_Release := FALSE;
            o_bRearClamp_Release := FALSE;

            IF s_bActionTimer_Q AND (i_bFrontClamp_Closed AND i_bRearClamp_Closed) THEN
                // 定时到且传感器确认完成 → 进入下一步
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iCurrentStep := STP_ProductDetect;
                fb_tProductDetectStableTimer(IN := TRUE, PT := T_DEF_ProductDetectStableTime, Q => s_bProductDetectStableTimer_Q, ET => q_eProductDetectStable_Elapsed);
            ELSIF s_bActionTimer_Q AND NOT (i_bFrontClamp_Closed AND i_bRearClamp_Closed) THEN
                // 定时到但传感器未确认 → 触发夹紧超时报警
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_ClampTimeout;
                s_bFault := TRUE;
                o_bFrontClamp_Action := FALSE;
                o_bRearClamp_Action := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_ProductDetect:
            o_bFrontClamp_Action := TRUE;
            o_bRearClamp_Action := TRUE;

            IF s_bProductDetectStableTimer_Q THEN
                fb_tProductDetectStableTimer(IN := FALSE, PT := 0, Q => s_bProductDetectStableTimer_Q, ET => q_eProductDetectStable_Elapsed);

                s_bProductDetected :=
                    i_bLongEdge1Detect AND i_bLongEdge2Detect AND
                    i_bShortEdge1Detect AND i_bShortEdge2Detect;

                IF s_bProductDetected THEN
                    s_iCurrentStep := STP_PickupUp;
                    fb_tActionTimer(IN := TRUE, PT := i_iLiftActionTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                    s_bZAxis_RequestUp := TRUE;
                    o_bZAxis_PulseOutput := TRUE;
                    o_bZAxis_DirectionOutput := FALSE;
                    o_bLift_Up := TRUE;
                    o_bFrontClamp_Action := FALSE;
                    o_bRearClamp_Action := FALSE;
                ELSE
                    s_iActiveAlarmCode := ALM_ProductDetectFail;
                    s_bFault := TRUE;
                    o_bFrontClamp_Action := FALSE;
                    o_bRearClamp_Action := FALSE;
                    s_iCurrentStep := STP_Idle;
                    s_bRunning := FALSE;
                    s_bStartTriggered := FALSE;
                END_IF;
            END_IF;

        STP_PickupUp:
            o_bZAxis_PulseOutput := TRUE;
            o_bZAxis_DirectionOutput := FALSE;
            o_bLift_Up := TRUE;
            o_bLift_Down := FALSE;

            IF i_bLift_HomePos THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bZAxis_RequestUp := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Up := FALSE;
                s_iCurrentStep := STP_MovingToPlacePos;
                fb_tActionTimer(IN := TRUE, PT := T_DEF_MovementTimeoutTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bX1Axis_RequestFwd := FALSE;
                s_bX1Axis_RequestRev := TRUE;
                s_bX1AxisAtPickupPos := FALSE;
            ELSIF s_bActionTimer_Q THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_LiftUpTimeout;
                s_bFault := TRUE;
                s_bZAxis_RequestUp := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Up := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_MovingToPlacePos:
            s_bX1Axis_RequestRev := TRUE;
            s_bX1Axis_RequestFwd := FALSE;

            IF i_bX1Axis_RevLimit THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bX1Axis_RequestRev := FALSE;
                s_bX1AxisAtPlacePos := TRUE;
                s_iCurrentStep := STP_PlaceDown;
                fb_tActionTimer(IN := TRUE, PT := i_iLiftActionTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bZAxis_RequestDown := TRUE;
                s_bZAxis_RequestUp := FALSE;
                o_bZAxis_PulseOutput := TRUE;
                o_bZAxis_DirectionOutput := TRUE;
            ELSIF s_bActionTimer_Q THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_MovementTimeout;
                s_bFault := TRUE;
                s_bX1Axis_RequestRev := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_PlaceDown:
            o_bZAxis_PulseOutput := TRUE;
            o_bZAxis_DirectionOutput := TRUE;
            o_bLift_Down := TRUE;
            o_bLift_Up := FALSE;

            IF i_bLift_WorkPoint THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bZAxis_RequestDown := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Down := FALSE;
                s_iCurrentStep := STP_GripUnclamp;
                fb_tActionTimer(IN := TRUE, PT := T_DEF_UnclampConfirmTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                o_bFrontClamp_Release := TRUE;
                o_bRearClamp_Release := TRUE;
            ELSIF s_bActionTimer_Q THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_LiftDownTimeout;
                s_bFault := TRUE;
                s_bZAxis_RequestDown := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Down := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_GripUnclamp:
            o_bFrontClamp_Release := TRUE;
            o_bRearClamp_Release := TRUE;
            o_bFrontClamp_Action := FALSE;
            o_bRearClamp_Action := FALSE;

            IF s_bActionTimer_Q AND (i_bFrontClamp_Opened AND i_bRearClamp_Opened) THEN
                // 定时到且传感器确认完成 → 进入下一步
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iCurrentStep := STP_PlaceUp;
                fb_tActionTimer(IN := TRUE, PT := i_iLiftActionTime, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bZAxis_RequestUp := TRUE;
                o_bZAxis_PulseOutput := TRUE;
                o_bZAxis_DirectionOutput := FALSE;
                o_bLift_Up := TRUE;
                o_bFrontClamp_Release := FALSE;
                o_bRearClamp_Release := FALSE;
            ELSIF s_bActionTimer_Q AND NOT (i_bFrontClamp_Opened AND i_bRearClamp_Opened) THEN
                // 定时到但传感器未确认 → 触发松开超时报警
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_UnclampTimeout;
                s_bFault := TRUE;
                o_bFrontClamp_Release := FALSE;
                o_bRearClamp_Release := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_PlaceUp:
            o_bZAxis_PulseOutput := TRUE;
            o_bZAxis_DirectionOutput := FALSE;
            o_bLift_Up := TRUE;
            o_bLift_Down := FALSE;

            IF i_bLift_HomePos THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_bZAxis_RequestUp := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Up := FALSE;
                s_iCurrentStep := STP_PlaceCompleteNotify;
                fb_tPlaceCompleteHoldTimer(IN := TRUE, PT := T_DEF_PlaceCompleteHoldTime, Q => s_bPlaceCompleteHoldTimer_Q, ET => q_ePlaceCompleteHold_Elapsed);
                o_bPlaceComplete_ToFeeder := TRUE;
                s_bPlaceCompletePulse := TRUE;
            ELSIF s_bActionTimer_Q THEN
                fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
                s_iActiveAlarmCode := ALM_LiftUpTimeout;
                s_bFault := TRUE;
                s_bZAxis_RequestUp := FALSE;
                o_bZAxis_PulseOutput := FALSE;
                o_bLift_Up := FALSE;
                s_iCurrentStep := STP_Idle;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

        STP_PlaceCompleteNotify:
            o_bPlaceComplete_ToFeeder := TRUE;

            IF s_bPlaceCompleteHoldTimer_Q THEN
                fb_tPlaceCompleteHoldTimer(IN := FALSE, PT := 0, Q => s_bPlaceCompleteHoldTimer_Q, ET => q_ePlaceCompleteHold_Elapsed);
                o_bPlaceComplete_ToFeeder := FALSE;
                s_bPlaceCompletePulse := FALSE;

                s_iCompletedLayers := s_iCompletedLayers + 2;

                IF s_iCompletedLayers >= LAYER_TOTAL THEN
                    s_iCompletedLayers := 0;
                    s_iCurrentStep := STP_Idle;
                    s_bRunning := FALSE;
                    s_bStartTriggered := FALSE;
                    s_iCurrentPickLayerNum := 0;
                ELSE
                    s_iCurrentStep := STP_WaitingFeedComplete;
                    IF s_iCompletedLayers < 2 THEN
                        s_iCurrentPickLayerNum := 1;
                    ELSE
                        s_iCurrentPickLayerNum := 3;
                    END_IF;
                END_IF;
            END_IF;

        ELSE
            s_iCurrentStep := STP_Idle;
            s_bRunning := FALSE;
        END_CASE;
    END_IF;

ELSIF i_bManualMode THEN
    // ========================================================================
    // 手动模式：14个手动操作并带互锁（内联实现，无 METHOD）
    // ========================================================================

    IF s_bFault THEN
        s_bManualAllowed := FALSE;
        o_bLift_Up := FALSE;
        o_bLift_Down := FALSE;
        o_bFrontClamp_Action := FALSE;
        o_bFrontClamp_Release := FALSE;
        o_bRearClamp_Action := FALSE;
        o_bRearClamp_Release := FALSE;
        o_bFrontClamp2_Action := FALSE;
        o_bFrontClamp2_Release := FALSE;
        o_bRearClamp2_Action := FALSE;
        o_bRearClamp2_Release := FALSE;
        o_bZAxis_PulseOutput := FALSE;
        o_bZAxis_DirectionOutput := FALSE;
        o_bPlaceComplete_ToFeeder := FALSE;
        s_bZAxis_RequestDown := FALSE;
        s_bZAxis_RequestUp := FALSE;
        s_bX1Axis_RequestFwd := FALSE;
        s_bX1Axis_RequestRev := FALSE;
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
    ELSE
        s_bManualAllowed := TRUE;
        s_bRunning := FALSE;
        s_iCurrentStep := STP_Idle;
        o_iCurrentPickLayer := 0;
        o_bPlaceComplete_ToFeeder := FALSE;

        // Z轴点动：上/下互锁
        IF i_bLx_ZAxis_JogUp AND NOT i_bLx_ZAxis_JogDown THEN
            IF NOT i_bZAxis_FwdLimit THEN
                s_bZAxis_RequestUp := TRUE;
                s_bZAxis_RequestDown := FALSE;
                o_bZAxis_DirectionOutput := FALSE;
            END_IF;
        ELSIF i_bLx_ZAxis_JogDown AND NOT i_bLx_ZAxis_JogUp THEN
            IF NOT i_bZAxis_RevLimit THEN
                s_bZAxis_RequestDown := TRUE;
                s_bZAxis_RequestUp := FALSE;
                o_bZAxis_DirectionOutput := TRUE;
            END_IF;
        ELSE
            s_bZAxis_RequestDown := FALSE;
            s_bZAxis_RequestUp := FALSE;
        END_IF;

        // X1轴点动：前/后互锁
        IF i_bLx_X1Axis_JogFwd AND NOT i_bLx_X1Axis_JogRev THEN
            IF NOT i_bX1Axis_FwdLimit THEN
                s_bX1Axis_RequestFwd := TRUE;
                s_bX1Axis_RequestRev := FALSE;
            END_IF;
        ELSIF i_bLx_X1Axis_JogRev AND NOT i_bLx_X1Axis_JogFwd THEN
            IF NOT i_bX1Axis_RevLimit THEN
                s_bX1Axis_RequestRev := TRUE;
                s_bX1Axis_RequestFwd := FALSE;
            END_IF;
        ELSE
            s_bX1Axis_RequestFwd := FALSE;
            s_bX1Axis_RequestRev := FALSE;
        END_IF;

        // 升降气缸手动
        IF i_bLx_Lift_Up AND NOT i_bLx_Lift_Down THEN
            o_bLift_Up := TRUE;
            o_bLift_Down := FALSE;
        ELSIF i_bLx_Lift_Down AND NOT i_bLx_Lift_Up THEN
            o_bLift_Down := TRUE;
            o_bLift_Up := FALSE;
        ELSE
            o_bLift_Up := FALSE;
            o_bLift_Down := FALSE;
        END_IF;

        // 前夹紧手动
        IF i_bLx_FrontClamp AND NOT i_bLx_FrontUnclamp THEN
            o_bFrontClamp_Action := TRUE;
            o_bFrontClamp_Release := FALSE;
        ELSIF i_bLx_FrontUnclamp AND NOT i_bLx_FrontClamp THEN
            o_bFrontClamp_Release := TRUE;
            o_bFrontClamp_Action := FALSE;
        ELSE
            o_bFrontClamp_Action := FALSE;
            o_bFrontClamp_Release := FALSE;
        END_IF;

        // 后夹紧手动
        IF i_bLx_RearClamp AND NOT i_bLx_RearUnclamp THEN
            o_bRearClamp_Action := TRUE;
            o_bRearClamp_Release := FALSE;
        ELSIF i_bLx_RearUnclamp AND NOT i_bLx_RearClamp THEN
            o_bRearClamp_Release := TRUE;
            o_bRearClamp_Action := FALSE;
        ELSE
            o_bRearClamp_Action := FALSE;
            o_bRearClamp_Release := FALSE;
        END_IF;

        // 前夹紧2手动
        IF i_bLx_FrontClamp2 AND NOT i_bLx_FrontUnclamp2 THEN
            o_bFrontClamp2_Action := TRUE;
            o_bFrontClamp2_Release := FALSE;
        ELSIF i_bLx_FrontUnclamp2 AND NOT i_bLx_FrontClamp2 THEN
            o_bFrontClamp2_Release := TRUE;
            o_bFrontClamp2_Action := FALSE;
        ELSE
            o_bFrontClamp2_Action := FALSE;
            o_bFrontClamp2_Release := FALSE;
        END_IF;

        // 后夹紧2手动
        IF i_bLx_RearClamp2 AND NOT i_bLx_RearUnclamp2 THEN
            o_bRearClamp2_Action := TRUE;
            o_bRearClamp2_Release := FALSE;
        ELSIF i_bLx_RearUnclamp2 AND NOT i_bLx_RearClamp2 THEN
            o_bRearClamp2_Release := TRUE;
            o_bRearClamp2_Action := FALSE;
        ELSE
            o_bRearClamp2_Action := FALSE;
            o_bRearClamp2_Release := FALSE;
        END_IF;
    END_IF;

ELSE
    // 无效模式：安全状态
    o_bLift_Up := FALSE;
    o_bLift_Down := FALSE;
    o_bFrontClamp_Action := FALSE;
    o_bFrontClamp_Release := FALSE;
    o_bRearClamp_Action := FALSE;
    o_bRearClamp_Release := FALSE;
    o_bFrontClamp2_Action := FALSE;
    o_bFrontClamp2_Release := FALSE;
    o_bRearClamp2_Action := FALSE;
    o_bRearClamp2_Release := FALSE;
    o_bZAxis_PulseOutput := FALSE;
    o_bZAxis_DirectionOutput := FALSE;
    o_bPlaceComplete_ToFeeder := FALSE;
    s_bZAxis_RequestDown := FALSE;
    s_bZAxis_RequestUp := FALSE;
    s_bX1Axis_RequestFwd := FALSE;
    s_bX1Axis_RequestRev := FALSE;
    IF NOT s_bFault THEN
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
    END_IF;
END_IF;

// --- 停止处理 ---
IF i_bStop THEN
    IF s_bRunning AND NOT s_bFault THEN
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
        s_bStartTriggered := FALSE;
        o_bLift_Up := FALSE;
        o_bLift_Down := FALSE;
        o_bFrontClamp_Action := FALSE;
        o_bFrontClamp_Release := FALSE;
        o_bRearClamp_Action := FALSE;
        o_bRearClamp_Release := FALSE;
        o_bFrontClamp2_Action := FALSE;
        o_bFrontClamp2_Release := FALSE;
        o_bRearClamp2_Action := FALSE;
        o_bRearClamp2_Release := FALSE;
        o_bZAxis_PulseOutput := FALSE;
        o_bZAxis_DirectionOutput := FALSE;
        o_bPlaceComplete_ToFeeder := FALSE;
        s_bZAxis_RequestDown := FALSE;
        s_bZAxis_RequestUp := FALSE;
        s_bX1Axis_RequestFwd := FALSE;
        s_bX1Axis_RequestRev := FALSE;
        fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
        fb_tProductDetectStableTimer(IN := FALSE, PT := 0, Q => s_bProductDetectStableTimer_Q, ET => q_eProductDetectStable_Elapsed);
        fb_tPlaceCompleteHoldTimer(IN := FALSE, PT := 0, Q => s_bPlaceCompleteHoldTimer_Q, ET => q_ePlaceCompleteHold_Elapsed);
    END_IF;
END_IF;

// --- 复位处理 ---
IF i_bReset THEN
    IF s_bFault THEN
        s_iActiveAlarmCode := 0;
        s_bFault := FALSE;
        o_iStationAlarmCode := 0;
        s_iCurrentStep := STP_Idle;
        s_bRunning := FALSE;
        s_bStartTriggered := FALSE;
        s_iCompletedLayers := 0;
        s_iCurrentPickLayerNum := 0;
        s_iPickCount := 0;
        s_bPlaceCompletePulse := FALSE;
        s_bProductDetected := FALSE;
        o_bLift_Up := FALSE;
        o_bLift_Down := FALSE;
        o_bFrontClamp_Action := FALSE;
        o_bFrontClamp_Release := FALSE;
        o_bRearClamp_Action := FALSE;
        o_bRearClamp_Release := FALSE;
        o_bFrontClamp2_Action := FALSE;
        o_bFrontClamp2_Release := FALSE;
        o_bRearClamp2_Action := FALSE;
        o_bRearClamp2_Release := FALSE;
        o_bZAxis_PulseOutput := FALSE;
        o_bZAxis_DirectionOutput := FALSE;
        o_bPlaceComplete_ToFeeder := FALSE;
        s_bZAxis_RequestDown := FALSE;
        s_bZAxis_RequestUp := FALSE;
        s_bX1Axis_RequestFwd := FALSE;
        s_bX1Axis_RequestRev := FALSE;
        s_bX1AxisAtPickupPos := FALSE;
        s_bX1AxisAtPlacePos := FALSE;
        fb_tActionTimer(IN := FALSE, PT := 0, Q => s_bActionTimer_Q, ET => q_eAction_Elapsed);
        fb_tProductDetectStableTimer(IN := FALSE, PT := 0, Q => s_bProductDetectStableTimer_Q, ET => q_eProductDetectStable_Elapsed);
        fb_tPlaceCompleteHoldTimer(IN := FALSE, PT := 0, Q => s_bPlaceCompleteHoldTimer_Q, ET => q_ePlaceCompleteHold_Elapsed);
        s_bInitComplete := FALSE;
    END_IF;
END_IF;

// --- 状态输出 ---
o_bRunning := s_bRunning;
o_bFault := s_bFault;

IF s_bFault THEN
    o_iCurrentState := 99;
ELSE
    o_iCurrentState := s_iCurrentStep;
END_IF;

IF s_bRunning THEN
    o_iCurrentPickLayer := s_iCurrentPickLayerNum;
ELSIF s_iCompletedLayers >= LAYER_TOTAL THEN
    o_iCurrentPickLayer := 0;
ELSE
    o_iCurrentPickLayer := 0;
END_IF;

o_iStationAlarmCode := s_iActiveAlarmCode;

END_FUNCTION_BLOCK
