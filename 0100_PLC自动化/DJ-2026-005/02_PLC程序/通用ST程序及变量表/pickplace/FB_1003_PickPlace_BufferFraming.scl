(* ================================================================= *)
(*  功能块名称：FB_1003_PickPlace_BufferFraming                       *)
(*  功能描述：取放料机构控制 - 6步S20~S25状态机(Z升降+X1横移+4夹爪) *)
(*  创建日期：2026-05-04                                              *)
(*  版本号：V6.0.0                                                    *)
(*  编制人：Trae                                                      *)
(*  审核人：人工                                                      *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - 801_PLC变量命名与功能块命名规范_DEV-V1.0.5                    *)
(*    - 810_PLC编程规范_DEV-V1.0.2                                    *)
(*                                                                     *)
(*  变更记录：                                                          *)
(* ---------------------------------------------------------------- *)
(*  V6.0.0 (2026-05-18) Trae                                         *)
(*  - 重写: 11步→6步S20~S25状态机（对齐源程序D160~D165）          *)
(*  - 重写: 移除直接伺服控制，改用轴抽象请求接口                    *)
(*  - 重写: o_前缀→q_前缀（801规范）                               *)
(*  - 新增: 4组夹爪(前/后/前2/后2)独立控制                         *)
(*  - 新增: 产品检测在S22步内完成(4光电+确认时间)                  *)
(*  - 新增: 层选放料位置(L1/L3→D520, L2/L4→D540)                  *)
(*  - 新增: 边框检测阻塞回原点(F80)                                *)
(*  - 新增: TONR定时器（tIn/tQ/tR/tPt/tEt简化命名）               *)
(* ---------------------------------------------------------------- *)
(*  V4.2.0 (2026-05-04)                                              *)
(*  - 11步版本，含直接伺服控制（已废弃）                            *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1003_PickPlace_BufferFraming

(* ==================== VAR_INPUT ==================== *)
VAR_INPUT
    i_bAutoMode                 : BOOL;     (* 自动模式 *)
    i_bManualMode               : BOOL;     (* 手动模式 *)
    i_bStart                    : BOOL;     (* 启动 *)
    i_bStop                     : BOOL;     (* 停止 *)

    i_bLx_FrontClamp            : BOOL;     (* 手动:前夹紧 *)
    i_bLx_RearClamp             : BOOL;     (* 手动:后夹紧 *)
    i_bLx_FrontClamp2           : BOOL;     (* 手动:前夹紧2 *)
    i_bLx_RearClamp2            : BOOL;     (* 手动:后夹紧2 *)
    i_bLx_LiftUp                : BOOL;     (* 手动:升降上升 *)
    i_bLx_LiftDown              : BOOL;     (* 手动:升降下降 *)

    i_iPickLayer                : INT;      (* 当前取料层号(1~4) *)
    i_rZSpeed                   : REAL;     (* Z轴速度 *)
    i_rX1Speed                  : REAL;     (* X1轴速度 *)
    i_iClampConfirmTime         : INT;      (* 夹紧确认时间(ms) *)
    i_iLiftActionTime           : INT;      (* 升降动作超时(ms) *)

    i_bLayerFeedDone            : ARRAY[1..4] OF BOOL; (* L1~L4各层放料完成 *)

    i_bLongEdge1Detect          : BOOL;     (* 长边1光电 *)
    i_bLongEdge2Detect          : BOOL;     (* 长边2光电 *)
    i_bShortEdge1Detect         : BOOL;     (* 短边1光电 *)
    i_bShortEdge2Detect         : BOOL;     (* 短边2光电 *)

    i_bFrontClampClosed         : BOOL;     (* 前夹紧位1 *)
    i_bFrontClampOpened         : BOOL;     (* 前松开位1 *)
    i_bRearClampClosed          : BOOL;     (* 后夹紧位1 *)
    i_bRearClampOpened          : BOOL;     (* 后松开位1 *)
    i_bFrontClamp2Closed        : BOOL;     (* 前夹紧位2 *)
    i_bFrontClamp2Opened        : BOOL;     (* 前松开位2 *)
    i_bRearClamp2Closed         : BOOL;     (* 后夹紧位2 *)
    i_bRearClamp2Opened         : BOOL;     (* 后松开位2 *)

    i_bLiftHomePos              : BOOL;     (* 升降上位 *)
    i_bLiftWorkPoint            : BOOL;     (* 升降下位 *)

    i_bFrameDetect1             : BOOL;     (* 边框检测1 *)
    i_bFrameDetect2             : BOOL;     (* 边框检测2 *)
    i_bFullMaterialDetect1      : BOOL;     (* 满料检测1 *)
    i_bFullMaterialDetect2      : BOOL;     (* 满料检测2 *)
END_VAR

(* ==================== VAR_OUTPUT ==================== *)
VAR_OUTPUT
    q_bFrontClamp               : BOOL;     (* 前夹紧输出 *)
    q_bRearClamp                : BOOL;     (* 后夹紧输出 *)
    q_bFrontClamp2              : BOOL;     (* 前夹紧2输出 *)
    q_bRearClamp2               : BOOL;     (* 后夹紧2输出 *)
    q_bLiftUp                   : BOOL;     (* 上升 *)
    q_bLiftDown                 : BOOL;     (* 下降 *)

    q_bZAxisHomeRequest         : BOOL;     (* Z轴回原点请求 *)
    q_bZAxisMoveAbsReq          : BOOL;     (* Z轴绝对定位请求 *)
    q_rZAxisTargetPos           : REAL;     (* Z轴目标位置 *)
    q_bX1AxisHomeRequest        : BOOL;     (* X1轴回原点请求 *)
    q_bX1AxisMoveAbsReq         : BOOL;     (* X1轴绝对定位请求 *)
    q_rX1AxisTargetPos          : REAL;     (* X1轴目标位置 *)

    q_iCurrentState             : INT;      (* 当前步序(0~5=S20~S25) *)
    q_iCurrentPickLayer         : INT;      (* 当前取料层(1~4) *)
    q_iAlarmCode                : INT;      (* 当前报警码 *)
    q_bPlaceDoneToFeeder        : BOOL;     (* 放料完成通知FB_1004 *)
    q_bSensorFault              : BOOL;     (* 夹紧/升降传感器冗余不一致 *)
    q_bProductMissing           : BOOL;     (* 4光电未全检到 *)
    q_bFrameOnPickupPlatform    : BOOL;     (* 取料平台有边框 *)
    q_bRunning                  : BOOL;     (* 运行中 *)
END_VAR

(* ==================== VAR ==================== *)
VAR
    bStepEntry              : BOOL;         (* 新步入口标志 *)
    bRunning                : BOOL;         (* 运行标志 *)
    iCurrentState           : INT;          (* 当前状态内部 *)
    iAlarmCode              : INT;          (* 报警码内部 *)
    iPickLayer              : INT;          (* 当前取料层 *)
    bStartTriggered         : BOOL;         (* 启动锁存 *)

    tIn                     : ARRAY[0..2] OF BOOL;
    tQ                      : ARRAY[0..2] OF BOOL;
    tR                      : ARRAY[0..2] OF BOOL;
    tPt                     : ARRAY[0..2] OF DINT;
    tEt                     : ARRAY[0..2] OF DINT;

    tLiftTimer              : FB_TONR;      (* 升降超时 *)
    tClampTimer             : FB_TONR;      (* 夹紧确认 *)
    tPlaceDoneTimer         : FB_TONR;      (* 放料完成脉冲 *)

    bSensorFault            : BOOL;
    bProductMissing         : BOOL;
    bFrameOnPlatform        : BOOL;
    bPlaceDonePulse         : BOOL;

    rPickHeight             : REAL := 514.0;   (* D514取片教点 *)
    rPlaceHeightL1           : REAL := 520.0;   (* D520 L1/L3放片 *)
    rPlaceHeightL2           : REAL := 540.0;   (* D540 L2/L4放片 *)
    rPlaceDownHeight        : REAL := 524.0;   (* D524放片下教点 *)
END_VAR

(* ==================== VAR_CONSTANT ==================== *)
VAR CONSTANT
    S20_IDLE                : INT := 0;     (* 待机等待 *)
    S21_UP_TO_PICK          : INT := 1;     (* 上升到取料高度 *)
    S22_CLAMP_AND_DETECT    : INT := 2;     (* 夹紧与检测 *)
    S23_MOVE_TO_PLACE       : INT := 3;     (* 移动到放料位置 *)
    S24_DOWN_TO_PLACE       : INT := 4;     (* 下降到放料高度 *)
    S25_UNCLAMP_AND_NOTIFY  : INT := 5;     (* 松开与通知 *)

    T_LIFT_DEFAULT          : DINT := 3000;   (* 升降默认3s *)
    T_CLAMP_DEFAULT         : DINT := 800;    (* 夹紧默认800ms *)
    T_PLACE_DONE_PULSE      : DINT := 500;    (* 放料完成脉冲500ms *)
END_VAR

(* ==================== 定时器调用 ==================== *)
tLiftTimer(IN := tIn[0], R := tR[0], PT := tPt[0], Q => tQ[0], ET => tEt[0]);
tClampTimer(IN := tIn[1], R := tR[1], PT := tPt[1], Q => tQ[1], ET => tEt[1]);
tPlaceDoneTimer(IN := tIn[2], R := tR[2], PT := tPt[2], Q => tQ[2], ET => tEt[2]);

(* ==================== 使能关闭 ==================== *)
IF NOT i_bAutoMode AND NOT i_bManualMode THEN
    q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
    q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
    q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    q_bZAxisHomeRequest := FALSE; q_bZAxisMoveAbsReq := FALSE;
    q_rZAxisTargetPos := 0.0;
    q_bX1AxisHomeRequest := FALSE; q_bX1AxisMoveAbsReq := FALSE;
    q_rX1AxisTargetPos := 0.0;
    q_iAlarmCode := 0; q_bSensorFault := FALSE;
    q_bProductMissing := FALSE; q_bFrameOnPickupPlatform := FALSE;
    q_bPlaceDoneToFeeder := FALSE; q_bRunning := FALSE;
    iCurrentState := S20_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
    RETURN;
END_IF;

(* ==================== 停止处理 ==================== *)
IF i_bStop AND bRunning THEN
    iCurrentState := S20_IDLE; bRunning := FALSE; bStepEntry := TRUE;
    q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
    q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
    q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    q_bZAxisMoveAbsReq := FALSE; q_bX1AxisMoveAbsReq := FALSE;
    q_bPlaceDoneToFeeder := FALSE;
    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;
END_IF;

(* ==================== 模式分发 ==================== *)
IF i_bAutoMode THEN

    (* --- 启动触发 --- *)
    IF i_bStart AND NOT bStartTriggered THEN
        bStartTriggered := TRUE;
    END_IF;

    CASE iCurrentState OF

        S20_IDLE: (* 0 - 待机等待 *)
            IF bStepEntry THEN
                q_bZAxisMoveAbsReq := FALSE;
                q_bX1AxisMoveAbsReq := FALSE;
                q_bPlaceDoneToFeeder := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* 检查取料平台是否有残留边框 *)
            IF i_bFrameDetect1 OR i_bFrameDetect2 THEN
                q_bFrameOnPickupPlatform := TRUE;
                bFrameOnPlatform := TRUE;
                iAlarmCode := 80;
            END_IF;

            IF bStartTriggered AND i_iPickLayer > 0 AND i_iPickLayer <= 4 THEN
                iPickLayer := i_iPickLayer;
                bStepEntry := TRUE;
                iCurrentState := S21_UP_TO_PICK;
            END_IF;

        S21_UP_TO_PICK: (* 1 - Z上升到取料高度D514 *)
            IF bStepEntry THEN
                q_rZAxisTargetPos := rPickHeight;
                q_bZAxisMoveAbsReq := TRUE;
                IF i_iLiftActionTime > 0 THEN
                    tPt[0] := INT_TO_DINT(i_iLiftActionTime);
                ELSE
                    tPt[0] := T_LIFT_DEFAULT;
                END_IF;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            (* Z轴到达目标位 *)
            IF i_bLiftHomePos THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bZAxisMoveAbsReq := FALSE;
                bStepEntry := TRUE;
                iCurrentState := S22_CLAMP_AND_DETECT;
            ELSIF tQ[0] THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bZAxisMoveAbsReq := FALSE;
                iAlarmCode := 71;
                iCurrentState := S20_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            END_IF;

        S22_CLAMP_AND_DETECT: (* 2 - 四夹紧 + 四光电检测 *)
            IF bStepEntry THEN
                q_bFrontClamp := TRUE; q_bRearClamp := TRUE;
                q_bFrontClamp2 := TRUE; q_bRearClamp2 := TRUE;
                IF i_iClampConfirmTime > 0 THEN
                    tPt[1] := INT_TO_DINT(i_iClampConfirmTime);
                ELSE
                    tPt[1] := T_CLAMP_DEFAULT;
                END_IF;
                tIn[1] := TRUE; tR[1] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[1] THEN
                tIn[1] := FALSE; tR[1] := TRUE;
                (* 检测四组夹紧到位 *)
                IF i_bFrontClampClosed AND i_bRearClampClosed AND
                   i_bFrontClamp2Closed AND i_bRearClamp2Closed THEN
                    (* 夹紧到位，检测产品 *)
                    IF i_bLongEdge1Detect AND i_bLongEdge2Detect AND
                       i_bShortEdge1Detect AND i_bShortEdge2Detect THEN
                        bStepEntry := TRUE;
                        iCurrentState := S23_MOVE_TO_PLACE;
                    ELSE
                        q_bProductMissing := TRUE;
                        bProductMissing := TRUE;
                        iAlarmCode := 72;
                        iCurrentState := S25_UNCLAMP_AND_NOTIFY;
                    END_IF;
                ELSE
                    q_bSensorFault := TRUE;
                    bSensorFault := TRUE;
                    iAlarmCode := 71;
                    iCurrentState := S25_UNCLAMP_AND_NOTIFY;
                END_IF;
            END_IF;

        S23_MOVE_TO_PLACE: (* 3 - X1移动到放料位置，按层选 *)
            IF bStepEntry THEN
                IF (iPickLayer = 1) OR (iPickLayer = 3) THEN
                    q_rX1AxisTargetPos := rPlaceHeightL1;
                ELSE
                    q_rX1AxisTargetPos := rPlaceHeightL2;
                END_IF;
                q_bX1AxisMoveAbsReq := TRUE;
                bStepEntry := FALSE;
            END_IF;

            (* X1到位后进入下降步 *)
            IF i_bFullMaterialDetect1 OR i_bFullMaterialDetect2 THEN
                q_bX1AxisMoveAbsReq := FALSE;
                bStepEntry := TRUE;
                iCurrentState := S24_DOWN_TO_PLACE;
            END_IF;

        S24_DOWN_TO_PLACE: (* 4 - Z下降到放料高度D524 *)
            IF bStepEntry THEN
                q_rZAxisTargetPos := rPlaceDownHeight;
                q_bZAxisMoveAbsReq := TRUE;
                q_bLiftDown := TRUE;
                q_bLiftUp := FALSE;
                IF i_iLiftActionTime > 0 THEN
                    tPt[0] := INT_TO_DINT(i_iLiftActionTime);
                ELSE
                    tPt[0] := T_LIFT_DEFAULT;
                END_IF;
                tIn[0] := TRUE; tR[0] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF i_bLiftWorkPoint THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bZAxisMoveAbsReq := FALSE;
                q_bLiftDown := FALSE;
                bStepEntry := TRUE;
                iCurrentState := S25_UNCLAMP_AND_NOTIFY;
            ELSIF tQ[0] THEN
                tIn[0] := FALSE; tR[0] := TRUE;
                q_bZAxisMoveAbsReq := FALSE;
                q_bLiftDown := FALSE;
                iAlarmCode := 71;
                iCurrentState := S20_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            END_IF;

        S25_UNCLAMP_AND_NOTIFY: (* 5 - 四松开 + 通知FB_1004 *)
            IF bStepEntry THEN
                q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
                q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
                tPt[2] := T_PLACE_DONE_PULSE;
                tIn[2] := TRUE; tR[2] := FALSE;
                bStepEntry := FALSE;
            END_IF;

            IF tQ[2] THEN
                tIn[2] := FALSE; tR[2] := TRUE;
                q_bPlaceDoneToFeeder := TRUE;
                bPlaceDonePulse := TRUE;
                bStepEntry := TRUE;
                iCurrentState := S20_IDLE;
                bRunning := FALSE; bStartTriggered := FALSE;
            END_IF;

        ELSE
            iCurrentState := S20_IDLE;
            bRunning := FALSE; bStartTriggered := FALSE;
    END_CASE;

ELSIF i_bManualMode THEN
    (* ==================== 手动模式 ==================== *)
    bRunning := FALSE; iCurrentState := S20_IDLE;
    bStepEntry := TRUE; bStartTriggered := FALSE;
    q_bPlaceDoneToFeeder := FALSE;

    (* 前夹紧 *)
    IF i_bLx_FrontClamp THEN q_bFrontClamp := TRUE; ELSE q_bFrontClamp := FALSE; END_IF;
    (* 后夹紧 *)
    IF i_bLx_RearClamp THEN q_bRearClamp := TRUE; ELSE q_bRearClamp := FALSE; END_IF;
    (* 前夹紧2 *)
    IF i_bLx_FrontClamp2 THEN q_bFrontClamp2 := TRUE; ELSE q_bFrontClamp2 := FALSE; END_IF;
    (* 后夹紧2 *)
    IF i_bLx_RearClamp2 THEN q_bRearClamp2 := TRUE; ELSE q_bRearClamp2 := FALSE; END_IF;

    (* 升降 *)
    IF i_bLx_LiftUp AND NOT i_bLx_LiftDown THEN
        q_bLiftUp := TRUE; q_bLiftDown := FALSE;
    ELSIF i_bLx_LiftDown AND NOT i_bLx_LiftUp THEN
        q_bLiftDown := TRUE; q_bLiftUp := FALSE;
    ELSE
        q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    END_IF;

    tIn[0] := FALSE; tR[0] := TRUE;
    tIn[1] := FALSE; tR[1] := TRUE;
    tIn[2] := FALSE; tR[2] := TRUE;

ELSE
    q_bFrontClamp := FALSE; q_bRearClamp := FALSE;
    q_bFrontClamp2 := FALSE; q_bRearClamp2 := FALSE;
    q_bLiftUp := FALSE; q_bLiftDown := FALSE;
    q_bZAxisMoveAbsReq := FALSE; q_bX1AxisMoveAbsReq := FALSE;
    q_bPlaceDoneToFeeder := FALSE;
END_IF;

(* ==================== 状态输出 ==================== *)
q_bRunning := bRunning;
q_iCurrentState := iCurrentState;
q_iCurrentPickLayer := iPickLayer;
q_iAlarmCode := iAlarmCode;

(* 放料完成脉冲自清除 *)
IF bPlaceDonePulse AND tQ[2] = FALSE THEN
    q_bPlaceDoneToFeeder := FALSE;
    bPlaceDonePulse := FALSE;
END_IF;

END_FUNCTION_BLOCK
