(* ================================================================= *)
(*  功能块名称:FB_2001_CommonAlarm_AllStation                        *)
(*  功能描述:公共报警管理功能块 - 汇总所有工站报警信息                *)
(*  创建日期:2026-05-03                                              *)
(*  版本号:V2.1.0                                                    *)
(*  基于版本:V2.0.0                                                  *)
(*  编制人:[待填写]                                                  *)
(*  审核人:[待填写]                                                  *)
(*                                                                    *)
(*  遵循规范:                                                        *)
(*    - 801_PLC变量命名与功能块命名规范_DEV-V1.0.5                    *)
(*    - 810_PLC编程规范_DEV-V1.0.3                                    *)
(*                                                                    *)
(*  变更记录:                                                          *)
(* ---------------------------------------------------------------- *)
(*  V2.1.0 (2026-05-04) Trae                                        *)
(*  - 优化: 状态存储位置调整,避免读取未定义输出变量                  *)
(*  - 优化: 报警检测逻辑,只检测新增报警(从无到有)                  *)
(*  - 新增: 队列满标志 s_bQueueFull,便于监控队列状态                *)
(* ---------------------------------------------------------------- *)
(*  V2.0.0 (2026-05-03)                                              *)
(*  - 新增: 公共报警管理功能块,汇总3个工站报警信息                  *)
(*  - 新增: MES报警队列功能,支持最近10条报警记录去重存储            *)
(*  - 新增: 新报警检测脉冲,触发MES上传                              *)
(* ---------------------------------------------------------------- *)
(*                                                                    *)
(*  详细说明:                                                          *)
(*    本功能块负责汇总三层输送机,取放料机构和打胶机送料机构的报警信息:*)
(*    1. 报警汇总: 收集三个工站的报警码,生成全局报警字              *)
(*    2. 优先级处理: 选择最小报警码作为当前最高优先级报警            *)
(*    3. MES接口: 维护报警计数和报警队列,支持MES系统上传            *)
(*    4. 新报警检测: 检测报警上升沿,生成单次脉冲信号                *)
(*                                                                    *)
(*  架构特点:                                                          *)
(*    - 纯逻辑块: 无物理地址依赖,所有输入/输出均为逻辑变量          *)
(*    - 去重机制: 相同报警码不会重复加入队列                          *)
(*    - 循环队列: 队列满时自动覆盖最旧记录                            *)
(* ================================================================= *)
FUNCTION_BLOCK FB_2001_CommonAlarm_AllStation

//#region 100_VAR_INPUT 输入变量定义
VAR_INPUT
    i_iConveyorAlarm   : INT;   // 输送机工站报警码 (0=无报警, 1-7=报警类型)
    i_iPickPlaceAlarm  : INT;   // 取放料机构报警码 (0=无报警, 101-199=报警类型)
    i_iFeederAlarm     : INT;   // 送料机构报警码 (0=无报警, 201-299=报警类型)
    i_bReset           : BOOL;  // 复位按钮 (高电平有效,清除所有报警状态)
END_VAR
//#endregion 100_VAR_INPUT

//#region 200_VAR_OUTPUT 输出变量定义
VAR_OUTPUT
    o_wGlobalAlarmWord     : WORD;                       // 全局报警字 (各工站报警码按位或)
    o_iCurrentAlarmCode    : INT;                        // 当前最高优先级报警码
    o_bAnyAlarmActive      : BOOL;                       // 任何报警激活标志
    o_iMESAlarmCount       : INT;                        // MES报警累计计数
    o_iMESAlarmQueue       : ARRAY[0..9] OF INT;         // MES报警队列 (最近10条去重记录)
    o_bNewAlarmFlag        : BOOL;                       // 新报警检测脉冲 (单次触发)
    o_iStationAlarmStatus  : ARRAY[1..3] OF INT;         // 三工站报警状态数组 [1]输送机 [2]取放料 [3]送料
    o_bConveyorAlarmActive : BOOL;                       // 输送机工站报警激活标志
    o_bPickPlaceAlarmActive: BOOL;                       // 取放料机构报警激活标志
    o_bFeederAlarmActive   : BOOL;                       // 送料机构报警激活标志
END_VAR
//#endregion 200_VAR_OUTPUT

//#region 300_VAR 内部变量定义
VAR
    s_iPrevConveyorAlarm   : INT;   // 上一周期输送机报警码 (用于检测上升沿)
    s_iPrevPickPlaceAlarm  : INT;   // 上一周期取放料报警码 (用于检测上升沿)
    s_iPrevFeederAlarm     : INT;   // 上一周期送料机构报警码 (用于检测上升沿)
    s_wPrevGlobalAlarmWord : WORD;  // 上一周期全局报警字 (用于检测变化)
    s_bConveyorAlarmActive : BOOL;  // 输送机报警激活标志 (内部)
    s_bPickPlaceAlarmActive: BOOL;  // 取放料报警激活标志 (内部)
    s_bFeederAlarmActive   : BOOL;  // 送料机构报警激活标志 (内部)
    s_iMinAlarmCode        : INT;   // 当前最小报警码 (最高优先级)
    s_iQueueTailIndex      : INT;   // 报警队列尾指针
    s_bAlarmExistsInQueue  : BOOL;  // 报警码是否已存在于队列中
    s_iQueueScanIndex      : INT;   // 队列扫描索引
    s_iAlarmCount          : INT;   // 报警累计计数 (内部)
    s_bNewAlarmDetected    : BOOL;  // 新报警检测标志
    s_bQueueFull           : BOOL;  // 队列满标志 (TRUE=队列已满)
END_VAR
//#endregion 300_VAR

//#region 400_VAR_CONSTANT 常量定义
VAR CONSTANT
    QUEUE_SIZE     : INT := 10;     // 报警队列大小
    QUEUE_MASK     : INT := 9;      // 队列索引掩码 (用于循环队列)
    ALM_NONE       : INT := 0;      // 无报警值
    ALM_WORD_ZERO  : WORD := 0;     // 报警字零值
END_VAR
//#endregion 400_VAR_CONSTANT

//#region 500_功能块执行体
(* ========================================================================== *)
(* 功能块执行体                                                                *)
(* ========================================================================== *)

(* -------------------------------------------------------------------------- *)
(* 1. 保存当前输入状态用于下一周期比较                                          *)
(*    注意:必须在复位逻辑之前保存,确保复位时也能正确检测后续变化              *)
(* -------------------------------------------------------------------------- *)
s_iPrevConveyorAlarm := i_iConveyorAlarm;
s_iPrevPickPlaceAlarm := i_iPickPlaceAlarm;
s_iPrevFeederAlarm := i_iFeederAlarm;

(* -------------------------------------------------------------------------- *)
(* 2. 复位处理                                                                *)
(*    清除所有报警状态,重置队列和计数器                                        *)
(* -------------------------------------------------------------------------- *)
IF i_bReset THEN
    o_wGlobalAlarmWord := ALM_WORD_ZERO;
    o_iCurrentAlarmCode := ALM_NONE;
    o_bAnyAlarmActive := FALSE;
    o_bNewAlarmFlag := FALSE;
    o_iMESAlarmCount := ALM_NONE;
    s_iAlarmCount := ALM_NONE;
    FOR s_iQueueScanIndex := 0 TO QUEUE_MASK DO
        o_iMESAlarmQueue[s_iQueueScanIndex] := ALM_NONE;
    END_FOR;
    s_iQueueTailIndex := 0;
    s_bNewAlarmDetected := FALSE;
    s_iMinAlarmCode := ALM_NONE;
    s_wPrevGlobalAlarmWord := ALM_WORD_ZERO;
    s_bQueueFull := FALSE;
    RETURN;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 3. 各工站报警激活状态检测                                                    *)
(* -------------------------------------------------------------------------- *)
s_bConveyorAlarmActive := (i_iConveyorAlarm <> ALM_NONE);
s_bPickPlaceAlarmActive := (i_iPickPlaceAlarm <> ALM_NONE);
s_bFeederAlarmActive := (i_iFeederAlarm <> ALM_NONE);

(* -------------------------------------------------------------------------- *)
(* 4. 全局报警字生成                                                          *)
(*    将各工站报警码按位或组合成全局报警字                                      *)
(* -------------------------------------------------------------------------- *)
o_wGlobalAlarmWord := ALM_WORD_ZERO;

IF s_bConveyorAlarmActive THEN
    o_wGlobalAlarmWord := o_wGlobalAlarmWord OR INT_TO_WORD(i_iConveyorAlarm);
END_IF;

IF s_bPickPlaceAlarmActive THEN
    o_wGlobalAlarmWord := o_wGlobalAlarmWord OR INT_TO_WORD(i_iPickPlaceAlarm);
END_IF;

IF s_bFeederAlarmActive THEN
    o_wGlobalAlarmWord := o_wGlobalAlarmWord OR INT_TO_WORD(i_iFeederAlarm);
END_IF;

(* -------------------------------------------------------------------------- *)
(* 5. 最高优先级报警码选择                                                      *)
(*    选择最小报警码作为当前最高优先级报警(报警码越小优先级越高)                *)
(* -------------------------------------------------------------------------- *)
s_iMinAlarmCode := ALM_NONE;

IF s_bConveyorAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := i_iConveyorAlarm;
    ELSIF i_iConveyorAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := i_iConveyorAlarm;
    END_IF;
END_IF;

IF s_bPickPlaceAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := i_iPickPlaceAlarm;
    ELSIF i_iPickPlaceAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := i_iPickPlaceAlarm;
    END_IF;
END_IF;

IF s_bFeederAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := i_iFeederAlarm;
    ELSIF i_iFeederAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := i_iFeederAlarm;
    END_IF;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 6. 输出状态赋值                                                            *)
(* -------------------------------------------------------------------------- *)
o_iCurrentAlarmCode := s_iMinAlarmCode;
o_bAnyAlarmActive := s_bConveyorAlarmActive OR s_bPickPlaceAlarmActive OR s_bFeederAlarmActive;

o_iStationAlarmStatus[1] := i_iConveyorAlarm;
o_iStationAlarmStatus[2] := i_iPickPlaceAlarm;
o_iStationAlarmStatus[3] := i_iFeederAlarm;

o_bConveyorAlarmActive := s_bConveyorAlarmActive;
o_bPickPlaceAlarmActive := s_bPickPlaceAlarmActive;
o_bFeederAlarmActive := s_bFeederAlarmActive;

(* -------------------------------------------------------------------------- *)
(* 7. 新报警检测(上升沿检测)                                                  *)
(*    只检测报警从无到有的变化,避免报警解除时误触发                            *)
(* -------------------------------------------------------------------------- *)
s_bNewAlarmDetected := FALSE;

IF (i_iConveyorAlarm <> ALM_NONE AND s_iPrevConveyorAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;
IF (i_iPickPlaceAlarm <> ALM_NONE AND s_iPrevPickPlaceAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;
IF (i_iFeederAlarm <> ALM_NONE AND s_iPrevFeederAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;

o_bNewAlarmFlag := s_bNewAlarmDetected AND o_bAnyAlarmActive;

(* -------------------------------------------------------------------------- *)
(* 8. MES报警队列管理                                                          *)
(*    维护最近10条报警记录,支持去重存储,队列满时自动覆盖最旧记录              *)
(* -------------------------------------------------------------------------- *)
IF o_bAnyAlarmActive THEN
    s_iAlarmCount := s_iAlarmCount + 1;
    o_iMESAlarmCount := s_iAlarmCount;
    s_bAlarmExistsInQueue := FALSE;
    
    (* 检查报警码是否已存在于队列中(去重) *)
    FOR s_iQueueScanIndex := 0 TO QUEUE_MASK DO
        IF o_iMESAlarmQueue[s_iQueueScanIndex] = o_iCurrentAlarmCode THEN
            s_bAlarmExistsInQueue := TRUE;
            EXIT;
        END_IF;
    END_FOR;
    
    (* 如果报警码不存在于队列中,则加入队列 *)
    IF NOT s_bAlarmExistsInQueue THEN
        o_iMESAlarmQueue[s_iQueueTailIndex] := o_iCurrentAlarmCode;
        s_iQueueTailIndex := s_iQueueTailIndex + 1;
        
        (* 循环队列处理 *)
        IF s_iQueueTailIndex > QUEUE_MASK THEN
            s_iQueueTailIndex := 0;
            s_bQueueFull := TRUE;
        ELSE
            s_bQueueFull := FALSE;
        END_IF;
    END_IF;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 9. 保存当前状态用于下一周期比较                                              *)
(*    注意:必须在功能块末尾保存,确保读取的是当前周期计算后的有效值            *)
(* -------------------------------------------------------------------------- *)
s_wPrevGlobalAlarmWord := o_wGlobalAlarmWord;

//#endregion 500_功能块执行体

END_FUNCTION_BLOCK