// ============================================================================
// ST_ExternalDevice.scl - 外部设备交互结构体 (遵循 STD-820 规范)
// ============================================================================
// 描述:
//   定义边框缓存机与上游流水线/机器人及下游打胶机标准交互数据结构.
//   基于 STD-820 8 步闭环握手协议与 4s ON / 4s OFF 双向心跳监视体系.
// ============================================================================

// 1. 上游进料交握结构体 (STD-820 Infeed Handshake)
TYPE ST_UpstreamDocking :
STRUCT
    // 本机 -> 上游 (Machine Output)
    bMachine_ReadyIn            : BOOL := FALSE;   // (1) 机器准备好进料信号
    bMachine_RcvModuleIdAck     : BOOL := FALSE;   // (4) 机器收到组件ID信号
    bMachine_AllowInfeed        : BOOL := FALSE;   // (5) 机器允许上游进料信号
    bMachine_InfeedArrived      : BOOL := FALSE;   // (7) 机器给上游组件进料到位信号
    bMachine_HeartbeatToUp      : BOOL := FALSE;   // [心跳] 本机向上游心跳 (4s ON / 4s OFF)

    // 上游 -> 本机 (Upstream Output)
    bUpstream_LineReady         : BOOL := FALSE;   // (2) 上游流水线/机器人准备好信号
    bUpstream_SendModuleId      : BOOL := FALSE;   // (3) 上游流水线传组件ID信号
    bUpstream_InfeedReq         : BOOL := FALSE;   // (6) 上游流水线入料请求信号
    bUpstream_InfeedArrivedAck  : BOOL := FALSE;   // (8) 上游回收收到进料到位信号
    bUpstream_HeartbeatFromUp   : BOOL := FALSE;   // [心跳] 上游输入心跳

    // 状态与数据
    sRcvModuleID                : STRING[32] := ''; // 接收的组件 ID
    bUpstreamComFault           : BOOL := FALSE;   // 上游通讯中断报警 (12s 超时)
    iInfeedStep                 : INT := 0;        // 当前步序 0~8
    bRobot_Fault                : BOOL := FALSE;   // 机器人故障
    bRobot_EStop                : BOOL := FALSE;   // 机器人急停
END_STRUCT;
END_TYPE

// 2. 下游出料交握结构体 (STD-820 Outfeed Handshake)
TYPE ST_DownstreamDocking :
STRUCT
    // 本机 -> 下游 (Machine Output)
    bMachine_ReadyOut           : BOOL := FALSE;   // (2) 机器准备好出料信号
    bMachine_SendModuleId       : BOOL := FALSE;   // (3) 机器传组件ID信号
    bMachine_OutfeedReq         : BOOL := FALSE;   // (6) 机器给下游出料请求信号 (允许打胶机抓料 Y44)
    bMachine_OutfeedArrivedAck  : BOOL := FALSE;   // (8) 机器回收收到进料到位信号
    bMachine_HeartbeatToDown    : BOOL := FALSE;   // [心跳] 本机向下游心跳 (4s ON / 4s OFF)
    bSafetyZoneSignal           : BOOL := FALSE;   // 安全区隔离/开放信号 (Y47)

    // 下游 -> 本机 (Downstream Output)
    bDownstream_LineReady       : BOOL := FALSE;   // (1) 下游流水线准备好 (允许送料 X76)
    bDownstream_RcvModuleIdAck  : BOOL := FALSE;   // (4) 下游流水线收到组件ID信号
    bDownstream_AllowOutfeed    : BOOL := FALSE;   // (5) 下游流水线允许机器出料信号
    bDownstream_OutfeedArrived  : BOOL := FALSE;   // (7) 下游取料完成信号 (X102)
    bDownstream_HeartbeatFromDown: BOOL := FALSE;  // [心跳] 下游输入心跳
    bDownstream_Fault           : BOOL := FALSE;   // 打胶机故障
    bDownstream_EStop           : BOOL := FALSE;   // 打胶机急停

    // 状态与数据
    sSendModuleID               : STRING[32] := ''; // 发送给下游的组件 ID
    bDownstreamComFault         : BOOL := FALSE;   // 下游通讯中断报警 (12s 超时)
    iOutfeedStep                : INT := 0;        // 当前步序 0~8
END_STRUCT;
END_TYPE

// 3. 外部设备综合交互主结构体
TYPE ST_ExternalDevice :
STRUCT
    // === 系统控制输入 ===
    i_bEnable                   : BOOL := FALSE;   // 系统总使能
    i_bAutoMode                 : BOOL := FALSE;   // 自动模式选择
    i_bManualMode               : BOOL := FALSE;   // 手动模式选择
    i_bStart                    : BOOL := FALSE;   // 启动按钮
    i_bStop                     : BOOL := FALSE;   // 停止按钮
    i_bReset                    : BOOL := FALSE;   // 复位按钮
    i_bLocalReady               : BOOL := FALSE;   // 本机就绪状态
    i_bAnyAlarmActive           : BOOL := FALSE;   // 本机有任何报警激活
    i_bSystemFault              : BOOL := FALSE;   // 本机系统故障

    // === STD-820 上下游对接子结构体 ===
    stUpstream                  : ST_UpstreamDocking;   // 上游机器人供料对接
    stDownstream                : ST_DownstreamDocking; // 下游打胶机送料对接

    // === 组框机交互信号 ===
    i_bFrameMachine_AutoRunning : BOOL := FALSE;   // 组框机自动运行中
    i_bFrameMachine_AllowFeed   : BOOL := FALSE;   // 组框机允许向缓存机输送边框
    i_bFrameMaterialRequest     : BOOL := FALSE;   // 组框机有边框需要送入缓存机
    i_bDoorOpenRequest          : BOOL := FALSE;   // 组框机操作门打开(需本机暂停)
    i_bFrameMachine_EStop       : BOOL := FALSE;   // 组框机急停信号(需联锁)
    i_bFrameMachine_SafetyErr   : BOOL := FALSE;   // 组框机安全系统异常
    i_bFrameMachine_CommErr     : BOOL := FALSE;   // 与组框机通讯异常

    o_bFrameMachine_RequestFeed : BOOL := FALSE;   // 向组框机请求输送边框
    o_bFrameMachine_Pause       : BOOL := FALSE;   // 向组框机发送暂停指令
    o_bFrameMachine_EStop       : BOOL := FALSE;   // 向组框机发送急停联锁信号
    o_bDoorOpenRequest          : BOOL := FALSE;   // 向组框机申请开门操作
    o_bFrameMachine_Ready       : BOOL := FALSE;   // 本机就绪, 可接收边框

    // === 综合安全与报警输出 ===
    o_bFrameMachine_EmergencyStop : BOOL := FALSE; // 组框机急停/安全异常时强制本机停止
    o_bExternalDeviceFault      : BOOL := FALSE;   // 外部设备故障标志
    o_iExternalDeviceAlarmSummary : INT := 0;      // 外部设备故障报警码(300~399段)
    o_bSystemSafetyConditionMet : BOOL := FALSE;   // 系统安全条件是否满足
END_STRUCT;
END_TYPE
