(* ================================================================= *)
(*  功能块名称:FB_ExternalDeviceInteraction                           *)
(*  功能描述:处理与组框机,打胶机和上游机器人的交互逻辑 (遵循 STD-820) *)
(*  创建日期:2026-04-27                                            *)
(*  版本号:V5.0.0 (STD-820 结构化交握升级, LSP-905 0-Warn 合规)    *)
(*                                                                  *)
(*  遵循规范:                                                      *)
(*    - LSP-905 SCL编程规范                                         *)
(*    - STD-820 设备间信号交握与外部对接规范                        *)
(* ================================================================= *)

FUNCTION_BLOCK FB_ExternalDeviceInteraction

VAR_IN_OUT
    io_stExternal               : ST_ExternalDevice; // 外部设备交互全量数据结构体
END_VAR

VAR
    s_bSafetyConditionMet       : BOOL;   // 内部安全条件满足标志
    s_iExternalDeviceAlarmCode  : INT;    // 内部报警码变量

    // 本机心跳发生器 (4.0s 翻转)
    fb_tHbGenTimer              : FB_TONR;
    s_bHbState                  : BOOL := FALSE;
    s_bHbGen_In                 : BOOL := FALSE;
    s_bHbGen_Q                  : BOOL := FALSE;
    s_bHbGen_R                  : BOOL := FALSE;
    s_dHbGen_Et                 : DINT := 0;

    // 通讯超时监视器 (12.0s)
    fb_tUpstreamTimeoutTimer    : FB_TONR;
    s_bUpHb_In                  : BOOL := FALSE;
    s_bUpHb_Q                   : BOOL := FALSE;
    s_bUpHb_R                   : BOOL := FALSE;
    s_dUpHb_Et                  : DINT := 0;
    s_bLastUpHb                 : BOOL := FALSE;

    fb_tDownstreamTimeoutTimer  : FB_TONR;
    s_bDownHb_In                : BOOL := FALSE;
    s_bDownHb_Q                 : BOOL := FALSE;
    s_bDownHb_R                 : BOOL := FALSE;
    s_dDownHb_Et                : DINT := 0;
    s_bLastDownHb               : BOOL := FALSE;
END_VAR

VAR CONSTANT
    T_HEARTBEAT_PERIOD          : DINT := 4000;    (* 心跳翻转周期 4.0s *)
    T_COMM_TIMEOUT              : DINT := 12000;   (* 通讯中断超时 12.0s *)
END_VAR

(* ========================================================================== *)
(* 功能块执行体                                                                *)
(* ========================================================================== *)

//#region 100_STD820_心跳发生与监视
// 1.1 本机心跳发生器 (4s ON / 4s OFF)
s_bHbGen_In := TRUE;
s_bHbGen_R := s_bHbGen_Q;
fb_tHbGenTimer(
    IN := s_bHbGen_In,
    PT := T_HEARTBEAT_PERIOD,
    R  := s_bHbGen_R,
    Q  => s_bHbGen_Q,
    ET => s_dHbGen_Et
);
IF s_bHbGen_Q THEN
    s_bHbState := NOT s_bHbState;
END_IF;
io_stExternal.stUpstream.bMachine_HeartbeatToUp := s_bHbState;
io_stExternal.stDownstream.bMachine_HeartbeatToDown := s_bHbState;

// 1.2 上游心跳边沿检测与超时监视 (12s)
IF io_stExternal.stUpstream.bUpstream_HeartbeatFromUp <> s_bLastUpHb THEN
    s_bUpHb_R := TRUE;
    s_bLastUpHb := io_stExternal.stUpstream.bUpstream_HeartbeatFromUp;
ELSE
    s_bUpHb_R := FALSE;
END_IF;
s_bUpHb_In := io_stExternal.i_bEnable;
fb_tUpstreamTimeoutTimer(
    IN := s_bUpHb_In,
    PT := T_COMM_TIMEOUT,
    R  := s_bUpHb_R,
    Q  => s_bUpHb_Q,
    ET => s_dUpHb_Et
);
io_stExternal.stUpstream.bUpstreamComFault := s_bUpHb_Q;

// 1.3 下游心跳边沿检测与超时监视 (12s)
IF io_stExternal.stDownstream.bDownstream_HeartbeatFromDown <> s_bLastDownHb THEN
    s_bDownHb_R := TRUE;
    s_bLastDownHb := io_stExternal.stDownstream.bDownstream_HeartbeatFromDown;
ELSE
    s_bDownHb_R := FALSE;
END_IF;
s_bDownHb_In := io_stExternal.i_bEnable;
fb_tDownstreamTimeoutTimer(
    IN := s_bDownHb_In,
    PT := T_COMM_TIMEOUT,
    R  := s_bDownHb_R,
    Q  => s_bDownHb_Q,
    ET => s_dDownHb_Et
);
io_stExternal.stDownstream.bDownstreamComFault := s_bDownHb_Q;
//#endregion 100_STD820_心跳发生与监视

//#region 200_上游供料与机器人交互
// 上游就绪状态检查
io_stExternal.stUpstream.bMachine_ReadyIn := io_stExternal.i_bLocalReady 
                                        AND io_stExternal.i_bAutoMode 
                                        AND NOT io_stExternal.stUpstream.bUpstreamComFault;

// 允许上游进料: 本机准备好且无报警
IF io_stExternal.stUpstream.bMachine_ReadyIn AND (NOT io_stExternal.i_bAnyAlarmActive) THEN
    io_stExternal.stUpstream.bMachine_AllowInfeed := TRUE;
ELSE
    io_stExternal.stUpstream.bMachine_AllowInfeed := FALSE;
END_IF;
//#endregion 200_上游供料与机器人交互

//#region 300_下游打胶机安全交握
// 下游出料就绪状态检查
io_stExternal.stDownstream.bMachine_ReadyOut := io_stExternal.i_bAutoMode 
                                            AND io_stExternal.i_bEnable 
                                            AND NOT io_stExternal.stDownstream.bDownstreamComFault;

// 安全区管理 (Y47): 自动运行且无通讯中断时有效
IF io_stExternal.stDownstream.bDownstreamComFault THEN
    io_stExternal.stDownstream.bSafetyZoneSignal := FALSE;
    io_stExternal.stDownstream.bMachine_OutfeedReq := FALSE;
END_IF;
//#endregion 300_下游打胶机安全交握

//#region 400_组框机交互
IF io_stExternal.i_bFrameMachine_EStop OR io_stExternal.i_bFrameMachine_SafetyErr THEN
    io_stExternal.o_bFrameMachine_EStop := TRUE;
    io_stExternal.o_bFrameMachine_EmergencyStop := TRUE;
ELSE
    io_stExternal.o_bFrameMachine_EStop := FALSE;
    io_stExternal.o_bFrameMachine_EmergencyStop := FALSE;
END_IF;

IF io_stExternal.i_bDoorOpenRequest THEN
    io_stExternal.o_bFrameMachine_Pause := TRUE;
    io_stExternal.o_bDoorOpenRequest := TRUE;
ELSE
    io_stExternal.o_bFrameMachine_Pause := FALSE;
    io_stExternal.o_bDoorOpenRequest := FALSE;
END_IF;

io_stExternal.o_bFrameMachine_Ready := io_stExternal.i_bAutoMode 
                                   AND io_stExternal.i_bEnable 
                                   AND (NOT io_stExternal.i_bAnyAlarmActive)
                                   AND (NOT io_stExternal.o_bFrameMachine_EmergencyStop);

IF io_stExternal.i_bEnable 
   AND (NOT io_stExternal.o_bFrameMachine_EmergencyStop)
   AND io_stExternal.i_bFrameMachine_AllowFeed
   AND io_stExternal.i_bAutoMode 
THEN
    io_stExternal.o_bFrameMachine_RequestFeed := TRUE;
ELSE
    io_stExternal.o_bFrameMachine_RequestFeed := FALSE;
END_IF;
//#endregion 400_组框机交互

//#region 500_报警汇总
IF io_stExternal.stDownstream.bDownstream_Fault THEN
    s_iExternalDeviceAlarmCode := 300;        // 300=打胶机设备故障
ELSIF io_stExternal.stDownstream.bDownstream_EStop THEN
    s_iExternalDeviceAlarmCode := 301;        // 301=打胶机急停
ELSIF io_stExternal.stDownstream.bDownstreamComFault THEN
    s_iExternalDeviceAlarmCode := 302;        // 302=打胶机通讯中断(12s超时)
ELSIF io_stExternal.i_bFrameMachine_SafetyErr THEN
    s_iExternalDeviceAlarmCode := 310;        // 310=组框机安全异常
ELSIF io_stExternal.i_bFrameMachine_EStop THEN
    s_iExternalDeviceAlarmCode := 311;        // 311=组框机急停
ELSIF io_stExternal.i_bFrameMachine_CommErr THEN
    s_iExternalDeviceAlarmCode := 312;        // 312=组框机通讯异常
ELSIF io_stExternal.stUpstream.bRobot_Fault THEN
    s_iExternalDeviceAlarmCode := 320;        // 320=机器人设备故障
ELSIF io_stExternal.stUpstream.bRobot_EStop THEN
    s_iExternalDeviceAlarmCode := 321;        // 321=机器人急停
ELSIF io_stExternal.stUpstream.bUpstreamComFault THEN
    s_iExternalDeviceAlarmCode := 322;        // 322=上游通讯中断(12s超时)
ELSE
    s_iExternalDeviceAlarmCode := 0;          // 0=无报警
END_IF;

io_stExternal.o_iExternalDeviceAlarmSummary := s_iExternalDeviceAlarmCode;
io_stExternal.o_bExternalDeviceFault := (s_iExternalDeviceAlarmCode <> 0);
//#endregion 500_报警汇总

//#region 600_安全综合联锁
IF NOT io_stExternal.i_bFrameMachine_EStop
   AND NOT io_stExternal.stDownstream.bDownstream_EStop
   AND NOT io_stExternal.stDownstream.bDownstream_Fault
   AND NOT io_stExternal.stUpstream.bRobot_EStop
   AND NOT io_stExternal.stUpstream.bRobot_Fault
THEN
    s_bSafetyConditionMet := TRUE;
ELSE
    s_bSafetyConditionMet := FALSE;
END_IF;

io_stExternal.o_bSystemSafetyConditionMet := s_bSafetyConditionMet;
//#endregion 600_安全综合联锁

END_FUNCTION_BLOCK
