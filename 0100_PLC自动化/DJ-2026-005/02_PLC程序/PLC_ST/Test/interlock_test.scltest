// ============================================================================
// interlock_test.scltest - 工站安全联锁与交握信号集成测试 (V1.0.0)
// ============================================================================
// 功能说明：
//   测试 PickPlace (FB_1003) 与 GlueFeeder (FB_1004) 及 ExternalDevice (FB_External)
//   之间的跨工站信号交握与安全区互锁回路。
// ============================================================================

TEST_CASE "TC_Interlock_FeedComplete_To_Feeder"
    // ============================================================================
    // 测试目标：PickPlace 放料完成 → Feeder 接收并触发送料请求
    // ============================================================================
    SET GlobalVars.stPickPlace.o_bPlaceComplete_ToFeeder := TRUE;
    WAIT_CYCLES 2;
    ASSERT GlobalVars.stFeeder.i_bPickPlace_FeedComplete = TRUE; // 断言 Feeder 成功接收上游放料完成信号
END_TEST_CASE

TEST_CASE "TC_Interlock_SafetyZone_Protection"
    // ============================================================================
    // 测试目标：Feeder 安全区信号释放与允许取料交互
    // ============================================================================
    SET GlobalVars.stFeeder.i_bGlueMachine_AllowFeed := TRUE;
    SET GlobalVars.stFeeder.i_bPickPlace_FeedComplete := TRUE;
    WAIT_CYCLES 3;
    ASSERT GlobalVars.stFeeder.o_bSafetyZoneSignal = TRUE;      // 断言安全区信号激活
    ASSERT GlobalVars.stFeeder.o_bAllowPickup = TRUE;          // 断言允许打胶机取料
END_TEST_CASE
