(* ================================================================= *)
(*  功能块名称:FB_2001_CommonAlarm_AllStation                        *)
(*  功能描述:公共报警管理功能块 - 汇总所有工站报警信息                *)
(*  版本号:V4.0.0 (结构体整块传递架构, LSP-905 0-Warn 合规)          *)
(* ================================================================= *)
FUNCTION_BLOCK FB_2001_CommonAlarm_AllStation

VAR_IN_OUT
    io_stGlobal                : ST_CommonAlarm; // 公共报警工站全量数据结构体
END_VAR

VAR
    s_iPrevConveyorAlarm       : INT;
    s_iPrevPickPlaceAlarm      : INT;
    s_iPrevFeederAlarm         : INT;
    s_wPrevGlobalAlarmWord     : WORD;
    s_bConveyorAlarmActive     : BOOL;
    s_bPickPlaceAlarmActive    : BOOL;
    s_bFeederAlarmActive       : BOOL;
    s_iMinAlarmCode            : INT;
    s_iQueueTailIndex          : INT;
    s_bAlarmExistsInQueue      : BOOL;
    s_iQueueScanIndex          : INT;
    s_iAlarmCount              : INT;
    s_bNewAlarmDetected        : BOOL;
    s_bQueueFull               : BOOL;
END_VAR

VAR CONSTANT
    QUEUE_SIZE              : INT := 10;     // 报警队列大小
    QUEUE_MASK              : INT := 9;      // 队列索引掩码 (用于循环队列)
    ALM_NONE                : INT := 0;      // 无报警值
    ALM_WORD_ZERO           : WORD := 0;     // 报警字零值
    ALM_CODE_SAFETY_TIMEOUT : INT := 2009;   // 安全回看看门狗超时报警代码 (STD-860)
    ALM_BIT_SAFETY_TIMEOUT  : WORD := 16#0008; // 报警字第3位: 安全回路看门狗超时
    ALM_CODE_HEARTBEAT_LOST : INT := 2010;   // 外部设备通信心跳丢失报警代码 (STD-860/820)
    ALM_BIT_HEARTBEAT_LOST  : WORD := 16#0010; // 报警字第4位: 外部设备通信心跳丢失
END_VAR

(* -------------------------------------------------------------------------- *)
(* 1. 保存当前输入状态用于下一周期比较                                          *)
(* -------------------------------------------------------------------------- *)
s_iPrevConveyorAlarm := io_stGlobal.i_iConveyorAlarm;
s_iPrevPickPlaceAlarm := io_stGlobal.i_iPickPlaceAlarm;
s_iPrevFeederAlarm := io_stGlobal.i_iFeederAlarm;

(* -------------------------------------------------------------------------- *)
(* 2. 复位处理                                                                *)
(* -------------------------------------------------------------------------- *)
IF io_stGlobal.i_bReset THEN
    io_stGlobal.o_wGlobalAlarmWord := ALM_WORD_ZERO;
    io_stGlobal.o_iCurrentAlarmCode := ALM_NONE;
    io_stGlobal.o_bAnyAlarmActive := FALSE;
    io_stGlobal.o_bNewAlarmFlag := FALSE;
    io_stGlobal.o_iMESAlarmCount := ALM_NONE;
    s_iAlarmCount := ALM_NONE;
    FOR s_iQueueScanIndex := 0 TO QUEUE_MASK DO
        io_stGlobal.o_iMESAlarmQueue[s_iQueueScanIndex] := ALM_NONE;
    END_FOR;
    s_iQueueTailIndex := 0;
    s_bNewAlarmDetected := FALSE;
    s_iMinAlarmCode := ALM_NONE;
    s_wPrevGlobalAlarmWord := ALM_WORD_ZERO;
    s_bQueueFull := FALSE;
    RETURN;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 3. 各工站报警激活状态检测                                                    *)
(* -------------------------------------------------------------------------- *)
s_bConveyorAlarmActive := (io_stGlobal.i_iConveyorAlarm <> ALM_NONE);
s_bPickPlaceAlarmActive := (io_stGlobal.i_iPickPlaceAlarm <> ALM_NONE);
s_bFeederAlarmActive := (io_stGlobal.i_iFeederAlarm <> ALM_NONE);

(* -------------------------------------------------------------------------- *)
(* 4. 全局报警字生成                                                          *)
(*    将各工站报警码按位或组合成全局报警字                                      *)
(* -------------------------------------------------------------------------- *)
io_stGlobal.o_wGlobalAlarmWord := ALM_WORD_ZERO;

IF s_bConveyorAlarmActive THEN
    io_stGlobal.o_wGlobalAlarmWord := io_stGlobal.o_wGlobalAlarmWord OR INT_TO_WORD(io_stGlobal.i_iConveyorAlarm);
END_IF;

IF s_bPickPlaceAlarmActive THEN
    io_stGlobal.o_wGlobalAlarmWord := io_stGlobal.o_wGlobalAlarmWord OR INT_TO_WORD(io_stGlobal.i_iPickPlaceAlarm);
END_IF;

IF s_bFeederAlarmActive THEN
    io_stGlobal.o_wGlobalAlarmWord := io_stGlobal.o_wGlobalAlarmWord OR INT_TO_WORD(io_stGlobal.i_iFeederAlarm);
END_IF;

IF (io_stGlobal.i_iConveyorAlarm = ALM_CODE_SAFETY_TIMEOUT) OR
   (io_stGlobal.i_iPickPlaceAlarm = ALM_CODE_SAFETY_TIMEOUT) OR
   (io_stGlobal.i_iFeederAlarm = ALM_CODE_SAFETY_TIMEOUT) THEN
    io_stGlobal.o_wGlobalAlarmWord := io_stGlobal.o_wGlobalAlarmWord OR ALM_BIT_SAFETY_TIMEOUT;
END_IF;

IF (io_stGlobal.i_iConveyorAlarm = ALM_CODE_HEARTBEAT_LOST) OR
   (io_stGlobal.i_iPickPlaceAlarm = ALM_CODE_HEARTBEAT_LOST) OR
   (io_stGlobal.i_iFeederAlarm = ALM_CODE_HEARTBEAT_LOST) THEN
    io_stGlobal.o_wGlobalAlarmWord := io_stGlobal.o_wGlobalAlarmWord OR ALM_BIT_HEARTBEAT_LOST;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 5. 最高优先级报警码选择                                                      *)
(*    选择最小报警码作为当前最高优先级报警(报警码越小优先级越高)                *)
(* -------------------------------------------------------------------------- *)
s_iMinAlarmCode := ALM_NONE;

IF s_bConveyorAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := io_stGlobal.i_iConveyorAlarm;
    ELSIF io_stGlobal.i_iConveyorAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := io_stGlobal.i_iConveyorAlarm;
    END_IF;
END_IF;

IF s_bPickPlaceAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := io_stGlobal.i_iPickPlaceAlarm;
    ELSIF io_stGlobal.i_iPickPlaceAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := io_stGlobal.i_iPickPlaceAlarm;
    END_IF;
END_IF;

IF s_bFeederAlarmActive THEN
    IF s_iMinAlarmCode = ALM_NONE THEN
        s_iMinAlarmCode := io_stGlobal.i_iFeederAlarm;
    ELSIF io_stGlobal.i_iFeederAlarm < s_iMinAlarmCode THEN
        s_iMinAlarmCode := io_stGlobal.i_iFeederAlarm;
    END_IF;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 6. 输出状态赋值                                                            *)
(* -------------------------------------------------------------------------- *)
io_stGlobal.o_iCurrentAlarmCode := s_iMinAlarmCode;
io_stGlobal.o_bAnyAlarmActive := s_bConveyorAlarmActive OR s_bPickPlaceAlarmActive OR s_bFeederAlarmActive;

io_stGlobal.o_iStationAlarmStatus[1] := io_stGlobal.i_iConveyorAlarm;
io_stGlobal.o_iStationAlarmStatus[2] := io_stGlobal.i_iPickPlaceAlarm;
io_stGlobal.o_iStationAlarmStatus[3] := io_stGlobal.i_iFeederAlarm;

io_stGlobal.o_bConveyorAlarmActive := s_bConveyorAlarmActive;
io_stGlobal.o_bPickPlaceAlarmActive := s_bPickPlaceAlarmActive;
io_stGlobal.o_bFeederAlarmActive := s_bFeederAlarmActive;

(* -------------------------------------------------------------------------- *)
(* 7. 新报警检测(上升沿检测)                                                  *)
(*    只检测报警从无到有的变化,避免报警解除时误触发                            *)
(* -------------------------------------------------------------------------- *)
s_bNewAlarmDetected := FALSE;

IF (io_stGlobal.i_iConveyorAlarm <> ALM_NONE AND s_iPrevConveyorAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;
IF (io_stGlobal.i_iPickPlaceAlarm <> ALM_NONE AND s_iPrevPickPlaceAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;
IF (io_stGlobal.i_iFeederAlarm <> ALM_NONE AND s_iPrevFeederAlarm = ALM_NONE) THEN
    s_bNewAlarmDetected := TRUE;
END_IF;

io_stGlobal.o_bNewAlarmFlag := s_bNewAlarmDetected AND io_stGlobal.o_bAnyAlarmActive;

(* -------------------------------------------------------------------------- *)
(* 8. MES报警队列管理                                                          *)
(*    维护最近10条报警记录,支持去重存储,队列满时自动覆盖最旧记录              *)
(* -------------------------------------------------------------------------- *)
IF s_bNewAlarmDetected THEN
    s_iAlarmCount := s_iAlarmCount + 1;
    io_stGlobal.o_iMESAlarmCount := s_iAlarmCount;
END_IF;

IF io_stGlobal.o_bAnyAlarmActive THEN
    s_bAlarmExistsInQueue := FALSE;

    (* 检查报警码是否已存在于队列中(去重) *)
    FOR s_iQueueScanIndex := 0 TO QUEUE_MASK DO
        IF io_stGlobal.o_iMESAlarmQueue[s_iQueueScanIndex] = io_stGlobal.o_iCurrentAlarmCode THEN
            s_bAlarmExistsInQueue := TRUE;
            EXIT;
        END_IF;
    END_FOR;

    (* 如果报警码不存在于队列中,则加入队列 *)
    IF NOT s_bAlarmExistsInQueue THEN
        io_stGlobal.o_iMESAlarmQueue[s_iQueueTailIndex] := io_stGlobal.o_iCurrentAlarmCode;
        s_iQueueTailIndex := s_iQueueTailIndex + 1;

        (* 循环队列处理 *)
        IF s_iQueueTailIndex > QUEUE_MASK THEN
            s_iQueueTailIndex := 0;
            s_bQueueFull := TRUE;
        ELSE
            s_bQueueFull := FALSE;
        END_IF;
    END_IF;
END_IF;

(* -------------------------------------------------------------------------- *)
(* 9. 保存当前状态用于下一周期比较                                              *)
(* -------------------------------------------------------------------------- *)
s_wPrevGlobalAlarmWord := io_stGlobal.o_wGlobalAlarmWord;

END_FUNCTION_BLOCK