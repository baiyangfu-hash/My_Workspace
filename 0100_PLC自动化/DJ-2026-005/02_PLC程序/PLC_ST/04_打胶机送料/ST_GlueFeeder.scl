(* ================================================================= *)
(*  类型名称：ST_GlueFeeder                                           *)
(*  功能描述：打胶机送料机构(X2台车)交互数据结构体                     *)
(*  创建日期：2026-07-26                                              *)
(*  版本号：V16.0.0 (STD-820 跨机双向安全状态持续监视/运行途中打断)   *)
(*                                                                     *)
(*  遵循规范：                                                         *)
(*    - LSP-905 SCL编程规范                                           *)
(*    - STD-840 设备对象化与接口规范                                  *)
(*    - STD-820 设备间信号交握规范                                   *)
(* ================================================================= *)

TYPE ST_GlueFeeder :
STRUCT
    // === 系统控制输入 ===
    i_bEnable                   : BOOL := FALSE;   // 总使能
    i_bAutoMode                 : BOOL := FALSE;   // 自动模式
    i_bManualMode               : BOOL := FALSE;   // 手动模式
    i_bStart                    : BOOL := FALSE;   // 启动按钮
    i_bStop                     : BOOL := FALSE;   // 停止按钮
    i_bReset                    : BOOL := FALSE;   // 复位按钮

    // === 手动操作输入 ===
    i_bLx_X2Axis_JogFwd         : BOOL := FALSE;   // 手动: X2正向点动 (前往打胶机)
    i_bLx_X2Axis_JogRev         : BOOL := FALSE;   // 手动: X2反向点动 (返回接料位)

    // === 工艺点位与速度参数 ===
    i_rFeedSpeed                : REAL := 120.0;   // X2轴送料速度(mm/s, D600)
    rStandbyPosition            : REAL := 610.0;   // X2待机位置 (D610)
    rPickupPosition             : REAL := 512.0;   // X2接料取片位置 (D512)
    rFeedPosition               : REAL := 522.0;   // X2打胶机放料位置 (D522)
    i_dDebounceMs               : DINT := 100;     // 传感器消抖时间(ms)

    // === 小车台车 4 槽位光电传感器输入 ===
    i_bCartSlotLong1_HasMat     : BOOL := FALSE;   // 小车槽位1(长边1) 有料检测 (X72)
    i_bCartSlotLong2_HasMat     : BOOL := FALSE;   // 小车槽位2(长边2) 有料检测 (X73)
    i_bCartSlotShort1_HasMat    : BOOL := FALSE;   // 小车槽位3(短边1) 有料检测 (X74)
    i_bCartSlotShort2_HasMat    : BOOL := FALSE;   // 小车槽位4(短边2) 有料检测 (X75)

    // === 内部工站交互信号 (来自取放料机构 FB_1003) ===
    i_bAllSlotsFull_FromPickPlace: BOOL := FALSE;  // 4根边框全部集齐全满 (M30)
    i_bPickPlace_FeedComplete   : BOOL := FALSE;   // 单次放料完成脉冲
    i_bPickPlaceInSafetyZone    : BOOL := FALSE;   // 取放料机构在安全区 (Z轴在待机位)

    // === 外部打胶机设备信号 (STD-820 跨机双向安全闭环持续监视) ===
    i_bGlueMachine_AllowFeed    : BOOL := FALSE;   // 打胶机允许送料 (X76: 常态需保持有效)
    i_bGlueMachine_SafetyOk     : BOOL := FALSE;   // 打胶机安全区/就绪状态
    i_bGlueMachine_EStop        : BOOL := FALSE;   // 打胶机急停状态 (TRUE=急停)
    i_bGlueMachine_Fault        : BOOL := FALSE;   // 打胶机故障状态 (TRUE=故障)
    i_bGlueMachine_ComFault     : BOOL := FALSE;   // 打胶机通讯中断 (12s 心跳超时)
    i_bGlueMachine_PickupComplete: BOOL := FALSE;  // 打胶机取料完成信号 (X102)

    // === 对取放料机构的联锁输出 ===
    o_bCartAtPickPos            : BOOL := FALSE;   // 小车在接料位 (到达 D512)
    o_bCartPermitPlace          : BOOL := FALSE;   // 小车允许放料 (处于接料安全状态)

    // === 对打胶机的信号输出 ===
    o_bSafetyZoneSignal         : BOOL := FALSE;   // 给打胶机安全区信号 (Y47)
    o_bAllowPickup              : BOOL := FALSE;   // 抓料可 / 放料请求信号 (Y44)
    o_bFeederInSafetyZone       : BOOL := FALSE;   // 小车处于安全待机区 (未进入打胶机干涉区)

    // === 状态与报警输出 ===
    o_bRunning                  : BOOL := FALSE;   // 自动运行中
    o_bFault                    : BOOL := FALSE;   // 本站故障
    o_bX2Fault                  : BOOL := FALSE;   // X2轴故障
    o_bInterlockStopActive      : BOOL := FALSE;   // 跨机联锁突发中断紧急制动生效
    o_iCurrentState             : INT := 0;        // 当前步序 (D760: 0~3)
    o_rX2Axis_CurrentPosition   : REAL := 0.0;     // X2轴当前位置
    o_iStationAlarmCode         : INT := 0;        // 报警码
END_STRUCT;
END_TYPE
