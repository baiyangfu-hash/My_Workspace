(* ================================================================= *)
(*  功能块名称:FB_1002_SingleLayerConveyor_BufferFraming              *)
(*  功能描述:单层边框分料输送机 - 100%复现三菱源程序(送料分料测试FB) *)
(*  版本号:V14.0.0 (满料防侧翻自动减速 / 单阀双气缸双端全检 / 分级暂停) *)
(*                                                                   *)
(*  遵循规范:                                                        *)
(*    - LSP-905 SCL编程规范                                          *)
(*    - 原始三菱源程序: 04_FB_FUN.pdf (送料分料测试)                 *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1002_SingleLayerConveyor_BufferFraming

VAR_IN_OUT
    io_stLayer                  : ST_SingleLayerConveyor; // 单层输送机全量数据结构体
END_VAR

VAR
    (* 子功能块实例 *)
    fb_Block                    : FB_1011_CylinderControl;  // 阻挡气缸
    fb_Separate                 : FB_1011_CylinderControl;  // 分料气缸
    fb_Motor                    : FB_1012_ConveyorMotor;    // 输送电机

    (* FB_1011 结构体接口 *)
    st_BlockCmd                 : ST_CylinderCmd;
    st_BlockSts                 : ST_CylinderSts;
    st_SeparateCmd              : ST_CylinderCmd;
    st_SeparateSts              : ST_CylinderSts;

    (* 工艺定时器 (DINT 毫秒) *)
    fb_InitTimer                : FB_TONR;   // 10.0s 初始化反转排空定时器 (TIMER_100_FB_M_1)
    s_bInitTimer_In             : BOOL := FALSE;
    s_bInitTimer_Q              : BOOL := FALSE;
    s_bInitTimer_R              : BOOL := FALSE;
    s_dInitTimer_Et             : DINT := 0;

    fb_PreBlockTimer            : FB_TONR;   // 3.0s 阻挡前到位延时定时器 (TIMER_100_FB_M_2, TT0[7]=30)
    s_bPreBlockTimer_In         : BOOL := FALSE;
    s_bPreBlockTimer_Q          : BOOL := FALSE;
    s_bPreBlockTimer_R          : BOOL := FALSE;
    s_dPreBlockTimer_Et         : DINT := 0;

    fb_SlowFeedTimer            : FB_TONR;   // 2.0s 慢速定位到位延时定时器 (TT0[7]=20)
    s_bSlowFeedTimer_In         : BOOL := FALSE;
    s_bSlowFeedTimer_Q          : BOOL := FALSE;
    s_bSlowFeedTimer_R          : BOOL := FALSE;
    s_dSlowFeedTimer_Et         : DINT := 0;

    fb_FullMaterialSlowTimer    : FB_TONR;   // 5.0s 满料防侧翻自动减速延时定时器 (TT0[9]=50)
    s_bFullSlowTimer_In         : BOOL := FALSE;
    s_bFullSlowTimer_Q          : BOOL := FALSE;
    s_bFullSlowTimer_R          : BOOL := FALSE;
    s_dFullSlowTimer_Et         : DINT := 0;

    fb_ReleaseTimer             : FB_TONR;   // 取料完成脱离延时 (有交互 1.0s / 无交互 8.0s, TIMER_100_FB_M_3)
    s_bReleaseTimer_In          : BOOL := FALSE;
    s_bReleaseTimer_Q           : BOOL := FALSE;
    s_bReleaseTimer_R           : BOOL := FALSE;
    s_dReleaseTimer_Et          : DINT := 0;

    (* 内部命令变量 *)
    s_bBlockExtend              : BOOL := FALSE;     // 阻挡气缸下位命令 (TRUE=阻挡下降)
    s_bBlockRetract             : BOOL := FALSE;     // 阻挡气缸上位命令 (TRUE=阻挡升起)
    s_bSeparateExtend           : BOOL := FALSE;     // 分料气缸推出命令 (TRUE=推出分料)
    s_bSeparateRetract          : BOOL := FALSE;     // 分料气缸缩回命令 (TRUE=缩回复位)
    s_bMotorFwd                 : BOOL := FALSE;     // 电机正转命令
    s_bMotorRev                 : BOOL := FALSE;     // 电机反转命令
    s_bMotorSlow                : BOOL := FALSE;     // 电机慢速命令
    s_bFullMaterialSlowActive   : BOOL := FALSE;     // 满料防侧翻自动慢速生效标志

    (* 内部状态与标志 *)
    s_bBlockIsExtended          : BOOL := FALSE;
    s_bBlockIsRetracted         : BOOL := FALSE;
    s_bBlockTimeout             : BOOL := FALSE;
    s_bBlockSensorFault         : BOOL := FALSE;
    s_bSeparateIsExtended       : BOOL := FALSE;
    s_bSeparateIsRetracted      : BOOL := FALSE;
    s_bSeparateTimeout          : BOOL := FALSE;
    s_bSeparateSensorFault      : BOOL := FALSE;
    s_bMotorRunning             : BOOL := FALSE;
    s_bMotorVfdAlarm            : BOOL := FALSE;

    (* 状态机变量 *)
    s_iCurrentState             : INT := 0;          // Step_S 步序 (0, 1, 2, 10, 20, 30, 50, 60, 70, 80)
    s_bStepEntry                : BOOL := TRUE;
    s_bRunning                  : BOOL := FALSE;
    s_bInitDone                 : BOOL := FALSE;     // 准备完成
    s_bRequestPickup            : BOOL := FALSE;     // 请求取料
    s_iAlarmCode                : INT := 0;

    (* 传感器综合标志 (单阀双气缸双端冗余) *)
    s_bBlockAllUp               : BOOL := FALSE;
    s_bBlockAllDown             : BOOL := FALSE;
    s_bSeparateAllUp            : BOOL := FALSE;
    s_bSeparateAllDown          : BOOL := FALSE;

    (* 工艺参数预设缓存 (DINT) *)
    s_dInitRevDurationMs        : DINT := 10000;     // 10s
    s_dPreBlockDelayMs          : DINT := 3000;      // 3s
    s_dSlowFeedDelayMs          : DINT := 2000;      // 2s
    s_dFullMaterialDelayMs      : DINT := 5000;      // 5s
    s_dSeparateTimeoutMs        : DINT := 5000;      // 5s
END_VAR

VAR CONSTANT
    STEP_0_IDLE                 : INT := 0;   // 待机与模式分支
    STEP_1_INIT_CHECK           : INT := 1;   // 初始化状态判断 (阻挡下/分料上，安全区检查)
    STEP_2_INIT_REVERSE         : INT := 2;   // 10.0s 输送线反转退料排空
    STEP_10_AUTO_START          : INT := 10;  // 自动启动，高速正转
    STEP_20_PRE_BLOCK_WAIT      : INT := 20;  // 阻挡前到位，3.0s 输送延时
    STEP_30_SEPARATE_PUSH       : INT := 30;  // 分料气缸推出
    STEP_50_BLOCK_DOWN          : INT := 50;  // 取料位无料，阻挡气缸下降
    STEP_60_SLOW_FEED           : INT := 60;  // 安全区确认，慢速送料，2.0s 到位延时
    STEP_70_REQUEST_PICKUP      : INT := 70;  // 阻挡升起，请求取料
    STEP_80_PICKUP_DONE         : INT := 80;  // 取料完成脱离延时 (1s/8s)
END_VAR

(* ==================== 1. 工艺参数初始化与更新 ==================== *)
IF io_stLayer.dInitRevDurationMs > 0 THEN s_dInitRevDurationMs := io_stLayer.dInitRevDurationMs; ELSE s_dInitRevDurationMs := 10000; END_IF;
IF io_stLayer.dPreBlockDelayMs > 0 THEN s_dPreBlockDelayMs := io_stLayer.dPreBlockDelayMs; ELSE s_dPreBlockDelayMs := 3000; END_IF;
IF io_stLayer.dSlowFeedDelayMs > 0 THEN s_dSlowFeedDelayMs := io_stLayer.dSlowFeedDelayMs; ELSE s_dSlowFeedDelayMs := 2000; END_IF;
IF io_stLayer.dFullMaterialDelayMs > 0 THEN s_dFullMaterialDelayMs := io_stLayer.dFullMaterialDelayMs; ELSE s_dFullMaterialDelayMs := 5000; END_IF;
IF io_stLayer.dSeparateTimeoutMs > 0 THEN s_dSeparateTimeoutMs := io_stLayer.dSeparateTimeoutMs; ELSE s_dSeparateTimeoutMs := 5000; END_IF;

(* ==================== 2. 双端传感器冗余采集 ==================== *)
// 阻挡单阀双气缸双端传感器综合判断
IF io_stLayer.bBlockCylinderUp1 OR io_stLayer.bBlockCylinderUp2 THEN
    s_bBlockAllUp := io_stLayer.bBlockCylinderUp1 AND io_stLayer.bBlockCylinderUp2;
ELSIF io_stLayer.bBlockCylinderUp THEN
    s_bBlockAllUp := io_stLayer.bBlockCylinderUp;
ELSE
    s_bBlockAllUp := FALSE;
END_IF;

IF io_stLayer.bBlockCylinderDown1 OR io_stLayer.bBlockCylinderDown2 THEN
    s_bBlockAllDown := io_stLayer.bBlockCylinderDown1 AND io_stLayer.bBlockCylinderDown2;
ELSIF io_stLayer.bBlockCylinderDown THEN
    s_bBlockAllDown := io_stLayer.bBlockCylinderDown;
ELSE
    s_bBlockAllDown := FALSE;
END_IF;

// 分料单阀双气缸双端传感器综合判断
IF io_stLayer.bSeparateCylinderUp1 OR io_stLayer.bSeparateCylinderUp2 THEN
    s_bSeparateAllUp := io_stLayer.bSeparateCylinderUp1 AND io_stLayer.bSeparateCylinderUp2;
ELSIF io_stLayer.bSeparateCylinderUp THEN
    s_bSeparateAllUp := io_stLayer.bSeparateCylinderUp;
ELSE
    s_bSeparateAllUp := FALSE;
END_IF;

IF io_stLayer.bSeparateCylinderDown1 OR io_stLayer.bSeparateCylinderDown2 THEN
    s_bSeparateAllDown := io_stLayer.bSeparateCylinderDown1 AND io_stLayer.bSeparateCylinderDown2;
ELSIF io_stLayer.bSeparateCylinderDown THEN
    s_bSeparateAllDown := io_stLayer.bSeparateCylinderDown;
ELSE
    s_bSeparateAllDown := FALSE;
END_IF;

(* ==================== 3. 定时器统一实例化调用 ==================== *)
fb_InitTimer(IN := s_bInitTimer_In, PT := s_dInitRevDurationMs, R := s_bInitTimer_R, Q => s_bInitTimer_Q, ET => s_dInitTimer_Et);
fb_PreBlockTimer(IN := s_bPreBlockTimer_In, PT := s_dPreBlockDelayMs, R := s_bPreBlockTimer_R, Q => s_bPreBlockTimer_Q, ET => s_dPreBlockTimer_Et);
fb_SlowFeedTimer(IN := s_bSlowFeedTimer_In, PT := s_dSlowFeedDelayMs, R := s_bSlowFeedTimer_R, Q => s_bSlowFeedTimer_Q, ET => s_dSlowFeedTimer_Et);
fb_FullMaterialSlowTimer(IN := s_bFullSlowTimer_In, PT := s_dFullMaterialDelayMs, R := s_bFullSlowTimer_R, Q => s_bFullSlowTimer_Q, ET => s_dFullSlowTimer_Et);

// 取料脱离延时：有外部取料完成握手为 1000ms，否则为 8000ms
fb_ReleaseTimer(
    IN := s_bReleaseTimer_In,
    PT := SEL(io_stLayer.bPickupConfirmed, 8000, 1000),
    R  := s_bReleaseTimer_R,
    Q  => s_bReleaseTimer_Q,
    ET => s_dReleaseTimer_Et
);

(* ==================== 4. 满料防侧翻自动减速逻辑 ==================== *)
// L型角铁边框在料仓后方满料贴紧时，正转运行5s后触发自动慢速，防止挤压侧翻
IF io_stLayer.bFullMaterial1 AND io_stLayer.bFullMaterial2 AND (s_bMotorFwd OR s_bMotorSlow) THEN
    s_bFullSlowTimer_In := TRUE;
    s_bFullSlowTimer_R  := FALSE;
ELSE
    s_bFullSlowTimer_In := FALSE;
    s_bFullSlowTimer_R  := TRUE;
END_IF;
s_bFullMaterialSlowActive := s_bFullSlowTimer_Q;

(* ==================== 5. 模式与安全使能检查 ==================== *)
IF NOT io_stLayer.bAutoMode AND NOT io_stLayer.bManualMode THEN
    s_bBlockExtend := FALSE;
    s_bBlockRetract := FALSE;
    s_bSeparateExtend := FALSE;
    s_bSeparateRetract := FALSE;
    s_bMotorFwd := FALSE;
    s_bMotorRev := FALSE;
    s_bMotorSlow := FALSE;

    s_bInitTimer_In := FALSE; s_bInitTimer_R := TRUE;
    s_bPreBlockTimer_In := FALSE; s_bPreBlockTimer_R := TRUE;
    s_bSlowFeedTimer_In := FALSE; s_bSlowFeedTimer_R := TRUE;
    s_bReleaseTimer_In := FALSE; s_bReleaseTimer_R := TRUE;

    s_iCurrentState := STEP_0_IDLE;
    s_bRunning := FALSE;
    s_bInitDone := FALSE;
    s_bRequestPickup := FALSE;
    s_iAlarmCode := 0;

    io_stLayer.q_bBlockSolenoid      := FALSE;
    io_stLayer.q_bSeparateSolenoid   := FALSE;
    io_stLayer.q_bConveyorFwd        := FALSE;
    io_stLayer.q_bConveyorRev        := FALSE;
    io_stLayer.q_bConveyorSlow       := FALSE;
    io_stLayer.q_bInitDone           := s_bInitDone;
    io_stLayer.q_bRequestPickup      := s_bRequestPickup;
    io_stLayer.q_bLayerFeedDone      := s_bRequestPickup;
    io_stLayer.q_iCurrentState       := s_iCurrentState;
    io_stLayer.q_iAlarmCode          := s_iAlarmCode;
    io_stLayer.q_bRunning            := s_bRunning;
    io_stLayer.q_bFault              := FALSE;
    io_stLayer.q_bAnySensorFault     := FALSE;
    RETURN;
END_IF;

(* ==================== 6. 停机处理 (电平有效, 步序清零复位) ==================== *)
IF (io_stLayer.bStop AND s_bRunning) OR (NOT io_stLayer.bSafetyDoorOk AND s_bRunning) THEN
    s_iCurrentState := STEP_0_IDLE;
    s_bRunning := FALSE;
    s_bStepEntry := TRUE;

    s_bBlockExtend := FALSE;
    s_bBlockRetract := TRUE;
    s_bSeparateExtend := FALSE;
    s_bSeparateRetract := TRUE;
    s_bMotorFwd := FALSE;
    s_bMotorRev := FALSE;
    s_bMotorSlow := FALSE;

    s_bInitTimer_In := FALSE; s_bInitTimer_R := TRUE;
    s_bPreBlockTimer_In := FALSE; s_bPreBlockTimer_R := TRUE;
    s_bSlowFeedTimer_In := FALSE; s_bSlowFeedTimer_R := TRUE;
    s_bReleaseTimer_In := FALSE; s_bReleaseTimer_R := TRUE;
    s_bRequestPickup := FALSE;
END_IF;

(* ==================== 7. 自动工艺状态机 (对齐三菱源程序) ==================== *)
IF io_stLayer.bAutoMode THEN

    IF io_stLayer.bVfdFault THEN
        s_bMotorFwd := FALSE;
        s_bMotorRev := FALSE;
        s_bMotorSlow := FALSE;
        s_iAlarmCode := 100 + io_stLayer.iLayerIndex;
    END_IF;

    CASE s_iCurrentState OF

        STEP_0_IDLE: (* 0 - 初始化分支与自动待机 *)
            s_bRequestPickup := FALSE;
            s_bInitTimer_In := FALSE; s_bInitTimer_R := TRUE;
            s_bPreBlockTimer_In := FALSE; s_bPreBlockTimer_R := TRUE;
            s_bSlowFeedTimer_In := FALSE; s_bSlowFeedTimer_R := TRUE;
            s_bReleaseTimer_In := FALSE; s_bReleaseTimer_R := TRUE;

            // 分支 1: 未初始化时请求初始化，或触发退料
            IF (io_stLayer.bInitStart AND NOT s_bInitDone) OR (NOT io_stLayer.bStart AND io_stLayer.bInitStart) THEN
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_1_INIT_CHECK;

            // 分支 2: 准备完成 + 启动 + 机械手在安全区 ➔ 自动进入运行
            ELSIF io_stLayer.bStart AND s_bInitDone AND io_stLayer.bRobotInSafetyPos THEN
                s_bRunning := TRUE;
                s_bStepEntry := TRUE;

                // 若取料位无料 ➔ 正转进料 (Step 10)；若取料位已有料 ➔ 直接进入慢速就绪 (Step 60)
                IF NOT io_stLayer.bPositionSensor1 AND NOT io_stLayer.bPositionSensor2 THEN
                    s_iCurrentState := STEP_10_AUTO_START;
                ELSE
                    s_iCurrentState := STEP_60_SLOW_FEED;
                END_IF;
            END_IF;

        STEP_1_INIT_CHECK: (* 1 - 状态判断: 阻挡下降、分料缩回，安全区检查 *)
            IF s_bStepEntry THEN
                s_bBlockExtend := TRUE;       // 阻挡下降打开通道
                s_bBlockRetract := FALSE;
                s_bSeparateExtend := FALSE;   // 分料气缸缩回
                s_bSeparateRetract := TRUE;
                s_bStepEntry := FALSE;
            END_IF;

            // 必须确认: 取料机构在安全区 + 分料气缸上位确认 + 阻挡气缸下位确认
            IF io_stLayer.bRobotInSafetyPos THEN
                IF s_bSeparateAllUp AND s_bBlockAllDown THEN
                    s_bStepEntry := TRUE;
                    s_iCurrentState := STEP_2_INIT_REVERSE;
                END_IF;
            END_IF;

        STEP_2_INIT_REVERSE: (* 2 - 初始化反转排空 10.0s *)
            IF s_bStepEntry THEN
                s_bMotorRev := TRUE;
                s_bMotorSlow := FALSE;
                s_bMotorFwd := FALSE;
                s_bInitTimer_In := TRUE;
                s_bInitTimer_R := FALSE;
                s_bStepEntry := FALSE;
            END_IF;

            // 10s 计时完成
            IF s_bInitTimer_Q THEN
                s_bMotorRev := FALSE;
                s_bInitTimer_In := FALSE;
                s_bInitTimer_R := TRUE;
                s_bInitDone := TRUE;          // 准备完成
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_0_IDLE; // 返回 0 步待机
            END_IF;

        STEP_10_AUTO_START: (* 10 - 自动启动: 阻挡升起，输送正转运行 *)
            s_bRequestPickup := FALSE;
            IF s_bStepEntry THEN
                s_bBlockExtend := FALSE;
                s_bBlockRetract := TRUE;      // 阻挡升起
                s_bSeparateExtend := FALSE;
                s_bSeparateRetract := TRUE;   // 分料缩回
                s_bStepEntry := FALSE;
            END_IF;

            IF io_stLayer.bRobotInSafetyPos THEN
                IF s_bBlockAllUp AND s_bSeparateAllUp THEN
                    s_bMotorFwd := TRUE;      // 输送快速正转
                    s_bMotorSlow := FALSE;
                    s_bMotorRev := FALSE;
                    s_bStepEntry := TRUE;
                    s_iCurrentState := STEP_20_PRE_BLOCK_WAIT;
                END_IF;
            END_IF;

        STEP_20_PRE_BLOCK_WAIT: (* 20 - 阻挡前到位 + 3.0s 延时输送 *)
            IF s_bStepEntry THEN
                s_bPreBlockTimer_In := FALSE;
                s_bPreBlockTimer_R := TRUE;
                s_bStepEntry := FALSE;
            END_IF;

            // 阻挡前到位传感器感应到边框
            IF io_stLayer.bPreSeparateSensor THEN
                s_bPreBlockTimer_In := TRUE;
                s_bPreBlockTimer_R := FALSE;
            END_IF;

            // 3.0s 输送延时完成
            IF s_bPreBlockTimer_Q THEN
                s_bMotorFwd := FALSE;         // 输送线停止
                s_bPreBlockTimer_In := FALSE;
                s_bPreBlockTimer_R := TRUE;
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_30_SEPARATE_PUSH;
            END_IF;

        STEP_30_SEPARATE_PUSH: (* 30 - 分料气缸动作推出 *)
            IF s_bStepEntry THEN
                s_bSeparateExtend := TRUE;    // 分料气缸推出
                s_bSeparateRetract := FALSE;
                s_bStepEntry := FALSE;
            END_IF;

            // 分料气缸推出到位 (下位)
            IF s_bSeparateAllDown THEN
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_50_BLOCK_DOWN;
            END_IF;

        STEP_50_BLOCK_DOWN: (* 50 - 取料位无料，阻挡气缸下降 *)
            IF s_bStepEntry THEN
                s_bStepEntry := FALSE;
            END_IF;

            // 确认取料位无料且阻挡前有料
            IF NOT io_stLayer.bPositionSensor1 AND NOT io_stLayer.bPositionSensor2 AND io_stLayer.bPreSeparateSensor THEN
                s_bBlockExtend := TRUE;       // 阻挡气缸下降
                s_bBlockRetract := FALSE;

                // 阻挡气缸下降到位
                IF s_bBlockAllDown THEN
                    s_bStepEntry := TRUE;
                    s_iCurrentState := STEP_60_SLOW_FEED;
                END_IF;
            END_IF;

        STEP_60_SLOW_FEED: (* 60 - 输送慢行送料到取料工位 + 2.0s 延时 *)
            IF s_bStepEntry THEN
                s_bSlowFeedTimer_In := FALSE;
                s_bSlowFeedTimer_R := TRUE;
                s_bStepEntry := FALSE;
            END_IF;

            IF io_stLayer.bRobotInSafetyPos THEN
                s_bMotorFwd := TRUE;

                // 边框触碰到取料位接近开关 1 & 2
                IF io_stLayer.bPositionSensor1 AND io_stLayer.bPositionSensor2 THEN
                    s_bMotorSlow := TRUE;     // 切慢速
                    s_bSlowFeedTimer_In := TRUE;
                    s_bSlowFeedTimer_R := FALSE;
                ELSE
                    s_bMotorSlow := FALSE;
                END_IF;
            ELSE
                s_bMotorFwd := FALSE;
                s_bMotorSlow := FALSE;
                s_bSlowFeedTimer_In := FALSE;
                s_bSlowFeedTimer_R := TRUE;
            END_IF;

            // 2.0s 慢速送料到位延时完成
            IF s_bSlowFeedTimer_Q THEN
                s_bMotorFwd := FALSE;
                s_bMotorSlow := FALSE;
                s_bSlowFeedTimer_In := FALSE;
                s_bSlowFeedTimer_R := TRUE;
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_70_REQUEST_PICKUP;
            END_IF;

        STEP_70_REQUEST_PICKUP: (* 70 - 阻挡升起，物料到位，请求取料 *)
            IF s_bStepEntry THEN
                s_bBlockExtend := FALSE;
                s_bBlockRetract := TRUE;      // 阻挡气缸升起
                s_bStepEntry := FALSE;
            END_IF;

            // 接近开关到位 + 阻挡升起 + 电机已停 ➔ 发出请求取料
            IF io_stLayer.bPositionSensor1 AND io_stLayer.bPositionSensor2 AND s_bBlockAllUp AND (NOT s_bMotorFwd) THEN
                s_bRequestPickup := TRUE;     // 请求取料 := 1
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_80_PICKUP_DONE;
            END_IF;

        STEP_80_PICKUP_DONE: (* 80 - 取料完成脱离检测 (1.0s / 8.0s) *)
            IF s_bStepEntry THEN
                s_bReleaseTimer_In := FALSE;
                s_bReleaseTimer_R := TRUE;
                s_bStepEntry := FALSE;
            END_IF;

            // 取料位接近开关全部脱离 (物料已被夹起/移走)
            IF NOT io_stLayer.bPositionSensor1 AND NOT io_stLayer.bPositionSensor2 THEN
                s_bReleaseTimer_In := TRUE;
                s_bReleaseTimer_R := FALSE;
            ELSE
                s_bReleaseTimer_In := FALSE;
                s_bReleaseTimer_R := TRUE;
            END_IF;

            // 脱离延时到达 ➔ 分料气缸缩回复位，重置请求，跳回 Step 10
            IF s_bReleaseTimer_Q THEN
                s_bReleaseTimer_In := FALSE;
                s_bReleaseTimer_R := TRUE;
                s_bSeparateExtend := FALSE;
                s_bSeparateRetract := TRUE;   // 分料缩回复位
                s_bRequestPickup := FALSE;
                s_bStepEntry := TRUE;
                s_iCurrentState := STEP_10_AUTO_START; // 开始下一循环
            END_IF;

        ELSE
            s_iCurrentState := STEP_0_IDLE;
            s_bRunning := FALSE;
    END_CASE;

ELSIF io_stLayer.bManualMode THEN
    (* ==================== 8. 手动模式 ==================== *)
    s_bRunning := FALSE;
    s_iCurrentState := STEP_0_IDLE;
    s_bStepEntry := TRUE;
    s_bRequestPickup := FALSE;

    s_bBlockExtend := io_stLayer.bManBlockExtend;
    s_bBlockRetract := io_stLayer.bManBlockRetract AND NOT io_stLayer.bManBlockExtend;

    s_bSeparateExtend := io_stLayer.bManSeparatePush;
    s_bSeparateRetract := NOT io_stLayer.bManSeparatePush;

    s_bMotorFwd := io_stLayer.bManConveyorFwd;
    s_bMotorRev := io_stLayer.bManConveyorRev;
    s_bMotorSlow := io_stLayer.bManConveyorSlow;

END_IF;

(* ==================== 9. 调用标准子 FB (气缸/电机) ==================== *)
st_BlockCmd.Extend := s_bBlockExtend;
st_BlockCmd.Retract := s_bBlockRetract;
st_BlockCmd.ExtendedPos := s_bBlockAllDown;
st_BlockCmd.RetractedPos := s_bBlockAllUp;
st_BlockCmd.TimeoutMs := s_dSeparateTimeoutMs;
st_BlockCmd.DebounceMs := io_stLayer.dDebounceMs;
st_BlockCmd.SolenoidType := INT#0;
st_BlockCmd.ExtendPolarity := FALSE;
IF io_stLayer.bAutoMode THEN st_BlockCmd.Mode := INT#1; ELSE st_BlockCmd.Mode := INT#0; END_IF;
fb_Block(i_stCmd := st_BlockCmd, q_stSts => st_BlockSts);
io_stLayer.q_bBlockSolenoid := st_BlockSts.SolenoidA;
s_bBlockIsExtended := st_BlockSts.IsExtended;
s_bBlockIsRetracted := st_BlockSts.IsRetracted;
s_bBlockTimeout := st_BlockSts.Timeout;
s_bBlockSensorFault := st_BlockSts.SensorFault;

st_SeparateCmd.Extend := s_bSeparateExtend;
st_SeparateCmd.Retract := s_bSeparateRetract;
st_SeparateCmd.ExtendedPos := s_bSeparateAllDown;
st_SeparateCmd.RetractedPos := s_bSeparateAllUp;
st_SeparateCmd.TimeoutMs := s_dSeparateTimeoutMs;
st_SeparateCmd.DebounceMs := io_stLayer.dDebounceMs;
st_SeparateCmd.SolenoidType := INT#0;
st_SeparateCmd.ExtendPolarity := FALSE;
IF io_stLayer.bAutoMode THEN st_SeparateCmd.Mode := INT#1; ELSE st_SeparateCmd.Mode := INT#0; END_IF;
fb_Separate(i_stCmd := st_SeparateCmd, q_stSts => st_SeparateSts);
io_stLayer.q_bSeparateSolenoid := st_SeparateSts.SolenoidA;
s_bSeparateIsExtended := st_SeparateSts.IsExtended;
s_bSeparateIsRetracted := st_SeparateSts.IsRetracted;
s_bSeparateTimeout := st_SeparateSts.Timeout;
s_bSeparateSensorFault := st_SeparateSts.SensorFault;

// 电机运行信号：受 bPause 暂停联锁控制
fb_Motor(
    i_bFwdCmd := s_bMotorFwd AND (NOT io_stLayer.bPause),
    i_bRevCmd := s_bMotorRev AND (NOT io_stLayer.bPause),
    i_bSlowCmd := (s_bMotorSlow OR s_bFullMaterialSlowActive) AND (NOT io_stLayer.bPause),
    i_bVfdFault := io_stLayer.bVfdFault,
    i_iCtrlMode := INT#0,
    i_rSpeed := REAL#100.0,
    q_bFwdOut => io_stLayer.q_bConveyorFwd,
    q_bRevOut => io_stLayer.q_bConveyorRev,
    q_bSlowOut => io_stLayer.q_bConveyorSlow,
    q_bRunning => s_bMotorRunning,
    q_bVfdAlarm => s_bMotorVfdAlarm
);

(* ==================== 10. 报警汇总 ==================== *)
s_iAlarmCode := 0;
IF s_bMotorVfdAlarm THEN s_iAlarmCode := 100 + io_stLayer.iLayerIndex; END_IF;
IF s_bBlockTimeout THEN s_iAlarmCode := 110 + io_stLayer.iLayerIndex; END_IF;
IF s_bBlockSensorFault AND s_iAlarmCode = 0 THEN s_iAlarmCode := 120 + io_stLayer.iLayerIndex; END_IF;
IF s_bSeparateTimeout AND s_iAlarmCode = 0 THEN s_iAlarmCode := 130 + io_stLayer.iLayerIndex; END_IF;
IF s_bSeparateSensorFault AND s_iAlarmCode = 0 THEN s_iAlarmCode := 140 + io_stLayer.iLayerIndex; END_IF;

(* ==================== 11. 输出结构体映射 ==================== *)
io_stLayer.q_bInitDone           := s_bInitDone;
io_stLayer.q_bRequestPickup      := s_bRequestPickup;
io_stLayer.q_bLayerFeedDone      := s_bRequestPickup;
io_stLayer.q_iCurrentState       := s_iCurrentState;
io_stLayer.q_iAlarmCode          := s_iAlarmCode;
io_stLayer.q_bRunning            := s_bRunning;
io_stLayer.q_bFault              := (s_iAlarmCode > 0);
io_stLayer.q_bAnySensorFault     := s_bBlockSensorFault OR s_bSeparateSensorFault;

END_FUNCTION_BLOCK