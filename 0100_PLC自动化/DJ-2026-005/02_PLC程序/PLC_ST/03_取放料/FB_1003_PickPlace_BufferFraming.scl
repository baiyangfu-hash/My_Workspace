(* ================================================================= *)
(*  功能块名称:FB_1003_PickPlace_BufferFraming                        *)
(*  功能描述:取放料搬运机构 - 伺服+辅助升降气缸/小车4槽位调度/10组配方 *)
(*  版本号:V15.0.0 (辅助升降气缸高度补偿 / 小车纯4卡槽光电无气缸)     *)
(*                                                                   *)
(*  遵循规范:                                                        *)
(*    - LSP-905 SCL编程规范                                          *)
(*    - STD-840 设备对象化与接口规范                                  *)
(*    - 原始三菱源程序: 01_梯形图.pdf (S20~S25 STL 状态机)           *)
(* ================================================================= *)

FUNCTION_BLOCK FB_1003_PickPlace_BufferFraming

VAR_IN_OUT
    io_stPickPlace              : ST_PickPlace;        // 取放料机构数据结构体
    io_stRecipe                 : ST_RecipeManager;    // 10组配方管理器与当前生效配方
    io_stZAxis                  : ST_ServoAxis;        // Z轴升降伺服 (对象化标准接口)
    io_stX1Axis                 : ST_ServoAxis;        // X1轴横移伺服 (对象化标准接口)
END_VAR

VAR
    (* 工艺定时器 (三段式 DINT 毫秒) *)
    fb_LiftTimer                : FB_TONR;   // 辅助升降气缸与Z轴动作超时定时器
    s_bLiftTimer_In             : BOOL := FALSE;
    s_bLiftTimer_Q              : BOOL := FALSE;
    s_bLiftTimer_R              : BOOL := FALSE;
    s_dLiftTimer_Et             : DINT := 0;

    fb_ClampTimer               : FB_TONR;   // 夹紧确认定时器
    s_bClampTimer_In            : BOOL := FALSE;
    s_bClampTimer_Q             : BOOL := FALSE;
    s_bClampTimer_R             : BOOL := FALSE;
    s_dClampTimer_Et            : DINT := 0;

    fb_UnclampTimer             : FB_TONR;   // 松开确认定时器
    s_bUnclampTimer_In          : BOOL := FALSE;
    s_bUnclampTimer_Q           : BOOL := FALSE;
    s_bUnclampTimer_R           : BOOL := FALSE;
    s_dUnclampTimer_Et          : DINT := 0;

    (* 内部夹爪与辅助升降气缸命令 (Y42/Y43 / Y40/Y41) *)
    s_bFrontClamp               : BOOL := FALSE;
    s_bRearClamp                : BOOL := FALSE;
    s_bFrontClamp2              : BOOL := FALSE;
    s_bRearClamp2               : BOOL := FALSE;
    s_bLiftUp                   : BOOL := FALSE;     // Y42 气缸上升 (高度补偿)
    s_bLiftDown                 : BOOL := TRUE;      // Y43 气缸下降 (放料/待机复位)

    (* 状态机变量 *)
    s_iCurrentState             : INT := 0;          // STL 步序 (20, 21, 22, 23, 24, 25)
    s_bStepEntry                : BOOL := TRUE;
    s_bRunning                  : BOOL := FALSE;
    s_bStartTriggered           : BOOL := FALSE;
    s_iPickLayer                : INT := 0;          // 当前锁定的取料层 (1..4)
    s_iTargetSlot               : INT := 0;          // 当前锁定的小车卡槽 (1..4: 长1/长2/短1/短2)
    s_iAlarmCode                : INT := 0;

    (* 对外通知标志 *)
    s_bPlaceDoneToCart          : BOOL := FALSE;
    s_bAllSlotsFull             : BOOL := FALSE;
    s_bSensorFault              : BOOL := FALSE;
    s_bProductMissing           : BOOL := FALSE;
    s_bX1Fault                  : BOOL := FALSE;
    s_bZFault                   : BOOL := FALSE;

    (* 工艺参数预设 *)
    s_dLiftTimeoutMs            : DINT := 3000;
    s_dClampConfirmMs           : DINT := 800;
    s_dUnclampConfirmMs         : DINT := 600;
END_VAR

VAR CONSTANT
    S20_IDLE                    : INT := 20;  // 待机与小车4卡槽供需调度 (升降气缸下位X71)
    S21_UP_TO_PICK              : INT := 21;  // Z轴上升+辅助升降气缸上升(Y42)至取料高度
    S22_CLAMP_AND_DETECT        : INT := 22;  // 4夹爪夹紧 + 4路光电工件检测
    S23_MOVE_TO_SLOT            : INT := 23;  // X1轴横移至小车对应卡槽放料点
    S24_DOWN_TO_PLACE           : INT := 24;  // Z轴下降+升降气缸下降(Y43)放料 + 发出取料完成信号
    S25_UNCLAMP_AND_NOTIFY      : INT := 25;  // 4夹爪松开 + 小车满料判定与通知
END_VAR

(* ==================== 1. 配方管理与参数加载 ==================== *)
IF io_stRecipe.bRecipeLoadReq THEN
    IF io_stRecipe.iActiveRecipeId >= 1 AND io_stRecipe.iActiveRecipeId <= 10 THEN
        io_stRecipe.stActiveRecipe := io_stRecipe.astRecipes[io_stRecipe.iActiveRecipeId];
    END_IF;
    io_stRecipe.bRecipeLoadReq := FALSE;
END_IF;

IF io_stRecipe.bRecipeSaveReq THEN
    IF io_stRecipe.iActiveRecipeId >= 1 AND io_stRecipe.iActiveRecipeId <= 10 THEN
        io_stRecipe.astRecipes[io_stRecipe.iActiveRecipeId] := io_stRecipe.stActiveRecipe;
    END_IF;
    io_stRecipe.bRecipeSaveReq := FALSE;
END_IF;

// 超时参数装载
IF io_stRecipe.stActiveRecipe.iLiftActionTimeMs > 0 THEN
    s_dLiftTimeoutMs := INT_TO_DINT(io_stRecipe.stActiveRecipe.iLiftActionTimeMs);
ELSE
    s_dLiftTimeoutMs := 3000;
END_IF;

IF io_stRecipe.stActiveRecipe.iClampConfirmTimeMs > 0 THEN
    s_dClampConfirmMs := INT_TO_DINT(io_stRecipe.stActiveRecipe.iClampConfirmTimeMs);
ELSE
    s_dClampConfirmMs := 800;
END_IF;

(* ==================== 2. 定时器统一实例化调用 ==================== *)
fb_LiftTimer(IN := s_bLiftTimer_In, PT := s_dLiftTimeoutMs, R := s_bLiftTimer_R, Q => s_bLiftTimer_Q, ET => s_dLiftTimer_Et);
fb_ClampTimer(IN := s_bClampTimer_In, PT := s_dClampConfirmMs, R := s_bClampTimer_R, Q => s_bClampTimer_Q, ET => s_dClampTimer_Et);
fb_UnclampTimer(IN := s_bUnclampTimer_In, PT := s_dUnclampConfirmMs, R := s_bUnclampTimer_R, Q => s_bUnclampTimer_Q, ET => s_dUnclampTimer_Et);

(* ==================== 3. 安全区判定 ==================== *)
// 取放料机构在安全区：待机位或仅在横移中，且升降气缸在下位 (X71)
io_stPickPlace.o_bPickPlaceInSafetyZone := (s_iCurrentState = S20_IDLE) OR (s_iCurrentState = S23_MOVE_TO_SLOT);

(* ==================== 4. 模式与使能检查 ==================== *)
IF NOT io_stPickPlace.i_bAutoMode AND NOT io_stPickPlace.i_bManualMode THEN
    s_bFrontClamp := FALSE; s_bRearClamp := FALSE;
    s_bFrontClamp2 := FALSE; s_bRearClamp2 := FALSE;
    s_bLiftUp := FALSE; s_bLiftDown := TRUE;

    s_bLiftTimer_In := FALSE; s_bLiftTimer_R := TRUE;
    s_bClampTimer_In := FALSE; s_bClampTimer_R := TRUE;
    s_bUnclampTimer_In := FALSE; s_bUnclampTimer_R := TRUE;

    s_iCurrentState := S20_IDLE;
    s_bRunning := FALSE;
    s_bStartTriggered := FALSE;
    s_bStepEntry := TRUE;
    s_iAlarmCode := 0;
    RETURN;
END_IF;

(* ==================== 5. 停止处理 ==================== *)
IF io_stPickPlace.i_bStop AND s_bRunning THEN
    s_iCurrentState := S20_IDLE;
    s_bRunning := FALSE;
    s_bStepEntry := TRUE;

    s_bFrontClamp := FALSE; s_bRearClamp := FALSE;
    s_bFrontClamp2 := FALSE; s_bRearClamp2 := FALSE;
    s_bLiftUp := FALSE; s_bLiftDown := TRUE;

    io_stZAxis.stStop.Execute := TRUE;
    io_stX1Axis.stStop.Execute := TRUE;
    io_stZAxis.stAbs.Execute := FALSE;
    io_stX1Axis.stAbs.Execute := FALSE;

    s_bPlaceDoneToCart := FALSE;
    s_bLiftTimer_In := FALSE; s_bLiftTimer_R := TRUE;
    s_bClampTimer_In := FALSE; s_bClampTimer_R := TRUE;
    s_bUnclampTimer_In := FALSE; s_bUnclampTimer_R := TRUE;
END_IF;

(* ==================== 6. 自动状态机 (小车4卡槽智能调度) ==================== *)
IF io_stPickPlace.i_bAutoMode THEN

    IF io_stPickPlace.i_bStart AND NOT s_bStartTriggered THEN
        s_bStartTriggered := TRUE;
    END_IF;

    // 小车 4 卡槽是否已全部集齐全满 (M30)
    s_bAllSlotsFull := io_stPickPlace.i_bCartSlotLong1_HasMat AND
                       io_stPickPlace.i_bCartSlotLong2_HasMat AND
                       io_stPickPlace.i_bCartSlotShort1_HasMat AND
                       io_stPickPlace.i_bCartSlotShort2_HasMat;

    CASE s_iCurrentState OF

        S20_IDLE: (* 20 - 待机与小车4卡槽供需匹配调度 (气缸在下位X71) *)
            IF s_bStepEntry THEN
                io_stZAxis.stAbs.Execute := FALSE;
                io_stX1Axis.stAbs.Execute := FALSE;
                s_bLiftUp := FALSE;
                s_bLiftDown := TRUE;      // 待机时气缸保持在下位
                s_bPlaceDoneToCart := FALSE;
                s_iPickLayer := 0;
                s_iTargetSlot := 0;
                s_bStepEntry := FALSE;
            END_IF;

            IF NOT io_stZAxis.stPower.Status THEN io_stZAxis.stPower.Enable := TRUE; END_IF;
            IF NOT io_stX1Axis.stPower.Status THEN io_stX1Axis.stPower.Enable := TRUE; END_IF;

            // 伺服报警检查
            IF io_stZAxis.stSensor.ServoAlarm OR io_stX1Axis.stSensor.ServoAlarm THEN
                s_iAlarmCode := 73;
                IF io_stZAxis.stSensor.ServoAlarm THEN s_bZFault := TRUE; END_IF;
                IF io_stX1Axis.stSensor.ServoAlarm THEN s_bX1Fault := TRUE; END_IF;
                s_iCurrentState := S20_IDLE;
                s_bRunning := FALSE;
                s_bStartTriggered := FALSE;
            END_IF;

            // 自动调度准入条件:
            // 1. 启动触发; 2. 小车在接料位 (i_bCartAtPickPos); 3. 小车允许放料 (i_bCartPermitPlace); 4. 小车未满
            IF s_bStartTriggered AND io_stPickPlace.i_bCartAtPickPos AND io_stPickPlace.i_bCartPermitPlace AND (NOT s_bAllSlotsFull) THEN
                
                // 供需匹配调度算法:
                // 规则 1: 1层(长边1)就绪 AND 小车长边1卡槽为空
                IF (io_stPickPlace.i_bLayerRequestPickup[1] OR io_stPickPlace.i_bLayerFeedDone[1]) AND (NOT io_stPickPlace.i_bCartSlotLong1_HasMat) THEN
                    s_iPickLayer := 1;
                    s_iTargetSlot := 1;
                    s_bRunning := TRUE;
                    s_bStepEntry := TRUE;
                    s_iCurrentState := S21_UP_TO_PICK;

                // 规则 2: 2层(长边2)就绪 AND 小车长边2卡槽为空
                ELSIF (io_stPickPlace.i_bLayerRequestPickup[2] OR io_stPickPlace.i_bLayerFeedDone[2]) AND (NOT io_stPickPlace.i_bCartSlotLong2_HasMat) THEN
                    s_iPickLayer := 2;
                    s_iTargetSlot := 2;
                    s_bRunning := TRUE;
                    s_bStepEntry := TRUE;
                    s_iCurrentState := S21_UP_TO_PICK;

                // 规则 3: 3层(短边1)就绪 AND 小车短边1卡槽为空
                ELSIF (io_stPickPlace.i_bLayerRequestPickup[3] OR io_stPickPlace.i_bLayerFeedDone[3]) AND (NOT io_stPickPlace.i_bCartSlotShort1_HasMat) THEN
                    s_iPickLayer := 3;
                    s_iTargetSlot := 3;
                    s_bRunning := TRUE;
                    s_bStepEntry := TRUE;
                    s_iCurrentState := S21_UP_TO_PICK;

                // 规则 4: 4层(短边2)就绪 AND 小车短边2卡槽为空
                ELSIF (io_stPickPlace.i_bLayerRequestPickup[4] OR io_stPickPlace.i_bLayerFeedDone[4]) AND (NOT io_stPickPlace.i_bCartSlotShort2_HasMat) THEN
                    s_iPickLayer := 4;
                    s_iTargetSlot := 4;
                    s_bRunning := TRUE;
                    s_bStepEntry := TRUE;
                    s_iCurrentState := S21_UP_TO_PICK;
                END_IF;

            END_IF;

        S21_UP_TO_PICK: (* 21 - Z轴伺服上升 + 辅助升降气缸上升(Y42)补偿高度 *)
            IF s_bStepEntry THEN
                // 1. 触发辅助升降气缸上升 (Y42)
                s_bLiftUp := TRUE;
                s_bLiftDown := FALSE;

                // 2. 根据层号下发 Z 轴定位目标
                CASE s_iPickLayer OF
                    1: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PickHeightL1;
                    2: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PickHeightL2;
                    3: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PickHeightL3;
                    4: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PickHeightL4;
                    ELSE io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PickHeightL1;
                END_CASE;

                IF io_stRecipe.stActiveRecipe.rZ_Speed > 0.0 THEN
                    io_stZAxis.stAbs.Velocity := io_stRecipe.stActiveRecipe.rZ_Speed;
                ELSE
                    io_stZAxis.stAbs.Velocity := 100.0;
                END_IF;

                io_stZAxis.stAbs.Execute := TRUE;
                s_bLiftTimer_In := TRUE;
                s_bLiftTimer_R := FALSE;
                s_bStepEntry := FALSE;
            END_IF;

            // Z轴伺服完成 + 升降气缸上位 (X70) 到位确认
            IF io_stZAxis.stAbs.Done AND (io_stPickPlace.i_bLift_HomePos OR NOT io_stPickPlace.i_bLift_WorkPoint) THEN
                io_stZAxis.stAbs.Execute := FALSE;
                s_bLiftTimer_In := FALSE;
                s_bLiftTimer_R := TRUE;
                s_bStepEntry := TRUE;
                s_iCurrentState := S22_CLAMP_AND_DETECT;

            ELSIF s_bLiftTimer_Q OR io_stZAxis.stAbs.Error THEN
                io_stZAxis.stAbs.Execute := FALSE;
                io_stZAxis.stStop.Execute := TRUE;
                s_bLiftTimer_In := FALSE;
                s_bLiftTimer_R := TRUE;
                s_iAlarmCode := 75; // Z轴升降或气缸上升超时故障 (F74)
                s_iCurrentState := S20_IDLE;
                s_bRunning := FALSE;
            END_IF;

        S22_CLAMP_AND_DETECT: (* 22 - 四夹爪夹紧 + 四光电工件检测 *)
            IF s_bStepEntry THEN
                s_bFrontClamp := TRUE;
                s_bRearClamp := TRUE;
                s_bFrontClamp2 := TRUE;
                s_bRearClamp2 := TRUE;

                s_bClampTimer_In := TRUE;
                s_bClampTimer_R := FALSE;
                s_bStepEntry := FALSE;
            END_IF;

            IF s_bClampTimer_Q THEN
                s_bClampTimer_In := FALSE;
                s_bClampTimer_R := TRUE;

                // 物理夹爪夹紧确认 (Y40/Y41 闭合)
                IF io_stPickPlace.i_bFrontClamp_Closed AND io_stPickPlace.i_bRearClamp_Closed AND
                   io_stPickPlace.i_bFrontClamp2_Closed AND io_stPickPlace.i_bRearClamp2_Closed THEN
                    
                    // 工件光电检测确认
                    IF (s_iTargetSlot <= 2 AND (io_stPickPlace.i_bLongEdge1Detect OR io_stPickPlace.i_bLongEdge2Detect)) OR
                       (s_iTargetSlot >= 3 AND (io_stPickPlace.i_bShortEdge1Detect OR io_stPickPlace.i_bShortEdge2Detect)) OR
                       (io_stPickPlace.i_bFrameDetect1 OR io_stPickPlace.i_bFrameDetect2) THEN
                        s_bStepEntry := TRUE;
                        s_iCurrentState := S23_MOVE_TO_SLOT;
                    ELSE
                        s_bProductMissing := TRUE;
                        s_iAlarmCode := 72; // 工件缺失报警
                        s_iCurrentState := S25_UNCLAMP_AND_NOTIFY;
                    END_IF;

                ELSE
                    s_bSensorFault := TRUE;
                    s_iAlarmCode := 71; // 夹爪未夹紧到位
                    s_iCurrentState := S25_UNCLAMP_AND_NOTIFY;
                END_IF;
            END_IF;

        S23_MOVE_TO_SLOT: (* 23 - X1横移至小车对应卡槽示教放料点 *)
            IF s_bStepEntry THEN
                CASE s_iTargetSlot OF
                    1: io_stX1Axis.stAbs.Position := io_stRecipe.stActiveRecipe.rX1_PlaceLong1_Pos;
                    2: io_stX1Axis.stAbs.Position := io_stRecipe.stActiveRecipe.rX1_PlaceLong2_Pos;
                    3: io_stX1Axis.stAbs.Position := io_stRecipe.stActiveRecipe.rX1_PlaceShort1_Pos;
                    4: io_stX1Axis.stAbs.Position := io_stRecipe.stActiveRecipe.rX1_PlaceShort2_Pos;
                    ELSE io_stX1Axis.stAbs.Position := io_stRecipe.stActiveRecipe.rX1_PlaceLong1_Pos;
                END_CASE;

                IF io_stRecipe.stActiveRecipe.rX1_Speed > 0.0 THEN
                    io_stX1Axis.stAbs.Velocity := io_stRecipe.stActiveRecipe.rX1_Speed;
                ELSE
                    io_stX1Axis.stAbs.Velocity := 150.0;
                END_IF;

                io_stX1Axis.stAbs.Execute := TRUE;
                s_bStepEntry := FALSE;
            END_IF;

            IF io_stX1Axis.stAbs.Done THEN
                io_stX1Axis.stAbs.Execute := FALSE;
                s_bStepEntry := TRUE;
                s_iCurrentState := S24_DOWN_TO_PLACE;

            ELSIF io_stX1Axis.stAbs.Error THEN
                io_stX1Axis.stAbs.Execute := FALSE;
                io_stX1Axis.stStop.Execute := TRUE;
                s_iAlarmCode := 74; // X1轴横移故障
                s_iCurrentState := S20_IDLE;
                s_bRunning := FALSE;
            END_IF;

        S24_DOWN_TO_PLACE: (* 24 - Z轴下降+升降气缸下降(Y43)放料 + 发出取料完成信号 *)
            IF s_bStepEntry THEN
                // 1. 辅助升降气缸下降复位 (Y43)
                s_bLiftUp := FALSE;
                s_bLiftDown := TRUE;

                // 2. Z轴定位至放料高度
                CASE s_iTargetSlot OF
                    1: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PlaceLong1_Height;
                    2: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PlaceLong2_Height;
                    3: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PlaceShort1_Height;
                    4: io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PlaceShort2_Height;
                    ELSE io_stZAxis.stAbs.Position := io_stRecipe.stActiveRecipe.rZ_PlaceLong1_Height;
                END_CASE;

                io_stZAxis.stAbs.Velocity := io_stRecipe.stActiveRecipe.rZ_Speed;
                io_stZAxis.stAbs.Execute := TRUE;

                // 3. 置位对应输送机层的取料完成信号
                IF s_iPickLayer >= 1 AND s_iPickLayer <= 4 THEN
                    io_stPickPlace.o_bLayerPickupDone[s_iPickLayer] := TRUE;
                END_IF;

                s_bLiftTimer_In := TRUE;
                s_bLiftTimer_R := FALSE;
                s_bStepEntry := FALSE;
            END_IF;

            // Z轴到位且升降气缸在下位 (X71)
            IF io_stZAxis.stAbs.Done AND (io_stPickPlace.i_bLift_WorkPoint OR NOT io_stPickPlace.i_bLift_HomePos) THEN
                io_stZAxis.stAbs.Execute := FALSE;
                s_bLiftTimer_In := FALSE;
                s_bLiftTimer_R := TRUE;
                s_bStepEntry := TRUE;
                s_iCurrentState := S25_UNCLAMP_AND_NOTIFY;

            ELSIF s_bLiftTimer_Q OR io_stZAxis.stAbs.Error THEN
                io_stZAxis.stAbs.Execute := FALSE;
                io_stZAxis.stStop.Execute := TRUE;
                s_bLiftTimer_In := FALSE;
                s_bLiftTimer_R := TRUE;
                s_iAlarmCode := 75;
                s_iCurrentState := S20_IDLE;
                s_bRunning := FALSE;
            END_IF;

        S25_UNCLAMP_AND_NOTIFY: (* 25 - 4夹爪松开 + 放料完成通知 *)
            IF s_bStepEntry THEN
                s_bFrontClamp := FALSE;
                s_bRearClamp := FALSE;
                s_bFrontClamp2 := FALSE;
                s_bRearClamp2 := FALSE;

                s_bUnclampTimer_In := TRUE;
                s_bUnclampTimer_R := FALSE;
                s_bStepEntry := FALSE;
            END_IF;

            IF s_bUnclampTimer_Q THEN
                s_bUnclampTimer_In := FALSE;
                s_bUnclampTimer_R := TRUE;

                // 清除对应层取料完成脉冲
                IF s_iPickLayer >= 1 AND s_iPickLayer <= 4 THEN
                    io_stPickPlace.o_bLayerPickupDone[s_iPickLayer] := FALSE;
                END_IF;

                s_bPlaceDoneToCart := TRUE; // 单次放料完成
                s_bStepEntry := TRUE;
                s_iCurrentState := S20_IDLE; // 返回待机准备下一次取料
            END_IF;

        ELSE
            s_iCurrentState := S20_IDLE;
            s_bRunning := FALSE;
    END_CASE;

ELSIF io_stPickPlace.i_bManualMode THEN
    (* ==================== 7. 手动模式 ==================== *)
    s_bRunning := FALSE;
    s_iCurrentState := S20_IDLE;
    s_bStepEntry := TRUE;
    s_bPlaceDoneToCart := FALSE;

    s_bFrontClamp := io_stPickPlace.i_bLx_FrontClamp;
    s_bRearClamp := io_stPickPlace.i_bLx_RearClamp;
    s_bFrontClamp2 := io_stPickPlace.i_bLx_FrontClamp2;
    s_bRearClamp2 := io_stPickPlace.i_bLx_RearClamp2;
    s_bLiftUp := io_stPickPlace.i_bLx_LiftUp OR io_stPickPlace.i_bLx_Lift_Up;
    s_bLiftDown := io_stPickPlace.i_bLx_LiftDown OR io_stPickPlace.i_bLx_Lift_Down;
END_IF;

(* ==================== 8. 执行器与输出映射 ==================== *)
io_stPickPlace.o_bFrontClamp_Action        := s_bFrontClamp;
io_stPickPlace.o_bFrontClamp_Release       := NOT s_bFrontClamp;
io_stPickPlace.o_bRearClamp_Action         := s_bRearClamp;
io_stPickPlace.o_bRearClamp_Release        := NOT s_bRearClamp;
io_stPickPlace.o_bFrontClamp2_Action       := s_bFrontClamp2;
io_stPickPlace.o_bFrontClamp2_Release      := NOT s_bFrontClamp2;
io_stPickPlace.o_bRearClamp2_Action        := s_bRearClamp2;
io_stPickPlace.o_bRearClamp2_Release       := NOT s_bRearClamp2;

// 辅助升降气缸输出 (Y42/Y43)
io_stPickPlace.o_bLift_Up                  := s_bLiftUp;
io_stPickPlace.o_bLift_Down                := s_bLiftDown;
io_stPickPlace.o_bLiftUp                   := s_bLiftUp;
io_stPickPlace.o_bLiftDown                 := s_bLiftDown;

io_stPickPlace.o_bPlaceComplete_ToFeeder   := s_bPlaceDoneToCart;
io_stPickPlace.o_bAllSlotsFull_ToCart      := s_bAllSlotsFull;
io_stPickPlace.o_bRunning                  := s_bRunning;
io_stPickPlace.o_bFault                    := (s_iAlarmCode > 0);
io_stPickPlace.o_bX1Fault                  := s_bX1Fault;
io_stPickPlace.o_bZFault                   := s_bZFault;
io_stPickPlace.o_iCurrentState             := s_iCurrentState;
io_stPickPlace.o_iCurrentPickLayer         := s_iPickLayer;
io_stPickPlace.o_iStationAlarmCode         := s_iAlarmCode;

END_FUNCTION_BLOCK
