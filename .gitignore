# ============================================
# My_Workspace 全局 Git 忽略规则
# 统一管理所有子项目的公共忽略规则
# 最后更新: 2026-05-08
# ============================================

# ---- 编译产物 ----
.plc-out/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
node_modules/

# ---- 虚拟环境 ----
venv/
ENV/
env/
.venv/
.conda/

# ---- IDE 配置 ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---- 日志与临时文件 ----
logs/
*.log
*.tmp
*.bak
*.backup
*.cache

# ---- 环境变量（含敏感信息）----
.env
.env.local
.env.*.local
.env.production
.env.staging

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ---- Trae 计划文档（本地生成，不需要版本控制）----
.trae/documents/
.trae/specs/

# ---- 数据库文件 ----
*.db
*.sqlite
*.sqlite3

# ---- Docker 开发配置覆盖（个人定制）----
docker-compose.override.yml
.docker/

# ---- 测试覆盖率 ----
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
nosetests.xml

# ---- 打包分发 ----
*.tar.gz
*.zip
*.whl

# ---- Jupyter Notebook ----
.ipynb_checkpoints/

# ---- Go 模块缓存 ----
go.sum (可选：如果需要锁定版本则取消注释)
